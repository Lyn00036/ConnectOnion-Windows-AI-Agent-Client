<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ConnectOnion.WinUIClient.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ConnectOnion.WinUIClient.Controls"
    xmlns:views="using:ConnectOnion.WinUIClient.Views"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource AppBackgroundBrush}">
        <!-- One ScrollViewer owns the whole page. ItemsRepeater receives its realization rect
             from this viewer, so cards remain virtualized without a nested vertical scroller. -->
        <ScrollViewer HorizontalScrollMode="Disabled"
                      HorizontalScrollBarVisibility="Disabled"
                      HorizontalContentAlignment="Stretch"
                      VerticalScrollMode="Enabled"
                      VerticalScrollBarVisibility="Auto">
            <Grid>
                <StackPanel MaxWidth="700"
                            Margin="32,0"
                            Padding="0,36,0,40"
                            HorizontalAlignment="Stretch">
                <Border Width="64"
                        Height="64"
                        Padding="8"
                        CornerRadius="12"
                        HorizontalAlignment="Center"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <Image Source="/Assets/icon.png" Stretch="Uniform" />
                </Border>

                <TextBlock x:Uid="HomeChooseAgent"
                           Text="Choose an agent"
                           Margin="0,20,0,0"
                           FontSize="32"
                           FontWeight="SemiBold"
                           TextAlignment="Center"
                           HorizontalAlignment="Center" />
                <TextBlock x:Uid="HomeChooseAgentDescription"
                           Text="Select an agent to start a new conversation"
                           Margin="0,6,0,16"
                           FontSize="16"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center" />

                <InfoBar x:Name="PageErrorBar"
                         Margin="0,0,0,12"
                         IsOpen="False"
                         Severity="Error"
                         Title="Couldn’t open the agent"
                         AutomationProperties.LiveSetting="Assertive" />

                <ItemsRepeater x:Name="AgentList"
                               ItemsSource="{x:Bind Agents, Mode=OneWay}"
                               HorizontalAlignment="Stretch">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="8" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="views:HomeAgentItem">
                            <Button Height="78"
                                    Padding="16,14"
                                    Style="{StaticResource CardButtonStyle}"
                                    Tag="{x:Bind Id}"
                                    IsEnabled="{x:Bind IsInteractionEnabled, Mode=OneWay}"
                                    AutomationProperties.Name="{x:Bind AutomationName}"
                                    AutomationProperties.HelpText="{x:Bind FullAddress}"
                                    Click="AgentCard_Click">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.ColumnSpan="3"
                                            Margin="-16"
                                            CornerRadius="8"
                                            BorderThickness="2"
                                            BorderBrush="{ThemeResource BrandPrimaryBrush}"
                                            IsHitTestVisible="False"
                                            Visibility="{x:Bind IsHighlighted, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

                                    <controls:AgentAvatar Size="44"
                                                          CornerRadius="8"
                                                          FontSize="16"
                                                          Initial="{x:Bind Initial}"
                                                          PaletteIndex="{x:Bind AvatarPaletteIndex}" />

                                    <StackPanel Grid.Column="1"
                                                Spacing="3"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Name}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind ShortAddress}"
                                                   FontSize="13"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTipService.ToolTip="{x:Bind FullAddress}" />
                                    </StackPanel>

                                    <Grid Grid.Column="2"
                                          MinWidth="108"
                                          ColumnSpacing="10"
                                          VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="7"
                                                    HorizontalAlignment="Right"
                                                    AutomationProperties.Name="{x:Bind StatusAutomationName}"
                                                    Visibility="{x:Bind IsOpening, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                                            <ProgressRing Width="12"
                                                          Height="12"
                                                          IsActive="{x:Bind IsChecking, Mode=OneWay}"
                                                          AutomationProperties.Name="{x:Bind StatusAutomationName}"
                                                          Visibility="{x:Bind IsChecking, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                            <Ellipse Width="8"
                                                     Height="8"
                                                     Fill="{x:Bind Presence, Mode=OneWay, Converter={StaticResource PresenceToBrush}}"
                                                     AutomationProperties.Name="{x:Bind StatusAutomationName}"
                                                     Visibility="{x:Bind IsStandardStatus, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                            <Ellipse Width="8"
                                                     Height="8"
                                                     Fill="{ThemeResource WarningBrush}"
                                                     AutomationProperties.Name="{x:Bind StatusAutomationName}"
                                                     Visibility="{x:Bind IsUnavailable, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Text="{x:Bind StatusLabel, Mode=OneWay}"
                                                       FontSize="13"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="7"
                                                    HorizontalAlignment="Right"
                                                    AutomationProperties.Name="Opening agent"
                                                    Visibility="{x:Bind IsOpening, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                            <ProgressRing Width="14"
                                                          Height="14"
                                                          IsActive="{x:Bind IsOpening, Mode=OneWay}" />
                                            <TextBlock Text="Opening" FontSize="13" VerticalAlignment="Center" />
                                        </StackPanel>

                                        <ic:FluentIcon Grid.Column="1"
                                                       Icon="ChevronRight"
                                                       IconVariant="Regular"
                                                       IconSize="Size16"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                       VerticalAlignment="Center"
                                                       Visibility="{x:Bind IsOpening, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                                    </Grid>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <Button Margin="0,10,0,0"
                        Padding="12,8"
                        HorizontalAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0"
                        AutomationProperties.AutomationId="HomeAddAgentButton"
                        AutomationProperties.Name="Add another agent"
                        Click="AddAnotherAgent_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ic:FluentIcon Icon="Add"
                                       IconVariant="Regular"
                                       IconSize="Size16"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="Add another agent"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Button>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>

<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ConnectOnion.WinUIClient.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ConnectOnion.WinUIClient.Controls"
    xmlns:views="using:ConnectOnion.WinUIClient.Views"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="PageRoot"
          Background="{ThemeResource AppBackgroundBrush}">
        <ScrollViewer HorizontalScrollMode="Disabled"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollMode="Enabled"
                      VerticalScrollBarVisibility="Auto">
            <Grid MinHeight="{Binding ActualHeight, ElementName=PageRoot}">
                <StackPanel MaxWidth="560"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            Margin="32,0,32,96"
                            Spacing="28">
            <StackPanel HorizontalAlignment="Center" Spacing="14">
                <Border Width="88"
                        Height="88"
                        Padding="12"
                        CornerRadius="14"
                        Background="{ThemeResource SurfaceElevatedBrush}">
                    <Image Source="/Assets/icon.png"
                           Stretch="Uniform" />
                </Border>

                <StackPanel Spacing="8" HorizontalAlignment="Center">
                    <TextBlock x:Uid="HomeChooseAgent" Text="Choose an agent"
                               FontSize="32"
                               FontWeight="Bold"
                               TextAlignment="Center"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Uid="HomeChooseAgentDescription" Text="Select an agent to start a new conversation"
                               FontSize="16"
                               Foreground="{ThemeResource TextSecondaryBrush}"
                               TextAlignment="Center"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </StackPanel>

            <ListView x:Name="AgentList"
                      ItemsSource="{x:Bind Agents, Mode=OneWay}"
                      SelectionMode="None"
                      ScrollViewer.HorizontalScrollMode="Disabled"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollMode="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                      Background="Transparent"
                      BorderThickness="0"
                      Padding="0"
                      MinHeight="84">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,8" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="views:HomeAgentItem">
                        <Button MinHeight="84"
                                Style="{StaticResource CardButtonStyle}"
                                Tag="{x:Bind Id}"
                                Click="AgentCard_Click">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <controls:AgentAvatar Size="48"
                                                      CornerRadius="8"
                                                      FontSize="17"
                                                      Initial="{x:Bind Initial}" />

                                <StackPanel Grid.Column="1"
                                            Spacing="4"
                                            VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind Name}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                        <ic:FluentIcon Icon="Live"
                                                       IconVariant="Regular"
                                                       IconSize="Size12"
                                                       Foreground="{ThemeResource SuccessBrush}"
                                                       VerticalAlignment="Center"
                                                       Visibility="{x:Bind IsOnline, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind ShortAddress}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextTertiaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Button HorizontalAlignment="Center"
                    Padding="14,8"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="AddAnotherAgent_Click">
                <controls:IconText x:Name="AddAgentActionLabel"
                                   Glyph="Add"
                                   IconSize="Size20"
                                   Spacing="12"
                                   FontSize="16"
                                   Foreground="{ThemeResource TextSecondaryBrush}" />
            </Button>

            <controls:AddAgentForm x:Name="AddAgentPanel"
                                   MaxWidth="560"
                                   HorizontalAlignment="Stretch"
                                   Visibility="Collapsed"
                                   AgentAdded="AddAgentForm_AgentAdded" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>

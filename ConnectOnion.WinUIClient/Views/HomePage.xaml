<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ConnectOnion.WinUIClient.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ConnectOnion.WinUIClient.Controls"
    xmlns:views="using:ConnectOnion.WinUIClient.Views"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource AppBackgroundBrush}">
        <StackPanel Width="704"
                    MaxWidth="704"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="32,0,32,96"
                    Spacing="28">
            <StackPanel HorizontalAlignment="Center" Spacing="14">
                <Border Width="88"
                        Height="88"
                        Padding="12"
                        CornerRadius="14"
                        Background="{ThemeResource SurfaceElevatedBrush}">
                    <Image Source="/Assets/icon.png"
                           Stretch="Uniform" />
                </Border>

                <StackPanel Spacing="8" HorizontalAlignment="Center">
                    <TextBlock Text="Choose an agent"
                               FontFamily="Georgia"
                               FontSize="36"
                               FontWeight="Bold"
                               TextAlignment="Center"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Select an agent to start a new conversation"
                               FontSize="18"
                               Foreground="{ThemeResource TextSecondaryBrush}"
                               TextAlignment="Center"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </StackPanel>

            <ListView x:Name="AgentList"
                      ItemsSource="{x:Bind Agents, Mode=OneWay}"
                      SelectionMode="None"
                      Background="Transparent"
                      BorderThickness="0"
                      Padding="0"
                      MinHeight="112">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,12" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="views:HomeAgentItem">
                        <Button HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Tag="{x:Bind Id}"
                                Click="AgentCard_Click">
                            <Border MinHeight="112"
                                    Padding="22"
                                    CornerRadius="8"
                                    Background="{ThemeResource SurfaceElevatedBrush}"
                                    BorderBrush="{ThemeResource BorderDefaultBrush}"
                                    BorderThickness="1">
                                <Grid ColumnSpacing="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="66"
                                            Height="66"
                                            CornerRadius="9"
                                            Background="{ThemeResource BrandPrimaryBrush}">
                                        <TextBlock Text="{x:Bind Initial}"
                                                   Foreground="{ThemeResource TextOnBrandBrush}"
                                                   FontSize="22"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="1"
                                                Spacing="8"
                                                VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock Text="{x:Bind Name}"
                                                       FontSize="20"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                            <ic:FluentIcon Icon="Live"
                                                           IconVariant="Regular"
                                                           IconSize="Size16"
                                                           Foreground="{ThemeResource SuccessBrush}"
                                                           VerticalAlignment="Center"
                                                           Visibility="{x:Bind IsOnline, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind ShortAddress}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TextTertiaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Button>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Button HorizontalAlignment="Center"
                    Padding="14,8"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="AddAnotherAgent_Click">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <ic:FluentIcon Icon="Add"
                                   IconVariant="Regular"
                                   IconSize="Size20"
                                   Foreground="{ThemeResource TextSecondaryBrush}" />
                    <TextBlock x:Name="AddAgentActionLabel"
                               FontSize="16"
                               Foreground="{ThemeResource TextSecondaryBrush}" />
                </StackPanel>
            </Button>

            <controls:AddAgentForm x:Name="AddAgentPanel"
                                   Width="420"
                                   MaxWidth="620"
                                   HorizontalAlignment="Center"
                                   Visibility="Collapsed"
                                   CloseRequested="AddAgentForm_CloseRequested"
                                   AgentAdded="AddAgentForm_AgentAdded" />
        </StackPanel>
    </Grid>
</Page>

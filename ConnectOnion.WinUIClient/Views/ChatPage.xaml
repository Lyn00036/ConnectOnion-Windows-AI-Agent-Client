<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ConnectOnion.WinUIClient.Views.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:ConnectOnion.WinUIClient.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="ChatRoot"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
          SizeChanged="ChatRoot_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" MinHeight="62" Padding="18,10,20,8" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="ChatHeaderIdentity"
                        Orientation="Horizontal"
                        Spacing="10">
                <Border Width="30"
                        Height="30"
                        CornerRadius="8"
                        Background="{ThemeResource TextFillColorPrimaryBrush}">
                    <TextBlock Text="{x:Bind Vm.SelectedAgentInitial, Mode=OneWay}"
                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                               FontSize="12"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Vm.SelectedAgentName, Mode=OneWay}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock FontSize="9"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                        <Run Text="Session " />
                        <Run Text="{x:Bind Vm.SessionShortId, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </StackPanel>

            <StackPanel x:Name="ChatHeaderActions"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                <Border MinHeight="30"
                        CornerRadius="15"
                        Padding="12,0"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        Background="{ThemeResource LayerFillColorDefaultBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                        <Ellipse Width="10"
                                 Height="10"
                                 Fill="{x:Bind Vm.Presence, Mode=OneWay, Converter={StaticResource PresenceToBrush}}" />
                        <TextBlock FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center">
                            <Run Text="{x:Bind Vm.PresenceLabel, Mode=OneWay}" />
                            <Run Text=" - " />
                            <Run Text="{x:Bind Vm.ConnectionDetail, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>

            <TextBlock Grid.Row="1"
                       Grid.Column="0"
                       Grid.ColumnSpan="2"
                       Margin="40,2,0,0"
                       Text="{x:Bind Vm.StatusText, Mode=OneWay}"
                       FontSize="11"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextTrimming="CharacterEllipsis"
                       Visibility="{x:Bind Vm.StatusText, Mode=OneWay, Converter={StaticResource StringToVis}}" />
        </Grid>

        <ListView Grid.Row="1"
                  x:Name="MessageList"
                  ItemsSource="{x:Bind Vm.Messages, Mode=OneWay}"
                  FontSize="{x:Bind Vm.MessageFontSize, Mode=OneWay}"
                  SelectionMode="None"
                  Background="Transparent"
                  BorderThickness="0"
                  Padding="92,18,52,22"
                  HorizontalAlignment="Stretch">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,14" />
                    <Setter Property="Background" Value="Transparent" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:ChatMessage">
                    <Grid HorizontalAlignment="Stretch">
                        <StackPanel MaxWidth="520"
                                    HorizontalAlignment="Right"
                                    Spacing="8"
                                    Visibility="{x:Bind IsUser, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{x:Bind Content}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Right"
                                       IsTextSelectionEnabled="True"
                                       LineHeight="22" />
                            <Button HorizontalAlignment="Right"
                                    Padding="0"
                                    MinWidth="0"
                                    MinHeight="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="CopyMessage_Click"
                                    ToolTipService.ToolTip="Copy message">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="Copy" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Activity card: colored status dot + label + detail + meta
                             (thinking, intent, eval, compact, files, onboarding). -->
                        <Border MaxWidth="700"
                                HorizontalAlignment="Left"
                                CornerRadius="10"
                                Padding="12,9"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                Visibility="{x:Bind IsActivityEvent, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="9"
                                         Height="9"
                                         VerticalAlignment="Top"
                                         Margin="0,5,0,0"
                                         Fill="{x:Bind Status, Mode=OneWay, Converter={StaticResource EventStatusToBrush}}" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{x:Bind EventTitle, Mode=OneWay}"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind EventDetail, Mode=OneWay}"
                                               FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               Visibility="{x:Bind HasEventDetail, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2"
                                           Text="{x:Bind EventMeta, Mode=OneWay}"
                                           FontSize="10"
                                           VerticalAlignment="Top"
                                           Margin="0,4,0,0"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           Visibility="{x:Bind HasEventMeta, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </Border>

                        <!-- Tool card: eyebrow + name + status badge + collapsible args/result + timing
                             (tool_call merged with tool_result, and tool_blocked). -->
                        <Border MaxWidth="700"
                                HorizontalAlignment="Left"
                                CornerRadius="10"
                                Padding="14,11"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                Visibility="{x:Bind IsToolEvent, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <StackPanel Spacing="8">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{x:Bind EventEyebrow, Mode=OneWay}"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind EventTitle, Mode=OneWay}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <Border Grid.Column="2"
                                            CornerRadius="8"
                                            Padding="8,2"
                                            VerticalAlignment="Center"
                                            Background="{ThemeResource LayerFillColorDefaultBrush}">
                                        <TextBlock Text="{x:Bind StatusBadge, Mode=OneWay}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{x:Bind Status, Mode=OneWay, Converter={StaticResource EventStatusToBrush}}" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="{x:Bind EventDetail, Mode=OneWay}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Visibility="{x:Bind HasEventDetail, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                <Expander Header="Arguments"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          Visibility="{x:Bind HasEventArgs, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                    <ScrollViewer MaxHeight="220" HorizontalScrollBarVisibility="Auto">
                                        <TextBlock Text="{x:Bind EventArgs, Mode=OneWay}"
                                                   FontFamily="Consolas"
                                                   FontSize="12"
                                                   IsTextSelectionEnabled="True"
                                                   TextWrapping="NoWrap" />
                                    </ScrollViewer>
                                </Expander>
                                <Expander Header="Result"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          Visibility="{x:Bind HasEventResult, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                    <ScrollViewer MaxHeight="260" HorizontalScrollBarVisibility="Auto">
                                        <TextBlock Text="{x:Bind EventResult, Mode=OneWay}"
                                                   FontFamily="Consolas"
                                                   FontSize="12"
                                                   IsTextSelectionEnabled="True"
                                                   TextWrapping="Wrap" />
                                    </ScrollViewer>
                                </Expander>
                                <TextBlock Text="{x:Bind EventMeta, Mode=OneWay}"
                                           FontSize="10"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           Visibility="{x:Bind HasEventMeta, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Border>

                        <StackPanel MaxWidth="760"
                                    HorizontalAlignment="Left"
                                    Spacing="8"
                                    Visibility="{x:Bind IsAgent, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{x:Bind AgentName}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Visibility="{x:Bind AgentName, Converter={StaticResource StringToVis}}" />
                            <TextBlock Text="{x:Bind Content}"
                                       TextWrapping="Wrap"
                                       IsTextSelectionEnabled="True"
                                       LineHeight="22" />
                            <Grid ColumnSpacing="8"
                                  Visibility="{x:Bind IsOnboarding, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         MinWidth="0"
                                         PlaceholderText="Invite code"
                                         Text="{x:Bind OnboardInviteCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{x:Bind IsOnboardingInputEnabled, Mode=OneWay}" />
                                <Button Grid.Column="1"
                                        Content="Submit"
                                        Click="SubmitOnboard_Click"
                                        IsEnabled="{x:Bind IsOnboardingInputEnabled, Mode=OneWay}" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Padding="0"
                                        MinWidth="0"
                                        MinHeight="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="CopyMessage_Click"
                                        ToolTipService.ToolTip="Copy message">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon Glyph="&#xE8C8;"
                                                  FontSize="12"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="Copy"
                                                   FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="Collapse"
                                           FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Visibility="Collapsed" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel x:Name="ComposerPanel"
                    Grid.Row="2"
                    MaxWidth="1104"
                    Margin="24,0,24,24"
                    HorizontalAlignment="Center"
                    Width="1104">
            <Border CornerRadius="14"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid MinHeight="140">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="90" />
                        <RowDefinition Height="1" />
                        <RowDefinition Height="48" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0"
                          Padding="24,18,24,16"
                          ColumnSpacing="16"
                          VerticalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Width="48"
                                Height="48"
                                Padding="0"
                                CornerRadius="24"
                                Background="Transparent"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                ToolTipService.ToolTip="Add attachment">
                            <FontIcon Glyph="&#xE710;"
                                      FontSize="24"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Button>

                        <TextBox x:Name="InputBox"
                                 Grid.Column="1"
                                 MinHeight="48"
                                 Padding="0,9,0,0"
                                 PlaceholderText="Message this agent..."
                                 PlaceholderForeground="{ThemeResource TextFillColorTertiaryBrush}"
                                 Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                 FontSize="16"
                                 FontWeight="SemiBold"
                                 IsEnabled="{x:Bind Vm.CanSend, Mode=OneWay}"
                                 AcceptsReturn="True"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 VerticalAlignment="Center"
                                 KeyDown="InputBox_KeyDown" />

                        <Button Grid.Column="2"
                                Width="48"
                                Height="48"
                                Padding="0"
                                CornerRadius="24"
                                Background="Transparent"
                                BorderThickness="0"
                                ToolTipService.ToolTip="Voice input">
                            <FontIcon Glyph="&#xE720;"
                                      FontSize="24"
                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </Button>

                        <Button Grid.Column="3"
                                Width="56"
                                Height="56"
                                Padding="0"
                                CornerRadius="14"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderThickness="0"
                                IsEnabled="{x:Bind Vm.CanSend, Mode=OneWay}"
                                Click="Send_Click"
                                ToolTipService.ToolTip="Send message">
                            <FontIcon Glyph="&#xE74A;"
                                      FontSize="25"
                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </Button>
                    </Grid>

                    <Border Grid.Row="1"
                            Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                    <TextBlock Grid.Row="2"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Margin="0,0,24,0"
                               FontSize="14">
                        <Run Text="safe"
                             FontWeight="SemiBold"
                             Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <Run Text=" &#x00B7; "
                             Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Run Text="plan"
                             Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Run Text=" &#x00B7; "
                             Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Run Text="accept"
                             Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Run Text=" &#x00B7; "
                             Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Run Text="ultra"
                             Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </TextBlock>
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</Page>

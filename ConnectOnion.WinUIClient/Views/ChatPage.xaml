<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ConnectOnion.WinUIClient.Views.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:ConnectOnion.WinUIClient.Common"
    xmlns:controls="using:ConnectOnion.WinUIClient.Controls"
    xmlns:models="using:ConnectOnion.WinUIClient.Models"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="ChatRoot"
          Background="{ThemeResource AppBackgroundBrush}"
          SizeChanged="ChatRoot_SizeChanged">
        <Grid.Resources>
            <!-- Shared attachment rendering for both user and agent bubbles: inline
                 image preview (tap to open in the default viewer) or a file chip
                 (tap to open, button to save a copy). -->
            <DataTemplate x:Key="AttachmentChipTemplate" x:DataType="models:ChatAttachment">
                <Grid Margin="0,2">
                    <!-- Image: thumbnail, or a fallback message if it failed to load/decode. -->
                    <StackPanel Spacing="4" Visibility="{x:Bind IsImage, Converter={StaticResource BoolToVis}}">
                        <Border CornerRadius="10"
                                MaxWidth="280"
                                MaxHeight="280"
                                Background="{ThemeResource SurfaceSecondaryBrush}"
                                Visibility="{x:Bind IsFailed, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"
                                Tapped="AttachmentImage_Tapped"
                                Tag="{x:Bind}">
                            <Image Source="{x:Bind LocalCachePath, Mode=OneWay, Converter={StaticResource PathToImage}}"
                                   Stretch="Uniform"
                                   MaxWidth="280"
                                   MaxHeight="280" />
                        </Border>
                        <TextBlock Text="Image could not be loaded."
                                   FontSize="11"
                                   FontStyle="Italic"
                                   Foreground="{ThemeResource TextSecondaryBrush}"
                                   Visibility="{x:Bind IsFailed, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <!-- Generic file: icon + name + size, tap to open, button to save a copy. -->
                    <Border CornerRadius="10"
                            Padding="10,8"
                            MaxWidth="320"
                            Background="{ThemeResource SurfaceSecondaryBrush}"
                            BorderBrush="{ThemeResource BorderDefaultBrush}"
                            BorderThickness="1"
                            Tapped="AttachmentFile_Tapped"
                            Tag="{x:Bind}"
                            Visibility="{x:Bind IsImage, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ic:FluentIcon Grid.Column="0"
                                           Icon="DocumentText"
                                           IconVariant="Regular"
                                           IconSize="Size24"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextSecondaryBrush}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="{x:Bind FileName}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind SizeLabel}"
                                           FontSize="10"
                                           Foreground="{ThemeResource TextSecondaryBrush}" />
                            </StackPanel>
                            <Button Grid.Column="2"
                                    Width="28"
                                    Height="28"
                                    Padding="0"
                                    MinWidth="0"
                                    MinHeight="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    VerticalAlignment="Center"
                                    Tag="{x:Bind}"
                                    Click="SaveAttachment_Click"
                                    ToolTipService.ToolTip="Save a copy">
                                <ic:FluentIcon Icon="SaveArrowRight"
                                               IconVariant="Regular"
                                               IconSize="Size16"
                                               Foreground="{ThemeResource TextSecondaryBrush}" />
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </DataTemplate>

            <!-- One template per bubble kind, dispatched by ChatMessageTemplateSelector below.
                 A row only ever builds the visual tree for what it actually is; the previous
                 all-in-one template built every kind and hid all but one, paying that cost again
                 on every container the list recycled. -->

            <DataTemplate x:Key="ChatUserTemplate" x:DataType="models:ChatMessage">
                <StackPanel MaxWidth="520"
                            HorizontalAlignment="Right"
                            Spacing="8">
                    <ItemsControl ItemsSource="{x:Bind Attachments}"
                                  ItemTemplate="{StaticResource AttachmentChipTemplate}"
                                  HorizontalAlignment="Right"
                                  Visibility="{x:Bind HasAttachments, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                    <Border CornerRadius="18"
                            Padding="16,12"
                            Background="{ThemeResource UserMessageBackgroundBrush}"
                            BorderBrush="{ThemeResource BorderDefaultBrush}"
                            BorderThickness="1"
                            Visibility="{x:Bind Content, Converter={StaticResource StringToVis}}">
                        <controls:HighlightedTextBlock Text="{x:Bind Content, Mode=OneWay}"
                                                       SearchQuery="{x:Bind FindQuery, Mode=OneWay}"
                                                       ActiveMatchIndex="{x:Bind ActiveFindMatchIndex, Mode=OneWay}" />
                    </Border>
                    <Button HorizontalAlignment="Right"
                            Padding="0"
                            MinWidth="0"
                            MinHeight="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="CopyMessage_Click"
                            ToolTipService.ToolTip="Copy message">
                        <controls:IconText Glyph="Copy" IconSize="Size16" Spacing="6" FontSize="11"
                                           Foreground="{ThemeResource TextSecondaryBrush}" Text="Copy" />
                    </Button>
                </StackPanel>
            </DataTemplate>

            <DataTemplate x:Key="ChatAgentTemplate" x:DataType="models:ChatMessage">
                <StackPanel MaxWidth="760"
                            HorizontalAlignment="Left"
                            Spacing="8">
                    <TextBlock Text="{x:Bind AgentName}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextSecondaryBrush}"
                               Visibility="{x:Bind AgentName, Converter={StaticResource StringToVis}}" />
                    <controls:MarkdownTextBlock Markdown="{x:Bind Content, Mode=OneWay}"
                                                MaxLines="{x:Bind RenderedMaxLines, Mode=OneWay}"
                                                SearchQuery="{x:Bind FindQuery, Mode=OneWay}"
                                                ActiveMatchIndex="{x:Bind ActiveFindMatchIndex, Mode=OneWay}"
                                                Foreground="{ThemeResource TextPrimaryBrush}" />
                    <ItemsControl ItemsSource="{x:Bind Attachments}"
                                  ItemTemplate="{StaticResource AttachmentChipTemplate}"
                                  Visibility="{x:Bind HasAttachments, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                    <Grid ColumnSpacing="8"
                          Visibility="{x:Bind IsOnboarding, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 MinWidth="0"
                                 PlaceholderText="Invite code"
                                 Text="{x:Bind OnboardInviteCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{x:Bind IsOnboardingInputEnabled, Mode=OneWay}" />
                        <Button Grid.Column="1"
                                Content="Submit"
                                Click="SubmitOnboard_Click"
                                IsEnabled="{x:Bind IsOnboardingInputEnabled, Mode=OneWay}" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Padding="0"
                                MinWidth="0"
                                MinHeight="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="CopyMessage_Click"
                                ToolTipService.ToolTip="Copy message">
                            <controls:IconText Glyph="Copy" IconSize="Size16" Spacing="5" FontSize="11"
                                               Foreground="{ThemeResource TextSecondaryBrush}" Text="Copy" />
                        </Button>
                        <Button Padding="0"
                                MinWidth="0"
                                MinHeight="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="ToggleMessageCollapse_Click"
                                ToolTipService.ToolTip="{x:Bind CollapseButtonText, Mode=OneWay}"
                                Visibility="{x:Bind IsCollapsible, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <controls:IconText Glyph="ArrowMinimize" IconSize="Size16" Spacing="5" FontSize="11"
                                               Foreground="{ThemeResource TextSecondaryBrush}"
                                               Text="{x:Bind CollapseButtonText, Mode=OneWay}" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </DataTemplate>

            <!-- Activity card: colored status dot + label + detail + meta
                 (thinking, intent, eval, compact, files, onboarding). -->
            <DataTemplate x:Key="ChatActivityTemplate" x:DataType="models:ChatMessage">
                <Border MaxWidth="700"
                        HorizontalAlignment="Left"
                        CornerRadius="10"
                        Padding="12,9"
                        Background="{ThemeResource SurfaceElevatedBrush}"
                        BorderBrush="{ThemeResource BorderDefaultBrush}"
                        BorderThickness="1">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="9"
                                 Height="9"
                                 VerticalAlignment="Top"
                                 Margin="0,5,0,0"
                                 Fill="{x:Bind Status, Mode=OneWay, Converter={StaticResource EventStatusToBrush}}" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{x:Bind EventTitle, Mode=OneWay}"
                                       FontSize="12"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind EventDetail, Mode=OneWay}"
                                       FontSize="11"
                                       Foreground="{ThemeResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Visibility="{x:Bind HasEventDetail, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2"
                                   Text="{x:Bind EventMeta, Mode=OneWay}"
                                   FontSize="10"
                                   VerticalAlignment="Top"
                                   Margin="0,4,0,0"
                                   Foreground="{ThemeResource TextTertiaryBrush}"
                                   Visibility="{x:Bind HasEventMeta, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="ChatToolActivityTemplate" x:DataType="models:ChatMessage">
                <controls:ToolActivityView Activity="{x:Bind ToolActivity, Mode=OneWay}"
                                           HorizontalAlignment="Left" />
            </DataTemplate>

            <!-- Ask-user card: question + inline answer controls (dynamic fields,
                 single/multi-select options, or free text), submit button. -->
            <DataTemplate x:Key="ChatAskUserTemplate" x:DataType="models:ChatMessage">
                <Border MaxWidth="520"
                        HorizontalAlignment="Left"
                        CornerRadius="10"
                        Padding="14,11"
                        Background="{ThemeResource SurfaceElevatedBrush}"
                        BorderBrush="{ThemeResource BorderDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ic:FluentIcon Icon="QuestionCircle" IconVariant="Regular" IconSize="Size16"
                                           Foreground="{ThemeResource TextTertiaryBrush}" />
                            <TextBlock Text="{x:Bind EventEyebrow}"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextTertiaryBrush}" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind EventTitle}" FontSize="13" TextWrapping="Wrap" />

                        <ItemsControl ItemsSource="{x:Bind AskUserFields}"
                                      Visibility="{x:Bind HasAskUserFields, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:AskUserFieldEntry">
                                    <StackPanel Spacing="4" Margin="0,0,0,8">
                                        <TextBlock Text="{x:Bind Label}"
                                                   FontSize="11"
                                                   Foreground="{ThemeResource TextSecondaryBrush}" />
                                        <TextBox PlaceholderText="{x:Bind Placeholder}"
                                                 Text="{x:Bind Value, Mode=TwoWay}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <RadioButtons ItemsSource="{x:Bind AskUserOptions}"
                                      SelectedItem="{x:Bind SelectedAskUserOption, Mode=TwoWay}"
                                      Visibility="{x:Bind HasAskUserOptions, Converter={StaticResource BoolToVis}}" />

                        <ItemsControl ItemsSource="{x:Bind AskUserOptionEntries}"
                                      Visibility="{x:Bind HasAskUserMultiOptions, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:AskUserOptionEntry">
                                    <CheckBox Content="{x:Bind Text}" IsChecked="{x:Bind IsChecked, Mode=TwoWay}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBox PlaceholderText="Type your answer"
                                 Text="{x:Bind AskUserFreeText, Mode=TwoWay}"
                                 Visibility="{x:Bind ShowAskUserFreeText, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

                        <Button Content="Submit"
                                HorizontalAlignment="Right"
                                Tag="{x:Bind}"
                                Click="AskUserSubmit_Click"
                                Visibility="{x:Bind IsAwaitingResponse, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{x:Bind EventMeta, Mode=OneWay}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Foreground="{x:Bind Status, Mode=OneWay, Converter={StaticResource EventStatusToBrush}}"
                                   Visibility="{x:Bind IsAwaitingResponse, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                    </StackPanel>
                </Border>
            </DataTemplate>

            <!-- Approval card: tool + description + collapsible arguments, approve/reject buttons. -->
            <DataTemplate x:Key="ChatApprovalTemplate" x:DataType="models:ChatMessage">
                <Border MaxWidth="520"
                        HorizontalAlignment="Left"
                        CornerRadius="10"
                        Padding="14,11"
                        Background="{ThemeResource SurfaceElevatedBrush}"
                        BorderBrush="{ThemeResource BorderDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ic:FluentIcon Icon="ShieldTask" IconVariant="Regular" IconSize="Size16"
                                           Foreground="{ThemeResource TextTertiaryBrush}" />
                            <TextBlock Text="{x:Bind EventEyebrow}"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextTertiaryBrush}" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind EventTitle}" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind EventDetail}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextSecondaryBrush}"
                                   Visibility="{x:Bind HasEventDetail, Converter={StaticResource BoolToVis}}" />
                        <Expander Header="Arguments"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Stretch"
                                  Visibility="{x:Bind HasEventArgs, Converter={StaticResource BoolToVis}}">
                            <ScrollViewer MaxHeight="200" HorizontalScrollBarVisibility="Auto">
                                <TextBlock Text="{x:Bind EventArgs}"
                                           FontFamily="Consolas"
                                           FontSize="12"
                                           IsTextSelectionEnabled="True"
                                           TextWrapping="NoWrap" />
                            </ScrollViewer>
                        </Expander>
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8"
                                    Visibility="{x:Bind IsAwaitingResponse, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <Button Content="Approve once" Tag="{x:Bind}" Click="ApprovalOnce_Click" />
                            <Button Content="Approve for session" Tag="{x:Bind}" Click="ApprovalSession_Click" />
                            <Button Content="Reject" Tag="{x:Bind}" Click="ApprovalReject_Click" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind EventMeta, Mode=OneWay}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{x:Bind Status, Mode=OneWay, Converter={StaticResource EventStatusToBrush}}"
                                   Visibility="{x:Bind IsAwaitingResponse, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                    </StackPanel>
                </Border>
            </DataTemplate>

            <!-- Plan-review card: rendered plan + optional feedback, approve/request-changes buttons. -->
            <DataTemplate x:Key="ChatPlanReviewTemplate" x:DataType="models:ChatMessage">
                <Border MaxWidth="640"
                        HorizontalAlignment="Left"
                        CornerRadius="10"
                        Padding="14,11"
                        Background="{ThemeResource SurfaceElevatedBrush}"
                        BorderBrush="{ThemeResource BorderDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ic:FluentIcon Icon="ClipboardTask" IconVariant="Regular" IconSize="Size16"
                                           Foreground="{ThemeResource TextTertiaryBrush}" />
                            <TextBlock Text="{x:Bind EventEyebrow}"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextTertiaryBrush}" />
                        </StackPanel>
                        <controls:MarkdownTextBlock Markdown="{x:Bind EventDetail}"
                                                    Foreground="{ThemeResource TextPrimaryBrush}" />
                        <TextBox PlaceholderText="Optional feedback or requested changes"
                                 AcceptsReturn="True"
                                 Height="72"
                                 Text="{x:Bind PlanFeedback, Mode=TwoWay}"
                                 Visibility="{x:Bind IsAwaitingResponse, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8"
                                    Visibility="{x:Bind IsAwaitingResponse, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <Button Content="Approve plan" Tag="{x:Bind}" Click="PlanApprove_Click" />
                            <Button Content="Request changes" Tag="{x:Bind}" Click="PlanRequestChanges_Click" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind EventMeta, Mode=OneWay}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{x:Bind Status, Mode=OneWay, Converter={StaticResource EventStatusToBrush}}"
                                   Visibility="{x:Bind IsAwaitingResponse, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                    </StackPanel>
                </Border>
            </DataTemplate>

            <!-- Fallback for an event kind this build has no card for (a legacy "tool" row
                 migration left behind, or a tool_activity row whose payload failed to
                 deserialize). The old all-in-one template drew these as a blank row too. -->
            <DataTemplate x:Key="ChatEmptyTemplate">
                <Grid />
            </DataTemplate>

            <common:ChatMessageTemplateSelector x:Key="ChatMessageTemplates"
                                                User="{StaticResource ChatUserTemplate}"
                                                Agent="{StaticResource ChatAgentTemplate}"
                                                Activity="{StaticResource ChatActivityTemplate}"
                                                ToolActivity="{StaticResource ChatToolActivityTemplate}"
                                                AskUser="{StaticResource ChatAskUserTemplate}"
                                                Approval="{StaticResource ChatApprovalTemplate}"
                                                PlanReview="{StaticResource ChatPlanReviewTemplate}"
                                                Empty="{StaticResource ChatEmptyTemplate}" />
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" MinHeight="62" Padding="18,10,20,8" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="ChatHeaderIdentity"
                        Orientation="Horizontal"
                        Spacing="10">
                <controls:AgentAvatar Size="30"
                                      CornerRadius="8"
                                      FontSize="12"
                                      Initial="{x:Bind Vm.SelectedAgentInitial, Mode=OneWay}" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Vm.SelectedAgentName, Mode=OneWay}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock FontSize="9"
                               Foreground="{ThemeResource TextSecondaryBrush}">
                        <Run Text="Session " />
                        <Run Text="{x:Bind Vm.SessionShortId, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </StackPanel>

            <StackPanel x:Name="ChatHeaderActions"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                <Border MinHeight="30"
                        CornerRadius="15"
                        Padding="12,0"
                        BorderBrush="{ThemeResource BorderDefaultBrush}"
                        BorderThickness="1"
                        Background="{ThemeResource SurfaceSecondaryBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                        <Ellipse Width="10"
                                 Height="10"
                                 Fill="{x:Bind Vm.Presence, Mode=OneWay, Converter={StaticResource PresenceToBrush}}" />
                        <TextBlock FontSize="12"
                                   Foreground="{ThemeResource TextSecondaryBrush}"
                                   VerticalAlignment="Center">
                            <Run Text="{x:Bind Vm.PresenceLabel, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <ListView Grid.Row="1"
                  x:Name="MessageList"
                  ItemsSource="{x:Bind Vm.Messages, Mode=OneWay}"
                  ItemTemplateSelector="{StaticResource ChatMessageTemplates}"
                  FontSize="{x:Bind Vm.MessageFontSize, Mode=OneWay}"
                  SelectionMode="None"
                  Background="Transparent"
                  BorderThickness="0"
                  Padding="92,18,52,22"
                  HorizontalAlignment="Stretch">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,14" />
                    <Setter Property="Background" Value="Transparent" />
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>

        <Border Grid.Row="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,16"
                MaxWidth="520"
                CornerRadius="14"
                Padding="12,7"
                Background="{ThemeResource SurfaceElevatedBrush}"
                BorderBrush="{ThemeResource BorderDefaultBrush}"
                BorderThickness="1"
                IsHitTestVisible="False"
                Visibility="{x:Bind Vm.StatusText, Mode=OneWay, Converter={StaticResource StringToVis}}">
            <TextBlock Text="{x:Bind Vm.StatusText, Mode=OneWay}"
                       FontSize="11"
                       Foreground="{ThemeResource TextSecondaryBrush}"
                       TextTrimming="CharacterEllipsis" />
        </Border>

        <!-- Failure bar: appears when the last run failed and is still retryable. Mutually
             exclusive with the offline bar (see Vm.ShowRetryBar) so the two never stack. -->
        <Border Grid.Row="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,16"
                MaxWidth="520"
                CornerRadius="14"
                Padding="14,8"
                Background="{ThemeResource SurfaceElevatedBrush}"
                BorderBrush="{ThemeResource BorderDefaultBrush}"
                BorderThickness="1"
                Visibility="{x:Bind Vm.ShowRetryBar, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock Text="Couldn't reach the agent."
                           FontSize="12"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextSecondaryBrush}" />
                <Button Command="{x:Bind Vm.RetryCommand}"
                        Padding="12,5"
                        CornerRadius="8">
                    <controls:IconText Glyph="ArrowClockwise" IconSize="Size16" Spacing="6" FontSize="12" Text="Retry" />
                </Button>
            </StackPanel>
        </Border>

        <controls:OfflineNoticeBar Grid.Row="1"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Bottom"
                                   Margin="20,0,20,18"
                                   MaxWidth="620"
                                   Detail="{x:Bind Vm.PresenceDetail, Mode=OneWay}"
                                   CanRecheck="{x:Bind Vm.CanReconnect, Mode=OneWay}"
                                   IsChecking="{x:Bind Vm.IsCheckingPresence, Mode=OneWay}"
                                   StatusMessage="{x:Bind Vm.RecheckFailedMessage, Mode=OneWay}"
                                   RecheckRequested="OfflineNotice_RecheckRequested"
                                   Visibility="{x:Bind Vm.ShowOfflineNotice, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

        <controls:ChatComposer x:Name="Composer"
                               Grid.Row="2"
                               CanSubmit="{x:Bind Vm.CanSend, Mode=OneWay}"
                               EnterToSubmit="{x:Bind Vm.EnterToSend, Mode=OneWay}"
                               IsBusy="{x:Bind Vm.IsProcessing, Mode=OneWay}"
                               AcceptedInputs="{x:Bind Vm.AcceptedInputs, Mode=OneWay}"
                               ShowSuggestions="False"
                               SubmitRequested="Composer_SubmitRequested" />

        <!-- Loading overlay hides the empty-state flash before conversation data arrives -->
        <Border x:Name="LoadingOverlay"
                Grid.Row="1"
                Background="{ThemeResource AppBackgroundBrush}"
                Visibility="Visible">
            <ProgressRing Width="28"
                          Height="28"
                          IsActive="True"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
        </Border>

    </Grid>
</Page>

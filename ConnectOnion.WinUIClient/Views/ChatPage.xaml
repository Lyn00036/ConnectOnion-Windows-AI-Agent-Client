<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ConnectOnion.WinUIClient.Views.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:presentation="using:ConnectOnion.WinUIClient.Presentation"
    xmlns:controls="using:ConnectOnion.WinUIClient.Controls"
    xmlns:models="using:ConnectOnion.WinUIClient.Models"
    xmlns:animations="using:CommunityToolkit.WinUI.Animations"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="ChatRoot"
          Background="{ThemeResource AppBackgroundBrush}"
          SizeChanged="ChatRoot_SizeChanged">
        <Grid.Resources>
            <!-- Shared chrome for the three interactive cards (ask_user / approval / plan_review).
                 Their header is the same fold-away control the tool-activity card uses: click the
                 row to expand or collapse, chevron shows which way it goes, and the collapsed row
                 carries the outcome ("Approved once", "Rejected", "No selection", …).

                 These three keep the elevated surface AND the 1px border that the activity and
                 tool-activity cards deliberately gave up. That asymmetry is the point: those two
                 narrate what the agent did, these three block on the user for an answer. Now that
                 narration is a borderless wash, the border here reads as "this one wants something
                 from you" instead of being chrome every row happens to have. Don't flatten these
                 for consistency — the inconsistency is carrying the signal. -->
            <Style x:Key="InteractiveCardHeaderStyle" TargetType="Button" BasedOn="{StaticResource TransparentButtonStyle}">
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinHeight" Value="0" />
            </Style>

            <!-- An ask_user option card. It needs its own template rather than TransparentButtonStyle:
                 that one swaps in a bare Grid with no Border and no BorderBrush/CornerRadius
                 template bindings, so a border set on the instance is silently dropped — the
                 template never reads it. This one keeps a real Border and drives its own hover
                 and pressed states, which is also where the hover feedback comes from (the
                 default Fluent hover would repaint with accent chrome that fights the palette). -->
            <Style x:Key="AskUserOptionStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="MinHeight" Value="52" />
                <Setter Property="Padding" Value="16,10" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Background" Value="{ThemeResource SurfaceElevatedBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource BorderDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="OptionRoot"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Padding="{TemplateBinding Padding}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <!-- Hover deepens the surface and firms the border, so the
                                             row under the pointer is obvious without moving or
                                             resizing anything — a card that grew or shifted would
                                             make a list of options twitch as the pointer crosses it. -->
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="OptionRoot.Background" Value="{ThemeResource SurfaceHoverBrush}" />
                                                <Setter Target="OptionRoot.BorderBrush" Value="{ThemeResource BorderStrongBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="OptionRoot.Background" Value="{ThemeResource SurfacePressedBrush}" />
                                                <Setter Target="OptionRoot.BorderBrush" Value="{ThemeResource BorderStrongBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="InteractiveEyebrowStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{ThemeResource TextTertiaryBrush}" />
            </Style>

            <Style x:Key="InteractiveCollapsedTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
            </Style>

            <Style x:Key="InteractiveOutcomeStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="InteractiveChevronStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
                <Setter Property="FontSize" Value="10" />
                <Setter Property="Foreground" Value="{ThemeResource TextTertiaryBrush}" />
            </Style>

            <!-- Approval-card menu chrome. The rows are buttons but must not look like buttons:
                 they read as a list of choices, so the only chrome is a full-width hover wash from
                 TransparentButtonStyle. Verb and consequence are two TextBlocks, not one string,
                 because the weight contrast is what makes the row scannable. -->
            <Style x:Key="ApprovalMenuItemStyle" TargetType="Button" BasedOn="{StaticResource TransparentButtonStyle}">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="14,10" />
                <Setter Property="MinHeight" Value="0" />
                <!-- The two affirmative rows sit muted and come up to full strength under the
                     pointer. Opacity on the whole row rather than a per-element Foreground swap:
                     it lifts icon, verb and consequence together by the same amount, and it needs
                     no theme-specific "resting" colour to be chosen for each of them. The lift is
                     driven from code-behind (see ChatPage.Interactive.cs) because a Style setter
                     cannot reach a control's visual states without replacing its template. -->
                <Setter Property="Opacity" Value="0.62" />
            </Style>

            <Style x:Key="ApprovalFooterItemStyle" TargetType="Button" BasedOn="{StaticResource TransparentButtonStyle}">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="Padding" Value="8,9" />
                <Setter Property="MinHeight" Value="0" />
            </Style>

            <Style x:Key="ApprovalMenuVerbStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
            </Style>

            <Style x:Key="ApprovalMenuHintStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
            </Style>

            <Style x:Key="ApprovalFooterVerbStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
            </Style>

            <Style x:Key="ApprovalFooterHintStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{ThemeResource TextTertiaryBrush}" />
            </Style>

            <!-- Shared attachment rendering for both user and agent bubbles: inline
                 image preview (tap to open in the default viewer) or a file chip
                 (tap to open, button to save a copy). -->
            <DataTemplate x:Key="AttachmentChipTemplate" x:DataType="models:ChatAttachment">
                <Grid Margin="0,2">
                    <!-- Image: thumbnail, or a fallback message if it failed to load/decode. -->
                    <StackPanel Spacing="4" Visibility="{x:Bind IsImage, Converter={StaticResource BoolToVis}}">
                        <Border CornerRadius="10"
                                MaxWidth="280"
                                MaxHeight="280"
                                Background="{ThemeResource SurfaceSecondaryBrush}"
                                Visibility="{x:Bind IsFailed, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"
                                Tapped="AttachmentImage_Tapped"
                                Tag="{x:Bind}">
                            <Image Source="{x:Bind LocalCachePath, Mode=OneWay, Converter={StaticResource PathToImage}}"
                                   Stretch="Uniform"
                                   MaxWidth="280"
                                   MaxHeight="280" />
                        </Border>
                        <TextBlock x:Uid="ChatImageLoadFailure" Text="Image could not be loaded."
                                   FontSize="11"
                                   FontStyle="Italic"
                                   Foreground="{ThemeResource TextSecondaryBrush}"
                                   Visibility="{x:Bind IsFailed, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <!-- Generic file: icon + name + size, tap to open, button to save a copy. -->
                    <Border CornerRadius="10"
                            Padding="10,8"
                            MaxWidth="320"
                            Background="{ThemeResource SurfaceSecondaryBrush}"
                            BorderBrush="{ThemeResource BorderDefaultBrush}"
                            BorderThickness="1"
                            Tapped="AttachmentFile_Tapped"
                            Tag="{x:Bind}"
                            Visibility="{x:Bind IsImage, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ic:FluentIcon Grid.Column="0"
                                           Icon="DocumentText"
                                           IconVariant="Regular"
                                           IconSize="Size24"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextSecondaryBrush}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="{x:Bind FileName}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind SizeLabel}"
                                           FontSize="10"
                                           Foreground="{ThemeResource TextSecondaryBrush}" />
                            </StackPanel>
                            <Button Grid.Column="2"
                                    Width="28"
                                    Height="28"
                                    Padding="0"
                                    MinWidth="0"
                                    MinHeight="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    VerticalAlignment="Center"
                                    Tag="{x:Bind}"
                                    Click="SaveAttachment_Click"
                                    ToolTipService.ToolTip="Save a copy">
                                <ic:FluentIcon Icon="SaveArrowRight"
                                               IconVariant="Regular"
                                               IconSize="Size16"
                                               Foreground="{ThemeResource TextSecondaryBrush}" />
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </DataTemplate>

            <!-- One template per bubble kind, dispatched by ChatMessageTemplateSelector below.
                 A row only ever builds the visual tree for what it actually is; the previous
                 all-in-one template built every kind and hid all but one, paying that cost again
                 on every container the list recycled. -->

            <DataTemplate x:Key="ChatUserTemplate" x:DataType="models:ChatMessage">
                <StackPanel MaxWidth="700"
                            HorizontalAlignment="Right"
                            Spacing="8"
                            Background="Transparent"
                            PointerEntered="MessageActions_PointerEntered"
                            PointerExited="MessageActions_PointerExited"
                            GotFocus="MessageActions_GotFocus"
                            LostFocus="MessageActions_LostFocus">
                    <StackPanel HorizontalAlignment="Right"
                                Spacing="8"
                                Visibility="{x:Bind IsEditing, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                        <ItemsControl ItemsSource="{x:Bind Attachments}"
                                      ItemTemplate="{StaticResource AttachmentChipTemplate}"
                                      HorizontalAlignment="Right"
                                      Visibility="{x:Bind HasAttachments, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                        <Border MaxWidth="520"
                                HorizontalAlignment="Right"
                                CornerRadius="18"
                                Padding="16,12"
                                Background="{ThemeResource UserMessageBackgroundBrush}"
                                BorderBrush="{ThemeResource BorderDefaultBrush}"
                                BorderThickness="1"
                                Visibility="{x:Bind Content, Converter={StaticResource StringToVis}}">
                            <controls:HighlightedTextBlock Text="{x:Bind Content, Mode=OneWay}"
                                                           SearchQuery="{x:Bind FindQuery, Mode=OneWay}"
                                                           ActiveMatchIndex="{x:Bind ActiveFindMatchIndex, Mode=OneWay}"
                                                           FontSize="{x:Bind MessageFontSize, Mode=OneWay}"
                                                           Foreground="{ThemeResource TextPrimaryBrush}" />
                        </Border>
                        <!-- This row always owns its height. Hover only changes the inner
                             visibility, so showing actions never pushes the transcript down. -->
                        <Grid Height="24" HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Spacing="2"
                                        Opacity="{x:Bind UserActionsOpacity, Mode=OneWay}"
                                        IsHitTestVisible="{x:Bind ShowUserActions, Mode=OneWay}">
                                <StackPanel.OpacityTransition>
                                    <ScalarTransition Duration="0:0:0.16" />
                                </StackPanel.OpacityTransition>
                                <TextBlock Margin="0,0,4,0"
                                           VerticalAlignment="Center"
                                           Text="{x:Bind TimeLabel, Mode=OneWay}"
                                           FontSize="11"
                                           Foreground="{ThemeResource TextSecondaryBrush}" />
                                <Button Tag="{x:Bind}"
                                        Padding="3"
                                        MinWidth="24"
                                        MinHeight="24"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        IsTabStop="{x:Bind ShowUserActions, Mode=OneWay}"
                                        Click="RetryUserMessage_Click"
                                        AutomationProperties.Name="Retry from this message"
                                        ToolTipService.ToolTip="Retry from this message"
                                        Visibility="{x:Bind CanEdit, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                    <!-- All three action icons take the Size16-scaled-to-12 treatment, even
                                         the two that do have a Size12 glyph: mixing the two fonts in one row
                                         reads as inconsistent, because the Size12 designs carry heavier
                                         strokes and measure 12px against the scaled icon's 16px slot. -->
                                    <ic:FluentIcon Icon="ArrowClockwise" IconVariant="Regular" IconSize="Size16"
                                                   RenderTransformOrigin="0.5,0.5"
                                                   Foreground="{ThemeResource TextSecondaryBrush}">
                                        <ic:FluentIcon.RenderTransform>
                                            <ScaleTransform ScaleX="0.75" ScaleY="0.75" />
                                        </ic:FluentIcon.RenderTransform>
                                    </ic:FluentIcon>
                                </Button>
                                <Button Tag="{x:Bind}"
                                        Padding="3"
                                        MinWidth="24"
                                        MinHeight="24"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        IsTabStop="{x:Bind ShowUserActions, Mode=OneWay}"
                                        Click="EditUserMessage_Click"
                                        AutomationProperties.Name="Edit message"
                                        ToolTipService.ToolTip="Edit message"
                                        Visibility="{x:Bind CanEdit, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                    <ic:FluentIcon Icon="Edit" IconVariant="Regular" IconSize="Size16"
                                                   RenderTransformOrigin="0.5,0.5"
                                                   Foreground="{ThemeResource TextSecondaryBrush}">
                                        <ic:FluentIcon.RenderTransform>
                                            <ScaleTransform ScaleX="0.75" ScaleY="0.75" />
                                        </ic:FluentIcon.RenderTransform>
                                    </ic:FluentIcon>
                                </Button>
                                <Button Padding="3"
                                        MinWidth="24"
                                        MinHeight="24"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        IsTabStop="{x:Bind ShowUserActions, Mode=OneWay}"
                                        Click="CopyMessage_Click"
                                        AutomationProperties.Name="Copy message"
                                        ToolTipService.ToolTip="Copy message">
                                    <ic:FluentIcon Icon="Copy" IconVariant="Regular" IconSize="Size16"
                                                   RenderTransformOrigin="0.5,0.5"
                                                   Foreground="{ThemeResource TextSecondaryBrush}">
                                        <ic:FluentIcon.RenderTransform>
                                            <ScaleTransform ScaleX="0.75" ScaleY="0.75" />
                                        </ic:FluentIcon.RenderTransform>
                                    </ic:FluentIcon>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <Border Padding="12"
                            CornerRadius="16"
                            Background="{ThemeResource UserMessageBackgroundBrush}"
                            BorderBrush="{ThemeResource BorderDefaultBrush}"
                            BorderThickness="1"
                            Visibility="{x:Bind IsEditing, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <StackPanel Spacing="10">
                            <!-- Top: this wraps, so it opts out of the implicit style's centring. -->
                            <TextBox Text="{x:Bind EditDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalContentAlignment="Top"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="48"
                                     AutomationProperties.Name="Edit message text" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                    <ic:FluentIcon Icon="Info" IconVariant="Regular" IconSize="Size16"
                                                   Margin="0,2,0,0"
                                                   Foreground="{ThemeResource TextSecondaryBrush}" />
                                    <TextBlock Text="Editing creates a new conversation from this point. The original remains in the sidebar."
                                               TextWrapping="Wrap"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextSecondaryBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <Button Tag="{x:Bind}"
                                            Content="Cancel"
                                            Click="CancelEditUserMessage_Click" />
                                    <Button Tag="{x:Bind}"
                                            Content="Save"
                                            Style="{StaticResource AccentButtonStyle}"
                                            IsEnabled="{x:Bind CanSaveEdit, Mode=OneWay}"
                                            Click="SaveEditUserMessage_Click" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DataTemplate>

            <DataTemplate x:Key="ChatAgentTemplate" x:DataType="models:ChatMessage">
                <StackPanel MaxWidth="{StaticResource ChatColumnWidth}"
                            HorizontalAlignment="Left"
                            Spacing="8"
                            Background="Transparent"
                            PointerEntered="MessageActions_PointerEntered"
                            PointerExited="MessageActions_PointerExited"
                            GotFocus="MessageActions_GotFocus"
                            LostFocus="MessageActions_LostFocus">
                    <!-- No agent-name label above the reply. A conversation is with one agent,
                         named in the header and the sidebar, so repeating it over every bubble
                         labelled the obvious. ChatMessage.AgentName is still populated and still
                         persisted — notifications title themselves with it, and the CONNECT
                         history import needs it — this only drops the label. -->
                    <controls:MarkdownTextBlock Markdown="{x:Bind Content, Mode=OneWay}"
                                                SearchQuery="{x:Bind FindQuery, Mode=OneWay}"
                                                ActiveMatchIndex="{x:Bind ActiveFindMatchIndex, Mode=OneWay}"
                                                FontSize="{x:Bind MessageFontSize, Mode=OneWay}"
                                                Foreground="{ThemeResource TextPrimaryBrush}" />
                    <StackPanel Orientation="Horizontal"
                                Spacing="5"
                                Visibility="{x:Bind HasEventMeta, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <ic:FluentIcon Icon="Stop" IconVariant="Regular" IconSize="Size16"
                                       RenderTransformOrigin="0.5,0.5"
                                       Foreground="{ThemeResource TextTertiaryBrush}">
                            <ic:FluentIcon.RenderTransform>
                                <ScaleTransform ScaleX="0.7" ScaleY="0.7" />
                            </ic:FluentIcon.RenderTransform>
                        </ic:FluentIcon>
                        <TextBlock Text="{x:Bind EventMeta, Mode=OneWay}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextTertiaryBrush}" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{x:Bind Attachments}"
                                  ItemTemplate="{StaticResource AttachmentChipTemplate}"
                                  Visibility="{x:Bind HasAttachments, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                    <!-- Collapses (not just disables) once the code is submitted: a spent invite
                         box is dead UI, and IsOnboarding alone is not observable so it could
                         never take the row away. -->
                    <Grid ColumnSpacing="8"
                          Visibility="{x:Bind IsOnboardingInputEnabled, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 MinWidth="0"
                                 x:Uid="ChatInviteCode" PlaceholderText="Invite code"
                                 Text="{x:Bind OnboardInviteCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{x:Bind IsOnboardingInputEnabled, Mode=OneWay}" />
                        <Button Grid.Column="1"
                                x:Uid="ChatSubmitInvite" Content="Submit"
                                Click="SubmitOnboard_Click"
                                IsEnabled="{x:Bind IsOnboardingInputEnabled, Mode=OneWay}" />
                    </Grid>
                    <Grid Height="24" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="2"
                                    Opacity="{x:Bind UserActionsOpacity, Mode=OneWay}"
                                    IsHitTestVisible="{x:Bind ShowUserActions, Mode=OneWay}">
                            <StackPanel.OpacityTransition>
                                <ScalarTransition Duration="0:0:0.16" />
                            </StackPanel.OpacityTransition>
                            <Button Tag="{x:Bind}"
                                    Padding="3"
                                    MinWidth="24"
                                    MinHeight="24"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    IsTabStop="{x:Bind ShowUserActions, Mode=OneWay}"
                                    Click="RetryAgentMessage_Click"
                                    AutomationProperties.Name="Retry this response"
                                    ToolTipService.ToolTip="Retry this response">
                                <!-- Matches the user-message action row above: same font, same scale. -->
                                <ic:FluentIcon Icon="ArrowClockwise" IconVariant="Regular" IconSize="Size16"
                                               RenderTransformOrigin="0.5,0.5"
                                               Foreground="{ThemeResource TextSecondaryBrush}">
                                    <ic:FluentIcon.RenderTransform>
                                        <ScaleTransform ScaleX="0.75" ScaleY="0.75" />
                                    </ic:FluentIcon.RenderTransform>
                                </ic:FluentIcon>
                            </Button>
                            <Button Padding="3"
                                    MinWidth="24"
                                    MinHeight="24"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    IsTabStop="{x:Bind ShowUserActions, Mode=OneWay}"
                                    Click="CopyMessage_Click"
                                    AutomationProperties.Name="Copy response"
                                    ToolTipService.ToolTip="Copy response">
                                <ic:FluentIcon Icon="Copy" IconVariant="Regular" IconSize="Size16"
                                               RenderTransformOrigin="0.5,0.5"
                                               Foreground="{ThemeResource TextSecondaryBrush}">
                                    <ic:FluentIcon.RenderTransform>
                                        <ScaleTransform ScaleX="0.75" ScaleY="0.75" />
                                    </ic:FluentIcon.RenderTransform>
                                </ic:FluentIcon>
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </DataTemplate>

            <!-- Claude-style process disclosure shared by thinking, lightweight activity and
                 turn-usage rows. Process narration stays on the transcript background: a quiet
                 header, connected timeline markers, and an explicit terminal state. -->
            <!-- Activity card (thinking / intent / eval / compact). The projection folds a run of
                 consecutive `thinking` frames into one card, so this template has two shapes and
                 picks by step count:

                 One entry — shown inline behind a quiet left rule, no disclosure header. Folding a
                 single line away costs a click to read one sentence and wraps it in more scaffold
                 than content.

                 Several — collapsed to one "Thought process · N steps" row the user opens on
                 purpose, because several paragraphs of reasoning inline would bury the answer.

                 The running label survives in both because it is the one thing the content can't
                 say for itself: an empty card mid-stream must read as "Thinking...", not as blank. -->
            <DataTemplate x:Key="ChatActivityTemplate" x:DataType="models:ChatMessage">
                <!-- Same outer frame as ToolActivityView: the shared ChatColumnWidth cap and a
                     stretched grid, so both cards start on the same left edge. -->
                <Grid MaxWidth="{StaticResource ChatColumnWidth}"
                      HorizontalAlignment="Stretch">
                    <!-- No Spacing: most of these children are collapsed at any moment, and
                         StackPanel reserves the gap for a collapsed slot too — which is what left
                         a blank strip under the tool-activity header. Gaps go on margins. -->
                    <StackPanel>
                        <!-- Running label, for the window before any text has streamed in. -->
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6"
                                    Padding="0,4"
                                    Visibility="{x:Bind IsThinkingRunning, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <!-- Win2D starburst, not a ProgressRing: a spinner in a transcript
                                 reads as a progress bar and invites "how far along is it?", which
                                 this state cannot answer. IsActive is the message's own running
                                 flag — no second state to keep in sync.

                                 x:Load, not just Visibility, and this is the important part: the
                                 surrounding panel is only *hidden* on a settled row, but XAML
                                 still constructs everything inside it. That meant a
                                 CanvasAnimatedControl — a swap chain and a render thread — built
                                 for every activity row in every conversation the user opened, all
                                 paused, none released. x:Load defers construction until the row is
                                 actually thinking, and at most one row ever is (the projection
                                 removes the indicator on llm_result), so the app holds one canvas
                                 rather than one per row ever seen. -->
                            <!-- x:Name is required by x:Load; it is not referenced from code. -->
                            <controls:ThinkingIndicator x:Name="ThinkingMark"
                                                        x:Load="{x:Bind IsThinkingRunning, Mode=OneWay}"
                                                        IsActive="{x:Bind IsThinkingRunning, Mode=OneWay}"
                                                        VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ActivityHeaderTitle, Mode=OneWay}"
                                       FontSize="14"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextSecondaryBrush}" />
                            <!-- Live seconds, ticked by ChatViewModel while the call is out. It
                                 exists only during the wait: once the model answers the row goes
                                 away entirely, so there is no "thought for" epitaph to leave
                                 behind — the turn's total time is on the usage line. -->
                            <TextBlock Text="{x:Bind ThinkingElapsedLabel, Mode=OneWay}"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextTertiaryBrush}"
                                       Visibility="{x:Bind HasThinkingElapsed, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>

                        <!-- Single entry: the text itself. A thought is the agent's own aside, so
                             it is set in italic behind a quiet grey rule — the rule is what tells
                             a wrapped, italic aside apart from the agent's actual reply, which is
                             the same width and starts on the same line. The other activities are
                             statements of fact about the run: no italics, no rule. -->
                        <Grid ColumnSpacing="12"
                              Visibility="{x:Bind IsThinkingSingleThought, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="2"
                                    Margin="1,2,0,2"
                                    CornerRadius="1"
                                    Background="{ThemeResource BorderDefaultBrush}" />
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind ActivityTimelineText, Mode=OneWay}"
                                       FontSize="13"
                                       FontStyle="Italic"
                                       Foreground="{ThemeResource TextSecondaryBrush}"
                                       TextWrapping="WrapWholeWords"
                                       IsTextSelectionEnabled="True" />
                        </Grid>
                        <TextBlock Text="{x:Bind ActivityTimelineText, Mode=OneWay}"
                                   FontSize="13"
                                   Foreground="{ThemeResource TextSecondaryBrush}"
                                   TextWrapping="WrapWholeWords"
                                   IsTextSelectionEnabled="True"
                                   Visibility="{x:Bind IsPlainSingleActivity, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

                        <!-- Several entries: the tool-activity header, verbatim in structure —
                             title | summary + chevron | spacer. The trailing star column is what
                             keeps the group left-aligned, so the chevron sits right after the
                             summary instead of being pushed to the card's right edge. -->
                        <StackPanel Visibility="{x:Bind HasMultipleThoughts, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <Button MinHeight="30"
                                    Padding="0,4"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Style="{StaticResource TransparentButtonStyle}"
                                    Tag="{x:Bind}"
                                    Click="ActivityHeader_Click"
                                    AutomationProperties.Name="{x:Bind ActivityAccessibilityName, Mode=OneWay}">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{x:Bind ActivityHeaderTitle, Mode=OneWay}"
                                               FontSize="14"
                                               Foreground="{ThemeResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" />

                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                Spacing="2"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ThoughtStepsSummary, Mode=OneWay}"
                                                   MaxWidth="560"
                                                   FontSize="11"
                                                   Foreground="{ThemeResource TextTertiaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                        <!-- Unlike the tool card's, this chevron stays visible
                                             rather than being revealed on hover: a folded thought
                                             card has no other content on screen to hint that it
                                             opens. -->
                                        <Grid Width="16" Height="16" VerticalAlignment="Center">
                                            <ic:FluentIcon Icon="ChevronUp"
                                                           IconVariant="Regular"
                                                           IconSize="Size12"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Foreground="{ThemeResource TextTertiaryBrush}"
                                                           Visibility="{x:Bind IsActivityExpanded, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                            <ic:FluentIcon Icon="ChevronDown"
                                                           IconVariant="Regular"
                                                           IconSize="Size12"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Foreground="{ThemeResource TextTertiaryBrush}"
                                                           Visibility="{x:Bind IsActivityExpanded, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- Timeline panel, same geometry as the tool card's: 9px indent and
                                 a 1px rule down the gutter the steps hang off. -->
                            <Grid Margin="9,5,0,0"
                                  Visibility="{x:Bind IsActivityExpanded, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                <Border Width="1"
                                        Background="{ThemeResource BorderDefaultBrush}"
                                        HorizontalAlignment="Left"
                                        Margin="10,10,0,12" />
                                <ItemsControl ItemsSource="{x:Bind ThoughtSteps, Mode=OneWay}"
                                              Margin="0,2,4,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <TextBlock Text="{x:Bind}"
                                                       Margin="31,2,0,10"
                                                       FontSize="13"
                                                       FontStyle="Italic"
                                                       Foreground="{ThemeResource TextSecondaryBrush}"
                                                       TextWrapping="WrapWholeWords"
                                                       IsTextSelectionEnabled="True" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </StackPanel>

                        <!-- How long the agent spent thinking ("Thought for 2.0 s"), stamped when
                             the run of thoughts ends rather than at turn end — see
                             ChatTurnProjection.StampThinkingDuration. -->
                        <TextBlock Text="{x:Bind EventMeta, Mode=OneWay}"
                                   Margin="0,3,0,0"
                                   FontSize="11"
                                   Foreground="{ThemeResource TextTertiaryBrush}"
                                   TextWrapping="WrapWholeWords"
                                   Visibility="{x:Bind HasActivityTimelineMeta, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

                        <TextBlock x:Uid="ChatActivityFailed"
                                   Text="Failed"
                                   Margin="0,3,0,0"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{x:Bind Status, Mode=OneWay, Converter={StaticResource EventStatusToBrush}}"
                                   Visibility="{x:Bind IsActivityFailed, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <!-- A turn's model/token cost is supporting metadata, not another process card.
                 Keep it to one quiet line immediately before the final assistant output. -->
            <DataTemplate x:Key="ChatTurnUsageTemplate" x:DataType="models:ChatMessage">
                <StackPanel MaxWidth="700"
                            Margin="0,2,0,0"
                            Orientation="Horizontal"
                            Spacing="6"
                            HorizontalAlignment="Left"
                            AutomationProperties.Name="{x:Bind TurnUsageSummary, Mode=OneWay}">
                    <!-- Size16 scaled to 0.75 rather than Size12: the 12px font ships ~439 of the
                         4372 glyphs and silently renders a missing one as .notdef (see the
                         FluentIcons notes in CLAUDE.md). The transform does not shrink the layout
                         slot, so the icon still measures 16px — fine against this 11px line. -->
                    <ic:FluentIcon Icon="Gauge"
                                   IconVariant="Regular"
                                   IconSize="Size16"
                                   VerticalAlignment="Center"
                                   RenderTransformOrigin="0.5,0.5"
                                   Foreground="{ThemeResource TextTertiaryBrush}">
                        <ic:FluentIcon.RenderTransform>
                            <ScaleTransform ScaleX="0.75" ScaleY="0.75" />
                        </ic:FluentIcon.RenderTransform>
                    </ic:FluentIcon>
                    <TextBlock Text="{x:Bind TurnUsageSummary, Mode=OneWay}"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextTertiaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               IsTextSelectionEnabled="True" />
                </StackPanel>
            </DataTemplate>

            <DataTemplate x:Key="ChatToolActivityTemplate" x:DataType="models:ChatMessage">
                <controls:ToolActivityView Activity="{x:Bind ToolActivity, Mode=OneWay}"
                                           HorizontalAlignment="Stretch" />
            </DataTemplate>

            <!-- Ask-user card. Not a bordered box on the transcript: the options are the only
                 things that carry a frame, so the card reads as a list of choices rather than a
                 dialog dropped into the conversation. Header (chevron | dot | icon | title |
                 PENDING) over the question, the option cards, a labelled divider, the custom
                 answer box, and a quiet way out.

                 The option rows are hand-built Buttons, not RadioButton/CheckBox — see the
                 comment on the ItemsControl below for why. -->
            <DataTemplate x:Key="ChatAskUserTemplate" x:DataType="models:ChatMessage">
                <StackPanel MaxWidth="{StaticResource ChatColumnWidth}"
                            HorizontalAlignment="Stretch">
                    <Button Style="{StaticResource InteractiveCardHeaderStyle}"
                            Margin="0,0,0,10"
                            Tag="{x:Bind}"
                            Click="InteractiveHeader_Click"
                            AutomationProperties.Name="{x:Bind InteractiveAccessibilityName, Mode=OneWay}">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource InteractiveChevronStyle}"
                                           Text="&#xE70D;"
                                           Visibility="{x:Bind IsInteractiveExpanded, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Style="{StaticResource InteractiveChevronStyle}"
                                           Text="&#xE76C;"
                                           Visibility="{x:Bind IsInteractiveCollapsed, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                            <!-- Dot, icon and status label all take the interactive status
                                 color, so a card still waiting on the user reads amber end to
                                 end and a resolved one goes green (or red). Three elements
                                 rather than one because the row is scanned at three widths:
                                 the dot survives any truncation, the label carries the word. -->
                            <Ellipse Grid.Column="1"
                                     Width="7" Height="7"
                                     VerticalAlignment="Center"
                                     Fill="{x:Bind Status, Mode=OneWay, Converter={StaticResource InteractiveStatusToBrush}}" />
                            <ic:FluentIcon Grid.Column="2"
                                           Icon="QuestionCircle" IconVariant="Regular" IconSize="Size16"
                                           RenderTransformOrigin="0.5,0.5"
                                           VerticalAlignment="Center"
                                           Foreground="{x:Bind Status, Mode=OneWay, Converter={StaticResource InteractiveStatusToBrush}}">
                                <ic:FluentIcon.RenderTransform>
                                    <ScaleTransform ScaleX="0.75" ScaleY="0.75" />
                                </ic:FluentIcon.RenderTransform>
                            </ic:FluentIcon>
                            <!-- 14 to match the tool-activity card's header. Fixed rather than
                                 inherited because it is chrome: a card title should not grow with
                                 the message-size setting the way its content does. -->
                            <TextBlock Grid.Column="3"
                                       Text="{x:Bind EventEyebrow}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource TextPrimaryBrush}" />
                            <Border Grid.Column="4"
                                    CornerRadius="4"
                                    Padding="7,2"
                                    VerticalAlignment="Center"
                                    Background="{x:Bind Status, Mode=OneWay, Converter={StaticResource InteractiveStatusToBrush}, ConverterParameter=surface}">
                                <TextBlock Text="{x:Bind InteractiveStatusLabel, Mode=OneWay}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{x:Bind Status, Mode=OneWay, Converter={StaticResource InteractiveStatusToBrush}}" />
                            </Border>
                        </Grid>
                    </Button>

                    <StackPanel Visibility="{x:Bind IsInteractiveExpanded, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <!-- No FontSize: the question is body text, so it inherits the ListView's
                             MessageFontSize like every other bubble. Hardcoding it made this card
                             deaf to the Small/Large setting — the rest of the transcript resized
                             around a question that never moved. -->
                        <TextBlock Text="{x:Bind EventTitle}"
                                   Margin="0,0,0,14"
                                   TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True"
                                   Foreground="{ThemeResource TextPrimaryBrush}" />

                        <ItemsControl ItemsSource="{x:Bind AskUserFields}"
                                      Visibility="{x:Bind HasAskUserFields, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:AskUserFieldEntry">
                                    <StackPanel Spacing="4" Margin="0,0,0,8">
                                        <TextBlock Text="{x:Bind Label}"
                                                   FontSize="11"
                                                   Foreground="{ThemeResource TextSecondaryBrush}" />
                                        <TextBox PlaceholderText="{x:Bind Placeholder}"
                                                 Text="{x:Bind Value, Mode=TwoWay}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Option cards, drawn by hand rather than by RadioButton/CheckBox. Their
                             default templates decide their own chrome, so a bordered full-width
                             card was not something a Style could reliably ask them for — the
                             radio glyph in particular sits outside anything the ItemTemplate can
                             draw. Here the Button *is* the card, and the mark is an Ellipse we
                             own, which is also what lets single- and multi-select share one row
                             design. Exclusivity lives on the model (AskUserOptionEntry.Toggle). -->
                        <!-- HorizontalContentAlignment on the ItemsControl is what makes the cards
                             fill the column: it flows down to the generated ContentPresenters,
                             which otherwise size to their content and leave every option as wide
                             as its own label. -->
                        <ItemsControl ItemsSource="{x:Bind AskUserOptionEntries}"
                                      HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Stretch"
                                      Visibility="{x:Bind ShowAskUserOptions, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:AskUserOptionEntry">
                                    <!-- Selection is carried by the whole card — accent border
                                         and a tinted ground — not by the 11px dot alone, which
                                         is easy to miss in a list of five. The dot stays as the
                                         precise marker; the tint is what makes "one of these is
                                         picked" true at a glance. Both re-evaluate on IsChecked,
                                         and the hover/pressed visual states still win while the
                                         pointer is down, so a selected card stays responsive. -->
                                    <Button Style="{StaticResource AskUserOptionStyle}"
                                            Margin="0,0,0,8"
                                            Tag="{x:Bind}"
                                            Click="AskUserOption_Click"
                                            Background="{x:Bind IsChecked, Mode=OneWay, Converter={StaticResource BoolToResourceBrush}, ConverterParameter=AttentionSubtleBrush|SurfaceElevatedBrush}"
                                            BorderBrush="{x:Bind IsChecked, Mode=OneWay, Converter={StaticResource BoolToResourceBrush}, ConverterParameter=AttentionBrush|BorderDefaultBrush}"
                                            AutomationProperties.Name="{x:Bind Text}">
                                        <!-- VerticalAlignment="Center" on the content grid, not
                                             just on its children: the grid stretches to the
                                             card's full height otherwise, and the mark then
                                             centres within a taller box than the label occupies,
                                             which reads as misaligned on a wrapped option. -->
                                        <Grid ColumnSpacing="14" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="20" Height="20" VerticalAlignment="Center">
                                                <Ellipse Width="19" Height="19"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"
                                                         Stroke="{x:Bind IsChecked, Mode=OneWay, Converter={StaticResource BoolToResourceBrush}, ConverterParameter=AttentionBrush|BorderStrongBrush}"
                                                         StrokeThickness="1.5" />
                                                <Ellipse Width="11" Height="11"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"
                                                         Fill="{ThemeResource AttentionBrush}"
                                                         Visibility="{x:Bind IsChecked, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                            </Grid>
                                            <!-- Inherits MessageFontSize, same as the question above:
                                                 an option is something the user reads, not chrome. -->
                                            <TextBlock Grid.Column="1"
                                                       Text="{x:Bind Text}"
                                                       VerticalAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       Foreground="{ThemeResource TextPrimaryBrush}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Divider that names what follows, so the free-text box reads as an
                             alternative to the options rather than another required field. -->
                        <Grid Margin="0,6,0,10"
                              ColumnSpacing="12"
                              Visibility="{x:Bind ShowAskUserCustomAnswer, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Height="1" VerticalAlignment="Center" Background="{ThemeResource BorderSubtleBrush}" />
                            <TextBlock x:Uid="ChatCustomAnswerDivider" Grid.Column="1"
                                       Text="OR PROVIDE CUSTOM ANSWER"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextTertiaryBrush}" />
                            <Border Grid.Column="2" Height="1" VerticalAlignment="Center" Background="{ThemeResource BorderSubtleBrush}" />
                        </Grid>

                        <!-- Answer box with the submit affordance inside it, composer-style: the
                             text and the action that sends it belong to one control. -->
                        <Border CornerRadius="10"
                                Padding="4,4,4,4"
                                Background="{ThemeResource SurfaceElevatedBrush}"
                                BorderBrush="{ThemeResource BorderDefaultBrush}"
                                BorderThickness="1"
                                Visibility="{x:Bind ShowAskUserFreeText, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- FontSize is explicit here, unlike the TextBlocks above: a
                                     TextBox's default style sets FontSize itself, and a style
                                     setter beats inheritance, so omitting it would silently keep
                                     the control default rather than follow the message size. 14
                                     matches the transcript at the default setting; tracking
                                     Small/Large would need a binding out of the DataTemplate. -->
                                <TextBox x:Uid="ChatAnswer"
                                         PlaceholderText="Something else..."
                                         Text="{x:Bind AskUserFreeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         MinHeight="44"
                                         VerticalAlignment="Center"
                                         VerticalContentAlignment="Center"
                                         FontSize="14"
                                         Background="Transparent"
                                         BorderThickness="0">
                                    <!-- Same treatment ChatComposer gives its input, and for the
                                         same reason: this field sits inside a Border that already
                                         draws the rounded frame, so the TextBox must contribute no
                                         chrome of its own in any state.

                                         BorderThickness="0" above only covers the resting state —
                                         the focused state is a separate template setter reading
                                         TextControlBorderThemeThicknessFocused, so without
                                         scoping both keys here the app-wide 1px border reappears
                                         *inside* the card the moment the field is clicked. The
                                         background keys stop WinUI painting its own hover/focus
                                         shade over the card's surface. -->
                                    <TextBox.Resources>
                                        <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                                        <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                        <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                        <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent" />
                                    </TextBox.Resources>
                                </TextBox>
                                <!-- Filled, like the composer's send button: this box is the
                                     agent's blocking question, so the action that answers it
                                     is the primary action on screen and should not look like
                                     the quiet "Skip" underneath it. -->
                                <Button Grid.Column="1"
                                        Width="44" Height="44"
                                        Padding="0"
                                        CornerRadius="8"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource ComposerPrimaryButtonBackgroundBrush}"
                                        BorderThickness="0"
                                        Tag="{x:Bind}"
                                        Click="AskUserSubmit_Click"
                                        AutomationProperties.AutomationId="AskUserSubmitButton"
                                        AutomationProperties.Name="Send answer"
                                        ToolTipService.ToolTip="Send answer">
                                    <ic:FluentIcon Icon="Send" IconVariant="Regular" IconSize="Size16"
                                                   Foreground="{ThemeResource ComposerPrimaryButtonForegroundBrush}" />
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Skipping is a real answer here: the agent is blocked on io.receive()
                             and only unblocks when something is sent, so this replies rather than
                             merely dismissing the card. -->
                        <Button x:Uid="ChatSkipQuestion"
                                Content="Skip this question"
                                Style="{StaticResource TransparentButtonStyle}"
                                Margin="0,10,0,0"
                                Padding="8,4"
                                HorizontalAlignment="Center"
                                FontSize="13"
                                Foreground="{ThemeResource TextTertiaryBrush}"
                                Tag="{x:Bind}"
                                Click="AskUserSkip_Click"
                                Visibility="{x:Bind IsAwaitingResponse, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

                        <TextBlock Text="{x:Bind EventMeta, Mode=OneWay}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Foreground="{x:Bind Status, Mode=OneWay, Converter={StaticResource EventStatusToBrush}}"
                                   Visibility="{x:Bind IsAwaitingResponse, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                    </StackPanel>
                </StackPanel>
            </DataTemplate>

            <!-- Approval card: a decision menu, not a dialog. The tool-activity row above already
                 says which tool is pending and shows "awaiting approval", so this card carries no
                 header of its own while it waits — it is purely the list of things the user can do
                 about it, ordered by how permissive they are: the two affirmative choices on top as
                 full-width rows, the three ways out as a footer strip.

                 Each row is <bold verb> + <muted consequence>, so the choice is readable at a glance
                 and the small print never competes with it. "Reject" (soft) declines just this tool
                 and lets the agent keep going; "Stop" is the hard reject that breaks the iteration
                 loop — two different intentions, hence two entries. "Explain" answers nothing: it
                 unfolds the arguments the agent already sent, so inspecting a request never costs
                 the user their decision.

                 Once answered, the whole menu is replaced by a single resolved line — a menu of
                 dead controls is worse than no menu, and history reloaded from SQLite is all
                 resolved cards. -->
            <DataTemplate x:Key="ChatApprovalTemplate" x:DataType="models:ChatMessage">
                <!-- The left bar is the card's whole status display — this template has no
                     header while it waits, so there is nowhere else to put one. Amber while
                     the agent is blocked on the decision, green or red once it is made. The
                     ground stays the neutral elevated surface deliberately: a tint behind the
                     decision menu turned the card into a banner and made the two affirmative
                     rows' hover wash almost invisible against it. Bar only. -->
                <Border MaxWidth="720"
                        HorizontalAlignment="Stretch"
                        Padding="0"
                        Background="{ThemeResource SurfaceElevatedBrush}"
                        BorderBrush="{x:Bind Status, Mode=OneWay, Converter={StaticResource InteractiveStatusToBrush}}"
                        BorderThickness="3,0,0,0">
                    <Grid>
                        <!-- Awaiting: the decision menu. -->
                        <StackPanel Visibility="{x:Bind IsAwaitingResponse, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <Button Style="{StaticResource ApprovalMenuItemStyle}"
                                    Tag="{x:Bind}"
                                    Click="ApprovalOnce_Click"
                                    PointerEntered="ApprovalMenuItem_PointerEntered"
                                    PointerExited="ApprovalMenuItem_PointerExited"
                                    GotFocus="ApprovalMenuItem_GotFocus"
                                    LostFocus="ApprovalMenuItem_LostFocus"
                                    AutomationProperties.AutomationId="ApproveOnceButton"
                                    AutomationProperties.Name="{x:Bind ApprovalAllowOnceAccessibilityName, Mode=OneWay}">
                                <Button.OpacityTransition>
                                    <ScalarTransition Duration="0:0:0.14" />
                                </Button.OpacityTransition>
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <!-- Only the icons take a hue, never the verb or the
                                         consequence text: the row's meaning is carried by
                                         its words, and coloring those would fight the weight
                                         contrast the two TextBlocks exist to create. The icon
                                         is enough to sort affirmative from negative before
                                         reading. Both still ride the style's opacity lift, so
                                         a resting row stays muted green rather than shouting. -->
                                    <ic:FluentIcon Icon="Checkmark" IconVariant="Regular" IconSize="Size16"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{ThemeResource SuccessBrush}" />
                                    <TextBlock x:Uid="ChatApproveOnce" Grid.Column="1"
                                               Text="Allow once"
                                               Style="{StaticResource ApprovalMenuVerbStyle}" />
                                    <TextBlock Grid.Column="2"
                                               Text="{x:Bind EventDetail}"
                                               Style="{StaticResource ApprovalMenuHintStyle}"
                                               Visibility="{x:Bind HasEventDetail, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                            </Button>

                            <Button Style="{StaticResource ApprovalMenuItemStyle}"
                                    Tag="{x:Bind}"
                                    Click="ApprovalSession_Click"
                                    PointerEntered="ApprovalMenuItem_PointerEntered"
                                    PointerExited="ApprovalMenuItem_PointerExited"
                                    GotFocus="ApprovalMenuItem_GotFocus"
                                    LostFocus="ApprovalMenuItem_LostFocus"
                                    AutomationProperties.AutomationId="ApproveSessionButton"
                                    AutomationProperties.Name="{x:Bind ApprovalTrustAccessibilityName, Mode=OneWay}">
                                <Button.OpacityTransition>
                                    <ScalarTransition Duration="0:0:0.14" />
                                </Button.OpacityTransition>
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ic:FluentIcon Icon="ShieldTask" IconVariant="Regular" IconSize="Size16"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{ThemeResource SuccessBrush}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind ApprovalTrustLabel, Mode=OneWay}"
                                               Style="{StaticResource ApprovalMenuVerbStyle}" />
                                    <TextBlock x:Uid="ChatApproveSessionHint" Grid.Column="2"
                                               Text="for this session"
                                               Style="{StaticResource ApprovalMenuHintStyle}" />
                                </Grid>
                            </Button>

                            <Border Height="1" Margin="14,4" Background="{ThemeResource BorderSubtleBrush}" />

                            <!-- Footer strip: the three ways out, hairline-separated. -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Style="{StaticResource ApprovalFooterItemStyle}"
                                        Tag="{x:Bind}"
                                        Click="ApprovalSkip_Click"
                                        AutomationProperties.AutomationId="SkipStepButton"
                                        ToolTipService.ToolTip="Decline this tool; the agent keeps working">
                                    <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center">
                                        <ic:FluentIcon Icon="Dismiss" IconVariant="Regular" IconSize="Size16"
                                                       VerticalAlignment="Center"
                                                       Foreground="{ThemeResource DangerBrush}" />
                                        <TextBlock x:Uid="ChatReject" Text="Reject" Style="{StaticResource ApprovalFooterVerbStyle}" />
                                        <TextBlock x:Uid="ChatRejectHint" Text="this tool" Style="{StaticResource ApprovalFooterHintStyle}" />
                                    </StackPanel>
                                </Button>

                                <Border Grid.Column="1" Width="1" Margin="0,6" Background="{ThemeResource BorderSubtleBrush}" />

                                <Button Grid.Column="2"
                                        Style="{StaticResource ApprovalFooterItemStyle}"
                                        Tag="{x:Bind}"
                                        Click="ApprovalReject_Click"
                                        AutomationProperties.AutomationId="RejectButton"
                                        ToolTipService.ToolTip="Halt the agent and hand the turn back">
                                    <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center">
                                        <ic:FluentIcon Icon="RecordStop" IconVariant="Regular" IconSize="Size16"
                                                       VerticalAlignment="Center"
                                                       Foreground="{ThemeResource DangerBrush}" />
                                        <TextBlock x:Uid="ChatApprovalStop" Text="Stop" Style="{StaticResource ApprovalFooterVerbStyle}" />
                                        <TextBlock x:Uid="ChatApprovalStopHint" Text="all &amp; redirect" Style="{StaticResource ApprovalFooterHintStyle}" />
                                    </StackPanel>
                                </Button>

                                <Border Grid.Column="3" Width="1" Margin="0,6" Background="{ThemeResource BorderSubtleBrush}" />

                                <Button Grid.Column="4"
                                        Style="{StaticResource ApprovalFooterItemStyle}"
                                        Tag="{x:Bind}"
                                        Click="ApprovalExplain_Click"
                                        AutomationProperties.AutomationId="ExplainButton"
                                        ToolTipService.ToolTip="Show what this tool was asked to do">
                                    <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center">
                                        <ic:FluentIcon Icon="QuestionCircle" IconVariant="Regular" IconSize="Size16"
                                                       VerticalAlignment="Center"
                                                       Foreground="{ThemeResource TextSecondaryBrush}" />
                                        <TextBlock x:Uid="ChatApprovalExplain" Text="Explain" Style="{StaticResource ApprovalFooterVerbStyle}" />
                                        <TextBlock x:Uid="ChatApprovalExplainHint" Text="why?" Style="{StaticResource ApprovalFooterHintStyle}" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Explain panel: the request as sent, revealed in place. -->
                            <StackPanel Margin="14,2,14,12"
                                        Spacing="6"
                                        Visibility="{x:Bind IsApprovalExplainOpen, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{x:Bind EventDetail}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           IsTextSelectionEnabled="True"
                                           Foreground="{ThemeResource TextSecondaryBrush}"
                                           Visibility="{x:Bind HasEventDetail, Converter={StaticResource BoolToVis}}" />
                                <Border CornerRadius="6"
                                        Padding="10,8"
                                        Background="{ThemeResource SurfaceSecondaryBrush}"
                                        Visibility="{x:Bind HasEventArgs, Converter={StaticResource BoolToVis}}">
                                    <ScrollViewer MaxHeight="200" HorizontalScrollBarVisibility="Auto">
                                        <TextBlock Text="{x:Bind EventArgs}"
                                                   FontFamily="Consolas"
                                                   FontSize="12"
                                                   IsTextSelectionEnabled="True"
                                                   TextWrapping="NoWrap" />
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- Resolved: one line saying which way it went. -->
                        <Grid Margin="14,11"
                              ColumnSpacing="8"
                              Visibility="{x:Bind IsAwaitingResponse, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ic:FluentIcon Icon="ShieldTask" IconVariant="Regular" IconSize="Size16"
                                           RenderTransformOrigin="0.5,0.5"
                                           VerticalAlignment="Center"
                                           Foreground="{x:Bind Status, Mode=OneWay, Converter={StaticResource InteractiveStatusToBrush}}">
                                <ic:FluentIcon.RenderTransform>
                                    <ScaleTransform ScaleX="0.75" ScaleY="0.75" />
                                </ic:FluentIcon.RenderTransform>
                            </ic:FluentIcon>
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind EventTitle}"
                                       Style="{StaticResource InteractiveCollapsedTitleStyle}" />
                            <TextBlock Grid.Column="2"
                                       Text="{x:Bind InteractiveOutcome, Mode=OneWay}"
                                       Style="{StaticResource InteractiveOutcomeStyle}"
                                       Foreground="{x:Bind Status, Mode=OneWay, Converter={StaticResource InteractiveStatusToBrush}}" />
                        </Grid>
                    </Grid>
                </Border>
            </DataTemplate>

            <!-- Plan-review card: collapsible header + rendered plan + optional feedback,
                 approve/request-changes buttons. -->
            <DataTemplate x:Key="ChatPlanReviewTemplate" x:DataType="models:ChatMessage">
                <!-- Frame follows status like the approval card's left bar, but stays a 1px
                     outline rather than gaining a wash: this card can hold a long rendered
                     plan, and a tinted ground under that much markdown reads as a highlight
                     on the content instead of a state on the card. -->
                <Border MaxWidth="640"
                        HorizontalAlignment="Left"
                        CornerRadius="10"
                        Padding="14,11"
                        Background="{ThemeResource SurfaceElevatedBrush}"
                        BorderBrush="{x:Bind Status, Mode=OneWay, Converter={StaticResource InteractiveStatusToBrush}}"
                        BorderThickness="1">
                    <StackPanel Spacing="8">
                        <Button Style="{StaticResource InteractiveCardHeaderStyle}"
                                Tag="{x:Bind}"
                                Click="InteractiveHeader_Click"
                                AutomationProperties.Name="{x:Bind InteractiveAccessibilityName, Mode=OneWay}">
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ic:FluentIcon Icon="ClipboardTask" IconVariant="Regular" IconSize="Size16"
                                               RenderTransformOrigin="0.5,0.5"
                                               VerticalAlignment="Center"
                                               Foreground="{x:Bind Status, Mode=OneWay, Converter={StaticResource InteractiveStatusToBrush}}">
                                    <ic:FluentIcon.RenderTransform>
                                        <ScaleTransform ScaleX="0.75" ScaleY="0.75" />
                                    </ic:FluentIcon.RenderTransform>
                                </ic:FluentIcon>
                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind EventEyebrow}"
                                           Style="{StaticResource InteractiveEyebrowStyle}"
                                           Foreground="{x:Bind Status, Mode=OneWay, Converter={StaticResource InteractiveStatusToBrush}}" />
                                <TextBlock Grid.Column="2"
                                           Text="{x:Bind EventTitle}"
                                           Style="{StaticResource InteractiveCollapsedTitleStyle}"
                                           Visibility="{x:Bind IsInteractiveCollapsed, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Grid.Column="3"
                                           Text="{x:Bind InteractiveOutcome, Mode=OneWay}"
                                           Style="{StaticResource InteractiveOutcomeStyle}"
                                           Foreground="{x:Bind Status, Mode=OneWay, Converter={StaticResource InteractiveStatusToBrush}}"
                                           Visibility="{x:Bind IsInteractiveCollapsed, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                <Grid Grid.Column="4" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource InteractiveChevronStyle}"
                                               Text="&#xE70D;"
                                               Visibility="{x:Bind IsInteractiveExpanded, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Style="{StaticResource InteractiveChevronStyle}"
                                               Text="&#xE76C;"
                                               Visibility="{x:Bind IsInteractiveCollapsed, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                            </Grid>
                        </Button>

                    <StackPanel Spacing="8"
                                Visibility="{x:Bind IsInteractiveExpanded, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <controls:MarkdownTextBlock Markdown="{x:Bind EventDetail}"
                                                    Foreground="{ThemeResource TextPrimaryBrush}" />
                        <!-- Top: this wraps, so it opts out of the implicit style's centring. -->
                        <TextBox x:Uid="ChatPlanFeedback" PlaceholderText="Optional feedback or requested changes"
                                 VerticalContentAlignment="Top"
                                 AcceptsReturn="True"
                                 Height="72"
                                 Text="{x:Bind PlanFeedback, Mode=TwoWay}"
                                 Visibility="{x:Bind IsAwaitingResponse, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8"
                                    Visibility="{x:Bind IsAwaitingResponse, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <Button x:Uid="ChatApprovePlan" Content="Approve plan" Tag="{x:Bind}" Click="PlanApprove_Click" />
                            <Button x:Uid="ChatRequestChanges" Content="Request changes" Tag="{x:Bind}" Click="PlanRequestChanges_Click" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind EventMeta, Mode=OneWay}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{x:Bind Status, Mode=OneWay, Converter={StaticResource EventStatusToBrush}}"
                                   Visibility="{x:Bind IsAwaitingResponse, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                    </StackPanel>
                    </StackPanel>
                </Border>
            </DataTemplate>

            <!-- Proposed file change (diff_preview). Read-only by design: DiffWriter sends this
                 for display and asks for approval through a separate ask_user that arrives right
                 behind it, so the approve/reject buttons live on that card, not this one. Adding
                 buttons here would answer a frame the agent is not waiting on and hang the real
                 question. See the diff_preview arm of ChatTurnProjection.Events.cs.

                 The body is monospaced and scrolls horizontally rather than wrapping — a wrapped
                 diff line loses the column alignment that makes a diff readable at all. -->
            <DataTemplate x:Key="ChatDiffPreviewTemplate" x:DataType="models:ChatMessage">
                <Border MaxWidth="720"
                        HorizontalAlignment="Stretch"
                        CornerRadius="10"
                        Background="{ThemeResource SurfaceElevatedBrush}"
                        BorderBrush="{ThemeResource BorderDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel>
                        <Grid Padding="14,10" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ic:FluentIcon Icon="DocumentEdit" IconVariant="Regular" IconSize="Size16"
                                           RenderTransformOrigin="0.5,0.5"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextSecondaryBrush}">
                                <ic:FluentIcon.RenderTransform>
                                    <ScaleTransform ScaleX="0.75" ScaleY="0.75" />
                                </ic:FluentIcon.RenderTransform>
                            </ic:FluentIcon>
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind EventEyebrow}"
                                       Style="{StaticResource InteractiveEyebrowStyle}" />
                            <TextBlock Grid.Column="2"
                                       Text="{x:Bind EventTitle}"
                                       FontFamily="Consolas"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTipService.ToolTip="{x:Bind EventTitle}"
                                       Foreground="{ThemeResource TextPrimaryBrush}" />
                            <TextBlock Grid.Column="3"
                                       Text="{x:Bind EventMeta, Mode=OneWay}"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextTertiaryBrush}"
                                       Visibility="{x:Bind HasEventMeta, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                        </Grid>

                        <Border Height="1" Background="{ThemeResource BorderSubtleBrush}" />

                        <ScrollViewer MaxHeight="320"
                                      HorizontalScrollBarVisibility="Auto"
                                      HorizontalScrollMode="Auto"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{x:Bind EventDetail, Converter={StaticResource DiffTextToLines}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="presentation:DiffLine">
                                        <Border Background="{x:Bind Kind, Converter={StaticResource DiffKindToBrush}}"
                                                Padding="14,1">
                                            <TextBlock Text="{x:Bind Text}"
                                                       FontFamily="Consolas"
                                                       FontSize="12"
                                                       IsTextSelectionEnabled="True"
                                                       TextWrapping="NoWrap"
                                                       Foreground="{x:Bind Kind, Converter={StaticResource DiffKindToBrush}, ConverterParameter=foreground}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </DataTemplate>

            <!-- Fallback for an event kind this build has no card for (a legacy "tool" row
                 migration left behind, or a tool_activity row whose payload failed to
                 deserialize). The old all-in-one template drew these as a blank row too. -->
            <DataTemplate x:Key="ChatEmptyTemplate">
                <Grid />
            </DataTemplate>

            <presentation:ChatMessageTemplateSelector x:Key="ChatMessageTemplates"
                                                User="{StaticResource ChatUserTemplate}"
                                                Agent="{StaticResource ChatAgentTemplate}"
                                                Usage="{StaticResource ChatTurnUsageTemplate}"
                                                Activity="{StaticResource ChatActivityTemplate}"
                                                ToolActivity="{StaticResource ChatToolActivityTemplate}"
                                                AskUser="{StaticResource ChatAskUserTemplate}"
                                                Approval="{StaticResource ChatApprovalTemplate}"
                                                PlanReview="{StaticResource ChatPlanReviewTemplate}"
                                                DiffPreview="{StaticResource ChatDiffPreviewTemplate}"
                                                Empty="{StaticResource ChatEmptyTemplate}" />
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ListView Grid.Row="0"
                  x:Name="MessageList"
                  AutomationProperties.AutomationId="MessageList"
                  ItemsSource="{x:Bind Vm.Messages, Mode=OneWay}"
                  ItemTemplateSelector="{StaticResource ChatMessageTemplates}"
                  FontSize="{x:Bind Vm.MessageFontSize, Mode=OneWay}"
                  SelectionMode="None"
                  Background="Transparent"
                  BorderThickness="0"
                  Padding="92,18,52,22"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Stretch">
            <!-- Conversation identity belongs to the transcript, not permanent page chrome.
                 Keeping it in the ListView header makes it available at the start of a chat and
                 lets it scroll away once the user is reading the conversation. -->
            <ListView.Header>
                <Grid MaxWidth="{StaticResource ChatColumnWidth}"
                      Margin="0,0,0,18"
                      HorizontalAlignment="Stretch" />
            </ListView.Header>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,6" />
                    <Setter Property="Background" Value="Transparent" />
                    <!-- The Fluent default is 40px, which silently floors every short row (a
                         thought line, a usage line) and shows up as gap the Margin above cannot
                         take back. Zeroing it is what makes the spacing actually settable. -->
                    <Setter Property="MinHeight" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>

        <!-- Claude-style continuation affordance. It is controlled by the real ScrollViewer
             offset, so it appears only while transcript content remains below the viewport. -->
        <Button x:Name="ScrollToLatestButton"
                Grid.Row="0"
                Canvas.ZIndex="20"
                Width="44"
                Height="44"
                Margin="0,0,0,10"
                Padding="0"
                CornerRadius="22"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Background="{ThemeResource SurfaceElevatedBrush}"
                BorderBrush="{ThemeResource BorderDefaultBrush}"
                BorderThickness="1"
                Translation="0,0,12"
                Visibility="Collapsed"
                Click="ScrollToLatest_Click"
                AutomationProperties.Name="Scroll to latest message"
                ToolTipService.ToolTip="Scroll to latest message">
            <Button.Shadow>
                <ThemeShadow />
            </Button.Shadow>
            <ic:FluentIcon Icon="ArrowDown"
                           IconVariant="Regular"
                           IconSize="Size20"
                           Foreground="{ThemeResource TextPrimaryBrush}" />
        </Button>

        <!-- Failure bar: appears when the last run failed and is still retryable. Mutually
             exclusive with the offline bar (see Vm.ShowRetryBar) so the two never stack. -->
        <Border Grid.Row="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,16"
                MaxWidth="520"
                CornerRadius="14"
                Padding="14,8"
                Background="{ThemeResource SurfaceElevatedBrush}"
                BorderBrush="{ThemeResource BorderDefaultBrush}"
                BorderThickness="1"
                Visibility="{x:Bind Vm.ShowRetryBar, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock x:Uid="ChatConnectionFailure" Text="Couldn't reach the agent."
                           FontSize="12"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextSecondaryBrush}" />
                <Button Command="{x:Bind Vm.RetryCommand}"
                        Padding="12,5"
                        CornerRadius="8">
                    <controls:IconText x:Uid="ChatRetry" Glyph="ArrowClockwise" IconSize="Size16" Spacing="6" FontSize="12" Text="Retry" />
                </Button>
            </StackPanel>
        </Border>

        <controls:OfflineNoticeBar Grid.Row="0"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Bottom"
                                   Margin="20,0,20,18"
                                   MaxWidth="620"
                                   Detail="{x:Bind Vm.PresenceDetail, Mode=OneWay}"
                                   CanRecheck="{x:Bind Vm.CanReconnect, Mode=OneWay}"
                                   IsChecking="{x:Bind Vm.IsCheckingPresence, Mode=OneWay}"
                                   StatusMessage="{x:Bind Vm.RecheckFailedMessage, Mode=OneWay}"
                                   RecheckRequested="OfflineNotice_RecheckRequested"
                                   Visibility="{x:Bind Vm.ShowOfflineNotice, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <!-- Slide + fade up when the offline card appears, instead of popping in. -->
            <animations:Implicit.ShowAnimations>
                <animations:OpacityAnimation From="0" To="1" Duration="0:0:0.2" />
                <animations:TranslationAnimation From="0,14,0" To="0,0,0" Duration="0:0:0.2" />
            </animations:Implicit.ShowAnimations>
        </controls:OfflineNoticeBar>

        <StackPanel Grid.Row="1">
            <!-- Transient run feedback is input-adjacent: it explains what the action the user
                 just submitted is doing without consuming a permanent page header. -->
            <Grid MaxWidth="{StaticResource ChatComposerWidth}"
                  MinHeight="22"
                  Margin="20,0,20,3"
                  HorizontalAlignment="Stretch"
                  Visibility="{x:Bind Vm.StatusText, Mode=OneWay, Converter={StaticResource StringToVis}}">
                <StackPanel Orientation="Horizontal"
                            Spacing="7"
                            VerticalAlignment="Center">
                    <ProgressRing Width="12"
                                  Height="12"
                                  IsActive="{x:Bind Vm.IsProcessing, Mode=OneWay}"
                                  Visibility="{x:Bind Vm.IsProcessing, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{x:Bind Vm.StatusText, Mode=OneWay}"
                               AutomationProperties.AutomationId="ConnectionStatus"
                               FontSize="11"
                               Foreground="{ThemeResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <controls:ChatComposer x:Name="Composer"
                                   CanSubmit="{x:Bind Vm.CanSend, Mode=OneWay}"
                                   EnterToSubmit="{x:Bind Vm.EnterToSend, Mode=OneWay}"
                                   IsBusy="{x:Bind Vm.IsProcessing, Mode=OneWay}"
                                   CanStop="{x:Bind Vm.CanStop, Mode=OneWay}"
                                   IsStopping="{x:Bind Vm.IsStopping, Mode=OneWay}"
                                   Mode="{x:Bind Vm.CurrentMode, Mode=OneWay}"
                                   ShowModeSelector="True"
                                   AcceptedInputs="{x:Bind Vm.AcceptedInputs, Mode=OneWay}"
                                   ShowSuggestions="False"
                                   StopRequested="Composer_StopRequested"
                                   ModeChangeRequested="Composer_ModeChangeRequested"
                                   SubmitRequested="Composer_SubmitRequested" />

            <!-- Identity and live socket phase, below the composer. One line rather than two:
                 both answer "what am I talking to and is it there", and a separate connection
                 banner would compete with the transient run status above the composer. -->
            <StackPanel Orientation="Horizontal"
                        Spacing="6"
                        HorizontalAlignment="Center"
                        Margin="0,4,0,12">
                <TextBlock FontSize="10"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextTertiaryBrush}">
                        <Run Text="{x:Bind Vm.SelectedAgentName, Mode=OneWay}" />
                        <Run Text="· Session " />
                        <Run Text="{x:Bind Vm.SessionShortId, Mode=OneWay}" />
                </TextBlock>

                <TextBlock Text="·"
                           FontSize="10"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextTertiaryBrush}" />

                <Ellipse Width="6" Height="6"
                         VerticalAlignment="Center"
                         Fill="{x:Bind Vm.ConnectionPhase, Mode=OneWay, Converter={StaticResource ConnectionPhaseToBrush}}" />
                <TextBlock Text="{x:Bind Vm.ConnectionPhaseText, Mode=OneWay}"
                           AutomationProperties.AutomationId="ConnectionPhaseLabel"
                           FontSize="10"
                           VerticalAlignment="Center"
                           Foreground="{x:Bind Vm.ConnectionPhase, Mode=OneWay, Converter={StaticResource ConnectionPhaseToBrush}}" />
            </StackPanel>
        </StackPanel>

        <!-- Empty state: shown after loading completes when no messages exist -->
        <StackPanel x:Name="EmptyStatePanel"
                    Grid.Row="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8"
                    Visibility="Collapsed">
            <TextBlock x:Uid="ChatEmptyTitle" Text="No messages yet"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       HorizontalAlignment="Center" />
            <TextBlock x:Uid="ChatEmptyDescription" Text="Type a message below to start the conversation."
                       Foreground="{ThemeResource TextSecondaryBrush}"
                       HorizontalAlignment="Center"
                       TextWrapping="WrapWholeWords" />
        </StackPanel>

        <!-- Loading overlay hides the empty-state flash before conversation data arrives -->
        <Border x:Name="LoadingOverlay"
                Grid.Row="0"
                Background="{ThemeResource AppBackgroundBrush}"
                Visibility="Visible">
            <ProgressRing Width="28"
                          Height="28"
                          IsActive="True"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
        </Border>

    </Grid>
</Page>

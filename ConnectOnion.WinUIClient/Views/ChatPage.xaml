<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ConnectOnion.WinUIClient.Views.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ConnectOnion.WinUIClient.Controls"
    xmlns:models="using:ConnectOnion.WinUIClient.Models"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="ChatRoot"
          Background="{ThemeResource AppBackgroundBrush}"
          SizeChanged="ChatRoot_SizeChanged">
        <Grid.Resources>
            <!-- Shared attachment rendering for both user and agent bubbles: inline
                 image preview (tap to open in the default viewer) or a file chip
                 (tap to open, button to save a copy). -->
            <DataTemplate x:Key="AttachmentChipTemplate" x:DataType="models:ChatAttachment">
                <Grid Margin="0,2">
                    <!-- Image: thumbnail, or a fallback message if it failed to load/decode. -->
                    <StackPanel Spacing="4" Visibility="{x:Bind IsImage, Converter={StaticResource BoolToVis}}">
                        <Border CornerRadius="10"
                                MaxWidth="280"
                                MaxHeight="280"
                                Background="{ThemeResource SurfaceSecondaryBrush}"
                                Visibility="{x:Bind IsFailed, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"
                                Tapped="AttachmentImage_Tapped"
                                Tag="{x:Bind}">
                            <Image Source="{x:Bind LocalCachePath, Mode=OneWay, Converter={StaticResource PathToImage}}"
                                   Stretch="Uniform"
                                   MaxWidth="280"
                                   MaxHeight="280" />
                        </Border>
                        <TextBlock Text="Image could not be loaded."
                                   FontSize="11"
                                   FontStyle="Italic"
                                   Foreground="{ThemeResource TextSecondaryBrush}"
                                   Visibility="{x:Bind IsFailed, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <!-- Generic file: icon + name + size, tap to open, button to save a copy. -->
                    <Border CornerRadius="10"
                            Padding="10,8"
                            MaxWidth="320"
                            Background="{ThemeResource SurfaceSecondaryBrush}"
                            BorderBrush="{ThemeResource BorderDefaultBrush}"
                            BorderThickness="1"
                            Tapped="AttachmentFile_Tapped"
                            Tag="{x:Bind}"
                            Visibility="{x:Bind IsImage, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ic:FluentIcon Grid.Column="0"
                                           Icon="DocumentText"
                                           IconVariant="Regular"
                                           IconSize="Size24"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextSecondaryBrush}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="{x:Bind FileName}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind SizeLabel}"
                                           FontSize="10"
                                           Foreground="{ThemeResource TextSecondaryBrush}" />
                            </StackPanel>
                            <Button Grid.Column="2"
                                    Width="28"
                                    Height="28"
                                    Padding="0"
                                    MinWidth="0"
                                    MinHeight="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    VerticalAlignment="Center"
                                    Tag="{x:Bind}"
                                    Click="SaveAttachment_Click"
                                    ToolTipService.ToolTip="Save a copy">
                                <ic:FluentIcon Icon="SaveArrowRight"
                                               IconVariant="Regular"
                                               IconSize="Size16"
                                               Foreground="{ThemeResource TextSecondaryBrush}" />
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </DataTemplate>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" MinHeight="62" Padding="18,10,20,8" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="ChatHeaderIdentity"
                        Orientation="Horizontal"
                        Spacing="10">
                <Border Width="30"
                        Height="30"
                        CornerRadius="8"
                        Background="{ThemeResource BrandPrimaryBrush}">
                    <TextBlock Text="{x:Bind Vm.SelectedAgentInitial, Mode=OneWay}"
                               Foreground="{ThemeResource TextOnBrandBrush}"
                               FontSize="12"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Vm.SelectedAgentName, Mode=OneWay}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock FontSize="9"
                               Foreground="{ThemeResource TextSecondaryBrush}">
                        <Run Text="Session " />
                        <Run Text="{x:Bind Vm.SessionShortId, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </StackPanel>

            <StackPanel x:Name="ChatHeaderActions"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                <Border MinHeight="30"
                        CornerRadius="15"
                        Padding="12,0"
                        BorderBrush="{ThemeResource BorderDefaultBrush}"
                        BorderThickness="1"
                        Background="{ThemeResource SurfaceSecondaryBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                        <Ellipse Width="10"
                                 Height="10"
                                 Fill="{x:Bind Vm.Presence, Mode=OneWay, Converter={StaticResource PresenceToBrush}}" />
                        <TextBlock FontSize="12"
                                   Foreground="{ThemeResource TextSecondaryBrush}"
                                   VerticalAlignment="Center">
                            <Run Text="{x:Bind Vm.PresenceLabel, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <ListView Grid.Row="1"
                  x:Name="MessageList"
                  ItemsSource="{x:Bind Vm.Messages, Mode=OneWay}"
                  FontSize="{x:Bind Vm.MessageFontSize, Mode=OneWay}"
                  SelectionMode="None"
                  Background="Transparent"
                  BorderThickness="0"
                  Padding="92,18,52,22"
                  HorizontalAlignment="Stretch">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,14" />
                    <Setter Property="Background" Value="Transparent" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:ChatMessage">
                    <Grid HorizontalAlignment="Stretch">
                        <StackPanel MaxWidth="520"
                                    HorizontalAlignment="Right"
                                    Spacing="8"
                                    Visibility="{x:Bind IsUser, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <ItemsControl ItemsSource="{x:Bind Attachments}"
                                          ItemTemplate="{StaticResource AttachmentChipTemplate}"
                                          HorizontalAlignment="Right"
                                          Visibility="{x:Bind HasAttachments, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                            <Border CornerRadius="18"
                                    Padding="16,12"
                                    Background="{ThemeResource UserMessageBackgroundBrush}"
                                    BorderBrush="{ThemeResource BorderDefaultBrush}"
                                    BorderThickness="1"
                                    Visibility="{x:Bind Content, Converter={StaticResource StringToVis}}">
                                <controls:HighlightedTextBlock Text="{x:Bind Content, Mode=OneWay}"
                                                               SearchQuery="{x:Bind FindQuery, Mode=OneWay}"
                                                               ActiveMatchIndex="{x:Bind ActiveFindMatchIndex, Mode=OneWay}" />
                            </Border>
                            <Button HorizontalAlignment="Right"
                                    Padding="0"
                                    MinWidth="0"
                                    MinHeight="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="CopyMessage_Click"
                                    ToolTipService.ToolTip="Copy message">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ic:FluentIcon Icon="Copy" IconVariant="Regular" IconSize="Size16" Foreground="{ThemeResource TextSecondaryBrush}" />
                                    <TextBlock Text="Copy" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Activity card: colored status dot + label + detail + meta
                             (thinking, intent, eval, compact, files, onboarding). -->
                        <Border MaxWidth="700"
                                HorizontalAlignment="Left"
                                CornerRadius="10"
                                Padding="12,9"
                                Background="{ThemeResource SurfaceElevatedBrush}"
                                BorderBrush="{ThemeResource BorderDefaultBrush}"
                                BorderThickness="1"
                                Visibility="{x:Bind IsActivityEvent, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="9"
                                         Height="9"
                                         VerticalAlignment="Top"
                                         Margin="0,5,0,0"
                                         Fill="{x:Bind Status, Mode=OneWay, Converter={StaticResource EventStatusToBrush}}" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{x:Bind EventTitle, Mode=OneWay}"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind EventDetail, Mode=OneWay}"
                                               FontSize="11"
                                               Foreground="{ThemeResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               Visibility="{x:Bind HasEventDetail, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2"
                                           Text="{x:Bind EventMeta, Mode=OneWay}"
                                           FontSize="10"
                                           VerticalAlignment="Top"
                                           Margin="0,4,0,0"
                                           Foreground="{ThemeResource TextTertiaryBrush}"
                                           Visibility="{x:Bind HasEventMeta, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </Border>

                        <!-- Tool card: eyebrow + name + status badge + collapsible args/result + timing
                             (tool_call merged with tool_result, and tool_blocked). -->
                        <Border MaxWidth="700"
                                HorizontalAlignment="Left"
                                CornerRadius="10"
                                Padding="14,11"
                                Background="{ThemeResource SurfaceElevatedBrush}"
                                BorderBrush="{ThemeResource BorderDefaultBrush}"
                                BorderThickness="1"
                                Visibility="{x:Bind IsToolEvent, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <StackPanel Spacing="8">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{x:Bind EventEyebrow, Mode=OneWay}"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextTertiaryBrush}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind EventTitle, Mode=OneWay}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <Border Grid.Column="2"
                                            CornerRadius="8"
                                            Padding="8,2"
                                            VerticalAlignment="Center"
                                            Background="{ThemeResource SurfaceSecondaryBrush}">
                                        <TextBlock Text="{x:Bind StatusBadge, Mode=OneWay}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{x:Bind Status, Mode=OneWay, Converter={StaticResource EventStatusToBrush}}" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="{x:Bind EventDetail, Mode=OneWay}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextSecondaryBrush}"
                                           Visibility="{x:Bind HasEventDetail, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                <Expander Header="Arguments"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          Visibility="{x:Bind HasEventArgs, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                    <ScrollViewer MaxHeight="220" HorizontalScrollBarVisibility="Auto">
                                        <TextBlock Text="{x:Bind EventArgs, Mode=OneWay}"
                                                   FontFamily="Consolas"
                                                   FontSize="12"
                                                   IsTextSelectionEnabled="True"
                                                   TextWrapping="NoWrap" />
                                    </ScrollViewer>
                                </Expander>
                                <Expander Header="Result"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          Visibility="{x:Bind HasEventResult, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                    <ScrollViewer MaxHeight="260" HorizontalScrollBarVisibility="Auto">
                                        <TextBlock Text="{x:Bind EventResult, Mode=OneWay}"
                                                   FontFamily="Consolas"
                                                   FontSize="12"
                                                   IsTextSelectionEnabled="True"
                                                   TextWrapping="Wrap" />
                                    </ScrollViewer>
                                </Expander>
                                <TextBlock Text="{x:Bind EventMeta, Mode=OneWay}"
                                           FontSize="10"
                                           Foreground="{ThemeResource TextTertiaryBrush}"
                                           Visibility="{x:Bind HasEventMeta, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Border>

                        <!-- Ask-user card: question + inline answer controls (dynamic fields,
                             single/multi-select options, or free text), submit button. -->
                        <Border MaxWidth="520"
                                HorizontalAlignment="Left"
                                CornerRadius="10"
                                Padding="14,11"
                                Background="{ThemeResource SurfaceElevatedBrush}"
                                BorderBrush="{ThemeResource BorderDefaultBrush}"
                                BorderThickness="1"
                                Visibility="{x:Bind IsAskUserEvent, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ic:FluentIcon Icon="QuestionCircle" IconVariant="Regular" IconSize="Size16"
                                                   Foreground="{ThemeResource TextTertiaryBrush}" />
                                    <TextBlock Text="{x:Bind EventEyebrow}"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextTertiaryBrush}" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind EventTitle}" FontSize="13" TextWrapping="Wrap" />

                                <ItemsControl ItemsSource="{x:Bind AskUserFields}"
                                              Visibility="{x:Bind HasAskUserFields, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:AskUserFieldEntry">
                                            <StackPanel Spacing="4" Margin="0,0,0,8">
                                                <TextBlock Text="{x:Bind Label}"
                                                           FontSize="11"
                                                           Foreground="{ThemeResource TextSecondaryBrush}" />
                                                <TextBox PlaceholderText="{x:Bind Placeholder}"
                                                         Text="{x:Bind Value, Mode=TwoWay}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <RadioButtons ItemsSource="{x:Bind AskUserOptions}"
                                              SelectedItem="{x:Bind SelectedAskUserOption, Mode=TwoWay}"
                                              Visibility="{x:Bind HasAskUserOptions, Converter={StaticResource BoolToVis}}" />

                                <ItemsControl ItemsSource="{x:Bind AskUserOptionEntries}"
                                              Visibility="{x:Bind HasAskUserMultiOptions, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:AskUserOptionEntry">
                                            <CheckBox Content="{x:Bind Text}" IsChecked="{x:Bind IsChecked, Mode=TwoWay}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBox PlaceholderText="Type your answer"
                                         Text="{x:Bind AskUserFreeText, Mode=TwoWay}"
                                         Visibility="{x:Bind HasAskUserFields, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />

                                <Button Content="Submit"
                                        HorizontalAlignment="Right"
                                        Tag="{x:Bind}"
                                        Click="AskUserSubmit_Click"
                                        Visibility="{x:Bind IsAwaitingResponse, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Text="{x:Bind EventMeta, Mode=OneWay}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Foreground="{x:Bind Status, Mode=OneWay, Converter={StaticResource EventStatusToBrush}}"
                                           Visibility="{x:Bind IsAwaitingResponse, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                            </StackPanel>
                        </Border>

                        <!-- Approval card: tool + description + collapsible arguments, approve/reject buttons. -->
                        <Border MaxWidth="520"
                                HorizontalAlignment="Left"
                                CornerRadius="10"
                                Padding="14,11"
                                Background="{ThemeResource SurfaceElevatedBrush}"
                                BorderBrush="{ThemeResource BorderDefaultBrush}"
                                BorderThickness="1"
                                Visibility="{x:Bind IsApprovalEvent, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ic:FluentIcon Icon="ShieldTask" IconVariant="Regular" IconSize="Size16"
                                                   Foreground="{ThemeResource TextTertiaryBrush}" />
                                    <TextBlock Text="{x:Bind EventEyebrow}"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextTertiaryBrush}" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind EventTitle}" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind EventDetail}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextSecondaryBrush}"
                                           Visibility="{x:Bind HasEventDetail, Converter={StaticResource BoolToVis}}" />
                                <Expander Header="Arguments"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          Visibility="{x:Bind HasEventArgs, Converter={StaticResource BoolToVis}}">
                                    <ScrollViewer MaxHeight="200" HorizontalScrollBarVisibility="Auto">
                                        <TextBlock Text="{x:Bind EventArgs}"
                                                   FontFamily="Consolas"
                                                   FontSize="12"
                                                   IsTextSelectionEnabled="True"
                                                   TextWrapping="NoWrap" />
                                    </ScrollViewer>
                                </Expander>
                                <StackPanel Orientation="Horizontal"
                                            Spacing="8"
                                            Visibility="{x:Bind IsAwaitingResponse, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                    <Button Content="Approve once" Tag="{x:Bind}" Click="ApprovalOnce_Click" />
                                    <Button Content="Approve for session" Tag="{x:Bind}" Click="ApprovalSession_Click" />
                                    <Button Content="Reject" Tag="{x:Bind}" Click="ApprovalReject_Click" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind EventMeta, Mode=OneWay}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{x:Bind Status, Mode=OneWay, Converter={StaticResource EventStatusToBrush}}"
                                           Visibility="{x:Bind IsAwaitingResponse, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                            </StackPanel>
                        </Border>

                        <!-- Plan-review card: rendered plan + optional feedback, approve/request-changes buttons. -->
                        <Border MaxWidth="640"
                                HorizontalAlignment="Left"
                                CornerRadius="10"
                                Padding="14,11"
                                Background="{ThemeResource SurfaceElevatedBrush}"
                                BorderBrush="{ThemeResource BorderDefaultBrush}"
                                BorderThickness="1"
                                Visibility="{x:Bind IsPlanReviewEvent, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ic:FluentIcon Icon="ClipboardTask" IconVariant="Regular" IconSize="Size16"
                                                   Foreground="{ThemeResource TextTertiaryBrush}" />
                                    <TextBlock Text="{x:Bind EventEyebrow}"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextTertiaryBrush}" />
                                </StackPanel>
                                <controls:MarkdownTextBlock Markdown="{x:Bind EventDetail}"
                                                            Foreground="{ThemeResource TextPrimaryBrush}" />
                                <TextBox PlaceholderText="Optional feedback or requested changes"
                                         AcceptsReturn="True"
                                         Height="72"
                                         Text="{x:Bind PlanFeedback, Mode=TwoWay}"
                                         Visibility="{x:Bind IsAwaitingResponse, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                <StackPanel Orientation="Horizontal"
                                            Spacing="8"
                                            Visibility="{x:Bind IsAwaitingResponse, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                    <Button Content="Approve plan" Tag="{x:Bind}" Click="PlanApprove_Click" />
                                    <Button Content="Request changes" Tag="{x:Bind}" Click="PlanRequestChanges_Click" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind EventMeta, Mode=OneWay}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{x:Bind Status, Mode=OneWay, Converter={StaticResource EventStatusToBrush}}"
                                           Visibility="{x:Bind IsAwaitingResponse, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                            </StackPanel>
                        </Border>

                        <StackPanel MaxWidth="760"
                                    HorizontalAlignment="Left"
                                    Spacing="8"
                                    Visibility="{x:Bind IsAgent, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{x:Bind AgentName}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextSecondaryBrush}"
                                       Visibility="{x:Bind AgentName, Converter={StaticResource StringToVis}}" />
                            <controls:MarkdownTextBlock Markdown="{x:Bind Content, Mode=OneWay}"
                                                        MaxLines="{x:Bind RenderedMaxLines, Mode=OneWay}"
                                                        SearchQuery="{x:Bind FindQuery, Mode=OneWay}"
                                                        ActiveMatchIndex="{x:Bind ActiveFindMatchIndex, Mode=OneWay}"
                                                        Foreground="{ThemeResource TextPrimaryBrush}" />
                            <ItemsControl ItemsSource="{x:Bind Attachments}"
                                          ItemTemplate="{StaticResource AttachmentChipTemplate}"
                                          Visibility="{x:Bind HasAttachments, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                            <Grid ColumnSpacing="8"
                                  Visibility="{x:Bind IsOnboarding, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         MinWidth="0"
                                         PlaceholderText="Invite code"
                                         Text="{x:Bind OnboardInviteCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{x:Bind IsOnboardingInputEnabled, Mode=OneWay}" />
                                <Button Grid.Column="1"
                                        Content="Submit"
                                        Click="SubmitOnboard_Click"
                                        IsEnabled="{x:Bind IsOnboardingInputEnabled, Mode=OneWay}" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Padding="0"
                                        MinWidth="0"
                                        MinHeight="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="CopyMessage_Click"
                                        ToolTipService.ToolTip="Copy message">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <ic:FluentIcon Icon="Copy"
                                                       IconVariant="Regular"
                                                       IconSize="Size16"
                                                       Foreground="{ThemeResource TextSecondaryBrush}" />
                                        <TextBlock Text="Copy"
                                                   FontSize="11"
                                                   Foreground="{ThemeResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </Button>
                                <Button Padding="0"
                                        MinWidth="0"
                                        MinHeight="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="ToggleMessageCollapse_Click"
                                        ToolTipService.ToolTip="{x:Bind CollapseButtonText, Mode=OneWay}"
                                        Visibility="{x:Bind IsCollapsible, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <ic:FluentIcon Icon="ArrowMinimize"
                                                       IconVariant="Regular"
                                                       IconSize="Size16"
                                                       Foreground="{ThemeResource TextSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind CollapseButtonText, Mode=OneWay}"
                                                   FontSize="11"
                                                   Foreground="{ThemeResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Border Grid.Row="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,16"
                MaxWidth="520"
                CornerRadius="14"
                Padding="12,7"
                Background="{ThemeResource SurfaceElevatedBrush}"
                BorderBrush="{ThemeResource BorderDefaultBrush}"
                BorderThickness="1"
                IsHitTestVisible="False"
                Visibility="{x:Bind Vm.StatusText, Mode=OneWay, Converter={StaticResource StringToVis}}">
            <TextBlock Text="{x:Bind Vm.StatusText, Mode=OneWay}"
                       FontSize="11"
                       Foreground="{ThemeResource TextSecondaryBrush}"
                       TextTrimming="CharacterEllipsis" />
        </Border>

        <Border Grid.Row="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="20,0,20,18"
                MaxWidth="620"
                CornerRadius="10"
                Padding="14,10"
                Background="{ThemeResource SurfaceElevatedBrush}"
                BorderBrush="{ThemeResource BorderDefaultBrush}"
                BorderThickness="1"
                Visibility="{x:Bind Vm.ShowOfflineNotice, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ic:FluentIcon Grid.Column="0"
                               Icon="PlugDisconnected"
                               IconVariant="Regular"
                               IconSize="Size20"
                               Foreground="{ThemeResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />

                <StackPanel Grid.Column="1"
                            MinWidth="0"
                            VerticalAlignment="Center"
                            Spacing="2">
                    <TextBlock Text="Agent is offline"
                               FontSize="13"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{x:Bind Vm.PresenceDetail, Mode=OneWay}"
                               FontSize="11"
                               Foreground="{ThemeResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{x:Bind Vm.PresenceDetail, Mode=OneWay, Converter={StaticResource StringToVis}}" />
                </StackPanel>

                <Button Grid.Column="2"
                        MinWidth="0"
                        Padding="10,6"
                        VerticalAlignment="Center"
                        IsEnabled="{x:Bind Vm.CanReconnect, Mode=OneWay}"
                        Click="RecheckPresence_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ic:FluentIcon Icon="ArrowClockwise"
                                       IconVariant="Regular"
                                       IconSize="Size16" />
                        <TextBlock Text="Recheck" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <controls:ChatComposer x:Name="Composer"
                               Grid.Row="2"
                               CanSubmit="{x:Bind Vm.CanSend, Mode=OneWay}"
                               EnterToSubmit="{x:Bind Vm.EnterToSend, Mode=OneWay}"
                               IsBusy="{x:Bind Vm.IsProcessing, Mode=OneWay}"
                               AcceptedInputs="{x:Bind Vm.AcceptedInputs, Mode=OneWay}"
                               ShowSuggestions="False"
                               SubmitRequested="Composer_SubmitRequested" />

        <!-- Loading overlay hides the empty-state flash before conversation data arrives -->
        <Border x:Name="LoadingOverlay"
                Grid.Row="1"
                Background="{ThemeResource AppBackgroundBrush}"
                Visibility="Visible">
            <ProgressRing Width="28"
                          Height="28"
                          IsActive="True"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
        </Border>

    </Grid>
</Page>

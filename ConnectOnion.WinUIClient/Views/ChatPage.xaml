<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ConnectOnion.WinUIClient.Views.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:ConnectOnion.WinUIClient.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" MinHeight="62" Padding="18,10,20,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Border Width="30"
                        Height="30"
                        CornerRadius="8"
                        Background="{ThemeResource TextFillColorPrimaryBrush}">
                    <TextBlock Text="{x:Bind Vm.SelectedAgentInitial, Mode=OneWay}"
                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                               FontSize="12"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Vm.SelectedAgentName, Mode=OneWay}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock FontSize="9"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                        <Run Text="Session " />
                        <Run Text="{x:Bind Vm.SessionShortId, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                <Border MinHeight="30"
                        CornerRadius="15"
                        Padding="12,0"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        Background="{ThemeResource LayerFillColorDefaultBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                        <Ellipse Width="10"
                                 Height="10"
                                 Fill="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center">
                            <Run Text="{x:Bind Vm.ConnectionLabel, Mode=OneWay}" />
                            <Run Text=" - " />
                            <Run Text="{x:Bind Vm.ConnectionDetail, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Button MinHeight="30" Padding="12,0" Click="Reconnect_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="13" />
                        <TextBlock Text="Reconnect" />
                    </StackPanel>
                </Button>
                <Button MinHeight="30" Padding="12,0" Click="NewChat_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="13" />
                        <TextBlock Text="New chat" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <ListView Grid.Row="1"
                  x:Name="MessageList"
                  ItemsSource="{x:Bind Vm.Messages, Mode=OneWay}"
                  FontSize="{x:Bind Vm.MessageFontSize, Mode=OneWay}"
                  SelectionMode="None"
                  Background="Transparent"
                  BorderThickness="0"
                  Padding="92,18,52,22"
                  HorizontalAlignment="Stretch">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,14" />
                    <Setter Property="Background" Value="Transparent" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:ChatMessage">
                    <Grid HorizontalAlignment="Stretch">
                        <StackPanel MaxWidth="520"
                                    HorizontalAlignment="Right"
                                    Spacing="8"
                                    Visibility="{x:Bind IsUser, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{x:Bind Content}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Right"
                                       IsTextSelectionEnabled="True"
                                       LineHeight="22" />
                            <Button HorizontalAlignment="Right"
                                    Padding="0"
                                    MinWidth="0"
                                    MinHeight="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="CopyMessage_Click"
                                    ToolTipService.ToolTip="Copy message">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="Copy" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <Border MaxWidth="650"
                                HorizontalAlignment="Left"
                                CornerRadius="10"
                                Padding="12,9"
                                Background="{ThemeResource ThinkingStatusBackgroundBrush}"
                                BorderBrush="{ThemeResource ThinkingStatusBorderBrush}"
                                BorderThickness="1"
                                Visibility="{x:Bind IsEvent, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="9"
                                         Height="9"
                                         Fill="{ThemeResource ThinkingStatusDotBrush}"
                                         VerticalAlignment="Top"
                                         Margin="0,5,0,0" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{x:Bind EventTitle}"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind EventDetail}"
                                               FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               Visibility="{x:Bind EventDetail, Converter={StaticResource StringToVis}}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <StackPanel MaxWidth="760"
                                    HorizontalAlignment="Left"
                                    Spacing="8"
                                    Visibility="{x:Bind IsAgent, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{x:Bind AgentName}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Visibility="{x:Bind AgentName, Converter={StaticResource StringToVis}}" />
                            <TextBlock Text="{x:Bind Content}"
                                       TextWrapping="Wrap"
                                       IsTextSelectionEnabled="True"
                                       LineHeight="22" />
                            <Grid ColumnSpacing="8"
                                  Visibility="{x:Bind IsOnboarding, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         MinWidth="360"
                                         PlaceholderText="Invite code"
                                         Text="{x:Bind OnboardInviteCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{x:Bind IsOnboardingInputEnabled, Mode=OneWay}" />
                                <Button Grid.Column="1"
                                        Content="Submit"
                                        Click="SubmitOnboard_Click"
                                        IsEnabled="{x:Bind IsOnboardingInputEnabled, Mode=OneWay}" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Padding="0"
                                        MinWidth="0"
                                        MinHeight="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="CopyMessage_Click"
                                        ToolTipService.ToolTip="Copy message">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon Glyph="&#xE8C8;"
                                                  FontSize="12"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="Copy"
                                                   FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="Collapse"
                                           FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Visibility="Collapsed" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="2"
                    MaxWidth="760"
                    Width="760"
                    Margin="0,0,0,24"
                    HorizontalAlignment="Center"
                    Spacing="8">
            <Border CornerRadius="12"
                    Padding="10"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Width="34" Height="34" Padding="0">
                        <FontIcon Glyph="&#xE723;" FontSize="15" />
                    </Button>
                    <TextBox x:Name="InputBox"
                             Grid.Column="1"
                             PlaceholderText="Message this agent..."
                             IsEnabled="{x:Bind Vm.CanSend, Mode=OneWay}"
                             AcceptsReturn="False"
                             BorderThickness="0"
                             Background="{ThemeResource LayerFillColorDefaultBrush}"
                             KeyDown="InputBox_KeyDown" />
                    <Button Grid.Column="2"
                            Width="36"
                            Height="36"
                            Padding="0"
                            CornerRadius="18"
                            Style="{StaticResource AccentButtonStyle}"
                            IsEnabled="{x:Bind Vm.CanSend, Mode=OneWay}"
                            Click="Send_Click">
                        <FontIcon Glyph="&#xE74A;" FontSize="16" />
                    </Button>
                </Grid>
            </Border>
            <TextBlock Text="Mode safe    Enter to send - Shift + Enter for a new line"
                       HorizontalAlignment="Right"
                       FontSize="9"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </Grid>
</Page>

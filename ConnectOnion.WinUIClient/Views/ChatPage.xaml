<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ConnectOnion.WinUIClient.Views.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:presentation="using:ConnectOnion.WinUIClient.Presentation"
    xmlns:controls="using:ConnectOnion.WinUIClient.Controls"
    xmlns:models="using:ConnectOnion.WinUIClient.Models"
    xmlns:animations="using:CommunityToolkit.WinUI.Animations"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="ChatRoot"
          Background="{ThemeResource AppBackgroundBrush}"
          SizeChanged="ChatRoot_SizeChanged">
        <Grid.Resources>
            <!-- Shared chrome for the three interactive cards (ask_user / approval / plan_review).
                 Their header is the same fold-away control the tool-activity card uses: click the
                 row to expand or collapse, chevron shows which way it goes, and the collapsed row
                 carries the outcome ("Approved once", "Rejected", "No selection", …).

                 These three keep the elevated surface AND the 1px border that the activity and
                 tool-activity cards deliberately gave up. That asymmetry is the point: those two
                 narrate what the agent did, these three block on the user for an answer. Now that
                 narration is a borderless wash, the border here reads as "this one wants something
                 from you" instead of being chrome every row happens to have. Don't flatten these
                 for consistency — the inconsistency is carrying the signal. -->
            <Style x:Key="InteractiveCardHeaderStyle" TargetType="Button" BasedOn="{StaticResource TransparentButtonStyle}">
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinHeight" Value="0" />
            </Style>

            <Style x:Key="InteractiveEyebrowStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{ThemeResource TextTertiaryBrush}" />
            </Style>

            <Style x:Key="InteractiveCollapsedTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
            </Style>

            <Style x:Key="InteractiveOutcomeStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="InteractiveChevronStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
                <Setter Property="FontSize" Value="10" />
                <Setter Property="Foreground" Value="{ThemeResource TextTertiaryBrush}" />
            </Style>

            <!-- Shared attachment rendering for both user and agent bubbles: inline
                 image preview (tap to open in the default viewer) or a file chip
                 (tap to open, button to save a copy). -->
            <DataTemplate x:Key="AttachmentChipTemplate" x:DataType="models:ChatAttachment">
                <Grid Margin="0,2">
                    <!-- Image: thumbnail, or a fallback message if it failed to load/decode. -->
                    <StackPanel Spacing="4" Visibility="{x:Bind IsImage, Converter={StaticResource BoolToVis}}">
                        <Border CornerRadius="10"
                                MaxWidth="280"
                                MaxHeight="280"
                                Background="{ThemeResource SurfaceSecondaryBrush}"
                                Visibility="{x:Bind IsFailed, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"
                                Tapped="AttachmentImage_Tapped"
                                Tag="{x:Bind}">
                            <Image Source="{x:Bind LocalCachePath, Mode=OneWay, Converter={StaticResource PathToImage}}"
                                   Stretch="Uniform"
                                   MaxWidth="280"
                                   MaxHeight="280" />
                        </Border>
                        <TextBlock x:Uid="ChatImageLoadFailure" Text="Image could not be loaded."
                                   FontSize="11"
                                   FontStyle="Italic"
                                   Foreground="{ThemeResource TextSecondaryBrush}"
                                   Visibility="{x:Bind IsFailed, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <!-- Generic file: icon + name + size, tap to open, button to save a copy. -->
                    <Border CornerRadius="10"
                            Padding="10,8"
                            MaxWidth="320"
                            Background="{ThemeResource SurfaceSecondaryBrush}"
                            BorderBrush="{ThemeResource BorderDefaultBrush}"
                            BorderThickness="1"
                            Tapped="AttachmentFile_Tapped"
                            Tag="{x:Bind}"
                            Visibility="{x:Bind IsImage, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ic:FluentIcon Grid.Column="0"
                                           Icon="DocumentText"
                                           IconVariant="Regular"
                                           IconSize="Size24"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextSecondaryBrush}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="{x:Bind FileName}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind SizeLabel}"
                                           FontSize="10"
                                           Foreground="{ThemeResource TextSecondaryBrush}" />
                            </StackPanel>
                            <Button Grid.Column="2"
                                    Width="28"
                                    Height="28"
                                    Padding="0"
                                    MinWidth="0"
                                    MinHeight="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    VerticalAlignment="Center"
                                    Tag="{x:Bind}"
                                    Click="SaveAttachment_Click"
                                    ToolTipService.ToolTip="Save a copy">
                                <ic:FluentIcon Icon="SaveArrowRight"
                                               IconVariant="Regular"
                                               IconSize="Size16"
                                               Foreground="{ThemeResource TextSecondaryBrush}" />
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </DataTemplate>

            <!-- One template per bubble kind, dispatched by ChatMessageTemplateSelector below.
                 A row only ever builds the visual tree for what it actually is; the previous
                 all-in-one template built every kind and hid all but one, paying that cost again
                 on every container the list recycled. -->

            <DataTemplate x:Key="ChatUserTemplate" x:DataType="models:ChatMessage">
                <StackPanel MaxWidth="700"
                            HorizontalAlignment="Right"
                            Spacing="8"
                            Background="Transparent"
                            PointerEntered="MessageActions_PointerEntered"
                            PointerExited="MessageActions_PointerExited"
                            GotFocus="MessageActions_GotFocus"
                            LostFocus="MessageActions_LostFocus">
                    <StackPanel HorizontalAlignment="Right"
                                Spacing="8"
                                Visibility="{x:Bind IsEditing, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                        <ItemsControl ItemsSource="{x:Bind Attachments}"
                                      ItemTemplate="{StaticResource AttachmentChipTemplate}"
                                      HorizontalAlignment="Right"
                                      Visibility="{x:Bind HasAttachments, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                        <Border MaxWidth="520"
                                HorizontalAlignment="Right"
                                CornerRadius="18"
                                Padding="16,12"
                                Background="{ThemeResource UserMessageBackgroundBrush}"
                                BorderBrush="{ThemeResource BorderDefaultBrush}"
                                BorderThickness="1"
                                Visibility="{x:Bind Content, Converter={StaticResource StringToVis}}">
                            <controls:HighlightedTextBlock Text="{x:Bind Content, Mode=OneWay}"
                                                           SearchQuery="{x:Bind FindQuery, Mode=OneWay}"
                                                           ActiveMatchIndex="{x:Bind ActiveFindMatchIndex, Mode=OneWay}"
                                                           Foreground="{ThemeResource TextPrimaryBrush}" />
                        </Border>
                        <!-- This row always owns its height. Hover only changes the inner
                             visibility, so showing actions never pushes the transcript down. -->
                        <Grid Height="24" HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Spacing="2"
                                        Opacity="{x:Bind UserActionsOpacity, Mode=OneWay}"
                                        IsHitTestVisible="{x:Bind ShowUserActions, Mode=OneWay}">
                                <StackPanel.OpacityTransition>
                                    <ScalarTransition Duration="0:0:0.16" />
                                </StackPanel.OpacityTransition>
                                <TextBlock Margin="0,0,4,0"
                                           VerticalAlignment="Center"
                                           Text="{x:Bind TimeLabel, Mode=OneWay}"
                                           FontSize="11"
                                           Foreground="{ThemeResource TextSecondaryBrush}" />
                                <Button Tag="{x:Bind}"
                                        Padding="3"
                                        MinWidth="24"
                                        MinHeight="24"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        IsTabStop="{x:Bind ShowUserActions, Mode=OneWay}"
                                        Click="RetryUserMessage_Click"
                                        AutomationProperties.Name="Retry from this message"
                                        ToolTipService.ToolTip="Retry from this message"
                                        Visibility="{x:Bind CanEdit, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                    <!-- All three action icons take the Size16-scaled-to-12 treatment, even
                                         the two that do have a Size12 glyph: mixing the two fonts in one row
                                         reads as inconsistent, because the Size12 designs carry heavier
                                         strokes and measure 12px against the scaled icon's 16px slot. -->
                                    <ic:FluentIcon Icon="ArrowClockwise" IconVariant="Regular" IconSize="Size16"
                                                   RenderTransformOrigin="0.5,0.5"
                                                   Foreground="{ThemeResource TextSecondaryBrush}">
                                        <ic:FluentIcon.RenderTransform>
                                            <ScaleTransform ScaleX="0.75" ScaleY="0.75" />
                                        </ic:FluentIcon.RenderTransform>
                                    </ic:FluentIcon>
                                </Button>
                                <Button Tag="{x:Bind}"
                                        Padding="3"
                                        MinWidth="24"
                                        MinHeight="24"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        IsTabStop="{x:Bind ShowUserActions, Mode=OneWay}"
                                        Click="EditUserMessage_Click"
                                        AutomationProperties.Name="Edit message"
                                        ToolTipService.ToolTip="Edit message"
                                        Visibility="{x:Bind CanEdit, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                    <ic:FluentIcon Icon="Edit" IconVariant="Regular" IconSize="Size16"
                                                   RenderTransformOrigin="0.5,0.5"
                                                   Foreground="{ThemeResource TextSecondaryBrush}">
                                        <ic:FluentIcon.RenderTransform>
                                            <ScaleTransform ScaleX="0.75" ScaleY="0.75" />
                                        </ic:FluentIcon.RenderTransform>
                                    </ic:FluentIcon>
                                </Button>
                                <Button Padding="3"
                                        MinWidth="24"
                                        MinHeight="24"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        IsTabStop="{x:Bind ShowUserActions, Mode=OneWay}"
                                        Click="CopyMessage_Click"
                                        AutomationProperties.Name="Copy message"
                                        ToolTipService.ToolTip="Copy message">
                                    <ic:FluentIcon Icon="Copy" IconVariant="Regular" IconSize="Size16"
                                                   RenderTransformOrigin="0.5,0.5"
                                                   Foreground="{ThemeResource TextSecondaryBrush}">
                                        <ic:FluentIcon.RenderTransform>
                                            <ScaleTransform ScaleX="0.75" ScaleY="0.75" />
                                        </ic:FluentIcon.RenderTransform>
                                    </ic:FluentIcon>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <Border Padding="12"
                            CornerRadius="16"
                            Background="{ThemeResource UserMessageBackgroundBrush}"
                            BorderBrush="{ThemeResource BorderDefaultBrush}"
                            BorderThickness="1"
                            Visibility="{x:Bind IsEditing, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <StackPanel Spacing="10">
                            <TextBox Text="{x:Bind EditDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="48"
                                     AutomationProperties.Name="Edit message text" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                    <ic:FluentIcon Icon="Info" IconVariant="Regular" IconSize="Size16"
                                                   Margin="0,2,0,0"
                                                   Foreground="{ThemeResource TextSecondaryBrush}" />
                                    <TextBlock Text="Editing creates a new conversation from this point. The original remains in the sidebar."
                                               TextWrapping="Wrap"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextSecondaryBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <Button Tag="{x:Bind}"
                                            Content="Cancel"
                                            Click="CancelEditUserMessage_Click" />
                                    <Button Tag="{x:Bind}"
                                            Content="Save"
                                            Style="{StaticResource AccentButtonStyle}"
                                            IsEnabled="{x:Bind CanSaveEdit, Mode=OneWay}"
                                            Click="SaveEditUserMessage_Click" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DataTemplate>

            <DataTemplate x:Key="ChatAgentTemplate" x:DataType="models:ChatMessage">
                <StackPanel MaxWidth="{StaticResource ChatColumnWidth}"
                            HorizontalAlignment="Left"
                            Spacing="8"
                            Background="Transparent"
                            PointerEntered="MessageActions_PointerEntered"
                            PointerExited="MessageActions_PointerExited"
                            GotFocus="MessageActions_GotFocus"
                            LostFocus="MessageActions_LostFocus">
                    <TextBlock Text="{x:Bind AgentName}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextSecondaryBrush}"
                               Visibility="{x:Bind AgentName, Converter={StaticResource StringToVis}}" />
                    <controls:MarkdownTextBlock Markdown="{x:Bind Content, Mode=OneWay}"
                                                SearchQuery="{x:Bind FindQuery, Mode=OneWay}"
                                                ActiveMatchIndex="{x:Bind ActiveFindMatchIndex, Mode=OneWay}"
                                                Foreground="{ThemeResource TextPrimaryBrush}" />
                    <StackPanel Orientation="Horizontal"
                                Spacing="5"
                                Visibility="{x:Bind HasEventMeta, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <ic:FluentIcon Icon="Stop" IconVariant="Regular" IconSize="Size16"
                                       RenderTransformOrigin="0.5,0.5"
                                       Foreground="{ThemeResource TextTertiaryBrush}">
                            <ic:FluentIcon.RenderTransform>
                                <ScaleTransform ScaleX="0.7" ScaleY="0.7" />
                            </ic:FluentIcon.RenderTransform>
                        </ic:FluentIcon>
                        <TextBlock Text="{x:Bind EventMeta, Mode=OneWay}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextTertiaryBrush}" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{x:Bind Attachments}"
                                  ItemTemplate="{StaticResource AttachmentChipTemplate}"
                                  Visibility="{x:Bind HasAttachments, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                    <!-- Collapses (not just disables) once the code is submitted: a spent invite
                         box is dead UI, and IsOnboarding alone is not observable so it could
                         never take the row away. -->
                    <Grid ColumnSpacing="8"
                          Visibility="{x:Bind IsOnboardingInputEnabled, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 MinWidth="0"
                                 x:Uid="ChatInviteCode" PlaceholderText="Invite code"
                                 Text="{x:Bind OnboardInviteCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{x:Bind IsOnboardingInputEnabled, Mode=OneWay}" />
                        <Button Grid.Column="1"
                                x:Uid="ChatSubmitInvite" Content="Submit"
                                Click="SubmitOnboard_Click"
                                IsEnabled="{x:Bind IsOnboardingInputEnabled, Mode=OneWay}" />
                    </Grid>
                    <Grid Height="24" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="2"
                                    Opacity="{x:Bind UserActionsOpacity, Mode=OneWay}"
                                    IsHitTestVisible="{x:Bind ShowUserActions, Mode=OneWay}">
                            <StackPanel.OpacityTransition>
                                <ScalarTransition Duration="0:0:0.16" />
                            </StackPanel.OpacityTransition>
                            <Button Tag="{x:Bind}"
                                    Padding="3"
                                    MinWidth="24"
                                    MinHeight="24"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    IsTabStop="{x:Bind ShowUserActions, Mode=OneWay}"
                                    Click="RetryAgentMessage_Click"
                                    AutomationProperties.Name="Retry this response"
                                    ToolTipService.ToolTip="Retry this response">
                                <!-- Matches the user-message action row above: same font, same scale. -->
                                <ic:FluentIcon Icon="ArrowClockwise" IconVariant="Regular" IconSize="Size16"
                                               RenderTransformOrigin="0.5,0.5"
                                               Foreground="{ThemeResource TextSecondaryBrush}">
                                    <ic:FluentIcon.RenderTransform>
                                        <ScaleTransform ScaleX="0.75" ScaleY="0.75" />
                                    </ic:FluentIcon.RenderTransform>
                                </ic:FluentIcon>
                            </Button>
                            <Button Padding="3"
                                    MinWidth="24"
                                    MinHeight="24"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    IsTabStop="{x:Bind ShowUserActions, Mode=OneWay}"
                                    Click="CopyMessage_Click"
                                    AutomationProperties.Name="Copy response"
                                    ToolTipService.ToolTip="Copy response">
                                <ic:FluentIcon Icon="Copy" IconVariant="Regular" IconSize="Size16"
                                               RenderTransformOrigin="0.5,0.5"
                                               Foreground="{ThemeResource TextSecondaryBrush}">
                                    <ic:FluentIcon.RenderTransform>
                                        <ScaleTransform ScaleX="0.75" ScaleY="0.75" />
                                    </ic:FluentIcon.RenderTransform>
                                </ic:FluentIcon>
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </DataTemplate>

            <!-- Claude-style process disclosure shared by thinking, lightweight activity and
                 turn-usage rows. Process narration stays on the transcript background: a quiet
                 header, connected timeline markers, and an explicit terminal state. -->
            <DataTemplate x:Key="ChatActivityTemplate" x:DataType="models:ChatMessage">
                <StackPanel MaxWidth="700"
                            HorizontalAlignment="Left"
                            Spacing="4">
                    <Button MinHeight="30"
                            Padding="0,4"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Tag="{x:Bind}"
                            Click="ActivityHeader_Click"
                            AutomationProperties.Name="{x:Bind ActivityAccessibilityName, Mode=OneWay}">
                        <Grid ColumnSpacing="7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ProgressRing Width="12"
                                          Height="12"
                                          IsActive="{x:Bind IsThinkingRunning, Mode=OneWay}"
                                          Visibility="{x:Bind IsThinkingRunning, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                          VerticalAlignment="Center"
                                          AutomationProperties.Name="Thinking" />
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind ActivityHeaderTitle, Mode=OneWay}"
                                       FontSize="14"
                                       Foreground="{ThemeResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <Grid Grid.Column="2" Width="16" Height="16" VerticalAlignment="Center">
                                <TextBlock Text="&#xE70D;"
                                           Style="{StaticResource InteractiveChevronStyle}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="{x:Bind IsActivityExpanded, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Text="&#xE76C;"
                                           Style="{StaticResource InteractiveChevronStyle}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="{x:Bind IsActivityExpanded, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                            </Grid>
                        </Grid>
                    </Button>

                    <Grid Margin="4,0,0,0"
                          Visibility="{x:Bind IsActivityExpanded, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Grid.RowSpan="2"
                                Width="1"
                                Margin="10,10,0,11"
                                HorizontalAlignment="Left"
                                Background="{ThemeResource BorderDefaultBrush}" />

                        <Grid Grid.Row="0" ColumnSpacing="10" Margin="0,2,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="21" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="21" Height="21" CornerRadius="10.5"
                                    Background="{ThemeResource ChatBackgroundBrush}"
                                    VerticalAlignment="Top">
                                <ic:FluentIcon Icon="Clock" IconVariant="Regular" IconSize="Size12"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextTertiaryBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock Text="{x:Bind ActivityTimelineText, Mode=OneWay}"
                                           FontSize="13"
                                           Foreground="{ThemeResource TextPrimaryBrush}"
                                           TextWrapping="WrapWholeWords"
                                           IsTextSelectionEnabled="True" />
                                <TextBlock Text="{x:Bind EventMeta, Mode=OneWay}"
                                           FontSize="11"
                                           Foreground="{ThemeResource TextTertiaryBrush}"
                                           TextWrapping="WrapWholeWords"
                                           Visibility="{x:Bind HasActivityTimelineMeta, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="21" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="21" Height="21" CornerRadius="10.5"
                                    Background="{ThemeResource ChatBackgroundBrush}">
                                <TextBlock Text="{x:Bind ActivityStatusGlyph, Mode=OneWay}"
                                           FontSize="13"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{x:Bind Status, Mode=OneWay, Converter={StaticResource EventStatusToBrush}}" />
                            </Border>
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind ActivityStatusLabel, Mode=OneWay}"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextSecondaryBrush}" />
                        </Grid>
                    </Grid>
                </StackPanel>
            </DataTemplate>

            <!-- A turn's model/token cost is supporting metadata, not another process card.
                 Keep it to one quiet line immediately before the final assistant output. -->
            <DataTemplate x:Key="ChatTurnUsageTemplate" x:DataType="models:ChatMessage">
                <TextBlock MaxWidth="700"
                           Margin="0,2,0,0"
                           HorizontalAlignment="Left"
                           Text="{x:Bind TurnUsageSummary, Mode=OneWay}"
                           FontSize="11"
                           Foreground="{ThemeResource TextTertiaryBrush}"
                           TextTrimming="CharacterEllipsis"
                           IsTextSelectionEnabled="True"
                           AutomationProperties.Name="{x:Bind TurnUsageSummary, Mode=OneWay}" />
            </DataTemplate>

            <DataTemplate x:Key="ChatToolActivityTemplate" x:DataType="models:ChatMessage">
                <controls:ToolActivityView Activity="{x:Bind ToolActivity, Mode=OneWay}"
                                           HorizontalAlignment="Stretch" />
            </DataTemplate>

            <!-- Ask-user card: collapsible header + question + inline answer controls (dynamic
                 fields, single/multi-select options, or free text), submit button. -->
            <DataTemplate x:Key="ChatAskUserTemplate" x:DataType="models:ChatMessage">
                <Border MaxWidth="520"
                        HorizontalAlignment="Left"
                        CornerRadius="10"
                        Padding="14,11"
                        Background="{ThemeResource SurfaceElevatedBrush}"
                        BorderBrush="{ThemeResource BorderDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="10">
                        <Button Style="{StaticResource InteractiveCardHeaderStyle}"
                                Tag="{x:Bind}"
                                Click="InteractiveHeader_Click"
                                AutomationProperties.Name="{x:Bind InteractiveAccessibilityName, Mode=OneWay}">
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ic:FluentIcon Icon="QuestionCircle" IconVariant="Regular" IconSize="Size16"
                                               VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextTertiaryBrush}" />
                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind EventEyebrow}"
                                           Style="{StaticResource InteractiveEyebrowStyle}" />
                                <TextBlock Grid.Column="2"
                                           Text="{x:Bind EventTitle}"
                                           Style="{StaticResource InteractiveCollapsedTitleStyle}"
                                           Visibility="{x:Bind IsInteractiveCollapsed, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Grid.Column="3"
                                           Text="{x:Bind InteractiveOutcome, Mode=OneWay}"
                                           Style="{StaticResource InteractiveOutcomeStyle}"
                                           Foreground="{x:Bind Status, Mode=OneWay, Converter={StaticResource EventStatusToBrush}}"
                                           Visibility="{x:Bind IsInteractiveCollapsed, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                <Grid Grid.Column="4" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource InteractiveChevronStyle}"
                                               Text="&#xE70D;"
                                               Visibility="{x:Bind IsInteractiveExpanded, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Style="{StaticResource InteractiveChevronStyle}"
                                               Text="&#xE76C;"
                                               Visibility="{x:Bind IsInteractiveCollapsed, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                            </Grid>
                        </Button>

                    <StackPanel Spacing="10"
                                Visibility="{x:Bind IsInteractiveExpanded, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{x:Bind EventTitle}" FontSize="13" TextWrapping="Wrap" />

                        <ItemsControl ItemsSource="{x:Bind AskUserFields}"
                                      Visibility="{x:Bind HasAskUserFields, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:AskUserFieldEntry">
                                    <StackPanel Spacing="4" Margin="0,0,0,8">
                                        <TextBlock Text="{x:Bind Label}"
                                                   FontSize="11"
                                                   Foreground="{ThemeResource TextSecondaryBrush}" />
                                        <TextBox PlaceholderText="{x:Bind Placeholder}"
                                                 Text="{x:Bind Value, Mode=TwoWay}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <RadioButtons ItemsSource="{x:Bind AskUserOptions}"
                                      SelectedItem="{x:Bind SelectedAskUserOption, Mode=TwoWay}"
                                      Visibility="{x:Bind HasAskUserOptions, Converter={StaticResource BoolToVis}}" />

                        <ItemsControl ItemsSource="{x:Bind AskUserOptionEntries}"
                                      Visibility="{x:Bind HasAskUserMultiOptions, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:AskUserOptionEntry">
                                    <CheckBox Content="{x:Bind Text}" IsChecked="{x:Bind IsChecked, Mode=TwoWay}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBox x:Uid="ChatAnswer" PlaceholderText="Type your answer"
                                 Text="{x:Bind AskUserFreeText, Mode=TwoWay}"
                                 Visibility="{x:Bind ShowAskUserFreeText, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

                        <Button x:Uid="ChatSubmitAnswer" Content="Submit"
                                HorizontalAlignment="Right"
                                Tag="{x:Bind}"
                                Click="AskUserSubmit_Click"
                                Visibility="{x:Bind IsAwaitingResponse, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{x:Bind EventMeta, Mode=OneWay}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Foreground="{x:Bind Status, Mode=OneWay, Converter={StaticResource EventStatusToBrush}}"
                                   Visibility="{x:Bind IsAwaitingResponse, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                    </StackPanel>
                    </StackPanel>
                </Border>
            </DataTemplate>

            <!-- Approval card: collapsible header + tool + description + collapsible arguments,
                 approve/reject buttons. -->
            <DataTemplate x:Key="ChatApprovalTemplate" x:DataType="models:ChatMessage">
                <Border MaxWidth="520"
                        HorizontalAlignment="Left"
                        CornerRadius="10"
                        Padding="14,11"
                        Background="{ThemeResource SurfaceElevatedBrush}"
                        BorderBrush="{ThemeResource BorderDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="8">
                        <Button Style="{StaticResource InteractiveCardHeaderStyle}"
                                Tag="{x:Bind}"
                                Click="InteractiveHeader_Click"
                                AutomationProperties.Name="{x:Bind InteractiveAccessibilityName, Mode=OneWay}">
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ic:FluentIcon Icon="ShieldTask" IconVariant="Regular" IconSize="Size16"
                                               VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextTertiaryBrush}" />
                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind EventEyebrow}"
                                           Style="{StaticResource InteractiveEyebrowStyle}" />
                                <TextBlock Grid.Column="2"
                                           Text="{x:Bind EventTitle}"
                                           Style="{StaticResource InteractiveCollapsedTitleStyle}"
                                           Visibility="{x:Bind IsInteractiveCollapsed, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Grid.Column="3"
                                           Text="{x:Bind InteractiveOutcome, Mode=OneWay}"
                                           Style="{StaticResource InteractiveOutcomeStyle}"
                                           Foreground="{x:Bind Status, Mode=OneWay, Converter={StaticResource EventStatusToBrush}}"
                                           Visibility="{x:Bind IsInteractiveCollapsed, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                <Grid Grid.Column="4" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource InteractiveChevronStyle}"
                                               Text="&#xE70D;"
                                               Visibility="{x:Bind IsInteractiveExpanded, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Style="{StaticResource InteractiveChevronStyle}"
                                               Text="&#xE76C;"
                                               Visibility="{x:Bind IsInteractiveCollapsed, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                            </Grid>
                        </Button>

                    <StackPanel Spacing="8"
                                Visibility="{x:Bind IsInteractiveExpanded, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{x:Bind EventTitle}" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind EventDetail}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextSecondaryBrush}"
                                   Visibility="{x:Bind HasEventDetail, Converter={StaticResource BoolToVis}}" />
                        <Expander x:Uid="ChatArguments" Header="Arguments"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Stretch"
                                  Visibility="{x:Bind HasEventArgs, Converter={StaticResource BoolToVis}}">
                            <ScrollViewer MaxHeight="200" HorizontalScrollBarVisibility="Auto">
                                <TextBlock Text="{x:Bind EventArgs}"
                                           FontFamily="Consolas"
                                           FontSize="12"
                                           IsTextSelectionEnabled="True"
                                           TextWrapping="NoWrap" />
                            </ScrollViewer>
                        </Expander>
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8"
                                    Visibility="{x:Bind IsAwaitingResponse, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <Button x:Uid="ChatApproveOnce" Content="Approve once" Tag="{x:Bind}" Click="ApprovalOnce_Click"
                                    AutomationProperties.AutomationId="ApproveOnceButton" />
                            <Button x:Uid="ChatApproveSession" Content="Approve for session" Tag="{x:Bind}" Click="ApprovalSession_Click" />
                            <!-- Reject halts the agent (reject_hard: it breaks the iteration loop and
                                 hands the turn back). Skip declines only this tool and lets the agent
                                 keep going — two different intentions, so two buttons. -->
                            <Button x:Uid="ChatReject" Content="Reject" Tag="{x:Bind}" Click="ApprovalReject_Click"
                                    AutomationProperties.AutomationId="RejectButton"
                                    ToolTipService.ToolTip="Reject and stop the agent" />
                            <Button x:Uid="ChatSkip" Content="Skip step" Tag="{x:Bind}" Click="ApprovalSkip_Click"
                                    AutomationProperties.AutomationId="SkipStepButton"
                                    ToolTipService.ToolTip="Skip this tool; the agent keeps working" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind EventMeta, Mode=OneWay}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{x:Bind Status, Mode=OneWay, Converter={StaticResource EventStatusToBrush}}"
                                   Visibility="{x:Bind IsAwaitingResponse, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                    </StackPanel>
                    </StackPanel>
                </Border>
            </DataTemplate>

            <!-- Plan-review card: collapsible header + rendered plan + optional feedback,
                 approve/request-changes buttons. -->
            <DataTemplate x:Key="ChatPlanReviewTemplate" x:DataType="models:ChatMessage">
                <Border MaxWidth="640"
                        HorizontalAlignment="Left"
                        CornerRadius="10"
                        Padding="14,11"
                        Background="{ThemeResource SurfaceElevatedBrush}"
                        BorderBrush="{ThemeResource BorderDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="8">
                        <Button Style="{StaticResource InteractiveCardHeaderStyle}"
                                Tag="{x:Bind}"
                                Click="InteractiveHeader_Click"
                                AutomationProperties.Name="{x:Bind InteractiveAccessibilityName, Mode=OneWay}">
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ic:FluentIcon Icon="ClipboardTask" IconVariant="Regular" IconSize="Size16"
                                               VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextTertiaryBrush}" />
                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind EventEyebrow}"
                                           Style="{StaticResource InteractiveEyebrowStyle}" />
                                <TextBlock Grid.Column="2"
                                           Text="{x:Bind EventTitle}"
                                           Style="{StaticResource InteractiveCollapsedTitleStyle}"
                                           Visibility="{x:Bind IsInteractiveCollapsed, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Grid.Column="3"
                                           Text="{x:Bind InteractiveOutcome, Mode=OneWay}"
                                           Style="{StaticResource InteractiveOutcomeStyle}"
                                           Foreground="{x:Bind Status, Mode=OneWay, Converter={StaticResource EventStatusToBrush}}"
                                           Visibility="{x:Bind IsInteractiveCollapsed, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                <Grid Grid.Column="4" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource InteractiveChevronStyle}"
                                               Text="&#xE70D;"
                                               Visibility="{x:Bind IsInteractiveExpanded, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Style="{StaticResource InteractiveChevronStyle}"
                                               Text="&#xE76C;"
                                               Visibility="{x:Bind IsInteractiveCollapsed, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                            </Grid>
                        </Button>

                    <StackPanel Spacing="8"
                                Visibility="{x:Bind IsInteractiveExpanded, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <controls:MarkdownTextBlock Markdown="{x:Bind EventDetail}"
                                                    Foreground="{ThemeResource TextPrimaryBrush}" />
                        <TextBox x:Uid="ChatPlanFeedback" PlaceholderText="Optional feedback or requested changes"
                                 AcceptsReturn="True"
                                 Height="72"
                                 Text="{x:Bind PlanFeedback, Mode=TwoWay}"
                                 Visibility="{x:Bind IsAwaitingResponse, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8"
                                    Visibility="{x:Bind IsAwaitingResponse, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <Button x:Uid="ChatApprovePlan" Content="Approve plan" Tag="{x:Bind}" Click="PlanApprove_Click" />
                            <Button x:Uid="ChatRequestChanges" Content="Request changes" Tag="{x:Bind}" Click="PlanRequestChanges_Click" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind EventMeta, Mode=OneWay}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{x:Bind Status, Mode=OneWay, Converter={StaticResource EventStatusToBrush}}"
                                   Visibility="{x:Bind IsAwaitingResponse, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                    </StackPanel>
                    </StackPanel>
                </Border>
            </DataTemplate>

            <!-- Fallback for an event kind this build has no card for (a legacy "tool" row
                 migration left behind, or a tool_activity row whose payload failed to
                 deserialize). The old all-in-one template drew these as a blank row too. -->
            <DataTemplate x:Key="ChatEmptyTemplate">
                <Grid />
            </DataTemplate>

            <presentation:ChatMessageTemplateSelector x:Key="ChatMessageTemplates"
                                                User="{StaticResource ChatUserTemplate}"
                                                Agent="{StaticResource ChatAgentTemplate}"
                                                Usage="{StaticResource ChatTurnUsageTemplate}"
                                                Activity="{StaticResource ChatActivityTemplate}"
                                                ToolActivity="{StaticResource ChatToolActivityTemplate}"
                                                AskUser="{StaticResource ChatAskUserTemplate}"
                                                Approval="{StaticResource ChatApprovalTemplate}"
                                                PlanReview="{StaticResource ChatPlanReviewTemplate}"
                                                Empty="{StaticResource ChatEmptyTemplate}" />
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ListView Grid.Row="0"
                  x:Name="MessageList"
                  AutomationProperties.AutomationId="MessageList"
                  ItemsSource="{x:Bind Vm.Messages, Mode=OneWay}"
                  ItemTemplateSelector="{StaticResource ChatMessageTemplates}"
                  FontSize="{x:Bind Vm.MessageFontSize, Mode=OneWay}"
                  SelectionMode="None"
                  Background="Transparent"
                  BorderThickness="0"
                  Padding="92,18,52,22"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Stretch">
            <!-- Conversation identity belongs to the transcript, not permanent page chrome.
                 Keeping it in the ListView header makes it available at the start of a chat and
                 lets it scroll away once the user is reading the conversation. -->
            <ListView.Header>
                <Grid MaxWidth="{StaticResource ChatColumnWidth}"
                      Margin="0,0,0,18"
                      HorizontalAlignment="Stretch" />
            </ListView.Header>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,14" />
                    <Setter Property="Background" Value="Transparent" />
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>

        <!-- Claude-style continuation affordance. It is controlled by the real ScrollViewer
             offset, so it appears only while transcript content remains below the viewport. -->
        <Button x:Name="ScrollToLatestButton"
                Grid.Row="0"
                Canvas.ZIndex="20"
                Width="44"
                Height="44"
                Margin="0,0,0,10"
                Padding="0"
                CornerRadius="22"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Background="{ThemeResource SurfaceElevatedBrush}"
                BorderBrush="{ThemeResource BorderDefaultBrush}"
                BorderThickness="1"
                Translation="0,0,12"
                Visibility="Collapsed"
                Click="ScrollToLatest_Click"
                AutomationProperties.Name="Scroll to latest message"
                ToolTipService.ToolTip="Scroll to latest message">
            <Button.Shadow>
                <ThemeShadow />
            </Button.Shadow>
            <ic:FluentIcon Icon="ArrowDown"
                           IconVariant="Regular"
                           IconSize="Size20"
                           Foreground="{ThemeResource TextPrimaryBrush}" />
        </Button>

        <!-- Failure bar: appears when the last run failed and is still retryable. Mutually
             exclusive with the offline bar (see Vm.ShowRetryBar) so the two never stack. -->
        <Border Grid.Row="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,16"
                MaxWidth="520"
                CornerRadius="14"
                Padding="14,8"
                Background="{ThemeResource SurfaceElevatedBrush}"
                BorderBrush="{ThemeResource BorderDefaultBrush}"
                BorderThickness="1"
                Visibility="{x:Bind Vm.ShowRetryBar, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock x:Uid="ChatConnectionFailure" Text="Couldn't reach the agent."
                           FontSize="12"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextSecondaryBrush}" />
                <Button Command="{x:Bind Vm.RetryCommand}"
                        Padding="12,5"
                        CornerRadius="8">
                    <controls:IconText x:Uid="ChatRetry" Glyph="ArrowClockwise" IconSize="Size16" Spacing="6" FontSize="12" Text="Retry" />
                </Button>
            </StackPanel>
        </Border>

        <controls:OfflineNoticeBar Grid.Row="0"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Bottom"
                                   Margin="20,0,20,18"
                                   MaxWidth="620"
                                   Detail="{x:Bind Vm.PresenceDetail, Mode=OneWay}"
                                   CanRecheck="{x:Bind Vm.CanReconnect, Mode=OneWay}"
                                   IsChecking="{x:Bind Vm.IsCheckingPresence, Mode=OneWay}"
                                   StatusMessage="{x:Bind Vm.RecheckFailedMessage, Mode=OneWay}"
                                   RecheckRequested="OfflineNotice_RecheckRequested"
                                   Visibility="{x:Bind Vm.ShowOfflineNotice, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <!-- Slide + fade up when the offline card appears, instead of popping in. -->
            <animations:Implicit.ShowAnimations>
                <animations:OpacityAnimation From="0" To="1" Duration="0:0:0.2" />
                <animations:TranslationAnimation From="0,14,0" To="0,0,0" Duration="0:0:0.2" />
            </animations:Implicit.ShowAnimations>
        </controls:OfflineNoticeBar>

        <StackPanel Grid.Row="1">
            <!-- Transient run feedback is input-adjacent: it explains what the action the user
                 just submitted is doing without consuming a permanent page header. -->
            <Grid MaxWidth="{StaticResource ChatComposerWidth}"
                  MinHeight="22"
                  Margin="20,0,20,3"
                  HorizontalAlignment="Stretch"
                  Visibility="{x:Bind Vm.StatusText, Mode=OneWay, Converter={StaticResource StringToVis}}">
                <StackPanel Orientation="Horizontal"
                            Spacing="7"
                            VerticalAlignment="Center">
                    <ProgressRing Width="12"
                                  Height="12"
                                  IsActive="{x:Bind Vm.IsProcessing, Mode=OneWay}"
                                  Visibility="{x:Bind Vm.IsProcessing, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{x:Bind Vm.StatusText, Mode=OneWay}"
                               AutomationProperties.AutomationId="ConnectionStatus"
                               FontSize="11"
                               Foreground="{ThemeResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <controls:ChatComposer x:Name="Composer"
                                   CanSubmit="{x:Bind Vm.CanSend, Mode=OneWay}"
                                   EnterToSubmit="{x:Bind Vm.EnterToSend, Mode=OneWay}"
                                   IsBusy="{x:Bind Vm.IsProcessing, Mode=OneWay}"
                                   CanStop="{x:Bind Vm.CanStop, Mode=OneWay}"
                                   IsStopping="{x:Bind Vm.IsStopping, Mode=OneWay}"
                                   Mode="{x:Bind Vm.CurrentMode, Mode=OneWay}"
                                   ShowModeSelector="True"
                                   AcceptedInputs="{x:Bind Vm.AcceptedInputs, Mode=OneWay}"
                                   ShowSuggestions="False"
                                   StopRequested="Composer_StopRequested"
                                   ModeChangeRequested="Composer_ModeChangeRequested"
                                   SubmitRequested="Composer_SubmitRequested" />

                        <!-- Simple centered title bar below the composer -->
                        <TextBlock FontSize="10"
                                   Foreground="{ThemeResource TextTertiaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,12">
                                <Run Text="{x:Bind Vm.SelectedAgentName, Mode=OneWay}" />
                                <Run Text="· Session " />
                                <Run Text="{x:Bind Vm.SessionShortId, Mode=OneWay}" />
                        </TextBlock>
        </StackPanel>

        <!-- Empty state: shown after loading completes when no messages exist -->
        <StackPanel x:Name="EmptyStatePanel"
                    Grid.Row="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8"
                    Visibility="Collapsed">
            <TextBlock x:Uid="ChatEmptyTitle" Text="No messages yet"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       HorizontalAlignment="Center" />
            <TextBlock x:Uid="ChatEmptyDescription" Text="Type a message below to start the conversation."
                       Foreground="{ThemeResource TextSecondaryBrush}"
                       HorizontalAlignment="Center"
                       TextWrapping="WrapWholeWords" />
        </StackPanel>

        <!-- Loading overlay hides the empty-state flash before conversation data arrives -->
        <Border x:Name="LoadingOverlay"
                Grid.Row="0"
                Background="{ThemeResource AppBackgroundBrush}"
                Visibility="Visible">
            <ProgressRing Width="28"
                          Height="28"
                          IsActive="True"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
        </Border>

    </Grid>
</Page>

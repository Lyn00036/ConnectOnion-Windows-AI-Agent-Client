<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ConnectOnion.WinUIClient.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ConnectOnion.WinUIClient.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel MaxWidth="640" Margin="24" HorizontalAlignment="Stretch" Spacing="8">
            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="Desktop preferences for this app."
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextSecondaryBrush}" />

            <Border Margin="0,16,0,0" Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="20">
                    <TextBlock Text="Appearance" Style="{StaticResource SubtitleTextBlockStyle}" />

                    <controls:SettingRow Title="Theme"
                                         Description="Use the system theme or choose light or dark mode.">
                        <RadioButtons x:Name="ThemeChoice" MaxColumns="3"
                                      SelectionChanged="ThemeChoice_SelectionChanged">
                            <x:String>System</x:String>
                            <x:String>Light</x:String>
                            <x:String>Dark</x:String>
                        </RadioButtons>
                    </controls:SettingRow>

                    <controls:SettingRow Title="Enter to send"
                                         Description="When enabled, Enter sends and Shift+Enter inserts a new line.">
                        <ToggleSwitch x:Name="EnterToSendSwitch"
                                      Toggled="EnterToSendSwitch_Toggled" />
                    </controls:SettingRow>

                    <controls:SettingRow Title="Message text size"
                                         Description="Adjust how large chat messages appear.">
                        <RadioButtons x:Name="FontChoice" MaxColumns="3"
                                      SelectionChanged="FontChoice_SelectionChanged">
                            <x:String>Small</x:String>
                            <x:String>Medium</x:String>
                            <x:String>Large</x:String>
                        </RadioButtons>
                    </controls:SettingRow>

                    <controls:SettingRow Title="Local identity"
                                         Description="View this desktop client's ConnectOnion address and public key.">
                        <Button Content="View identity"
                                Padding="14,6"
                                Click="Identity_Click" />
                    </controls:SettingRow>
                </StackPanel>
            </Border>

            <Border Margin="0,8,0,0" Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="20">
                    <TextBlock Text="Audio" Style="{StaticResource SubtitleTextBlockStyle}" />

                    <controls:SettingRow Title="Microphone"
                                         Description="Choose the microphone for voice input.">
                        <ComboBox x:Name="MicChoice"
                                  Width="220"
                                  DisplayMemberPath="Name"
                                  SelectionChanged="MicChoice_SelectionChanged" />
                    </controls:SettingRow>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>

<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ConnectOnion.WinUIClient.Views.IdentityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel MaxWidth="760" Margin="24" HorizontalAlignment="Stretch" Spacing="16">
            <Button Padding="0"
                    MinWidth="0"
                    MinHeight="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="Back_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ic:FluentIcon Icon="ArrowLeft" IconVariant="Regular" IconSize="Size16" />
                    <TextBlock Text="Settings" />
                </StackPanel>
            </Button>

            <StackPanel Spacing="6">
                <TextBlock Text="Local identity" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="This desktop client uses an Ed25519 identity to sign ConnectOnion messages. The private seed is stored locally and is not shown here."
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource TextSecondaryBrush}" />
            </StackPanel>

            <Border Padding="20"
                    CornerRadius="8"
                    Background="{ThemeResource SurfaceElevatedBrush}"
                    BorderBrush="{ThemeResource BorderDefaultBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="18">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Address" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Name="AddressText"
                                       TextWrapping="Wrap"
                                       IsTextSelectionEnabled="True"
                                       FontFamily="Consolas" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Tag="address"
                                Padding="10,6"
                                VerticalAlignment="Center"
                                Click="Copy_Click"
                                ToolTipService.ToolTip="Copy address">
                            <ic:FluentIcon Icon="Copy" IconVariant="Regular" IconSize="Size16" />
                        </Button>
                    </Grid>

                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Public key" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Name="PublicKeyText"
                                       TextWrapping="Wrap"
                                       IsTextSelectionEnabled="True"
                                       FontFamily="Consolas" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Tag="publicKey"
                                Padding="10,6"
                                VerticalAlignment="Center"
                                Click="Copy_Click"
                                ToolTipService.ToolTip="Copy public key">
                            <ic:FluentIcon Icon="Copy" IconVariant="Regular" IconSize="Size16" />
                        </Button>
                    </Grid>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Storage" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="StorageText"
                                   TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True"
                                   FontFamily="Consolas"
                                   Foreground="{ThemeResource TextSecondaryBrush}" />
                    </StackPanel>

                    <TextBlock Text="Private seed is stored DPAPI-encrypted in the local SQLite identity_keys table and is intentionally hidden."
                               TextWrapping="Wrap"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>

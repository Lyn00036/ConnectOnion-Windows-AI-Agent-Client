<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ConnectOnion.WinUIClient.Views.AgentDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="AgentRoot"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
          SizeChanged="AgentRoot_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Width="620"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="32,0,32,108"
                    Spacing="18"
                    Visibility="{x:Bind Vm.HasAgent, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <Border Width="58"
                    Height="58"
                    CornerRadius="8"
                    HorizontalAlignment="Center"
                    Background="{ThemeResource TextFillColorPrimaryBrush}">
                <TextBlock Text="{x:Bind Vm.AgentInitial, Mode=OneWay}"
                           Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                           FontSize="20"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>

            <StackPanel HorizontalAlignment="Center" Spacing="8">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="8">
                    <TextBlock Text="{x:Bind Vm.AgentName, Mode=OneWay}"
                               FontFamily="Georgia"
                               FontSize="28"
                               FontWeight="Bold"
                               TextAlignment="Center" />
                    <Ellipse Width="7"
                             Height="7"
                             Fill="{x:Bind Vm.Presence, Mode=OneWay, Converter={StaticResource PresenceToBrush}}"
                             VerticalAlignment="Center" />
                    <TextBlock Text="{x:Bind Vm.PresenceLabel, Mode=OneWay}"
                               FontSize="9"
                               FontWeight="Bold"
                               Foreground="{x:Bind Vm.Presence, Mode=OneWay, Converter={StaticResource PresenceToBrush}}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Text="{x:Bind Vm.DisplayModel, Mode=OneWay}"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <Border HorizontalAlignment="Center"
                    CornerRadius="18"
                    Padding="14,6"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="BALANCE"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="$5.00"
                               FontSize="11"
                               FontWeight="Bold" />
                    <TextBlock Text="Top up ->"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource StatusSuccessTextBrush}" />
                </StackPanel>
            </Border>

            <StackPanel Spacing="4"
                        HorizontalAlignment="Center"
                        Visibility="{x:Bind Vm.HasToolSummary, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{x:Bind Vm.ToolSummaryLineOne, Mode=OneWay}"
                           FontFamily="Consolas"
                           FontSize="11"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{x:Bind Vm.ToolSummaryLineTwo, Mode=OneWay}"
                           FontFamily="Consolas"
                           FontSize="11"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           Visibility="{x:Bind Vm.ToolSummaryLineTwo, Mode=OneWay, Converter={StaticResource StringToVis}}" />
            </StackPanel>

            <ProgressRing Width="20"
                          Height="20"
                          IsActive="{x:Bind Vm.IsLoading, Mode=OneWay}"
                          Visibility="{x:Bind Vm.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                          HorizontalAlignment="Center" />

            <InfoBar Severity="Error"
                     Message="{x:Bind Vm.StatusText, Mode=OneWay}"
                     IsOpen="{x:Bind Vm.HasError, Mode=OneWay}"
                     IsClosable="False" />
        </StackPanel>

        <StackPanel Grid.Row="0"
                    Spacing="8"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{x:Bind Vm.HasAgent, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
            <TextBlock Text="No agent selected"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       TextAlignment="Center" />
            <TextBlock Text="Select an agent from the sidebar or add a new one to get started."
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextAlignment="Center"
                       TextWrapping="WrapWholeWords" />
        </StackPanel>

        <StackPanel Grid.Row="1"
                    x:Name="PromptPanel"
                    Width="656"
                    HorizontalAlignment="Center"
                    Margin="24,0,24,24"
                    Spacing="14"
                    Visibility="{x:Bind Vm.HasAgent, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Spacing="8">
                <Button Content="What can you do?"
                        Padding="16,6"
                        CornerRadius="16"
                        Tag="What can you do?"
                        Click="Suggestion_Click" />
                <Button Content="Show system info"
                        Padding="16,6"
                        CornerRadius="16"
                        Tag="Show system info"
                        Click="Suggestion_Click" />
                <Button Content="List files in current directory"
                        Padding="16,6"
                        CornerRadius="16"
                        Tag="List files in current directory"
                        Click="Suggestion_Click" />
            </StackPanel>

            <Border CornerRadius="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid MinHeight="84">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="56" />
                        <RowDefinition Height="1" />
                        <RowDefinition Height="28" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0"
                          Padding="14,10,14,8"
                          ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Width="36"
                                Height="36"
                                Padding="0"
                                CornerRadius="18"
                                Background="Transparent"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                ToolTipService.ToolTip="Add attachment">
                            <FontIcon Glyph="&#xE710;"
                                      FontSize="18"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Button>

                        <TextBox x:Name="PromptBox"
                                 Grid.Column="1"
                                 MinHeight="36"
                                 Padding="0,6,0,0"
                                 PlaceholderText="Message this agent..."
                                 PlaceholderForeground="{ThemeResource TextFillColorTertiaryBrush}"
                                 FontSize="14"
                                 FontWeight="SemiBold"
                                 AcceptsReturn="True"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 VerticalAlignment="Center"
                                 KeyDown="PromptBox_KeyDown" />

                        <Button Grid.Column="2"
                                Width="36"
                                Height="36"
                                Padding="0"
                                CornerRadius="18"
                                Background="Transparent"
                                BorderThickness="0"
                                ToolTipService.ToolTip="Voice input">
                            <FontIcon Glyph="&#xE720;"
                                      FontSize="18"
                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </Button>

                        <Button Grid.Column="3"
                                Width="40"
                                Height="40"
                                Padding="0"
                                CornerRadius="10"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderThickness="0"
                                Click="StartConversation_Click"
                                ToolTipService.ToolTip="Start conversation">
                            <FontIcon Glyph="&#xE74A;"
                                      FontSize="20"
                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </Button>
                    </Grid>

                    <Border Grid.Row="1"
                            Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                    <TextBlock Grid.Row="2"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Margin="0,0,14,0"
                               FontSize="11">
                        <Run Text="safe"
                             FontWeight="SemiBold"
                             Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <Run Text=" &#x00B7; "
                             Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Run Text="plan"
                             Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Run Text=" &#x00B7; "
                             Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Run Text="accept"
                             Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Run Text=" &#x00B7; "
                             Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Run Text="ultra"
                             Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </TextBlock>
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</Page>

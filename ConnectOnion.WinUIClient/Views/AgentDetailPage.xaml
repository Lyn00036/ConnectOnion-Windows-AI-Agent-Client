<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ConnectOnion.WinUIClient.Views.AgentDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ConnectOnion.WinUIClient.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="AgentRoot"
          Background="{ThemeResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Width="620"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="32,0,32,108"
                    Spacing="18"
                    Visibility="{x:Bind Vm.HasAgent, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <Border Width="58"
                    Height="58"
                    CornerRadius="8"
                    HorizontalAlignment="Center"
                    Background="{ThemeResource BrandPrimaryBrush}">
                <TextBlock Text="{x:Bind Vm.AgentInitial, Mode=OneWay}"
                           Foreground="{ThemeResource TextOnBrandBrush}"
                           FontSize="20"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>

            <StackPanel HorizontalAlignment="Center" Spacing="8">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="8">
                    <TextBlock Text="{x:Bind Vm.AgentName, Mode=OneWay}"
                               FontFamily="Georgia"
                               FontSize="28"
                               FontWeight="Bold"
                               TextAlignment="Center" />
                    <Ellipse Width="7"
                             Height="7"
                             Fill="{x:Bind Vm.Presence, Mode=OneWay, Converter={StaticResource PresenceToBrush}}"
                             VerticalAlignment="Center" />
                    <TextBlock Text="{x:Bind Vm.PresenceLabel, Mode=OneWay}"
                               FontSize="9"
                               FontWeight="Bold"
                               Foreground="{x:Bind Vm.Presence, Mode=OneWay, Converter={StaticResource PresenceToBrush}}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Text="{x:Bind Vm.DisplayModel, Mode=OneWay}"
                           FontSize="12"
                           Foreground="{ThemeResource TextTertiaryBrush}"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <StackPanel Spacing="4"
                        HorizontalAlignment="Center"
                        Visibility="{x:Bind Vm.HasToolSummary, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{x:Bind Vm.ToolSummaryLineOne, Mode=OneWay}"
                           FontFamily="Consolas"
                           FontSize="11"
                           Foreground="{ThemeResource TextTertiaryBrush}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{x:Bind Vm.ToolSummaryLineTwo, Mode=OneWay}"
                           FontFamily="Consolas"
                           FontSize="11"
                           Foreground="{ThemeResource TextTertiaryBrush}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           Visibility="{x:Bind Vm.ToolSummaryLineTwo, Mode=OneWay, Converter={StaticResource StringToVis}}" />
            </StackPanel>

            <ProgressRing Width="20"
                          Height="20"
                          IsActive="{x:Bind Vm.IsLoading, Mode=OneWay}"
                          Visibility="{x:Bind Vm.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                          HorizontalAlignment="Center" />

            <InfoBar Severity="Error"
                     Message="{x:Bind Vm.StatusText, Mode=OneWay}"
                     IsOpen="{x:Bind Vm.HasError, Mode=OneWay}"
                     IsClosable="False" />
        </StackPanel>

        <StackPanel Grid.Row="0"
                    Spacing="8"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{x:Bind Vm.HasAgent, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
            <TextBlock Text="No agent selected"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       TextAlignment="Center" />
            <TextBlock Text="Select an agent from the sidebar or add a new one to get started."
                       Foreground="{ThemeResource TextSecondaryBrush}"
                       TextAlignment="Center"
                       TextWrapping="WrapWholeWords" />
        </StackPanel>

        <controls:ChatComposer x:Name="Composer"
                               Grid.Row="1"
                               CanSubmit="{x:Bind Vm.HasAgent, Mode=OneWay}"
                               EnterToSubmit="{x:Bind Vm.EnterToSend, Mode=OneWay}"
                               AcceptedInputs="{x:Bind Vm.AcceptedInputs, Mode=OneWay}"
                               SubmitRequested="Composer_SubmitRequested"
                               Visibility="{x:Bind Vm.HasAgent, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
    </Grid>
</Page>

            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="{ThemeResource BrandPrimaryPressedColor}" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="{ThemeResource CodeTextColor}" />
            <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="{ThemeResource TextLinkColor}" />
            <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="{ThemeResource BrandPrimaryHoverColor}" />

            <!-- Default Button PointerOver/Pressed: unifies every plain-Style toolbar and
                 command button (Toggle Sidebar, Back/Forward, Find, Zoom, Approve/Reject, ...)

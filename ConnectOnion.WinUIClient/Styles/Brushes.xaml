<?xml version="1.0" encoding="utf-8"?>
<!--
    Semantic brush tokens — what pages and control styles actually bind to via
    {ThemeResource ...}. Each brush wraps the matching Color token from
    Colors.xaml (merged before this file — see App.xaml) so there is exactly
    one place (Colors.xaml) that owns a hex value.

    This file also:
      1. Redirects the small set of legacy, pre-existing resource keys
         (ShellBackgroundBrush, ComposerBackgroundBrush, StatusSuccessTextBrush,
         etc.) that Views/Controls already reference by name, onto the new
         semantic Color tokens — so those call sites keep working without a
         rename, while the actual color values now come from one system
         instead of being duplicated literals.
      2. Re-points WinUI's own themed control keys (TextFillColor*Brush,
         CardBackgroundFillColorDefaultBrush, AccentFillColor*Brush, the
         Button PointerOver/Pressed background keys, etc.) at the same
         tokens, so native Fluent chrome (Expander, default Button hover,
         ToggleSwitch accent, hyperlinks, ...) stays visually consistent with
         the app's own hand-styled surfaces without every native
         ControlTemplate being replaced. Only background/foreground/accent
         keys are touched here — ToggleSwitch, CheckBox, RadioButton and
         focus-visual templates keep their native Fluent look untouched
         (see CLAUDE.md "WinUI/XAML gotchas" and the High Contrast note in
         the color-system task this file was introduced for).
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Light">

            <!-- ============ Semantic tokens ============ -->

            <!-- Brand -->
            <SolidColorBrush x:Key="BrandPrimaryBrush" Color="{ThemeResource BrandPrimaryColor}" />
            <SolidColorBrush x:Key="BrandPrimaryHoverBrush" Color="{ThemeResource BrandPrimaryHoverColor}" />
            <SolidColorBrush x:Key="BrandPrimaryPressedBrush" Color="{ThemeResource BrandPrimaryPressedColor}" />
            <SolidColorBrush x:Key="BrandPrimarySubtleBrush" Color="{ThemeResource BrandPrimarySubtleColor}" />
            <SolidColorBrush x:Key="BrandAccentBrush" Color="{ThemeResource BrandAccentColor}" />
            <SolidColorBrush x:Key="BrandAccentHoverBrush" Color="{ThemeResource BrandAccentHoverColor}" />
            <SolidColorBrush x:Key="BrandAccentPressedBrush" Color="{ThemeResource BrandAccentPressedColor}" />
            <SolidColorBrush x:Key="BrandOnPrimaryBrush" Color="{ThemeResource BrandOnPrimaryColor}" />

            <!-- Background / Surface -->
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="{ThemeResource AppBackgroundColor}" />
            <SolidColorBrush x:Key="SurfacePrimaryBrush" Color="{ThemeResource SurfacePrimaryColor}" />
            <SolidColorBrush x:Key="SurfaceSecondaryBrush" Color="{ThemeResource SurfaceSecondaryColor}" />
            <SolidColorBrush x:Key="SurfaceTertiaryBrush" Color="{ThemeResource SurfaceTertiaryColor}" />
            <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{ThemeResource SurfaceElevatedColor}" />
            <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{ThemeResource SurfaceHoverColor}" />
            <SolidColorBrush x:Key="SurfacePressedBrush" Color="{ThemeResource SurfacePressedColor}" />
            <SolidColorBrush x:Key="SurfaceSelectedBrush" Color="{ThemeResource SurfaceSelectedColor}" />

            <!-- Text -->
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{ThemeResource TextPrimaryColor}" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{ThemeResource TextSecondaryColor}" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="{ThemeResource TextTertiaryColor}" />
            <SolidColorBrush x:Key="TextDisabledBrush" Color="{ThemeResource TextDisabledColor}" />
            <SolidColorBrush x:Key="TextOnBrandBrush" Color="{ThemeResource TextOnBrandColor}" />
            <SolidColorBrush x:Key="TextLinkBrush" Color="{ThemeResource TextLinkColor}" />
            <SolidColorBrush x:Key="TextLinkHoverBrush" Color="{ThemeResource TextLinkHoverColor}" />

            <!-- Border -->
            <SolidColorBrush x:Key="BorderSubtleBrush" Color="{ThemeResource BorderSubtleColor}" />
            <SolidColorBrush x:Key="BorderDefaultBrush" Color="{ThemeResource BorderDefaultColor}" />
            <SolidColorBrush x:Key="BorderStrongBrush" Color="{ThemeResource BorderStrongColor}" />
            <SolidColorBrush x:Key="DividerBrush" Color="{ThemeResource DividerColor}" />
            <SolidColorBrush x:Key="FocusBorderBrush" Color="{ThemeResource FocusBorderColor}" />

            <!-- Status -->
            <SolidColorBrush x:Key="SuccessBrush" Color="{ThemeResource SuccessColor}" />
            <SolidColorBrush x:Key="WarningBrush" Color="{ThemeResource WarningColor}" />
            <SolidColorBrush x:Key="DangerBrush" Color="{ThemeResource DangerColor}" />
            <SolidColorBrush x:Key="InfoBrush" Color="{ThemeResource InfoColor}" />

            <!-- Search -->
            <SolidColorBrush x:Key="SearchMatchBackgroundBrush" Color="{ThemeResource SearchMatchBackgroundColor}" />
            <SolidColorBrush x:Key="SearchCurrentBackgroundBrush" Color="{ThemeResource SearchCurrentBackgroundColor}" />
            <SolidColorBrush x:Key="SearchMatchTextBrush" Color="{ThemeResource SearchMatchTextColor}" />

            <!-- Chat -->
            <SolidColorBrush x:Key="ChatBackgroundBrush" Color="{ThemeResource ChatBackgroundColor}" />
            <SolidColorBrush x:Key="UserMessageBackgroundBrush" Color="{ThemeResource UserMessageBackgroundColor}" />
            <SolidColorBrush x:Key="AgentMessageBackgroundBrush" Color="{ThemeResource AgentMessageBackgroundColor}" />
            <SolidColorBrush x:Key="SystemMessageBackgroundBrush" Color="{ThemeResource SystemMessageBackgroundColor}" />
            <SolidColorBrush x:Key="ChatInputBackgroundBrush" Color="{ThemeResource ChatInputBackgroundColor}" />
            <SolidColorBrush x:Key="CodeBackgroundBrush" Color="{ThemeResource CodeBackgroundColor}" />
            <SolidColorBrush x:Key="InlineCodeBackgroundBrush" Color="{ThemeResource InlineCodeBackgroundColor}" />
            <SolidColorBrush x:Key="CodeTextBrush" Color="{ThemeResource CodeTextColor}" />

            <!-- Sidebar -->
            <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{ThemeResource SidebarBackgroundColor}" />
            <SolidColorBrush x:Key="SidebarItemHoverBrush" Color="{ThemeResource SidebarItemHoverColor}" />
            <SolidColorBrush x:Key="SidebarItemPressedBrush" Color="{ThemeResource SidebarItemPressedColor}" />
            <SolidColorBrush x:Key="SidebarItemSelectedBrush" Color="{ThemeResource SidebarItemSelectedColor}" />
            <SolidColorBrush x:Key="SidebarSelectedAccentBrush" Color="{ThemeResource SidebarSelectedAccentColor}" />
            <SolidColorBrush x:Key="SettingsBackdropBrush" Color="{ThemeResource SettingsBackdropColor}" />
            <SolidColorBrush x:Key="SettingsNavigationBrush" Color="{ThemeResource SettingsNavigationColor}" />
            <SolidColorBrush x:Key="SettingsContentBrush" Color="{ThemeResource SettingsContentColor}" />
            <SolidColorBrush x:Key="SettingsModalBorderBrush" Color="{ThemeResource SettingsModalBorderColor}" />

            <!-- ============ Legacy keys (kept for source compatibility, now sourced from the tokens above) ============ -->

            <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{ThemeResource AppBackgroundColor}" />
            <SolidColorBrush x:Key="ShellSidebarBrush" Color="{ThemeResource SidebarBackgroundColor}" />
            <SolidColorBrush x:Key="ShellRowBrush" Color="{ThemeResource SurfaceSecondaryColor}" />
            <SolidColorBrush x:Key="ShellHoverBrush" Color="{ThemeResource SidebarItemHoverColor}" />
            <SolidColorBrush x:Key="ShellMutedTextBrush" Color="{ThemeResource TextSecondaryColor}" />

            <SolidColorBrush x:Key="ThinkingStatusBackgroundBrush" Color="#FFE7F7EE" />
            <SolidColorBrush x:Key="ThinkingStatusBorderBrush" Color="#FF9BD7B8" />
            <SolidColorBrush x:Key="ThinkingStatusDotBrush" Color="{ThemeResource SuccessColor}" />
            <SolidColorBrush x:Key="StatusSuccessTextBrush" Color="{ThemeResource SuccessColor}" />
            <SolidColorBrush x:Key="StatusErrorTextBrush" Color="{ThemeResource DangerColor}" />

            <SolidColorBrush x:Key="ComposerBackgroundBrush" Color="{ThemeResource ChatInputBackgroundColor}" />
            <SolidColorBrush x:Key="ComposerBorderBrush" Color="{ThemeResource BorderDefaultColor}" />
            <SolidColorBrush x:Key="ComposerTextBrush" Color="{ThemeResource TextPrimaryColor}" />
            <SolidColorBrush x:Key="ComposerPlaceholderBrush" Color="{ThemeResource TextTertiaryColor}" />
            <SolidColorBrush x:Key="ComposerMutedControlBrush" Color="{ThemeResource TextSecondaryColor}" />
            <SolidColorBrush x:Key="ComposerControlBorderBrush" Color="{ThemeResource BorderDefaultColor}" />
            <SolidColorBrush x:Key="ComposerWaveformBaselineBrush" Color="{ThemeResource BorderStrongColor}" />
            <SolidColorBrush x:Key="ComposerActiveWaveformBrush" Color="{ThemeResource TextPrimaryColor}" />
            <SolidColorBrush x:Key="ComposerRecordingTextBrush" Color="{ThemeResource TextSecondaryColor}" />
            <!-- Deliberately monochrome ink/paper CTA (not brand purple) — matches the
                 restrained, non-"every button is Primary" composer convention common to
                 AI chat clients; kept as its own literal so it doesn't drift if the brand
                 scale changes. -->
            <SolidColorBrush x:Key="ComposerStopButtonBackgroundBrush" Color="#FF3A3A3D" />
            <SolidColorBrush x:Key="ComposerStopButtonForegroundBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ComposerPrimaryButtonBackgroundBrush" Color="#FF202124" />
            <SolidColorBrush x:Key="ComposerPrimaryButtonForegroundBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ComposerDisabledButtonBackgroundBrush" Color="#FFE7E7EA" />
            <SolidColorBrush x:Key="ComposerDisabledButtonForegroundBrush" Color="#FF9A9CA2" />

            <!-- ============ WinUI system theme-key overrides ============ -->
            <!-- Text tiers + card surfaces + accent: these ARE WinUI's own semantic keys
                 (consulted internally by native Button/Expander/Hyperlink/ToggleSwitch
                 templates), re-pointed at the tokens above so native chrome sitting next
                 to hand-styled app surfaces (e.g. an Expander inside a SurfaceElevated
                 card) matches instead of showing stock Fluent gray. -->
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{ThemeResource TextPrimaryColor}" />
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{ThemeResource TextSecondaryColor}" />
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="{ThemeResource TextTertiaryColor}" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="{ThemeResource TextOnBrandColor}" />
            <SolidColorBrush x:Key="TextOnAccentFillSecondaryBrush" Color="{ThemeResource TextOnBrandColor}" />
            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="{ThemeResource AppBackgroundColor}" />
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{ThemeResource SurfaceElevatedColor}" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="{ThemeResource BorderDefaultColor}" />
            <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="{ThemeResource SurfaceSecondaryColor}" />
            <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="{ThemeResource DividerColor}" />
            <SolidColorBrush x:Key="SurfaceStrokeColorDefaultBrush" Color="{ThemeResource BorderDefaultColor}" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="{ThemeResource SurfaceElevatedColor}" />

            <Color x:Key="BrandAccentColorSecondary">#FF5E35B1</Color>
            <Color x:Key="BrandAccentColorTertiary">#FF512DA8</Color>
            <Color x:Key="BrandAccentColorQuaternary">#FF4527A0</Color>
            <Color x:Key="SystemAccentColor">#FF673AB7</Color>
            <Color x:Key="SystemAccentColorDark1">#FF5E35B1</Color>
            <Color x:Key="SystemAccentColorDark2">#FF512DA8</Color>
            <Color x:Key="SystemAccentColorDark3">#FF4527A0</Color>
            <Color x:Key="SystemAccentColorLight1">#FF7C4DFF</Color>
            <Color x:Key="SystemAccentColorLight2">#FFB39DFF</Color>
            <Color x:Key="SystemAccentColorLight3">#FFD1C4E9</Color>
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{ThemeResource BrandPrimaryColor}" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{ThemeResource BrandPrimaryHoverColor}" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="{ThemeResource BrandPrimaryPressedColor}" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="{ThemeResource CodeTextColor}" />
            <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="{ThemeResource TextLinkColor}" />
            <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="{ThemeResource BrandPrimaryHoverColor}" />

            <!-- Default Button PointerOver/Pressed: unifies every plain-Style toolbar and
                 command button (Toggle Sidebar, Back/Forward, Find, Zoom, Approve/Reject, ...)
                 on SurfaceHover/SurfacePressed without a per-button override. ToggleSwitch,
                 CheckBox and RadioButton use their own separate resource keys and are
                 untouched. -->
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource SurfaceHoverColor}" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{ThemeResource SurfacePressedColor}" />
            <SolidColorBrush x:Key="FocusVisualPrimaryBrush" Color="{ThemeResource FocusBorderColor}" />

        </ResourceDictionary>


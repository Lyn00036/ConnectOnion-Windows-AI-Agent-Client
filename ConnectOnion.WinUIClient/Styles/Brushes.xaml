<?xml version="1.0" encoding="utf-8"?>
<!--
    Semantic brush tokens — what pages and control styles actually bind to via
    {ThemeResource ...}. Each brush wraps the matching Color token from
    Colors.xaml (merged before this file — see App.xaml) so there is exactly
    one place (Colors.xaml) that owns a hex value.

    This file also:
      1. Redirects the small set of legacy, pre-existing resource keys
         (ShellBackgroundBrush, ComposerBackgroundBrush, StatusSuccessTextBrush,
         etc.) that Views/Controls already reference by name, onto the new
         semantic Color tokens — so those call sites keep working without a
         rename, while the actual color values now come from one system
         instead of being duplicated literals.
      2. Re-points WinUI's own themed control keys (TextFillColor*Brush,
         CardBackgroundFillColorDefaultBrush, AccentFillColor*Brush, the
         Button PointerOver/Pressed background keys, etc.) at the same
         tokens, so native Fluent chrome (Expander, default Button hover,
         ToggleSwitch accent, hyperlinks, ...) stays visually consistent with
         the app's own hand-styled surfaces without every native
         ControlTemplate being replaced. Only background/foreground/accent
         keys are touched here — ToggleSwitch, CheckBox, RadioButton and
         focus-visual templates keep their native Fluent look untouched
         (see CLAUDE.md "WinUI/XAML gotchas" and the High Contrast note in
         the color-system task this file was introduced for).
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>


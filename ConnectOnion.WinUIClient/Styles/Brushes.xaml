            <SolidColorBrush x:Key="ComposerDisabledButtonBackgroundBrush" Color="#FF4A4A4A" />
            <SolidColorBrush x:Key="ComposerDisabledButtonForegroundBrush" Color="#FF8F8F8F" />

            <!-- ============ WinUI system theme-key overrides ============ -->
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{ThemeResource TextPrimaryColor}" />
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{ThemeResource TextSecondaryColor}" />

            <SolidColorBrush x:Key="BorderDefaultBrush" Color="{ThemeResource BorderDefaultColor}" />
            <SolidColorBrush x:Key="BorderStrongBrush" Color="{ThemeResource BorderStrongColor}" />
            <SolidColorBrush x:Key="DividerBrush" Color="{ThemeResource DividerColor}" />
            <SolidColorBrush x:Key="FocusBorderBrush" Color="{ThemeResource FocusBorderColor}" />

            <!-- Status -->
            <SolidColorBrush x:Key="SuccessBrush" Color="{ThemeResource SuccessColor}" />
            <SolidColorBrush x:Key="WarningBrush" Color="{ThemeResource WarningColor}" />
            <SolidColorBrush x:Key="DangerBrush" Color="{ThemeResource DangerColor}" />
            <SolidColorBrush x:Key="InfoBrush" Color="{ThemeResource InfoColor}" />

            <!-- Search -->
            <SolidColorBrush x:Key="SearchMatchBackgroundBrush" Color="{ThemeResource SearchMatchBackgroundColor}" />
            <SolidColorBrush x:Key="SearchCurrentBackgroundBrush" Color="{ThemeResource SearchCurrentBackgroundColor}" />
            <SolidColorBrush x:Key="SearchMatchTextBrush" Color="{ThemeResource SearchMatchTextColor}" />

            <!-- Chat -->
            <SolidColorBrush x:Key="ChatBackgroundBrush" Color="{ThemeResource ChatBackgroundColor}" />
            <SolidColorBrush x:Key="UserMessageBackgroundBrush" Color="{ThemeResource UserMessageBackgroundColor}" />
            <SolidColorBrush x:Key="AgentMessageBackgroundBrush" Color="{ThemeResource AgentMessageBackgroundColor}" />
            <SolidColorBrush x:Key="SystemMessageBackgroundBrush" Color="{ThemeResource SystemMessageBackgroundColor}" />
            <SolidColorBrush x:Key="ChatInputBackgroundBrush" Color="{ThemeResource ChatInputBackgroundColor}" />
            <SolidColorBrush x:Key="CodeBackgroundBrush" Color="{ThemeResource CodeBackgroundColor}" />
            <SolidColorBrush x:Key="InlineCodeBackgroundBrush" Color="{ThemeResource InlineCodeBackgroundColor}" />
            <SolidColorBrush x:Key="CodeTextBrush" Color="{ThemeResource CodeTextColor}" />

            <!-- Sidebar -->
            <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{ThemeResource SidebarBackgroundColor}" />
            <SolidColorBrush x:Key="SidebarItemHoverBrush" Color="{ThemeResource SidebarItemHoverColor}" />
            <SolidColorBrush x:Key="SidebarItemPressedBrush" Color="{ThemeResource SidebarItemPressedColor}" />
            <SolidColorBrush x:Key="SidebarItemSelectedBrush" Color="{ThemeResource SidebarItemSelectedColor}" />
            <SolidColorBrush x:Key="SidebarSelectedAccentBrush" Color="{ThemeResource SidebarSelectedAccentColor}" />
            <SolidColorBrush x:Key="SettingsBackdropBrush" Color="{ThemeResource SettingsBackdropColor}" />
            <SolidColorBrush x:Key="SettingsNavigationBrush" Color="{ThemeResource SettingsNavigationColor}" />
            <SolidColorBrush x:Key="SettingsContentBrush" Color="{ThemeResource SettingsContentColor}" />
            <SolidColorBrush x:Key="SettingsModalBorderBrush" Color="{ThemeResource SettingsModalBorderColor}" />

            <!-- ============ Legacy keys (kept for source compatibility, now sourced from the tokens above) ============ -->

            <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{ThemeResource AppBackgroundColor}" />
            <SolidColorBrush x:Key="ShellSidebarBrush" Color="{ThemeResource SidebarBackgroundColor}" />
            <SolidColorBrush x:Key="ShellRowBrush" Color="{ThemeResource SurfaceSecondaryColor}" />
            <SolidColorBrush x:Key="ShellHoverBrush" Color="{ThemeResource SidebarItemHoverColor}" />
            <SolidColorBrush x:Key="ShellMutedTextBrush" Color="{ThemeResource TextSecondaryColor}" />


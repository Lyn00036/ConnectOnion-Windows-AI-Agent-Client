<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="ConnectOnion.WinUIClient.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ConnectOnion.WinUIClient"
    xmlns:common="using:ConnectOnion.WinUIClient.Common">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="ShellSidebarBrush" Color="#FFF7F7F8" />
                    <SolidColorBrush x:Key="ShellRowBrush" Color="#FFF4F4F5" />
                    <SolidColorBrush x:Key="ShellHoverBrush" Color="#FFEFEFF0" />
                    <SolidColorBrush x:Key="ShellMutedTextBrush" Color="#FF6F737A" />
                    <SolidColorBrush x:Key="ThinkingStatusBackgroundBrush" Color="#FFE7F7EE" />
                    <SolidColorBrush x:Key="ThinkingStatusBorderBrush" Color="#FF9BD7B8" />
                    <SolidColorBrush x:Key="ThinkingStatusDotBrush" Color="#FF078B45" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="#FF111113" />
                    <SolidColorBrush x:Key="ShellSidebarBrush" Color="#FF1B1B1F" />
                    <SolidColorBrush x:Key="ShellRowBrush" Color="#FF242428" />
                    <SolidColorBrush x:Key="ShellHoverBrush" Color="#FF2D2D33" />
                    <SolidColorBrush x:Key="ShellMutedTextBrush" Color="#FFA2A2AA" />
                    <SolidColorBrush x:Key="ThinkingStatusBackgroundBrush" Color="#FF143426" />
                    <SolidColorBrush x:Key="ThinkingStatusBorderBrush" Color="#FF236F4A" />
                    <SolidColorBrush x:Key="ThinkingStatusDotBrush" Color="#FF39D98A" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <common:BoolToVisibilityConverter x:Key="BoolToVis" />
            <common:RoleToAlignmentConverter x:Key="RoleToAlignment" />
            <common:RoleToBrushConverter x:Key="RoleToBrush" />
            <common:StringToVisibilityConverter x:Key="StringToVis" />
        </ResourceDictionary>
    </Application.Resources>
</Application>

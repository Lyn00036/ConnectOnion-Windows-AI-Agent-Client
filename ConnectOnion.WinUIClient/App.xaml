<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="ConnectOnion.WinUIClient.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ConnectOnion.WinUIClient"
    xmlns:presentation="using:ConnectOnion.WinUIClient.Presentation">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Styles/Colors.xaml" />
                <ResourceDictionary Source="ms-appx:///Styles/Brushes.xaml" />
                <ResourceDictionary Source="ms-appx:///Styles/ControlStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <presentation:BoolToVisibilityConverter x:Key="BoolToVis" />
            <presentation:RoleToAlignmentConverter x:Key="RoleToAlignment" />
            <presentation:RoleToBrushConverter x:Key="RoleToBrush" />
            <presentation:StringToVisibilityConverter x:Key="StringToVis" />
            <presentation:PresenceToBrushConverter x:Key="PresenceToBrush" />
            <presentation:EventStatusToBrushConverter x:Key="EventStatusToBrush" />
            <presentation:ToolStatusToBrushConverter x:Key="ToolStatusToBrush" />
            <presentation:LocalPathToImageSourceConverter x:Key="PathToImage" />
            <presentation:RowStateToBackgroundConverter x:Key="RowStateToBackground" />
        </ResourceDictionary>
    </Application.Resources>
</Application>

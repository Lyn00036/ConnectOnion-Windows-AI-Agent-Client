<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ConnectOnion.WinUIClient.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ConnectOnion.WinUIClient.Controls"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="ConnectOnion">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Background="{ThemeResource AppBackgroundBrush}" SizeChanged="RootGrid_SizeChanged">
        <Grid.Resources>
            <Style x:Key="ShellMenuButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>

            <Style x:Key="TitleIconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Width" Value="28" />
                <Setter Property="Height" Value="28" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="0" />
            </Style>

            <Style x:Key="ZoomHudButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Width" Value="26" />
                <Setter Property="Height" Value="26" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
            </Style>

            <Style x:Key="FindHudButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Width" Value="28" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              x:Name="TitleBarArea"
              Background="{ThemeResource SidebarBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="CaptionButtonsColumn" Width="144" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2" Padding="10,0,0,0">
                <Button x:Name="SidebarToggleButton"
                        Style="{StaticResource TitleIconButtonStyle}"
                        Click="SidebarToggle_Click"
                        AutomationProperties.Name="Toggle sidebar"
                        ToolTipService.ToolTip="Toggle sidebar">
                    <ic:FluentIcon Icon="PanelLeft"
                                   IconVariant="Regular"
                                   IconSize="Size20"
                                   Foreground="{ThemeResource TextSecondaryBrush}" />
                </Button>
                <Button x:Name="BackButton"
                        Style="{StaticResource TitleIconButtonStyle}"
                        Click="Back_Click"
                        AutomationProperties.Name="Back"
                        ToolTipService.ToolTip="Back">
                    <!-- Disabled Back/Forward show no background (transparent, flush with the
                         title bar) — the arrow icon's own color is what signals disabled; see
                         UpdateNavigationButtons. -->
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
                    </Button.Resources>
                    <ic:FluentIcon x:Name="BackIcon"
                                   Icon="ArrowLeft"
                                   IconVariant="Regular"
                                   IconSize="Size20"
                                   Foreground="{ThemeResource TextSecondaryBrush}" />
                </Button>
                <Button x:Name="ForwardButton"
                        Style="{StaticResource TitleIconButtonStyle}"
                        Click="Forward_Click"
                        AutomationProperties.Name="Forward"
                        ToolTipService.ToolTip="Forward">
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
                    </Button.Resources>
                    <ic:FluentIcon x:Name="ForwardIcon"
                                   Icon="ArrowRight"
                                   IconVariant="Regular"
                                   IconSize="Size20"
                                   Foreground="{ThemeResource TextSecondaryBrush}" />
                </Button>
                <MenuBar Background="Transparent"
                         BorderThickness="0"
                         VerticalAlignment="Center">
                    <MenuBarItem Title="File">
                        <MenuFlyoutItem Text="New Chat"
                                        KeyboardAcceleratorTextOverride="Ctrl+N"
                                        Click="NewChat_Click" />
                        <MenuFlyoutItem Text="Open Folder..."
                                        KeyboardAcceleratorTextOverride="Ctrl+O"
                                        Click="OpenFolder_Click" />
                        <MenuFlyoutItem Text="Close"
                                        KeyboardAcceleratorTextOverride="Ctrl+W"
                                        Click="CloseWindow_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Settings..."
                                        KeyboardAcceleratorTextOverride="Ctrl+,"
                                        Click="SettingsMenu_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Exit"
                                        KeyboardAcceleratorTextOverride="Ctrl+Q"
                                        Click="Exit_Click" />
                    </MenuBarItem>
                    <MenuBarItem Title="Edit">
                        <MenuFlyoutItem Text="Undo"
                                        KeyboardAcceleratorTextOverride="Ctrl+Z"
                                        Click="Undo_Click" />
                        <MenuFlyoutItem Text="Redo"
                                        KeyboardAcceleratorTextOverride="Ctrl+Y"
                                        Click="Redo_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Cut"
                                        KeyboardAcceleratorTextOverride="Ctrl+X"
                                        Click="Cut_Click" />
                        <MenuFlyoutItem Text="Copy"
                                        KeyboardAcceleratorTextOverride="Ctrl+C"
                                        Click="Copy_Click" />
                        <MenuFlyoutItem Text="Paste"
                                        KeyboardAcceleratorTextOverride="Ctrl+V"
                                        Click="Paste_Click" />
                        <MenuFlyoutItem Text="Delete"
                                        Click="Delete_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Select All"
                                        KeyboardAcceleratorTextOverride="Ctrl+A"
                                        Click="SelectAll_Click" />
                    </MenuBarItem>
                    <MenuBarItem Title="View">
                        <MenuFlyoutItem Text="Toggle Sidebar"
                                        KeyboardAcceleratorTextOverride="Ctrl+B"
                                        Click="ToggleSidebarMenu_Click" />
                        <MenuFlyoutItem Text="Open Terminal"
                                        KeyboardAcceleratorTextOverride="Ctrl+`"
                                        Click="OpenTerminal_Click" />
                        <MenuFlyoutItem Text="Find"
                                        KeyboardAcceleratorTextOverride="Ctrl+F"
                                        Click="Find_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Back"
                                        KeyboardAcceleratorTextOverride="Ctrl+["
                                        Click="BackMenu_Click" />
                        <MenuFlyoutItem Text="Forward"
                                        KeyboardAcceleratorTextOverride="Ctrl+]"
                                        Click="ForwardMenu_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Zoom In"
                                        KeyboardAcceleratorTextOverride="Ctrl+Shift+="
                                        Click="ZoomIn_Click" />
                        <MenuFlyoutItem Text="Zoom Out"
                                        KeyboardAcceleratorTextOverride="Ctrl+-"
                                        Click="ZoomOut_Click" />
                        <MenuFlyoutItem Text="Actual Size"
                                        Click="ActualSize_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Toggle Full Screen"
                                        KeyboardAcceleratorTextOverride="F11"
                                        Click="ToggleFullScreen_Click" />
                    </MenuBarItem>
                    <MenuBarItem Title="Help">
                        <MenuFlyoutItem Text="About ConnectOnion"
                                        Click="AboutConnectOnion_Click" />
                    </MenuBarItem>
                </MenuBar>
            </StackPanel>

            <Grid x:Name="TitleBarDragRegion"
                  Grid.Column="1"
                  Background="Transparent" />
        </Grid>

        <Grid x:Name="MainContentArea"
              Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ShellSidebarColumn" Width="286" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <controls:ShellSidebar x:Name="ShellSidebar"
                                   Grid.Column="0" />

            <Frame Grid.Column="1"
                   x:Name="ContentFrame"
                   Background="{ThemeResource AppBackgroundBrush}" />

            <!-- Single hairline between sidebar and content — not a border around either
                 panel, so there's no double edge where the sidebar meets this line or the
                 window frame. -->
            <Rectangle Grid.Column="0"
                       Width="1"
                       HorizontalAlignment="Right"
                       Fill="{ThemeResource BorderDefaultBrush}" />

            <!-- Horizontal hairline separating the title bar from the content area, drawn only
                 over the content column so it meets the vertical divider above at the content's
                 top-left corner. The sidebar column has no line here, so the title bar reads as
                 seamlessly continuous with the sidebar below it (same color, no seam). -->
            <Rectangle Grid.Column="1"
                       Height="1"
                       VerticalAlignment="Top"
                       Fill="{ThemeResource BorderDefaultBrush}" />
        </Grid>

        <Grid x:Name="FloatingOverlayLayer"
              Grid.Row="0"
              Grid.RowSpan="2"
              Canvas.ZIndex="100">
            <Border x:Name="FindOverlayPanel"
                    Width="380"
                    MinHeight="36"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,18,152,0"
                    Padding="8,2,4,2"
                    CornerRadius="14"
                    Background="{ThemeResource SurfaceElevatedBrush}"
                    BorderBrush="{ThemeResource BorderDefaultBrush}"
                    BorderThickness="1"
                    IsHitTestVisible="True"
                    Visibility="Collapsed">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>
                <Grid ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ic:FluentIcon Grid.Column="0"
                                   Icon="Search"
                                   IconVariant="Regular"
                                   IconSize="Size16"
                                   Foreground="{ThemeResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="4,0,2,0" />

                    <TextBox x:Name="FindTextBox"
                             Grid.Column="1"
                             MinWidth="0"
                             BorderThickness="0"
                             Background="Transparent"
                             PlaceholderText="Search chat..."
                             TextChanged="FindTextBox_TextChanged"
                             KeyDown="FindTextBox_KeyDown" />

                    <TextBlock x:Name="FindCounterText"
                               Grid.Column="2"
                               Text="0 / 0 results"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextTertiaryBrush}" />

                    <Button x:Name="PreviousFindButton"
                            Grid.Column="3"
                            Style="{StaticResource FindHudButtonStyle}"
                            Click="PreviousFind_Click"
                            AutomationProperties.Name="Previous result"
                            ToolTipService.ToolTip="Previous result (Shift+Enter)">
                        <ic:FluentIcon Icon="ArrowUp"
                                       IconVariant="Regular"
                                       IconSize="Size16"
                                       Foreground="{ThemeResource TextSecondaryBrush}" />
                    </Button>

                    <Button x:Name="NextFindButton"
                            Grid.Column="4"
                            Style="{StaticResource FindHudButtonStyle}"
                            Click="NextFind_Click"
                            AutomationProperties.Name="Next result"
                            ToolTipService.ToolTip="Next result (Enter)">
                        <ic:FluentIcon Icon="ArrowDown"
                                       IconVariant="Regular"
                                       IconSize="Size16"
                                       Foreground="{ThemeResource TextSecondaryBrush}" />
                    </Button>

                    <Button Grid.Column="5"
                            Style="{StaticResource FindHudButtonStyle}"
                            Click="CloseFind_Click"
                            AutomationProperties.Name="Close find"
                            ToolTipService.ToolTip="Close find (Esc)">
                        <ic:FluentIcon Icon="Dismiss"
                                       IconVariant="Regular"
                                       IconSize="Size12"
                                       Foreground="{ThemeResource TextSecondaryBrush}" />
                    </Button>
                </Grid>
            </Border>

            <Border x:Name="ZoomPopupPanel"
                    Width="236"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Padding="14,6"
                    CornerRadius="18"
                    Background="{ThemeResource SurfaceElevatedBrush}"
                    BorderBrush="{ThemeResource BorderDefaultBrush}"
                    BorderThickness="1"
                    IsHitTestVisible="True"
                    Visibility="Collapsed">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="62" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="56" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="ZoomPercentText"
                               Grid.Column="0"
                               Text="100%"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <Rectangle Grid.Column="1"
                               Width="1"
                               Height="18"
                               Fill="{ThemeResource DividerBrush}"
                               Opacity="0.7"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="2"
                            Style="{StaticResource ZoomHudButtonStyle}"
                            Click="ActualSizeZoomOut_Click"
                            AutomationProperties.Name="Zoom out"
                            ToolTipService.ToolTip="Zoom out">
                        <TextBlock Text="-"
                                   FontSize="16"
                                   VerticalAlignment="Center" />
                    </Button>
                    <Button Grid.Column="3"
                            Style="{StaticResource ZoomHudButtonStyle}"
                            Click="ActualSizeZoomIn_Click"
                            AutomationProperties.Name="Zoom in"
                            ToolTipService.ToolTip="Zoom in">
                        <TextBlock Text="+"
                                   FontSize="16"
                                   VerticalAlignment="Center" />
                    </Button>
                    <Rectangle Grid.Column="4"
                               Width="1"
                               Height="18"
                               Fill="{ThemeResource DividerBrush}"
                               Opacity="0.7"
                               VerticalAlignment="Center" />
                    <Button x:Name="ResetZoomButton"
                            Grid.Column="5"
                            Style="{StaticResource DefaultButtonStyle}"
                            Background="Transparent"
                            BorderThickness="0"
                            IsEnabled="False"
                            Padding="10,0"
                            MinWidth="0"
                            MinHeight="26"
                            HorizontalAlignment="Stretch"
                            Foreground="{ThemeResource TextSecondaryBrush}"
                            Click="ResetZoom_Click">
                        <TextBlock Text="Reset"
                                   FontSize="12" />
                    </Button>
                </Grid>
            </Border>

            <!-- Window-wide "you dropped this in the wrong place" hint. Only the composer is a
                 real drop target, so a file dragged anywhere else in the window gets this
                 instead of a silent no-drop cursor. IsHitTestVisible=False so it never
                 intercepts the drag itself. See MainWindow.DragDrop.cs. -->
            <Border x:Name="DragHintPanel"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,60,0,0"
                    Padding="16,10"
                    CornerRadius="20"
                    Background="{ThemeResource SurfaceElevatedBrush}"
                    BorderBrush="{ThemeResource BrandPrimaryBrush}"
                    BorderThickness="1"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <ic:FluentIcon Icon="ArrowDown"
                                   IconVariant="Regular"
                                   IconSize="Size20"
                                   Foreground="{ThemeResource BrandPrimaryBrush}"
                                   VerticalAlignment="Center" />
                    <TextBlock Text="Drop files on the message box to attach"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Top-most, non-blocking overlay for in-app notification toasts. -->
        <controls:InAppNotificationHost x:Name="InAppNotifications" />
    </Grid>
</Window>

<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ConnectOnion.WinUIClient.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ConnectOnion.WinUIClient"
    xmlns:models="using:ConnectOnion.WinUIClient.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="ConnectOnion">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Background="{ThemeResource ShellBackgroundBrush}">
        <Grid.Resources>
            <Style x:Key="ShellMenuButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>

            <Style x:Key="ShellNavButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="Padding" Value="8,6" />
            </Style>

            <Style x:Key="ShellIconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Width" Value="26" />
                <Setter Property="Height" Value="26" />
                <Setter Property="Padding" Value="0" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              x:Name="TitleBarArea"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="0,0,0,1"
              Background="{ThemeResource ShellBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="144" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2" Padding="10,0,0,0">
                <Image Width="17" Height="17" Source="/Assets/icon.png" VerticalAlignment="Center" />
                <Button Style="{StaticResource ShellMenuButtonStyle}" Content="File" />
                <Button Style="{StaticResource ShellMenuButtonStyle}" Content="Edit" />
                <Button Style="{StaticResource ShellMenuButtonStyle}" Content="View" />
                <Button Style="{StaticResource ShellMenuButtonStyle}" Content="Help" />
            </StackPanel>

            <Grid x:Name="TitleBarDragRegion"
                  Grid.Column="1"
                  Background="Transparent" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="286" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0"
                  Background="{ThemeResource ShellSidebarBrush}"
                  Padding="14,18,10,16"
                  RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Button Grid.Row="0"
                        Style="{StaticResource ShellNavButtonStyle}"
                        Click="ChatHome_Click">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Image Width="32" Height="32" Source="/Assets/icon.png" />
                        <TextBlock Grid.Column="1"
                                   Text="ConnectOnion"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2"
                                   Text="desktop"
                                   FontSize="10"
                                   Foreground="{ThemeResource ShellMutedTextBrush}"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Button>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsRepeater ItemsSource="{Binding ShellAgents}">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,2">
                                    <Border CornerRadius="8"
                                            Background="{ThemeResource ShellRowBrush}"
                                            PointerEntered="AgentRow_PointerEntered"
                                            PointerExited="AgentRow_PointerExited">
                                        <Grid MinHeight="44" Padding="6,0" ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0"
                                                    Style="{StaticResource ShellIconButtonStyle}"
                                                    Click="ToggleAgent_Click"
                                                    Tag="{Binding Id}"
                                                    ToolTipService.ToolTip="Expand or collapse chats">
                                                <FontIcon Glyph="&#xE70D;"
                                                          FontSize="11"
                                                          Foreground="{ThemeResource ShellMutedTextBrush}"
                                                          RenderTransformOrigin="0.5,0.5">
                                                    <FontIcon.RenderTransform>
                                                        <RotateTransform Angle="{Binding ChevronAngle}" />
                                                    </FontIcon.RenderTransform>
                                                </FontIcon>
                                            </Button>
                                            <Border Grid.Column="1"
                                                    Width="26"
                                                    Height="26"
                                                    VerticalAlignment="Center"
                                                    CornerRadius="6"
                                                    Background="{ThemeResource TextFillColorPrimaryBrush}">
                                                <TextBlock Text="{Binding Initial}"
                                                           Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                           FontSize="11"
                                                           FontWeight="Bold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <Button Grid.Column="2"
                                                    Style="{StaticResource ShellNavButtonStyle}"
                                                    Click="Agent_Click"
                                                    Tag="{Binding Id}"
                                                    Padding="0"
                                                    MinHeight="0">
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                            </Button>
                                            <StackPanel Grid.Column="3"
                                                        Orientation="Horizontal"
                                                        Spacing="2"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SessionCount}"
                                                           FontSize="10"
                                                           Foreground="{ThemeResource ShellMutedTextBrush}"
                                                           VerticalAlignment="Center" />
                                                <StackPanel Orientation="Horizontal"
                                                            Spacing="2"
                                                            Visibility="{Binding AreActionsVisible, Converter={StaticResource BoolToVis}}">
                                                    <Button Style="{StaticResource ShellIconButtonStyle}"
                                                            Click="AddChat_Click"
                                                            Tag="{Binding Id}"
                                                            ToolTipService.ToolTip="New chat">
                                                        <FontIcon Glyph="&#xE710;" FontSize="13" Foreground="{ThemeResource ShellMutedTextBrush}" />
                                                    </Button>
                                                    <Button Style="{StaticResource ShellIconButtonStyle}"
                                                            Click="EditAgent_Click"
                                                            Tag="{Binding Id}"
                                                            ToolTipService.ToolTip="Edit agent">
                                                        <FontIcon Glyph="&#xE70F;" FontSize="13" Foreground="{ThemeResource ShellMutedTextBrush}" />
                                                    </Button>
                                                    <Button Style="{StaticResource ShellIconButtonStyle}"
                                                            Click="DeleteAgent_Click"
                                                            Tag="{Binding Id}"
                                                            ToolTipService.ToolTip="Delete agent">
                                                        <FontIcon Glyph="&#xE711;" FontSize="13" Foreground="{ThemeResource ShellMutedTextBrush}" />
                                                    </Button>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <ItemsRepeater ItemsSource="{Binding Sessions}"
                                                   Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="34,2,0,0"
                                                      PointerEntered="SessionRow_PointerEntered"
                                                      PointerExited="SessionRow_PointerExited">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0"
                                                            Style="{StaticResource ShellNavButtonStyle}"
                                                            Click="Session_Click"
                                                            Tag="{Binding Id}">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <FontIcon Glyph="&#xE8BD;"
                                                                      FontSize="14"
                                                                      Foreground="{ThemeResource ShellMutedTextBrush}" />
                                                            <TextBlock Text="{Binding Title}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       FontSize="13" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Grid.Column="1"
                                                            Margin="2,0,0,0"
                                                            Style="{StaticResource ShellIconButtonStyle}"
                                                            Click="DeleteSession_Click"
                                                            Tag="{Binding Id}"
                                                            VerticalAlignment="Center"
                                                            Visibility="{Binding AreActionsVisible, Converter={StaticResource BoolToVis}}"
                                                            ToolTipService.ToolTip="Delete chat">
                                                        <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="{ThemeResource ShellMutedTextBrush}" />
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Spacing="6">
                    <Button Style="{StaticResource ShellNavButtonStyle}" Click="AddAgent_Click">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <FontIcon Glyph="&#xE710;" FontSize="16" />
                            <TextBlock Text="Add Agent" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ShellNavButtonStyle}" Click="Settings_Click">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <FontIcon Glyph="&#xE713;" FontSize="16" />
                            <TextBlock Text="Settings" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Frame Grid.Column="1"
                   x:Name="ContentFrame"
                   Background="{ThemeResource ShellBackgroundBrush}" />
        </Grid>
    </Grid>
</Window>

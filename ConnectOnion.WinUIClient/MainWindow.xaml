<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ConnectOnion.WinUIClient.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ConnectOnion.WinUIClient.Controls"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="ConnectOnion">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Background="{ThemeResource ShellBackgroundBrush}" SizeChanged="RootGrid_SizeChanged">
        <Grid.Resources>
            <Style x:Key="ShellMenuButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>

            <Style x:Key="TitleIconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Width" Value="28" />
                <Setter Property="Height" Value="28" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="0" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              x:Name="TitleBarArea"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="0,0,0,1"
              Background="{ThemeResource ShellBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="144" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2" Padding="10,0,0,0">
                <Button x:Name="SidebarToggleButton"
                        Style="{StaticResource TitleIconButtonStyle}"
                        Click="SidebarToggle_Click"
                        AutomationProperties.Name="Toggle sidebar"
                        ToolTipService.ToolTip="Toggle sidebar">
                    <ic:FluentIcon Icon="PanelLeft"
                                   IconVariant="Regular"
                                   IconSize="Size20"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Button>
                <Button x:Name="BackButton"
                        Style="{StaticResource TitleIconButtonStyle}"
                        Click="Back_Click"
                        AutomationProperties.Name="Back"
                        ToolTipService.ToolTip="Back">
                    <ic:FluentIcon Icon="ArrowLeft"
                                   IconVariant="Regular"
                                   IconSize="Size20"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Button>
                <Button x:Name="ForwardButton"
                        Style="{StaticResource TitleIconButtonStyle}"
                        Click="Forward_Click"
                        AutomationProperties.Name="Forward"
                        ToolTipService.ToolTip="Forward">
                    <ic:FluentIcon Icon="ArrowRight"
                                   IconVariant="Regular"
                                   IconSize="Size20"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Button>
                <MenuBar Background="Transparent"
                         BorderThickness="0"
                         VerticalAlignment="Center">
                    <MenuBarItem Title="File">
                        <MenuFlyoutItem Text="New Window        Ctrl+Shift+N"
                                        Click="NewWindow_Click" />
                        <MenuFlyoutItem Text="New Chat          Ctrl+N"
                                        Click="NewChat_Click" />
                        <MenuFlyoutItem Text="Open Folder...    Ctrl+O"
                                        Click="OpenFolder_Click" />
                        <MenuFlyoutItem Text="Close             Ctrl+W"
                                        Click="CloseWindow_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Settings...       Ctrl+,"
                                        Click="SettingsMenu_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Exit              Ctrl+Q"
                                        Click="Exit_Click" />
                    </MenuBarItem>
                    <MenuBarItem Title="Edit" />
                    <MenuBarItem Title="View" />
                    <MenuBarItem Title="Help">
                        <MenuFlyoutItem Text="About ConnectOnion"
                                        Click="AboutConnectOnion_Click" />
                    </MenuBarItem>
                </MenuBar>
            </StackPanel>

            <Grid x:Name="TitleBarDragRegion"
                  Grid.Column="1"
                  Background="Transparent" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ShellSidebarColumn" Width="286" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <controls:ShellSidebar x:Name="ShellSidebar"
                                   Grid.Column="0" />

            <Frame Grid.Column="1"
                   x:Name="ContentFrame"
                   Background="{ThemeResource ShellBackgroundBrush}" />
        </Grid>
    </Grid>
</Window>

<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ConnectOnion.WinUIClient.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ConnectOnion.WinUIClient.Controls"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:tb="using:H.NotifyIcon"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="ConnectOnion">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" AutomationProperties.AutomationId="MainWindow"
          Background="{ThemeResource AppBackgroundBrush}" SizeChanged="RootGrid_SizeChanged">
        <Grid.Resources>
            <Style x:Key="ShellMenuButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>

            <Style x:Key="TitleIconButtonStyle" TargetType="Button" BasedOn="{StaticResource SmallIconButtonStyle}">
                <Setter Property="CornerRadius" Value="6" />
            </Style>

            <Style x:Key="ZoomHudButtonStyle" TargetType="Button" BasedOn="{StaticResource SmallIconButtonStyle}">
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Width" Value="26" />
                <Setter Property="Height" Value="26" />
                <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
            </Style>

            <Style x:Key="FindHudButtonStyle" TargetType="Button" BasedOn="{StaticResource SmallIconButtonStyle}">
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Width" Value="28" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <tb:TaskbarIcon
            x:Name="TrayIcon"
            ToolTipText="ConnectOnion"
            IconSource="ms-appx:///Assets/app-icon.ico"
            LeftClickCommand="{x:Bind OpenWindowCommand}"
            NoLeftClickDelay="True"
            ContextMenuMode="PopupMenu">
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout x:Name="TrayContextMenu"
                            AreOpenCloseAnimationsEnabled="False"
                            Opening="TrayContextMenu_Opening">
                    <MenuFlyoutItem
                        x:Uid="HistoryRecentChats"
                        x:Name="RecentChatsHeader"
                        Text="Recent chats"
                        IsEnabled="False" />
                    <MenuFlyoutSeparator x:Name="RecentChatsEndSeparator" />
                    <MenuFlyoutItem
                        x:Uid="HistoryNewChat"
                        Text="New Chat"
                        Command="{x:Bind NewChatFromTrayCommand}">
                        <MenuFlyoutItem.Icon>
                            <ic:FluentIcon Icon="Add"
                                           IconVariant="Regular"
                                           IconSize="Size16" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem
                        x:Uid="HistoryExit"
                        Text="Exit"
                        Command="{x:Bind ExitFromTrayCommand}" />
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>

        <Grid Grid.Row="0"
              x:Name="TitleBarArea"
              Background="{ThemeResource SidebarBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="CaptionButtonsColumn" Width="144" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2" Padding="10,0,0,0">
                <Button x:Uid="MainToggleSidebar" x:Name="SidebarToggleButton"
                        Style="{StaticResource TitleIconButtonStyle}"
                        Click="SidebarToggle_Click"
                        AutomationProperties.Name="Toggle sidebar"
                        ToolTipService.ToolTip="Toggle sidebar">
                    <ic:FluentIcon Icon="PanelLeft"
                                   IconVariant="Regular"
                                   IconSize="Size20"
                                   Foreground="{ThemeResource TextSecondaryBrush}" />
                </Button>
                <Button x:Uid="MainNavigateBack" x:Name="BackButton"
                        Style="{StaticResource TitleIconButtonStyle}"
                        Click="Back_Click"
                        AutomationProperties.Name="Back"
                        ToolTipService.ToolTip="Back">
                    <!-- Disabled Back/Forward show no background (transparent, flush with the
                         title bar) — the arrow icon's own color is what signals disabled; see
                         UpdateNavigationButtons. -->
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
                    </Button.Resources>
                    <ic:FluentIcon x:Name="BackIcon"
                                   Icon="ArrowLeft"
                                   IconVariant="Regular"
                                   IconSize="Size20"
                                   Foreground="{ThemeResource TextSecondaryBrush}" />
                </Button>
                <Button x:Uid="MainNavigateForward" x:Name="ForwardButton"
                        Style="{StaticResource TitleIconButtonStyle}"
                        Click="Forward_Click"
                        AutomationProperties.Name="Forward"
                        ToolTipService.ToolTip="Forward">
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
                    </Button.Resources>
                    <ic:FluentIcon x:Name="ForwardIcon"
                                   Icon="ArrowRight"
                                   IconVariant="Regular"
                                   IconSize="Size20"
                                   Foreground="{ThemeResource TextSecondaryBrush}" />
                </Button>
                <MenuBar Background="Transparent"
                         BorderThickness="0"
                         VerticalAlignment="Center">
            <MenuBarItem x:Uid="MenuFile" Title="File">
                        <MenuFlyoutItem x:Uid="MenuNewChat" x:Name="NewChatMenuItem" Text="New Chat"
                                        KeyboardAcceleratorTextOverride="Ctrl+N"
                                        Click="NewChat_Click" />
                        <MenuFlyoutItem x:Uid="MenuOpenFolder" x:Name="OpenFolderMenuItem" Text="Open Folder..."
                                        KeyboardAcceleratorTextOverride="Ctrl+O"
                                        Click="OpenFolder_Click" />
                        <MenuFlyoutItem x:Uid="MenuClose" x:Name="CloseWindowMenuItem" Text="Close"
                                        KeyboardAcceleratorTextOverride="Ctrl+W"
                                        Click="CloseWindow_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Uid="MenuSettings" x:Name="SettingsMenuItem" Text="Settings..."
                                        KeyboardAcceleratorTextOverride="Ctrl+,"
                                        Click="SettingsMenu_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Uid="MenuExit" x:Name="ExitMenuItem" Text="Exit"
                                        KeyboardAcceleratorTextOverride="Ctrl+Q"
                                        Click="Exit_Click" />
                    </MenuBarItem>
            <MenuBarItem x:Uid="MenuEdit" Title="Edit">
                        <MenuFlyoutItem x:Uid="MenuUndo" Text="Undo"
                                        KeyboardAcceleratorTextOverride="Ctrl+Z"
                                        Click="Undo_Click" />
                        <MenuFlyoutItem x:Uid="MenuRedo" Text="Redo"
                                        KeyboardAcceleratorTextOverride="Ctrl+Y"
                                        Click="Redo_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Uid="MenuCut" Text="Cut"
                                        KeyboardAcceleratorTextOverride="Ctrl+X"
                                        Click="Cut_Click" />
                        <MenuFlyoutItem x:Uid="MenuCopy" Text="Copy"
                                        KeyboardAcceleratorTextOverride="Ctrl+C"
                                        Click="Copy_Click" />
                        <MenuFlyoutItem x:Uid="MenuPaste" Text="Paste"
                                        KeyboardAcceleratorTextOverride="Ctrl+V"
                                        Click="Paste_Click" />
                        <MenuFlyoutItem x:Uid="MenuDelete" Text="Delete"
                                        Click="Delete_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Uid="MenuSelectAll" Text="Select All"
                                        KeyboardAcceleratorTextOverride="Ctrl+A"
                                        Click="SelectAll_Click" />
                    </MenuBarItem>
            <MenuBarItem x:Uid="MenuView" Title="View">
                        <MenuFlyoutItem x:Uid="MenuToggleSidebar" x:Name="ToggleSidebarMenuItem" Text="Toggle Sidebar"
                                        KeyboardAcceleratorTextOverride="Ctrl+B"
                                        Click="ToggleSidebarMenu_Click" />
                        <MenuFlyoutItem x:Uid="MenuOpenTerminal" x:Name="OpenTerminalMenuItem" Text="Open Terminal"
                                        KeyboardAcceleratorTextOverride="Ctrl+`"
                                        Click="OpenTerminal_Click" />
                        <MenuFlyoutItem x:Uid="MenuFind" x:Name="FindMenuItem" Text="Find"
                                        KeyboardAcceleratorTextOverride="Ctrl+F"
                                        Click="Find_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Uid="MenuBack" x:Name="BackMenuItem" Text="Back"
                                        KeyboardAcceleratorTextOverride="Ctrl+["
                                        Click="BackMenu_Click" />
                        <MenuFlyoutItem x:Uid="MenuForward" x:Name="ForwardMenuItem" Text="Forward"
                                        KeyboardAcceleratorTextOverride="Ctrl+]"
                                        Click="ForwardMenu_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Uid="MenuZoomIn" x:Name="ZoomInMenuItem" Text="Zoom In"
                                        KeyboardAcceleratorTextOverride="Ctrl+Shift+="
                                        Click="ZoomIn_Click" />
                        <MenuFlyoutItem x:Uid="MenuZoomOut" x:Name="ZoomOutMenuItem" Text="Zoom Out"
                                        KeyboardAcceleratorTextOverride="Ctrl+-"
                                        Click="ZoomOut_Click" />
                        <MenuFlyoutItem x:Uid="MenuActualSize" Text="Actual Size"
                                        Click="ActualSize_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Uid="MenuFullScreen" x:Name="FullScreenMenuItem" Text="Toggle Full Screen"
                                        KeyboardAcceleratorTextOverride="F11"
                                        Click="ToggleFullScreen_Click" />
                    </MenuBarItem>
            <MenuBarItem x:Uid="MenuHelp" x:Name="HelpMenuBarItem" Title="Help" AutomationProperties.AutomationId="HelpMenuButton">
                        <MenuFlyoutItem x:Uid="MenuKeyboardShortcuts" x:Name="KeyboardShortcutsMenuItem" Text="Keyboard shortcuts" AutomationProperties.AutomationId="KeyboardShortcutsMenuItem"
                                        KeyboardAcceleratorTextOverride="Ctrl+Shift+/"
                                        Click="KeyboardShortcuts_Click" />
                        <MenuFlyoutItem x:Uid="MenuDocs" Text="ConnectOnion Docs" AutomationProperties.AutomationId="ConnectOnionDocsMenuItem"
                                        Click="ConnectOnionDocs_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Uid="MenuAbout" Text="About ConnectOnion" AutomationProperties.AutomationId="AboutMenuItem"
                                        Click="AboutConnectOnion_Click" />
                    </MenuBarItem>
                </MenuBar>
            </StackPanel>

            <Grid x:Name="TitleBarDragRegion"
                  Grid.Column="1"
                  Background="Transparent" />
        </Grid>

        <Grid x:Name="MainContentArea"
              Grid.Row="1"
              Background="{ThemeResource SidebarBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ShellSidebarColumn" Width="264" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <controls:ShellSidebar x:Name="ShellSidebar"
                                   Grid.Column="0"
                                   Canvas.ZIndex="10" />

            <!-- Both hairlines — title bar → content, and sidebar → content — are one continuous
                 stroke drawn by this Border, so they meet in a rounded corner instead of a square
                 joint. It has to be a Border rather than two Rectangles: a rounded corner needs a
                 rounded *clip* on the page underneath, and every page paints its own opaque
                 background (ChatPage's differs from the others), which would otherwise square the
                 curve straight back off. The wedge outside the arc falls through to this Grid's
                 background, matched to the sidebar and title bar so the curve reads as the content
                 panel's corner rather than a gap. Only the top-left is rounded; the other three
                 corners are the window frame. -->
            <Border Grid.Column="1"
                    CornerRadius="12,0,0,0"
                    BorderThickness="1,1,0,0"
                    BorderBrush="{ThemeResource BorderDefaultBrush}">
                <Frame x:Name="ContentFrame"
                       Background="{ThemeResource AppBackgroundBrush}" />
            </Border>
        </Grid>

        <Grid x:Name="FloatingOverlayLayer"
              Grid.Row="0"
              Grid.RowSpan="2"
              Canvas.ZIndex="100">
            <!-- Add Agent can also be opened from Settings → Agents, so it must sit above the
                 settings modal and return focus to that page when it closes. -->
            <controls:AddAgentForm x:Name="AddAgentOverlay" Canvas.ZIndex="1004" />
            <controls:SettingsOverlay x:Name="SettingsOverlay" Canvas.ZIndex="1001" AutomationProperties.AutomationId="SettingsOverlay" />
            <controls:KeyboardShortcutsDialog x:Name="KeyboardShortcutsDialog" Canvas.ZIndex="1002" AutomationProperties.AutomationId="KeyboardShortcutsOverlay" />
            <controls:AboutOverlay x:Name="AboutOverlay" Canvas.ZIndex="1003" AutomationProperties.AutomationId="AboutOverlay" />
            <controls:SessionSearchOverlay x:Name="SessionSearchOverlay" Canvas.ZIndex="1005" />
            <Border x:Name="FindOverlayPanel"
                    Width="380"
                    MinHeight="36"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,18,152,0"
                    Padding="8,2,4,2"
                    CornerRadius="14"
                    Background="{ThemeResource SurfaceElevatedBrush}"
                    BorderBrush="{ThemeResource BorderDefaultBrush}"
                    BorderThickness="1"
                    IsHitTestVisible="True"
                    Visibility="Collapsed">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>
                <Grid ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ic:FluentIcon Grid.Column="0"
                                   Icon="Search"
                                   IconVariant="Regular"
                                   IconSize="Size16"
                                   Foreground="{ThemeResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="4,0,2,0" />

                    <TextBox x:Name="FindTextBox"
                             Grid.Column="1"
                             MinWidth="0"
                             BorderThickness="0"
                             Background="Transparent"
                             x:Uid="FindSearch" PlaceholderText="Search chat..."
                             TextChanged="FindTextBox_TextChanged"
                             KeyDown="FindTextBox_KeyDown" />

                    <TextBlock x:Name="FindCounterText"
                               Grid.Column="2"
                               x:Uid="FindCounter"
                               Text="0 / 0 results"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextTertiaryBrush}" />

                    <Button x:Uid="MainFindPrevious" x:Name="PreviousFindButton"
                            Grid.Column="3"
                            Style="{StaticResource FindHudButtonStyle}"
                            Click="PreviousFind_Click"
                            AutomationProperties.Name="Previous result"
                            ToolTipService.ToolTip="Previous result (Shift+Enter)">
                        <ic:FluentIcon Icon="ArrowUp"
                                       IconVariant="Regular"
                                       IconSize="Size16"
                                       Foreground="{ThemeResource TextSecondaryBrush}" />
                    </Button>

                    <Button x:Uid="MainFindNext" x:Name="NextFindButton"
                            Grid.Column="4"
                            Style="{StaticResource FindHudButtonStyle}"
                            Click="NextFind_Click"
                            AutomationProperties.Name="Next result"
                            ToolTipService.ToolTip="Next result (Enter)">
                        <ic:FluentIcon Icon="ArrowDown"
                                       IconVariant="Regular"
                                       IconSize="Size16"
                                       Foreground="{ThemeResource TextSecondaryBrush}" />
                    </Button>

                    <Button x:Uid="MainFindClose" Grid.Column="5"
                            Style="{StaticResource FindHudButtonStyle}"
                            Click="CloseFind_Click"
                            AutomationProperties.Name="Close find"
                            ToolTipService.ToolTip="Close find (Esc)">
                        <ic:FluentIcon Icon="Dismiss"
                                       IconVariant="Regular"
                                       IconSize="Size12"
                                       Foreground="{ThemeResource TextSecondaryBrush}" />
                    </Button>
                </Grid>
            </Border>

            <Border x:Name="ZoomPopupPanel"
                    Width="236"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Padding="14,6"
                    CornerRadius="18"
                    Background="{ThemeResource SurfaceElevatedBrush}"
                    BorderBrush="{ThemeResource BorderDefaultBrush}"
                    BorderThickness="1"
                    IsHitTestVisible="True"
                    Visibility="Collapsed">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="62" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="56" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="ZoomPercentText"
                               Grid.Column="0"
                               Text="100%"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <Rectangle Grid.Column="1"
                               Width="1"
                               Height="18"
                               Fill="{ThemeResource DividerBrush}"
                               Opacity="0.7"
                               VerticalAlignment="Center" />
                    <Button x:Uid="MainZoomOut" Grid.Column="2"
                            Style="{StaticResource ZoomHudButtonStyle}"
                            Click="ActualSizeZoomOut_Click"
                            AutomationProperties.Name="Zoom out"
                            ToolTipService.ToolTip="Zoom out">
                        <TextBlock Text="-"
                                   FontSize="16"
                                   VerticalAlignment="Center" />
                    </Button>
                    <Button x:Uid="MainZoomIn" Grid.Column="3"
                            Style="{StaticResource ZoomHudButtonStyle}"
                            Click="ActualSizeZoomIn_Click"
                            AutomationProperties.Name="Zoom in"
                            ToolTipService.ToolTip="Zoom in">
                        <TextBlock Text="+"
                                   FontSize="16"
                                   VerticalAlignment="Center" />
                    </Button>
                    <Rectangle Grid.Column="4"
                               Width="1"
                               Height="18"
                               Fill="{ThemeResource DividerBrush}"
                               Opacity="0.7"
                               VerticalAlignment="Center" />
                    <Button x:Name="ResetZoomButton"
                            Grid.Column="5"
                            Style="{StaticResource DefaultButtonStyle}"
                            Background="Transparent"
                            BorderThickness="0"
                            IsEnabled="False"
                            Padding="10,0"
                            MinWidth="0"
                            MinHeight="26"
                            HorizontalAlignment="Stretch"
                            Foreground="{ThemeResource TextSecondaryBrush}"
                            Click="ResetZoom_Click">
                        <TextBlock x:Uid="ZoomReset" Text="Reset"
                                   FontSize="12" />
                    </Button>
                </Grid>
            </Border>

            <!-- Window-wide "you dropped this in the wrong place" hint. Only the composer is a
                 real drop target, so a file dragged anywhere else in the window gets this
                 instead of a silent no-drop cursor. IsHitTestVisible=False so it never
                 intercepts the drag itself. See MainWindow.DragDrop.cs. -->
            <Border x:Name="DragHintPanel"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,60,0,0"
                    Padding="16,10"
                    CornerRadius="20"
                    Background="{ThemeResource SurfaceElevatedBrush}"
                    BorderBrush="{ThemeResource BrandPrimaryBrush}"
                    BorderThickness="1"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <ic:FluentIcon Icon="ArrowDown"
                                   IconVariant="Regular"
                                   IconSize="Size20"
                                   Foreground="{ThemeResource BrandPrimaryBrush}"
                                   VerticalAlignment="Center" />
                    <TextBlock x:Uid="DropHint" Text="Drop files on the message box to attach"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Top-most, non-blocking overlay for in-app notification toasts. Must span both rows
             (like SettingsOverlay/FindOverlayPanel) — otherwise it lands in the 36px title-bar
             row and its top-anchored cards are laid out below their slot and never show. -->
        <controls:InAppNotificationHost x:Name="InAppNotifications"
                                        Grid.Row="0" Grid.RowSpan="2" Canvas.ZIndex="1000" />
    </Grid>
</Window>

<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ConnectOnion.WinUIClient.Controls.AddAgentForm"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="AddAgentIconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </UserControl.Resources>

    <Border Padding="12"
            CornerRadius="14"
            Background="{ThemeResource SurfaceElevatedBrush}"
            BorderBrush="{ThemeResource BorderDefaultBrush}"
            BorderThickness="1">
        <StackPanel Spacing="8">
            <Grid>
                <TextBlock Text="{Binding FormTitle, ElementName=Root}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <Button Style="{StaticResource AddAgentIconButtonStyle}"
                        HorizontalAlignment="Right"
                        Click="Close_Click"
                        ToolTipService.ToolTip="Close add agent form">
                    <ic:FluentIcon Icon="Dismiss"
                                   IconVariant="Regular"
                                   IconSize="Size16"
                                   Foreground="{ThemeResource TextSecondaryBrush}" />
                </Button>
            </Grid>

            <TextBox x:Name="AddressBox"
                     PlaceholderText="0x address (optional)"
                     TextChanged="AddAgentField_TextChanged"
                     MinHeight="38" />
            <TextBox x:Name="DirectUrlBox"
                     PlaceholderText="Optional direct URL"
                     TextChanged="AddAgentField_TextChanged"
                     MinHeight="38" />

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        x:Name="TestButton"
                        Content="Test connection"
                        Click="TestConnection_Click"
                        HorizontalAlignment="Stretch" />
                <Button Grid.Column="1"
                        x:Name="SubmitButton"
                        Content="{Binding SubmitLabel, ElementName=Root}"
                        Style="{StaticResource AccentButtonStyle}"
                        IsEnabled="False"
                        Click="Submit_Click" />
                <ProgressRing Grid.Column="2"
                              x:Name="TestRing"
                              Width="18"
                              Height="18"
                              IsActive="False"
                              VerticalAlignment="Center"
                              Visibility="Collapsed" />
            </Grid>

            <TextBlock x:Name="StatusText"
                       FontSize="11"
                       Foreground="{ThemeResource TextSecondaryBrush}"
                       TextWrapping="WrapWholeWords"
                       Visibility="Collapsed" />
        </StackPanel>
    </Border>
</UserControl>

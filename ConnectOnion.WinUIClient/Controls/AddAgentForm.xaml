<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ConnectOnion.WinUIClient.Controls.AddAgentForm"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border Padding="12"
            CornerRadius="14"
            Background="{ThemeResource SurfaceElevatedBrush}"
            BorderBrush="{ThemeResource BorderDefaultBrush}"
            BorderThickness="1">
        <StackPanel Spacing="10">
            <!-- Title bar -->
            <Grid>
                <TextBlock Text="{Binding FormTitle, ElementName=Root}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <Button Style="{StaticResource SmallIconButtonStyle}"
                        HorizontalAlignment="Right"
                        Width="26"
                        Height="26"
                        Click="Close_Click"
                        ToolTipService.ToolTip="Close">
                    <ic:FluentIcon Icon="Dismiss"
                                   IconVariant="Regular"
                                   IconSize="Size16"
                                   Foreground="{ThemeResource TextSecondaryBrush}" />
                </Button>
            </Grid>

            <!-- Single input that accepts address or Direct URL -->
            <StackPanel Spacing="4">
                <TextBlock Text="Address or Direct URL"
                           FontSize="12"
                           Foreground="{ThemeResource TextSecondaryBrush}" />
                <TextBox x:Name="InputBox"
                         AutomationProperties.AutomationId="AgentAddressInput"
                         PlaceholderText="e.g. 0x... or wss://..."
                         TextChanged="InputBox_TextChanged"
                         KeyDown="InputBox_KeyDown"
                         FontSize="14"
                         MinHeight="36" />
            </StackPanel>

            <!-- Action buttons -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        x:Name="TestButton"
                        Content="Test connection"
                        Click="TestConnection_Click"
                        FontSize="13"
                        Padding="12,6"
                        MinHeight="34"
                        HorizontalAlignment="Stretch" />
                <Button Grid.Column="1"
                        x:Name="SubmitButton"
                        AutomationProperties.AutomationId="SubmitAgentButton"
                        Content="{Binding SubmitLabel, ElementName=Root}"
                        Style="{StaticResource AccentButtonStyle}"
                        IsEnabled="False"
                        Click="Submit_Click"
                        FontSize="13"
                        Padding="14,6"
                        MinHeight="34" />
                <ProgressRing Grid.Column="2"
                              x:Name="BusyRing"
                              Width="18"
                              Height="18"
                              IsActive="False"
                              Visibility="Collapsed"
                              VerticalAlignment="Center" />
            </Grid>

            <!-- Status / error text -->
            <TextBlock x:Name="StatusText"
                       FontSize="11"
                       Foreground="{ThemeResource TextSecondaryBrush}"
                       TextWrapping="WrapWholeWords"
                       Visibility="Collapsed" />
        </StackPanel>
    </Border>
</UserControl>

<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ConnectOnion.WinUIClient.Controls.ShellSidebar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ConnectOnion.WinUIClient.Controls"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid AutomationProperties.AutomationId="ShellSidebar"
          Background="{ThemeResource SidebarBackgroundBrush}"
          Padding="12,8,10,10"
          RowSpacing="4">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <!-- Near-opaque, not glass: this is a plain brush with no blur behind it, so any
                     alpha low enough to read as glass also reads the sidebar's own text straight
                     through the menu (Exit landed on top of Add Agent). Acrylic would be the way
                     to get real translucency here. -->
                    <ResourceDictionary x:Key="Light">
                        <SolidColorBrush x:Key="AccountMenuGlassBrush" Color="#F5F2F2F2" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Dark">
                        <SolidColorBrush x:Key="AccountMenuGlassBrush" Color="#F51C1B20" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="HighContrast">
                        <SolidColorBrush x:Key="AccountMenuGlassBrush"
                                     Color="{ThemeResource SystemColorWindowColor}" />
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
                <Style x:Key="ShellNavButtonStyle"
                   TargetType="Button"
                   BasedOn="{StaticResource TransparentButtonStyle}">
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="Padding" Value="0" />
                </Style>
                <Style x:Key="SidebarCaptionStyle" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="11" />
                    <Setter Property="Foreground" Value="{ThemeResource TextTertiaryBrush}" />
                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                </Style>
                <Style x:Key="AccountFlyoutRowStyle"
                   TargetType="Button"
                   BasedOn="{StaticResource SidebarNavButtonStyle}">
                    <Setter Property="MinHeight" Value="42" />
                    <Setter Property="Padding" Value="14,0" />
                    <Setter Property="CornerRadius" Value="6" />
                </Style>
            </ResourceDictionary>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Lightweight workspace header. It remains part of the window surface rather than
             becoming a separate branded card. -->
        <Button Grid.Row="0"
                Style="{StaticResource SidebarNavButtonStyle}"
                MinHeight="52"
                Padding="4,0"
                Click="ChatHome_Click"
                AutomationProperties.Name="ConnectOnion home">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Width="28"
                       Height="28"
                       Source="/Assets/icon.png"
                       VerticalAlignment="Center" />
                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="1">
                    <TextBlock Text="ConnectOnion"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="Agent workspace"
                               Style="{StaticResource SidebarCaptionStyle}" />
                </StackPanel>
            </Grid>
        </Button>

        <!-- A compact desktop command, deliberately quieter than a primary CTA. -->
        <Button x:Name="NewChatButton"
                Grid.Row="1"
                MinHeight="40"
                Margin="0,4,0,8"
                Style="{StaticResource SidebarNewChatButtonStyle}"
                Click="NewChatButton_Click"
                AutomationProperties.AutomationId="NewChatButton"
                AutomationProperties.Name="{Binding NewChatTargetText}"
                ToolTipService.ToolTip="{Binding NewChatTargetText}">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ic:FluentIcon Icon="Add"
                               IconVariant="Regular"
                               IconSize="Size16"
                               VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="New Chat"
                           FontSize="13"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="2"
                           Text="Ctrl+N"
                           FontSize="11"
                           Opacity="0.62"
                           VerticalAlignment="Center" />
            </Grid>
        </Button>

        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="2">

                <!-- Pinned conversations remain a fast cross-agent jump list. -->
                <StackPanel Spacing="2"
                            Visibility="{Binding HasPinnedSessions, Converter={StaticResource BoolToVis}}">
                    <Button Style="{StaticResource SidebarNavButtonStyle}"
                            Click="TogglePinned_Click"
                            MinHeight="32"
                            Padding="6,0"
                            Margin="0,4,0,2"
                            ToolTipService.ToolTip="Expand or collapse pinned chats"
                            AutomationProperties.Name="Expand or collapse pinned chats">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ic:FluentIcon Icon="ChevronDown"
                                           IconVariant="Regular"
                                           IconSize="Size16"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextTertiaryBrush}"
                                           RenderTransformOrigin="0.5,0.5">
                                <ic:FluentIcon.RenderTransform>
                                    <RotateTransform Angle="{Binding PinnedChevronAngle}" />
                                </ic:FluentIcon.RenderTransform>
                            </ic:FluentIcon>
                            <TextBlock Grid.Column="1"
                                       Text="Pinned"
                                       Style="{StaticResource SidebarSectionHeaderStyle}" />
                        </Grid>
                    </Button>

                    <ItemsRepeater ItemsSource="{Binding PinnedSessions}"
                                   Visibility="{Binding IsPinnedExpanded, Converter={StaticResource BoolToVis}}">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="56"
                                      Margin="0,1"
                                      Padding="10,4,4,4"
                                      PointerEntered="Row_PointerEntered"
                                      PointerExited="Row_PointerExited"
                                      GotFocus="Row_GotFocus"
                                      LostFocus="Row_LostFocus">
                                    <Grid.Resources>
                                        <ResourceDictionary>
                                            <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
                                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
                                            <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                                            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                                            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                                        </ResourceDictionary>
                                    </Grid.Resources>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.ColumnSpan="2"
                                            CornerRadius="8"
                                            Background="{Binding IsSelected, Converter={StaticResource RowStateToBackground}}"
                                            Visibility="{Binding ShowRowBackground, Converter={StaticResource BoolToVis}}" />
                                    <Border Grid.ColumnSpan="2"
                                            Width="3"
                                            Height="24"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            CornerRadius="1.5"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}" />

                                    <Button Grid.Column="0"
                                            Style="{StaticResource ShellNavButtonStyle}"
                                            Click="PinnedSession_Click"
                                            Tag="{Binding Id}"
                                            AutomationProperties.AutomationId="PinnedSessionButton"
                                            AutomationProperties.Name="{Binding AccessibilityName}"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Center"
                                            ToolTipService.ToolTip="{Binding Title}">
                                        <StackPanel Margin="10,0,8,0" Spacing="2">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="13"
                                                       FontWeight="{Binding IsSelected, Converter={StaticResource BoolToFontWeight}}"
                                                       Foreground="{ThemeResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Preview}"
                                                       Style="{StaticResource SidebarCaptionStyle}" />
                                        </StackPanel>
                                    </Button>

                                    <Grid Grid.Column="1"
                                          Width="64"
                                          VerticalAlignment="Stretch">
                                        <TextBlock Text="{Binding RelativeTime}"
                                                   FontSize="10"
                                                   Foreground="{ThemeResource TextTertiaryBrush}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,4,0"
                                                   TextWrapping="NoWrap"
                                                   Visibility="{Binding AreActionsVisible, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                                        <Button Style="{StaticResource SidebarActionButtonStyle}"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding AreActionsVisible, Converter={StaticResource BoolToVis}}"
                                                AutomationProperties.Name="More chat actions"
                                                ToolTipService.ToolTip="More actions">
                                            <ic:FluentIcon Icon="MoreHorizontal"
                                                           IconVariant="Regular"
                                                           IconSize="Size16"
                                                           Foreground="{ThemeResource TextSecondaryBrush}" />
                                            <Button.Flyout>
                                                <MenuFlyout Placement="Bottom">
                                                    <MenuFlyoutItem Text="{Binding PinToolTip}"
                                                                    Click="TogglePinSession_Click"
                                                                    Tag="{Binding Id}" />
                                                    <MenuFlyoutSeparator />
                                                    <MenuFlyoutItem Text="Delete chat"
                                                                    Click="DeleteSession_Click"
                                                                    Tag="{Binding Id}"
                                                                    Foreground="{ThemeResource DangerBrush}" />
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>

                <TextBlock Text="Agents"
                           Style="{StaticResource SidebarSectionHeaderStyle}"
                           Margin="10,16,0,6" />

                <ItemsRepeater ItemsSource="{Binding ShellAgents}"
                               AutomationProperties.AutomationId="AgentList">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,1">
                                <!-- The parent Agent row is intentionally lighter than a selected
                                     conversation: no accent rail, only a neutral hover/active wash. -->
                                <Border CornerRadius="8"
                                        Background="Transparent"
                                        PointerEntered="Row_PointerEntered"
                                        PointerExited="Row_PointerExited"
                                        GotFocus="Row_GotFocus"
                                        LostFocus="Row_LostFocus">
                                    <Border.Resources>
                                        <ResourceDictionary>
                                            <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
                                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
                                            <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                                            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                                            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                                        </ResourceDictionary>
                                    </Border.Resources>
                                    <Grid MinHeight="46" Padding="2,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.ColumnSpan="5"
                                                CornerRadius="8"
                                                Background="{ThemeResource SidebarItemHoverBrush}"
                                                Visibility="{Binding ShowRowBackground, Converter={StaticResource BoolToVis}}" />

                                        <Button Grid.Column="0"
                                                Style="{StaticResource SmallIconButtonStyle}"
                                                Width="24"
                                                Height="24"
                                                Click="ToggleAgent_Click"
                                                Tag="{Binding Id}"
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="Expand or collapse chats"
                                                ToolTipService.ToolTip="Expand or collapse chats">
                                            <ic:FluentIcon Icon="ChevronDown"
                                                           IconVariant="Regular"
                                                           IconSize="Size16"
                                                           Foreground="{ThemeResource TextTertiaryBrush}"
                                                           RenderTransformOrigin="0.5,0.5">
                                                <ic:FluentIcon.RenderTransform>
                                                    <RotateTransform Angle="{Binding ChevronAngle}" />
                                                </ic:FluentIcon.RenderTransform>
                                            </ic:FluentIcon>
                                        </Button>

                                        <Button Grid.Column="1"
                                                Style="{StaticResource ShellNavButtonStyle}"
                                                Click="Agent_Click"
                                                Tag="{Binding Id}"
                                                AutomationProperties.AutomationId="AgentAvatarButton"
                                                AutomationProperties.Name="{Binding OpenAccessibilityName}"
                                                ToolTipService.ToolTip="{Binding DisplayName}">
                                            <local:AgentAvatar Size="28"
                                                               CornerRadius="14"
                                                               FontSize="10"
                                                               Margin="4,0,10,0"
                                                               Initial="{Binding Initial}"
                                                               PaletteIndex="{Binding AvatarPaletteIndex}"
                                                               ImagePath="{Binding IconPath}"
                                                               IsHitTestVisible="False" />
                                        </Button>

                                        <Button Grid.Column="2"
                                                Style="{StaticResource ShellNavButtonStyle}"
                                                Click="Agent_Click"
                                                Tag="{Binding Id}"
                                                AutomationProperties.AutomationId="AgentButton"
                                                HorizontalContentAlignment="Left"
                                                ToolTipService.ToolTip="{Binding Name}">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontSize="13"
                                                       FontWeight="{Binding IsSelected, Converter={StaticResource BoolToFontWeight}}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{ThemeResource TextPrimaryBrush}" />
                                        </Button>

                                        <Grid Grid.Column="3"
                                              Width="9"
                                              Height="9"
                                              Margin="6,0,5,0"
                                              VerticalAlignment="Center"
                                              ToolTipService.ToolTip="{Binding PresenceLabel}"
                                              AutomationProperties.Name="{Binding PresenceLabel}">
                                            <Ellipse Fill="{ThemeResource SuccessBrush}"
                                                     Visibility="{Binding IsOnline, Converter={StaticResource BoolToVis}}" />
                                            <Ellipse Fill="{ThemeResource StatusRunningBrush}"
                                                     Visibility="{Binding IsChecking, Converter={StaticResource BoolToVis}}"
                                                     Loaded="PresenceCheckingDot_Loaded" />
                                            <Ellipse Stroke="{ThemeResource TextTertiaryBrush}"
                                                     StrokeThickness="1.5"
                                                     Visibility="{Binding IsOfflineIconVisible, Converter={StaticResource BoolToVis}}" />
                                        </Grid>

                                        <StackPanel Grid.Column="4"
                                                    Orientation="Horizontal"
                                                    Spacing="2"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding AreActionsVisible, Converter={StaticResource BoolToVis}}">
                                            <Button Style="{StaticResource SidebarActionButtonStyle}"
                                                    Click="AddChat_Click"
                                                    Tag="{Binding Id}"
                                                    AutomationProperties.Name="New chat"
                                                    ToolTipService.ToolTip="New chat">
                                                <ic:FluentIcon Icon="Add"
                                                               IconVariant="Regular"
                                                               IconSize="Size16"
                                                               Foreground="{ThemeResource TextSecondaryBrush}" />
                                            </Button>
                                            <Button Style="{StaticResource SidebarActionButtonStyle}"
                                                    AutomationProperties.Name="More agent actions"
                                                    ToolTipService.ToolTip="More actions">
                                                <ic:FluentIcon Icon="MoreHorizontal"
                                                               IconVariant="Regular"
                                                               IconSize="Size16"
                                                               Foreground="{ThemeResource TextSecondaryBrush}" />
                                                <Button.Flyout>
                                                    <MenuFlyout Placement="Bottom">
                                                        <MenuFlyoutItem Text="New chat"
                                                                        Click="AddChat_Click"
                                                                        Tag="{Binding Id}" />
                                                        <MenuFlyoutItem Text="Agent details"
                                                                        Click="Agent_Click"
                                                                        Tag="{Binding Id}" />
                                                        <MenuFlyoutItem Text="Change icon"
                                                                        Click="ChangeAgentIcon_Click"
                                                                        Tag="{Binding Id}" />
                                                        <MenuFlyoutItem Text="Remove custom icon"
                                                                        Click="RemoveAgentIcon_Click"
                                                                        Tag="{Binding Id}" />
                                                        <MenuFlyoutSeparator />
                                                        <MenuFlyoutItem Text="Delete agent"
                                                                        Click="DeleteAgent_Click"
                                                                        Tag="{Binding Id}"
                                                                        Foreground="{ThemeResource DangerBrush}" />
                                                    </MenuFlyout>
                                                </Button.Flyout>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Conversations remain children of their owning Agent, but are
                                     now grouped by time so the hierarchy scans like a desktop log. -->
                                <ItemsRepeater ItemsSource="{Binding SessionGroups}"
                                               Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Label}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Foreground="{ThemeResource TextTertiaryBrush}"
                                                           Margin="42,8,8,3" />
                                                <ItemsRepeater ItemsSource="{Binding Sessions}">
                                                    <ItemsRepeater.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid MinHeight="54"
                                                                  Margin="34,1,0,0"
                                                                  Padding="10,4,4,4"
                                                                  PointerEntered="Row_PointerEntered"
                                                                  PointerExited="Row_PointerExited"
                                                                  GotFocus="Row_GotFocus"
                                                                  LostFocus="Row_LostFocus">
                                                                <Grid.Resources>
                                                                    <ResourceDictionary>
                                                                        <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                                                                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
                                                                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
                                                                        <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                                                                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                                                                        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                                                                    </ResourceDictionary>
                                                                </Grid.Resources>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>

                                                                <Border Grid.ColumnSpan="2"
                                                                        CornerRadius="8"
                                                                        Background="{Binding IsSelected, Converter={StaticResource RowStateToBackground}}"
                                                                        Visibility="{Binding ShowRowBackground, Converter={StaticResource BoolToVis}}" />
                                                                <Border Grid.ColumnSpan="2"
                                                                        Width="3"
                                                                        Height="24"
                                                                        HorizontalAlignment="Left"
                                                                        VerticalAlignment="Center"
                                                                        CornerRadius="1.5"
                                                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                                        Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}" />

                                                                <Button Grid.Column="0"
                                                                        Style="{StaticResource ShellNavButtonStyle}"
                                                                        Click="Session_Click"
                                                                        Tag="{Binding Id}"
                                                                        AutomationProperties.AutomationId="SessionButton"
                                                                        AutomationProperties.Name="{Binding AccessibilityName}"
                                                                        HorizontalContentAlignment="Stretch"
                                                                        VerticalContentAlignment="Center"
                                                                        ToolTipService.ToolTip="{Binding Title}">
                                                                    <StackPanel Margin="10,0,6,0" Spacing="2">
                                                                        <TextBlock Text="{Binding Title}"
                                                                                   FontSize="13"
                                                                                   FontWeight="{Binding IsSelected, Converter={StaticResource BoolToFontWeight}}"
                                                                                   Foreground="{ThemeResource TextPrimaryBrush}"
                                                                                   TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Text="{Binding Preview}"
                                                                                   Style="{StaticResource SidebarCaptionStyle}" />
                                                                    </StackPanel>
                                                                </Button>

                                                                <Grid Grid.Column="1"
                                                                      Width="64"
                                                                      VerticalAlignment="Stretch">
                                                                    <TextBlock Text="{Binding RelativeTime}"
                                                                               FontSize="10"
                                                                               Foreground="{ThemeResource TextTertiaryBrush}"
                                                                               HorizontalAlignment="Right"
                                                                               VerticalAlignment="Center"
                                                                               Margin="0,0,4,0"
                                                                               TextWrapping="NoWrap"
                                                                               Visibility="{Binding AreActionsVisible, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                                                                    <Button Style="{StaticResource SidebarActionButtonStyle}"
                                                                            HorizontalAlignment="Right"
                                                                            VerticalAlignment="Center"
                                                                            Visibility="{Binding AreActionsVisible, Converter={StaticResource BoolToVis}}"
                                                                            AutomationProperties.Name="More chat actions"
                                                                            ToolTipService.ToolTip="More actions">
                                                                        <ic:FluentIcon Icon="MoreHorizontal"
                                                                                       IconVariant="Regular"
                                                                                       IconSize="Size16"
                                                                                       Foreground="{ThemeResource TextSecondaryBrush}" />
                                                                        <Button.Flyout>
                                                                            <MenuFlyout Placement="Bottom">
                                                                                <MenuFlyoutItem Text="{Binding PinToolTip}"
                                                                                                Click="TogglePinSession_Click"
                                                                                                Tag="{Binding Id}" />
                                                                                <MenuFlyoutSeparator />
                                                                                <MenuFlyoutItem Text="Delete chat"
                                                                                                Click="DeleteSession_Click"
                                                                                                Tag="{Binding Id}"
                                                                                                Foreground="{ThemeResource DangerBrush}" />
                                                                            </MenuFlyout>
                                                                        </Button.Flyout>
                                                                    </Button>
                                                                </Grid>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsRepeater.ItemTemplate>
                                                </ItemsRepeater>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </ScrollViewer>

        <!-- Fixed utility and local-client area; it never participates in conversation scrolling. -->
        <StackPanel Grid.Row="3" Spacing="2">
            <Border Height="1"
                    Margin="4,8,4,8"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <Button Style="{StaticResource SidebarNavButtonStyle}"
                    MinHeight="40"
                    Click="AddAgent_Click"
                    AutomationProperties.AutomationId="AddAgentButton"
                    AutomationProperties.Name="Add agent">
                <local:IconText Glyph="Add"
                                IconSize="Size16"
                                Spacing="10"
                                FontSize="13"
                                Text="Add Agent"
                                Foreground="{ThemeResource TextSecondaryBrush}" />
            </Button>

            <Grid MinHeight="56"
                  Margin="0,2,0,0">
                <Button x:Name="BottomAccountButton"
                        Style="{StaticResource SidebarNavButtonStyle}"
                        Padding="8,0"
                        AutomationProperties.AutomationId="AccountMenuButton"
                        AutomationProperties.Name="Open local client menu">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <local:AgentAvatar Size="32"
                                           CornerRadius="16"
                                           FontSize="10"
                                           Initial="CO"
                                           PaletteIndex="0"
                                           IsHitTestVisible="False" />
                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="2">
                            <TextBlock Text="Local Client"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <Ellipse Width="6"
                                         Height="6"
                                         Fill="{ThemeResource SuccessBrush}"
                                         VerticalAlignment="Center"
                                         Visibility="{Binding HasOnlineAgents, Converter={StaticResource BoolToVis}}" />
                                <Ellipse Width="6"
                                         Height="6"
                                         Stroke="{ThemeResource TextTertiaryBrush}"
                                         StrokeThickness="1"
                                         VerticalAlignment="Center"
                                         Visibility="{Binding HasOnlineAgents, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                                <TextBlock Text="{Binding OnlineAgentCountText}"
                                           Style="{StaticResource SidebarCaptionStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <Button.Flyout>
                        <!-- A plain Flyout keeps its Popup host transparent so the inner Border
                             owns the whole surface (fill, radius, border) instead of fighting
                             MenuFlyout's acrylic presenter. -->
                        <Flyout Placement="TopEdgeAlignedLeft">
                            <Flyout.FlyoutPresenterStyle>
                                <Style TargetType="FlyoutPresenter">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="CornerRadius" Value="12" />
                                </Style>
                            </Flyout.FlyoutPresenterStyle>
                            <Border MinWidth="272"
                                    Padding="6"
                                    CornerRadius="12"
                                    Background="{ThemeResource AccountMenuGlassBrush}"
                                    BorderBrush="{ThemeResource BorderSubtleBrush}"
                                    BorderThickness="1">
                                <StackPanel Spacing="0">
                                    <Button Style="{StaticResource AccountFlyoutRowStyle}"
                                            Click="BottomSettings_Click"
                                            AutomationProperties.AutomationId="SettingsButton"
                                            AutomationProperties.Name="Settings">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Settings" FontSize="14" />
                                            <TextBlock Grid.Column="1"
                                                       Text="Ctrl+,"
                                                       FontSize="12"
                                                       Foreground="{ThemeResource TextSecondaryBrush}" />
                                        </Grid>
                                    </Button>
                                    <Button Style="{StaticResource AccountFlyoutRowStyle}"
                                            Click="BottomKeyboardShortcuts_Click"
                                            AutomationProperties.AutomationId="AccountKeyboardShortcutsMenuItem"
                                            AutomationProperties.Name="Keyboard Shortcuts">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Keyboard Shortcuts" FontSize="14" />
                                            <TextBlock Grid.Column="1"
                                                       Text="Ctrl+Shift+/"
                                                       FontSize="12"
                                                       Foreground="{ThemeResource TextSecondaryBrush}" />
                                        </Grid>
                                    </Button>
                                    <Button Style="{StaticResource AccountFlyoutRowStyle}"
                                            AutomationProperties.Name="Theme">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Theme" FontSize="14" />
                                            <!-- The menu intentionally uses text only; no trailing icon. -->
                                            <!-- <TextBlock Grid.Column="1"
                                                       Text="›"
                                                       FontSize="18"
                                                       Foreground="{ThemeResource TextSecondaryBrush}" /> -->
                                        </Grid>
                                        <Button.Flyout>
                                            <MenuFlyout Placement="RightEdgeAlignedTop">
                                                <MenuFlyoutItem Text="Use system setting"
                                                                Tag="System"
                                                                Click="BottomTheme_Click" />
                                                <MenuFlyoutItem Text="Light"
                                                                Tag="Light"
                                                                Click="BottomTheme_Click" />
                                                <MenuFlyoutItem Text="Dark"
                                                                Tag="Dark"
                                                                Click="BottomTheme_Click" />
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                    <Border Height="1"
                                            Margin="4,4"
                                            Background="{ThemeResource DividerBrush}" />
                                    <Button Style="{StaticResource AccountFlyoutRowStyle}"
                                            Click="BottomAbout_Click"
                                            AutomationProperties.Name="About ConnectOnion">
                                        <TextBlock Text="About ConnectOnion" FontSize="14" />
                                    </Button>
                                    <Border Height="1"
                                            Margin="4,4"
                                            Background="{ThemeResource DividerBrush}" />
                                    <Button Style="{StaticResource AccountFlyoutRowStyle}"
                                            Click="BottomExit_Click"
                                            AutomationProperties.Name="Exit">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Exit" FontSize="14" />
                                            <TextBlock Grid.Column="1"
                                                       Text="Ctrl+Q"
                                                       FontSize="12"
                                                       Foreground="{ThemeResource TextSecondaryBrush}" />
                                        </Grid>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>

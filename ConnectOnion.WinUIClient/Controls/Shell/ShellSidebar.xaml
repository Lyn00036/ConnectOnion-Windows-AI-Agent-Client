<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ConnectOnion.WinUIClient.Controls.ShellSidebar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ConnectOnion.WinUIClient.Controls"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid AutomationProperties.AutomationId="ShellSidebar"
          Background="{ThemeResource SidebarBackgroundBrush}"
          Padding="8,8,6,10"
          RowSpacing="4">
        <Grid.Resources>
            <ResourceDictionary>
                <Style x:Key="ShellNavButtonStyle"
                   TargetType="Button"
                   BasedOn="{StaticResource TransparentButtonStyle}">
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="Padding" Value="0" />
                </Style>
                <Style x:Key="SidebarCaptionStyle" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="11" />
                    <Setter Property="Foreground" Value="{ThemeResource TextTertiaryBrush}" />
                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                    <Setter Property="TextWrapping" Value="NoWrap" />
                    <Setter Property="MaxLines" Value="1" />
                </Style>
            </ResourceDictionary>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Brand and live presence follow the same two-line hierarchy as the compact
             ConnectOnion clients: identity first, runtime status second. -->
        <Grid Grid.Row="0"
              MinHeight="60"
              Padding="4,2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                <Image x:Uid="SidebarLogo" Width="28"
                       Height="28"
                       Source="/Assets/icon.png"
                       AutomationProperties.Name="ConnectOnion logo" />
                <TextBlock Text="ConnectOnion"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextPrimaryBrush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <Border Padding="6,2"
                        CornerRadius="4"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding AppVersionBadgeText}"
                               FontFamily="{StaticResource JetBrainsMonoFontFamily}"
                               FontSize="9"
                               Foreground="{ThemeResource TextTertiaryBrush}" />
                </Border>
            </StackPanel>

            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        Spacing="7"
                        Margin="2,6,0,0"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{Binding OnlineAgentCountText}">
                <Ellipse Width="6"
                         Height="6"
                         Fill="{ThemeResource SuccessBrush}"
                         Visibility="{Binding HasOnlineAgents, Converter={StaticResource BoolToVis}}" />
                <Ellipse Width="6"
                         Height="6"
                         Stroke="{ThemeResource TextTertiaryBrush}"
                         StrokeThickness="1"
                         Visibility="{Binding HasOnlineAgents, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                <TextBlock Text="{Binding OnlineAgentStatusText}"
                           FontFamily="{StaticResource JetBrainsMonoFontFamily}"
                           FontSize="10"
                           CharacterSpacing="70"
                           Foreground="{ThemeResource TextSecondaryBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Navigation and sidebar-only utilities are explicit rows, separate from the brand. -->
        <StackPanel Grid.Row="1"
                    Margin="0,0,0,2"
                    Spacing="2">
            <Button x:Uid="SidebarAgentsNavigation"
                    x:Name="AgentsNavigationButton"
                    MinHeight="40"
                    Style="{StaticResource SidebarNavButtonStyle}"
                    Padding="12,0"
                    Click="ChatHome_Click"
                    AutomationProperties.Name="Agents"
                    ToolTipService.ToolTip="Agents">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ic:FluentIcon Icon="Bot"
                                   IconVariant="Regular"
                                   IconSize="Size16"
                                   VerticalAlignment="Center" />
                    <TextBlock x:Uid="SidebarAgentsNavigationLabel"
                               Grid.Column="1"
                               Text="Agents"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </Grid>
            </Button>

        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Keep the section command visible while only the conversation tree scrolls. -->
            <Grid MinHeight="28"
                  Margin="10,0,2,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Uid="SidebarConversations"
                           Text="Conversations"
                           Style="{StaticResource SidebarSectionHeaderStyle}"
                           VerticalAlignment="Center" />
                <Button x:Uid="SidebarSearchChats"
                        x:Name="SessionSearchButton"
                        Grid.Column="1"
                        Style="{StaticResource SmallIconButtonStyle}"
                        Click="SearchSessions_Click"
                        AutomationProperties.AutomationId="SessionSearchButton"
                        AutomationProperties.Name="Search chats"
                        ToolTipService.ToolTip="Search chats">
                    <ic:FluentIcon Icon="Search"
                                   IconVariant="Regular"
                                   IconSize="Size16" />
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <!-- The tree is ItemsRepeater all the way down, and ItemsRepeater — unlike
                     ListView — provides no arrow-key navigation of its own. Without this the
                     only way through the sidebar is Tab, one control at a time, which for a
                     handful of agents with their conversations expanded is dozens of presses.
                     XYFocus gives Up/Down row traversal on top of the Tab order. -->
                <StackPanel Spacing="2"
                            Margin="0,0,14,0"
                            XYFocusKeyboardNavigation="Enabled">

                <!-- Pinned conversations remain a fast cross-agent jump list. -->
                <StackPanel Spacing="2"
                            Visibility="{Binding HasPinnedSessions, Converter={StaticResource BoolToVis}}">
                    <Button x:Uid="SidebarTogglePinned" Style="{StaticResource SidebarNavButtonStyle}"
                            Click="TogglePinned_Click"
                            MinHeight="32"
                            Padding="6,0"
                            Margin="0,4,0,2"
                            ToolTipService.ToolTip="Expand or collapse pinned chats"
                            AutomationProperties.Name="Expand or collapse pinned chats">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ic:FluentIcon Icon="ChevronDown"
                                           IconVariant="Regular"
                                           IconSize="Size16"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextTertiaryBrush}"
                                           RenderTransformOrigin="0.5,0.5">
                                <ic:FluentIcon.RenderTransform>
                                    <RotateTransform Angle="{Binding PinnedChevronAngle}" />
                                </ic:FluentIcon.RenderTransform>
                            </ic:FluentIcon>
                            <TextBlock x:Uid="SidebarPinned" Grid.Column="1"
                                       Text="Pinned"
                                       Style="{StaticResource SidebarSectionHeaderStyle}" />
                        </Grid>
                    </Button>

                    <ItemsRepeater ItemsSource="{Binding PinnedSessions}"
                                   Visibility="{Binding IsPinnedExpanded, Converter={StaticResource BoolToVis}}">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="56"
                                      Margin="0,1"
                                      Padding="10,4,4,4"
                                      PointerEntered="Row_PointerEntered"
                                      PointerExited="Row_PointerExited"
                                      GotFocus="Row_GotFocus"
                                      LostFocus="Row_LostFocus">
                                    <Grid.Resources>
                                        <ResourceDictionary>
                                            <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
                                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
                                            <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                                            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                                            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                                        </ResourceDictionary>
                                    </Grid.Resources>
                                    <Grid.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem x:Uid="SidebarRenameChat" Text="Rename"
                                                            Click="RenameSession_Click"
                                                            Tag="{Binding Id}" />
                                            <MenuFlyoutItem Text="{Binding PinToolTip}"
                                                            Click="TogglePinSession_Click"
                                                            Tag="{Binding Id}" />
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem x:Uid="SidebarDeleteChat" Text="Delete chat"
                                                            Click="DeleteSession_Click"
                                                            Tag="{Binding Id}"
                                                            Foreground="{ThemeResource DangerBrush}" />
                                        </MenuFlyout>
                                    </Grid.ContextFlyout>
                                    <Border CornerRadius="8"
                                            Background="{Binding IsSelected, Converter={StaticResource RowStateToBackground}}"
                                            Visibility="{Binding ShowRowBackground, Converter={StaticResource BoolToVis}}" />
                                    <Border Width="3"
                                            Height="24"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            CornerRadius="1.5"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}" />

                                    <Button Style="{StaticResource ShellNavButtonStyle}"
                                            Click="PinnedSession_Click"
                                            Tag="{Binding Id}"
                                            AutomationProperties.AutomationId="PinnedSessionButton"
                                            AutomationProperties.Name="{Binding AccessibilityName}"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Center"
                                            ToolTipService.ToolTip="{Binding Title}">
                                        <StackPanel Margin="10,0,8,0" Spacing="2">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="13"
                                                       FontWeight="{Binding IsSelected, Converter={StaticResource BoolToFontWeight}}"
                                                       Foreground="{ThemeResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Preview}"
                                                       Style="{StaticResource SidebarCaptionStyle}" />
                                        </StackPanel>
                                    </Button>

                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>

                <ItemsRepeater ItemsSource="{Binding ShellAgents}"
                               AutomationProperties.AutomationId="AgentList">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,1">
                                <!-- The parent Agent row is intentionally lighter than a selected
                                     conversation: no accent rail, only a neutral hover/active wash. -->
                                <Border CornerRadius="8"
                                        Background="Transparent"
                                        PointerEntered="Row_PointerEntered"
                                        PointerExited="Row_PointerExited"
                                        GotFocus="Row_GotFocus"
                                        LostFocus="Row_LostFocus">
                                    <Border.Resources>
                                        <ResourceDictionary>
                                            <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
                                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
                                            <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                                            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                                            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                                        </ResourceDictionary>
                                    </Border.Resources>
                                    <Border.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem x:Uid="SidebarAgentNewChat" Text="New chat"
                                                            Click="AddChat_Click"
                                                            Tag="{Binding Id}" />
                                            <MenuFlyoutItem x:Uid="SidebarAgentDetails" Text="Agent details"
                                                            Click="Agent_Click"
                                                            Tag="{Binding Id}" />
                                            <MenuFlyoutItem x:Uid="MenuChangeAgentIcon"
                                                            Text="Change icon"
                                                            Click="ChangeAgentIcon_Click"
                                                            Tag="{Binding Id}" />
                                            <!-- Hidden rather than disabled when there is no custom icon:
                                                 an unavailable action is noise in a compact context menu. -->
                                            <MenuFlyoutItem x:Uid="MenuRemoveAgentIcon"
                                                            Text="Remove custom icon"
                                                            Click="RemoveAgentIcon_Click"
                                                            Tag="{Binding Id}"
                                                            Visibility="{Binding HasCustomIcon, Converter={StaticResource BoolToVis}}" />
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem x:Uid="SidebarDeleteAgent" Text="Delete agent"
                                                            Click="DeleteAgent_Click"
                                                            Tag="{Binding Id}"
                                                            Foreground="{ThemeResource DangerBrush}" />
                                        </MenuFlyout>
                                    </Border.ContextFlyout>
                                    <Grid MinHeight="46" Padding="2,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="36" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.ColumnSpan="5"
                                                CornerRadius="8"
                                                Background="{ThemeResource SidebarItemHoverBrush}"
                                                Visibility="{Binding ShowRowBackground, Converter={StaticResource BoolToVis}}" />

                                        <Button x:Uid="SidebarToggleAgentChats" Grid.Column="0"
                                                Style="{StaticResource SmallIconButtonStyle}"
                                                Width="24"
                                                Height="24"
                                                Click="ToggleAgent_Click"
                                                Tag="{Binding Id}"
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="Expand or collapse chats"
                                                ToolTipService.ToolTip="Expand or collapse chats">
                                            <ic:FluentIcon Icon="ChevronDown"
                                                           IconVariant="Regular"
                                                           IconSize="Size16"
                                                           Foreground="{ThemeResource TextTertiaryBrush}"
                                                           RenderTransformOrigin="0.5,0.5">
                                                <ic:FluentIcon.RenderTransform>
                                                    <RotateTransform Angle="{Binding ChevronAngle}" />
                                                </ic:FluentIcon.RenderTransform>
                                            </ic:FluentIcon>
                                        </Button>

                                        <!-- Same Agent_Click, same Tag, right next to the name
                                             button below: for a pointer that is a bigger target,
                                             but for the keyboard it was a second stop that did
                                             exactly what the next one does. Out of the tab order
                                             and out of the accessibility tree — the name button
                                             is the one canonical way in. It keeps its
                                             AutomationId because AutomationContractTests scans
                                             the XAML for it. -->
                                        <Button Grid.Column="1"
                                                Style="{StaticResource ShellNavButtonStyle}"
                                                Click="Agent_Click"
                                                Tag="{Binding Id}"
                                                IsTabStop="False"
                                                AutomationProperties.AutomationId="AgentAvatarButton"
                                                AutomationProperties.AccessibilityView="Raw"
                                                ToolTipService.ToolTip="{Binding DisplayName}">
                                            <local:AgentAvatar Size="28"
                                                               CornerRadius="14"
                                                               FontSize="10"
                                                               Margin="4,0,10,0"
                                                               Initial="{Binding Initial}"
                                                               ImagePath="{Binding IconPath}"
                                                               IsHitTestVisible="False" />
                                        </Button>

                                        <Button Grid.Column="2"
                                                Style="{StaticResource ShellNavButtonStyle}"
                                                Click="Agent_Click"
                                                Tag="{Binding Id}"
                                                AutomationProperties.AutomationId="AgentButton"
                                                AutomationProperties.Name="{Binding OpenAccessibilityName}"
                                                HorizontalContentAlignment="Stretch"
                                                ToolTipService.ToolTip="{Binding Name}">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       Margin="0,0,8,0"
                                                       FontSize="13"
                                                       FontWeight="{Binding IsSelected, Converter={StaticResource BoolToFontWeight}}"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap"
                                                       MaxLines="1"
                                                       Foreground="{ThemeResource TextPrimaryBrush}" />
                                        </Button>

                                        <Grid Grid.Column="3"
                                              Width="9"
                                              Height="9"
                                              Margin="6,0,5,0"
                                              VerticalAlignment="Center"
                                              ToolTipService.ToolTip="{Binding PresenceLabel}"
                                              AutomationProperties.Name="{Binding PresenceLabel}">
                                            <Ellipse Fill="{ThemeResource SuccessBrush}"
                                                     Visibility="{Binding IsOnline, Converter={StaticResource BoolToVis}}" />
                                            <Ellipse Fill="{ThemeResource StatusRunningBrush}"
                                                     Visibility="{Binding IsChecking, Converter={StaticResource BoolToVis}}"
                                                     Loaded="PresenceCheckingDot_Loaded" />
                                            <Ellipse Stroke="{ThemeResource TextTertiaryBrush}"
                                                     StrokeThickness="1.5"
                                                     Visibility="{Binding IsOfflineIconVisible, Converter={StaticResource BoolToVis}}" />
                                        </Grid>

                                        <Button x:Uid="SidebarAgentNewChatButton"
                                                Grid.Column="4"
                                                Style="{StaticResource SidebarActionButtonStyle}"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding AreActionsVisible, Converter={StaticResource BoolToVis}}"
                                                Click="AddChat_Click"
                                                Tag="{Binding Id}"
                                                AutomationProperties.Name="New chat"
                                                ToolTipService.ToolTip="New chat">
                                            <ic:FluentIcon Icon="Add"
                                                           IconVariant="Regular"
                                                           IconSize="Size16"
                                                           Foreground="{ThemeResource TextSecondaryBrush}" />
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Conversations remain children of their owning Agent, but are
                                     now grouped by time so the hierarchy scans like a desktop log. -->
                                <ItemsRepeater ItemsSource="{Binding SessionGroups}"
                                               Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Label}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Foreground="{ThemeResource TextTertiaryBrush}"
                                                           Margin="42,8,8,3" />
                                                <ItemsRepeater ItemsSource="{Binding Sessions}">
                                                    <ItemsRepeater.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid MinHeight="54"
                                                                  Margin="34,1,0,0"
                                                                  Padding="10,4,4,4"
                                                                  PointerEntered="Row_PointerEntered"
                                                                  PointerExited="Row_PointerExited"
                                                                  GotFocus="Row_GotFocus"
                                                                  LostFocus="Row_LostFocus">
                                                                <Grid.Resources>
                                                                    <ResourceDictionary>
                                                                        <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                                                                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
                                                                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
                                                                        <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                                                                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                                                                        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                                                                    </ResourceDictionary>
                                                                </Grid.Resources>
                                                                <Grid.ContextFlyout>
                                                                    <MenuFlyout>
                                                                        <MenuFlyoutItem x:Uid="SidebarRenameChat" Text="Rename"
                                                                                        Click="RenameSession_Click"
                                                                                        Tag="{Binding Id}" />
                                                                        <MenuFlyoutItem Text="{Binding PinToolTip}"
                                                                                        Click="TogglePinSession_Click"
                                                                                        Tag="{Binding Id}" />
                                                                        <MenuFlyoutSeparator />
                                                                        <MenuFlyoutItem x:Uid="SidebarDeleteChat" Text="Delete chat"
                                                                                        Click="DeleteSession_Click"
                                                                                        Tag="{Binding Id}"
                                                                                        Foreground="{ThemeResource DangerBrush}" />
                                                                    </MenuFlyout>
                                                                </Grid.ContextFlyout>
                                                                <Border CornerRadius="8"
                                                                        Background="{Binding IsSelected, Converter={StaticResource RowStateToBackground}}"
                                                                        Visibility="{Binding ShowRowBackground, Converter={StaticResource BoolToVis}}" />
                                                                <Border Width="3"
                                                                        Height="24"
                                                                        HorizontalAlignment="Left"
                                                                        VerticalAlignment="Center"
                                                                        CornerRadius="1.5"
                                                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                                        Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}" />

                                                                <Button Style="{StaticResource ShellNavButtonStyle}"
                                                                        Click="Session_Click"
                                                                        Tag="{Binding Id}"
                                                                        AutomationProperties.AutomationId="SessionButton"
                                                                        AutomationProperties.Name="{Binding AccessibilityName}"
                                                                        HorizontalContentAlignment="Stretch"
                                                                        VerticalContentAlignment="Center"
                                                                        ToolTipService.ToolTip="{Binding Title}">
                                                                    <StackPanel Margin="10,0,6,0" Spacing="2">
                                                                        <TextBlock Text="{Binding Title}"
                                                                                   FontSize="13"
                                                                                   FontWeight="{Binding IsSelected, Converter={StaticResource BoolToFontWeight}}"
                                                                                   Foreground="{ThemeResource TextPrimaryBrush}"
                                                                                   TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Text="{Binding Preview}"
                                                                                   Style="{StaticResource SidebarCaptionStyle}" />
                                                                    </StackPanel>
                                                                </Button>

                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsRepeater.ItemTemplate>
                                                </ItemsRepeater>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Fixed utility area; it never participates in conversation scrolling. -->
        <StackPanel Grid.Row="3" Spacing="2">
            <Border Height="1"
                    Margin="4,8,4,8"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <Button x:Uid="SidebarAddAgentButton" Style="{StaticResource SidebarNavButtonStyle}"
                    MinHeight="40"
                    Click="AddAgent_Click"
                    AutomationProperties.AutomationId="AddAgentButton"
                    AutomationProperties.Name="Add agent">
                <local:IconText x:Uid="SidebarAddAgent" Glyph="Add"
                                IconSize="Size16"
                                Spacing="10"
                                FontSize="13"
                                Text="Add Agent"
                                Foreground="{ThemeResource TextSecondaryBrush}" />
            </Button>

            <Button x:Uid="SidebarSettingsButton"
                    x:Name="SidebarSettingsButton"
                    MinHeight="44"
                    Style="{StaticResource SidebarNavButtonStyle}"
                    Padding="12,0"
                    Click="BottomSettings_Click"
                    AutomationProperties.AutomationId="SettingsButton"
                    AutomationProperties.Name="Settings"
                    ToolTipService.ToolTip="Settings">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ic:FluentIcon Icon="Settings"
                                   IconVariant="Regular"
                                   IconSize="Size16"
                                   VerticalAlignment="Center" />
                    <TextBlock x:Uid="SidebarSettings"
                               Grid.Column="1"
                               Text="Settings"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>

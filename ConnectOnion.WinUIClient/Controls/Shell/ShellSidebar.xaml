<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ConnectOnion.WinUIClient.Controls.ShellSidebar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ConnectOnion.WinUIClient.Controls"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid AutomationProperties.AutomationId="ShellSidebar"
          Background="{ThemeResource SidebarBackgroundBrush}"
          Padding="8,10,8,8"
          RowSpacing="4">
        <Grid.Resources>
            <!-- Transparent row buttons (agent name / conversation open): hover feedback
                 comes from the unified row Border, never the button itself. -->
            <Style x:Key="ShellNavButtonStyle" TargetType="Button" BasedOn="{StaticResource TransparentButtonStyle}">
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="0" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ Brand / online header ============ -->
        <Button Grid.Row="0"
                Style="{StaticResource SidebarNavButtonStyle}"
                MinHeight="52"
                Padding="8,0"
                Click="ChatHome_Click"
                AutomationProperties.Name="ConnectOnion home">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0"
                       Width="30"
                       Height="30"
                       Source="/Assets/icon.png"
                       VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="ConnectOnion"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextPrimaryBrush}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="5"
                            Margin="0,0,4,0"
                            VerticalAlignment="Center"
                            ToolTipService.ToolTip="{Binding OnlineAgentCountText}"
                            AutomationProperties.Name="{Binding OnlineAgentCountText}">
                    <Ellipse Width="7"
                             Height="7"
                             Fill="{ThemeResource SuccessBrush}"
                             VerticalAlignment="Center" />
                    <TextBlock Text="{Binding OnlineAgentCountText}"
                               FontSize="12"
                               Foreground="{ThemeResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Button>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,4,0,0">
            <StackPanel Spacing="2">

                <!-- ============ Pinned Chats section ============ -->
                <!-- Whole section hidden when nothing is pinned, so an empty group never leaves a
                     dangling header + blank gap (see HasPinnedSessions). -->
                <StackPanel Spacing="2" Visibility="{Binding HasPinnedSessions, Converter={StaticResource BoolToVis}}">
                    <Button Style="{StaticResource SidebarNavButtonStyle}"
                            Click="TogglePinned_Click"
                            MinHeight="30"
                            Padding="8,0"
                            Margin="0,8,0,0"
                            ToolTipService.ToolTip="Expand or collapse pinned chats"
                            AutomationProperties.Name="Expand or collapse pinned chats">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ic:FluentIcon Grid.Column="0"
                                           Icon="ChevronDown"
                                           IconVariant="Regular"
                                           IconSize="Size16"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextTertiaryBrush}"
                                           RenderTransformOrigin="0.5,0.5">
                                <ic:FluentIcon.RenderTransform>
                                    <RotateTransform Angle="{Binding PinnedChevronAngle}" />
                                </ic:FluentIcon.RenderTransform>
                            </ic:FluentIcon>
                            <TextBlock Grid.Column="1"
                                       Text="Pinned Chats"
                                       Style="{StaticResource SidebarSectionHeaderStyle}" />
                        </Grid>
                    </Button>

                    <ItemsRepeater ItemsSource="{Binding PinnedSessions}"
                                   Visibility="{Binding IsPinnedExpanded, Converter={StaticResource BoolToVis}}">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate>
                                <!-- Pinned rows are top-level (not indented under an agent). -->
                                <Grid Height="42"
                                      Padding="8,0"
                                      PointerEntered="Row_PointerEntered"
                                      PointerExited="Row_PointerExited"
                                      GotFocus="Row_GotFocus"
                                      LostFocus="Row_LostFocus">
                                    <!-- Neutralize the theme's Button chrome so the transparent row
                                         button doesn't paint a competing hover; the +/⋯ action
                                         buttons use SidebarActionButtonStyle and are immune. Declared
                                         inline (not a shared StaticResource): WinUI requires a
                                         per-element Resources dictionary and ItemsRepeater
                                         re-instantiates this template per row. -->
                                    <Grid.Resources>
                                        <ResourceDictionary>
                                            <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
                                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
                                            <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                                            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                                            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                                        </ResourceDictionary>
                                    </Grid.Resources>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!-- Unified selection/hover wash + 3px brand rail (a pinned chat
                                         is a real conversation, so it gets the strong treatment). -->
                                    <Border Grid.ColumnSpan="3"
                                            CornerRadius="6"
                                            Background="{Binding IsSelected, Converter={StaticResource RowStateToBackground}}"
                                            Visibility="{Binding ShowRowBackground, Converter={StaticResource BoolToVis}}" />
                                    <Border Grid.ColumnSpan="3"
                                            Width="3"
                                            Height="20"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            CornerRadius="1.5"
                                            Background="{ThemeResource SidebarSelectedAccentBrush}"
                                            Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}" />
                                    <ic:FluentIcon Grid.Column="0"
                                                   Icon="Chat"
                                                   IconVariant="Regular"
                                                   IconSize="Size16"
                                                   Margin="8,0,10,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextSecondaryBrush}" />
                                    <!-- PinnedSession_Click (not Session_Click): opening from the
                                         pinned list must not collapse the agent tree below. -->
                                    <Button Grid.Column="1"
                                            Style="{StaticResource ShellNavButtonStyle}"
                                            Click="PinnedSession_Click"
                                            Tag="{Binding Id}"
                                            AutomationProperties.AutomationId="PinnedSessionButton"
                                            VerticalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            VerticalContentAlignment="Center"
                                            ToolTipService.ToolTip="{Binding Title}">
                                        <StackPanel MinWidth="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}"
                                                       TextTrimming="CharacterEllipsis"
                                                       FontSize="13"
                                                       FontWeight="{Binding IsSelected, Converter={StaticResource BoolToFontWeight}}"
                                                       Foreground="{ThemeResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding AgentDisplayName}"
                                                       TextTrimming="CharacterEllipsis"
                                                       FontSize="11"
                                                       Foreground="{ThemeResource TextTertiaryBrush}" />
                                        </StackPanel>
                                    </Button>
                                    <!-- More menu, revealed on hover/focus; no bare × in the row. -->
                                    <Button Grid.Column="2"
                                            Style="{StaticResource SidebarActionButtonStyle}"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding AreActionsVisible, Converter={StaticResource BoolToVis}}"
                                            AutomationProperties.Name="More chat actions"
                                            ToolTipService.ToolTip="More actions">
                                        <ic:FluentIcon Icon="MoreHorizontal" IconVariant="Regular" IconSize="Size16" Foreground="{ThemeResource TextSecondaryBrush}" />
                                        <Button.Flyout>
                                            <MenuFlyout Placement="Bottom">
                                                <MenuFlyoutItem Text="{Binding PinToolTip}"
                                                                Click="TogglePinSession_Click"
                                                                Tag="{Binding Id}">
                                                    <MenuFlyoutItem.Icon>
                                                        <SymbolIcon Symbol="Pin" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem Text="Delete chat"
                                                                Click="DeleteSession_Click"
                                                                Tag="{Binding Id}"
                                                                Foreground="{ThemeResource DangerBrush}">
                                                    <MenuFlyoutItem.Icon>
                                                        <SymbolIcon Symbol="Delete" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>

                <!-- ============ Agents section ============ -->
                <TextBlock Text="Agents"
                           Style="{StaticResource SidebarSectionHeaderStyle}"
                           Margin="12,16,0,6" />
                <ItemsRepeater ItemsSource="{Binding ShellAgents}" AutomationProperties.AutomationId="AgentList">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,1">
                                <!-- Agent (parent) row. Transparent Border is the pointer hit-test
                                     target; the inner Border below paints the wash. An agent row
                                     gets only a SUBTLE active/hover wash and NO accent rail — the
                                     strong "selected" treatment (wash + rail + SemiBold) is reserved
                                     for the conversation actually open, so parent and child never
                                     both read as strongly selected. -->
                                <Border CornerRadius="6"
                                        Background="Transparent"
                                        PointerEntered="Row_PointerEntered"
                                        PointerExited="Row_PointerExited"
                                        GotFocus="Row_GotFocus"
                                        LostFocus="Row_LostFocus">
                                    <Border.Resources>
                                        <ResourceDictionary>
                                            <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
                                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
                                            <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                                            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                                            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                                        </ResourceDictionary>
                                    </Border.Resources>
                                    <Grid Height="44" Padding="4,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <!-- Subtle wash only (SidebarItemHover for both hover and
                                             active); no accent rail on a parent row. -->
                                        <Border Grid.ColumnSpan="5"
                                                CornerRadius="6"
                                                Background="{ThemeResource SidebarItemHoverBrush}"
                                                Visibility="{Binding ShowRowBackground, Converter={StaticResource BoolToVis}}" />

                                        <!-- Chevron: expand/collapse -->
                                        <Button Grid.Column="0"
                                                Style="{StaticResource SmallIconButtonStyle}"
                                                Width="24"
                                                Height="24"
                                                Click="ToggleAgent_Click"
                                                Tag="{Binding Id}"
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="Expand or collapse chats"
                                                ToolTipService.ToolTip="Expand or collapse chats">
                                            <ic:FluentIcon Icon="ChevronDown"
                                                           IconVariant="Regular"
                                                           IconSize="Size16"
                                                           Foreground="{ThemeResource TextTertiaryBrush}"
                                                           RenderTransformOrigin="0.5,0.5">
                                                <ic:FluentIcon.RenderTransform>
                                                    <RotateTransform Angle="{Binding ChevronAngle}" />
                                                </ic:FluentIcon.RenderTransform>
                                            </ic:FluentIcon>
                                        </Button>

                                        <!-- Avatar -->
                                        <local:AgentAvatar Grid.Column="1"
                                                           Size="28"
                                                           CornerRadius="7"
                                                           FontSize="12"
                                                           Margin="4,0,10,0"
                                                           VerticalAlignment="Center"
                                                           Initial="{Binding Initial}"
                                                           PaletteIndex="{Binding AvatarPaletteIndex}" />

                                        <!-- Name (friendly display name; raw id in the tooltip). The
                                             name column is * so it shrinks via trimming instead of
                                             pushing the status dot / actions off the row. -->
                                        <Button Grid.Column="2"
                                                Style="{StaticResource ShellNavButtonStyle}"
                                                Click="Agent_Click"
                                                Tag="{Binding Id}"
                                                AutomationProperties.AutomationId="AgentButton"
                                                VerticalAlignment="Stretch"
                                                HorizontalContentAlignment="Left"
                                                VerticalContentAlignment="Center"
                                                ToolTipService.ToolTip="{Binding Name}">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontSize="14"
                                                       FontWeight="{Binding IsSelected, Converter={StaticResource BoolToFontWeight}}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{ThemeResource TextPrimaryBrush}"
                                                       VerticalAlignment="Center" />
                                        </Button>

                                        <!-- Status dot (always visible). Online = solid green;
                                             Connecting = breathing neutral; Offline/Unknown =
                                             hollow gray. Tooltip + AutomationProperties.Name so the
                                             state is never conveyed by color alone. -->
                                        <Grid Grid.Column="3"
                                              Width="10"
                                              Height="10"
                                              Margin="6,0,4,0"
                                              VerticalAlignment="Center"
                                              ToolTipService.ToolTip="{Binding PresenceLabel}"
                                              AutomationProperties.Name="{Binding PresenceLabel}">
                                            <Ellipse Fill="{ThemeResource SuccessBrush}"
                                                     Visibility="{Binding IsOnline, Converter={StaticResource BoolToVis}}" />
                                            <Ellipse Fill="{ThemeResource StatusRunningBrush}"
                                                     Visibility="{Binding IsChecking, Converter={StaticResource BoolToVis}}"
                                                     Loaded="PresenceCheckingDot_Loaded" />
                                            <Ellipse Stroke="{ThemeResource TextTertiaryBrush}"
                                                     StrokeThickness="1.5"
                                                     Visibility="{Binding IsOfflineIconVisible, Converter={StaticResource BoolToVis}}" />
                                        </Grid>

                                        <!-- Actions: + (new chat) and ⋯ (more). Revealed on
                                             hover/focus; the dot to their left is fixed and the name
                                             start is fixed, so nothing jumps when they appear. -->
                                        <StackPanel Grid.Column="4"
                                                    Orientation="Horizontal"
                                                    Spacing="2"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding AreActionsVisible, Converter={StaticResource BoolToVis}}">
                                            <Button Style="{StaticResource SidebarActionButtonStyle}"
                                                    Click="AddChat_Click"
                                                    Tag="{Binding Id}"
                                                    AutomationProperties.Name="New chat"
                                                    ToolTipService.ToolTip="New chat">
                                                <ic:FluentIcon Icon="Add" IconVariant="Regular" IconSize="Size16" Foreground="{ThemeResource TextSecondaryBrush}" />
                                            </Button>
                                            <Button Style="{StaticResource SidebarActionButtonStyle}"
                                                    AutomationProperties.Name="More agent actions"
                                                    ToolTipService.ToolTip="More actions">
                                                <ic:FluentIcon Icon="MoreHorizontal" IconVariant="Regular" IconSize="Size16" Foreground="{ThemeResource TextSecondaryBrush}" />
                                                <Button.Flyout>
                                                    <MenuFlyout Placement="Bottom">
                                                        <MenuFlyoutItem Text="New chat"
                                                                        Click="AddChat_Click"
                                                                        Tag="{Binding Id}">
                                                            <MenuFlyoutItem.Icon>
                                                                <SymbolIcon Symbol="Add" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem Text="Agent details"
                                                                        Click="Agent_Click"
                                                                        Tag="{Binding Id}">
                                                            <MenuFlyoutItem.Icon>
                                                                <SymbolIcon Symbol="ContactInfo" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutSeparator />
                                                        <MenuFlyoutItem Text="Delete agent"
                                                                        Click="DeleteAgent_Click"
                                                                        Tag="{Binding Id}"
                                                                        Foreground="{ThemeResource DangerBrush}">
                                                            <MenuFlyoutItem.Icon>
                                                                <SymbolIcon Symbol="Delete" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                    </MenuFlyout>
                                                </Button.Flyout>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- ============ Conversations under this agent ============ -->
                                <ItemsRepeater ItemsSource="{Binding Sessions}"
                                               Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate>
                                            <!-- Indented ~42px so the conversation aligns under the
                                                 agent name, clearly a child of the agent above. -->
                                            <Grid Height="38"
                                                  Margin="42,1,0,0"
                                                  Padding="8,0"
                                                  PointerEntered="Row_PointerEntered"
                                                  PointerExited="Row_PointerExited"
                                                  GotFocus="Row_GotFocus"
                                                  LostFocus="Row_LostFocus">
                                                <Grid.Resources>
                                                    <ResourceDictionary>
                                                        <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                                                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
                                                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
                                                        <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                                                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                                                        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                                                    </ResourceDictionary>
                                                </Grid.Resources>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <!-- Strong selected treatment: wash + 3px brand rail. -->
                                                <Border Grid.ColumnSpan="3"
                                                        CornerRadius="6"
                                                        Background="{Binding IsSelected, Converter={StaticResource RowStateToBackground}}"
                                                        Visibility="{Binding ShowRowBackground, Converter={StaticResource BoolToVis}}" />
                                                <Border Grid.ColumnSpan="3"
                                                        Width="3"
                                                        Height="18"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        CornerRadius="1.5"
                                                        Background="{ThemeResource SidebarSelectedAccentBrush}"
                                                        Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}" />
                                                <ic:FluentIcon Grid.Column="0"
                                                               Icon="Chat"
                                                               IconVariant="Regular"
                                                               IconSize="Size16"
                                                               Margin="6,0,10,0"
                                                               VerticalAlignment="Center"
                                                               Foreground="{ThemeResource TextSecondaryBrush}" />
                                                <Button Grid.Column="1"
                                                        Style="{StaticResource ShellNavButtonStyle}"
                                                        Click="Session_Click"
                                                        Tag="{Binding Id}"
                                                        AutomationProperties.AutomationId="SessionButton"
                                                        VerticalAlignment="Stretch"
                                                        HorizontalContentAlignment="Left"
                                                        VerticalContentAlignment="Center"
                                                        ToolTipService.ToolTip="{Binding Title}">
                                                    <TextBlock Text="{Binding Title}"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"
                                                               FontSize="13"
                                                               FontWeight="{Binding IsSelected, Converter={StaticResource BoolToFontWeight}}"
                                                               Foreground="{ThemeResource TextPrimaryBrush}" />
                                                </Button>
                                                <Button Grid.Column="2"
                                                        Style="{StaticResource SidebarActionButtonStyle}"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding AreActionsVisible, Converter={StaticResource BoolToVis}}"
                                                        AutomationProperties.Name="More chat actions"
                                                        ToolTipService.ToolTip="More actions">
                                                    <ic:FluentIcon Icon="MoreHorizontal" IconVariant="Regular" IconSize="Size16" Foreground="{ThemeResource TextSecondaryBrush}" />
                                                    <Button.Flyout>
                                                        <MenuFlyout Placement="Bottom">
                                                            <MenuFlyoutItem Text="{Binding PinToolTip}"
                                                                            Click="TogglePinSession_Click"
                                                                            Tag="{Binding Id}">
                                                                <MenuFlyoutItem.Icon>
                                                                    <SymbolIcon Symbol="Pin" />
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutSeparator />
                                                            <MenuFlyoutItem Text="Delete chat"
                                                                            Click="DeleteSession_Click"
                                                                            Tag="{Binding Id}"
                                                                            Foreground="{ThemeResource DangerBrush}">
                                                                <MenuFlyoutItem.Icon>
                                                                    <SymbolIcon Symbol="Delete" />
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                        </MenuFlyout>
                                                    </Button.Flyout>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </ScrollViewer>

        <!-- ============ Bottom navigation ============ -->
        <StackPanel Grid.Row="2" Spacing="2">
            <!-- A hairline divider separates the fixed nav from the scrolling tree. -->
            <Border Height="1"
                    Margin="8,4,8,6"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <!-- Add Agent carries a slightly stronger foreground than Settings (a light emphasis,
                 not a primary button). Both share the nav-item chrome and states. -->
            <Button Style="{StaticResource SidebarNavButtonStyle}"
                    MinHeight="44"
                    Click="AddAgent_Click"
                    AutomationProperties.AutomationId="AddAgentButton"
                    AutomationProperties.Name="Add agent">
                <local:IconText Glyph="Add" IconSize="Size20" Spacing="12" FontSize="13" Text="Add Agent"
                                Foreground="{ThemeResource TextPrimaryBrush}" />
            </Button>
            <Button Style="{StaticResource SidebarNavButtonStyle}"
                    MinHeight="44"
                    Click="Settings_Click"
                    AutomationProperties.AutomationId="SettingsButton"
                    AutomationProperties.Name="Open settings">
                <local:IconText Glyph="Settings" IconSize="Size20" Spacing="12" FontSize="13" Text="Settings"
                                Foreground="{ThemeResource TextSecondaryBrush}" />
            </Button>
        </StackPanel>
    </Grid>
</UserControl>

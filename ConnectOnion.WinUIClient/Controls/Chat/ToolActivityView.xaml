<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ConnectOnion.WinUIClient.Controls.ToolActivityView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:controls="using:ConnectOnion.WinUIClient.Controls"
    xmlns:models="using:ConnectOnion.WinUIClient.Models">

    <UserControl.Resources>
        <!-- Hover feedback comes through foreground color and icon visibility
             (handled in code-behind), never background painting. -->
    </UserControl.Resources>

    <Grid MaxWidth="{StaticResource ChatColumnWidth}"
          HorizontalAlignment="Stretch"
          Visibility="{x:Bind Activity.IsVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}">
        <Grid.ChildrenTransitions>
            <TransitionCollection>
                <EntranceThemeTransition />
            </TransitionCollection>
        </Grid.ChildrenTransitions>

        <!-- No Spacing on this panel: StackPanel reserves it between child *slots*, including
             collapsed ones, so a folded card paid 5px for the hidden timeline and another 5px
             for the hidden error line — a blank strip under the header with nothing in it. The
             gaps live on the children's own margins instead, which a collapsed element does not
             contribute. -->
        <StackPanel>
            <!-- Header row. Gone when the turn ran exactly one tool: the step below says
                 everything this row would have summarised, and the disclosure it carries has
                 nothing left to disclose. -->
            <Button MinHeight="30"
                    Visibility="{x:Bind Activity.ShowCardChrome, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                    Padding="0,4"
                    Background="Transparent"
                    BorderThickness="0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Style="{StaticResource TransparentButtonStyle}"
                    Click="Header_Click"
                    PointerEntered="Header_PointerEntered"
                    PointerExited="Header_PointerExited"
                    AutomationProperties.Name="{x:Bind Activity.AccessibilityName, Mode=OneWay}">
                <!-- Title | summary + chevron | spacer.
                     The trailing star column is what keeps the group left-aligned: the chevron
                     sits directly after the summary text rather than being pushed to the far
                     right edge of the card. The header duration that used to occupy the right
                     edge is gone — Complete() already appends it to the summary text itself
                     ("… · 3 steps · 1.4 s"), so it was the same number twice. -->
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="HeaderTitle"
                               Text="Tool activity"
                               FontSize="14"
                               Foreground="{ThemeResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="2"
                                VerticalAlignment="Center">
                        <!-- MaxWidth is required for TextTrimming to do anything: the column is
                             Auto now, so without a cap a long summary would size the column to
                             its full width and never ellipsize. -->
                        <!-- The collapsed card's only chance to say a tool broke, so the summary
                             goes red too when it did ("Tool execution failed · …"). -->
                        <TextBlock Text="{x:Bind Activity.Summary, Mode=OneWay}"
                                   MaxWidth="560"
                                   FontSize="11"
                                   Foreground="{x:Bind Activity.Status, Mode=OneWay, Converter={StaticResource ToolStatusToBrush}, ConverterParameter='danger-only:TextTertiaryBrush'}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                        <!-- One rotated ChevronDown, exactly as the sidebar's agent rows do it
                             (ShellAgentItem.ChevronAngle): down when open, turned to point right
                             when closed. It used to be a Up/Down pair swapped by Visibility, which
                             turned the wrong way — up/down instead of the sidebar's down/right —
                             for the same disclosure gesture.

                             No fixed-size wrapper either. The pair sat in a 16x16 Grid, but a 12px
                             icon is a 12px *font*, and a TextBlock's line box at that size is
                             ~16-17px tall — so the glyph overflowed the Grid and was clipped along
                             the bottom. Sizing comes from the icon itself now, and nothing clips
                             it. The rotation is a RenderTransform, which does not affect layout,
                             so turning it cannot reintroduce the overflow. -->
                        <ic:FluentIcon x:Name="HeaderChevron"
                                       Icon="ChevronDown"
                                       IconVariant="Regular"
                                       IconSize="Size12"
                                       VerticalAlignment="Center"
                                       Opacity="0"
                                       Foreground="{ThemeResource TextTertiaryBrush}"
                                       RenderTransformOrigin="0.5,0.5">
                            <ic:FluentIcon.RenderTransform>
                                <RotateTransform Angle="{x:Bind Activity.ChevronAngle, Mode=OneWay}" />
                            </ic:FluentIcon.RenderTransform>
                        </ic:FluentIcon>
                    </StackPanel>
                </Grid>
            </Button>

            <!-- Collapsed-only failure line. A folded card otherwise reports that something went
                 wrong without saying what ("Tool execution completed · 1 steps had issues"), so
                 the user has to open it to find out whether it mattered. Hidden once expanded —
                 the failed step prints the same text in full down in its Error block. -->
            <TextBlock Text="{x:Bind Activity.LastErrorMessage, Mode=OneWay}"
                       Visibility="{x:Bind Activity.ShowCollapsedError, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                       Margin="0,1,0,3"
                       FontSize="11"
                       Foreground="{ThemeResource DangerBrush}"
                       TextTrimming="CharacterEllipsis"
                       IsTextSelectionEnabled="True" />

            <!-- Timeline panel. Named because Header_Click hands it to the disclosure animation
                 explicitly: DisclosureAnimation.FindContentAfter would take the header's first
                 sibling, which is the collapsed error line above. -->
            <!-- The 9px indent sets the timeline in under its header. With no header — the single
                 step case — there is nothing to sit under, and the inset would leave the row
                 hanging a few pixels right of every other bubble in the transcript, so it goes to
                 zero and the step starts on the chat column's left edge like any other message. -->
            <Grid x:Name="TimelinePanel"
                  Margin="{x:Bind Activity.ShowCardChrome, Mode=OneWay, Converter={StaticResource BoolToThickness}, ConverterParameter='9,5,0,0|0,0,0,0'}"
                  Visibility="{x:Bind Activity.IsTimelineVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <!-- The connecting rule is what makes a list of steps read as a timeline. One
                     step is not a timeline, so it draws no thread. -->
                <Border Width="1"
                        Visibility="{x:Bind Activity.ShowCardChrome, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                        Background="{ThemeResource BorderDefaultBrush}"
                        HorizontalAlignment="Left"
                        Margin="10,10,0,12" />

                <StackPanel>
                    <ItemsControl ItemsSource="{x:Bind Activity.Steps, Mode=OneWay}"
                                  Margin="0,2,4,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:ToolStepViewModel">
                            <Grid x:Name="StepItemRoot"
                                  Margin="0,2,0,10"
                                  ColumnSpacing="10"
                                  PointerEntered="StepItem_PointerEntered"
                                  PointerExited="StepItem_PointerExited">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="21" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- The timeline node identifies the tool, and its colour reports
                                     how the step went: red failed, amber needs attention, grey
                                     otherwise. Shape says what ran, colour says how it went — one
                                     node answering both, rather than the ✓/✕ glyph that could only
                                     answer the second. The glyph still reaches screen readers
                                     through the step's AccessibilityName, built from StatusGlyph.

                                     "muted-success", so a run of successful steps stays quiet grey
                                     instead of a column of green: success is the expected outcome
                                     and colour is worth more when it is reserved for the rows that
                                     actually want attention. -->
                                <Border Width="21"
                                        Height="21"
                                        CornerRadius="10.5"
                                        Background="{ThemeResource ChatBackgroundBrush}"
                                        VerticalAlignment="Top">
                                    <!-- Size16 scaled to 12 — the repo idiom, and mandatory here:
                                         Globe, Database, Screenshot and WindowDevTools ship no
                                         Size12 design and would render as a silent blank. The
                                         16px layout slot still fits inside the 21px node. -->
                                    <ic:FluentIcon Icon="{x:Bind IconKind, Converter={StaticResource ToolIcon}}"
                                                   IconVariant="Regular"
                                                   IconSize="Size16"
                                                   RenderTransformOrigin="0.5,0.5"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{x:Bind Status, Mode=OneWay, Converter={StaticResource ToolStatusToBrush}, ConverterParameter=muted-success}">
                                        <ic:FluentIcon.RenderTransform>
                                            <ScaleTransform ScaleX="0.75" ScaleY="0.75" />
                                        </ic:FluentIcon.RenderTransform>
                                    </ic:FluentIcon>
                                </Border>

                                <StackPanel Grid.Column="1"
                                            Spacing="5">
                                    <!-- Step header -->
                                    <Button MinHeight="0"
                                            Padding="0,1,0,3"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            CornerRadius="4"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            Style="{StaticResource TransparentButtonStyle}"
                                            Click="Step_Click"
                                            Tag="{x:Bind}"
                                            AutomationProperties.Name="{x:Bind AccessibilityName, Mode=OneWay}">
                                        <!-- Two columns: name/target, then duration. A step used to
                                             carry a hover-revealed chevron in a third column; the
                                             row is still click-to-expand, and hover still lifts
                                             the name to the primary foreground, but the icon
                                             itself is gone. -->
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Spacing="2">
                                                <TextBlock x:Name="StepNameText"
                                                           Text="{x:Bind DisplayName, Mode=OneWay}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{x:Bind Status, Mode=OneWay, Converter={StaticResource ToolStatusToBrush}, ConverterParameter=danger-only}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <!-- The step's *target* only ("a.txt"), not its
                                                     result summary. A collapsed step says what
                                                     the tool was pointed at; what came back is
                                                     the Result block one click away, so printing
                                                     a digest of it here was the same information
                                                     twice at two levels of fidelity. Summary is
                                                     still collected and still read out by
                                                     AccessibilityName — this is a display choice,
                                                     not a collection one. -->
                                                <TextBlock Text="{x:Bind DisplayTarget, Mode=OneWay}"
                                                           FontSize="12"
                                                           Foreground="{ThemeResource TextSecondaryBrush}"
                                                           TextWrapping="WrapWholeWords"
                                                           MaxLines="2"
                                                           Visibility="{x:Bind HasDisplayTarget, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="1"
                                                       Text="{x:Bind DurationLabel, Mode=OneWay}"
                                                       FontSize="11"
                                                       Foreground="{ThemeResource TextTertiaryBrush}"
                                                       VerticalAlignment="Top"
                                                       Margin="12,2,0,0" />

                                        </Grid>
                                    </Button>

                                    <!-- Per-step expanded content -->
                                    <ScrollViewer MaxHeight="330"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  Visibility="{x:Bind IsExpanded, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                        <!-- The step's Input (its arguments) is deliberately not
                                             rendered. The header row already names the tool and
                                             its target ("Read file · a.txt"), which is the part
                                             a user is scanning for; the raw argument JSON was
                                             noise above the result. The data is still captured
                                             on the step (redacted, and persisted in event_args)
                                             — this is a display choice, not a collection one, so
                                             re-adding a block bound to Arguments restores it. -->
                                        <!-- One output block, not a Result card plus an Error
                                             card. A failed step carries the same text in both
                                             fields, so two cards printed the same message twice.
                                             Status drives the accent (DangerBrush when failed)
                                             through ToolStatusToBrushConverter, and DetailLabel
                                             switches the heading — the styling carries the
                                             success/failure distinction the second card used to. -->
                                        <StackPanel Spacing="7">
                                            <!-- No status-coloured left rule. The step's own
                                                 status glyph in the timeline gutter already says
                                                 whether it succeeded, and the body's heading
                                                 switches to "Error" when it did not — a second,
                                                 full-height colour bar on every single step made
                                                 a long tool card read as a stack of alerts. -->
                                            <Border Background="{ThemeResource SurfaceElevatedBrush}"
                                                    CornerRadius="4"
                                                    Padding="10,8"
                                                    Visibility="{x:Bind HasDetail, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                                <StackPanel Spacing="5">
                                                    <TextBlock Text="{x:Bind DetailLabel, Mode=OneWay}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{x:Bind Status, Mode=OneWay, Converter={StaticResource ToolStatusToBrush}}" />
                                                    <!-- Content-aware: a JSON result is
                                                         re-indented and syntax coloured, anything
                                                         else renders exactly as the tool sent it.
                                                         See ToolResultFormatter. -->
                                                    <controls:ToolResultTextBlock
                                                        Text="{x:Bind DetailText, Mode=OneWay}" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Completion marker. Suppressed for a single step, whose own node already
                         carries the outcome in exactly the same colour — a second "Done" row under
                         a one-row card restates it. -->
                    <Grid ColumnSpacing="10" Margin="0,0,4,0"
                          Visibility="{x:Bind Activity.ShowCardChrome, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="21" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="21"
                                Height="21"
                                CornerRadius="10.5"
                                Background="{ThemeResource ChatBackgroundBrush}">
                            <!-- A FluentIcon, not the literal StatusGlyph character. "⚠" (U+26A0)
                                 has emoji presentation on Windows: it renders through Segoe UI
                                 Emoji in that font's own orange and ignores Foreground outright,
                                 so the warning triangle could never be themed, muted, or turned
                                 red like every other status. FluentIcons glyphs carry no colour of
                                 their own, so this one takes the brush. StatusGlyph itself stays —
                                 it is what AccessibilityName reads out. -->
                            <ic:FluentIcon Icon="{x:Bind Activity.Status, Mode=OneWay, Converter={StaticResource ToolStatusToIcon}}"
                                           IconVariant="Regular"
                                           IconSize="Size16"
                                           RenderTransformOrigin="0.5,0.5"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{x:Bind Activity.Status, Mode=OneWay, Converter={StaticResource ToolStatusToBrush}}">
                                <ic:FluentIcon.RenderTransform>
                                    <ScaleTransform ScaleX="0.75" ScaleY="0.75" />
                                </ic:FluentIcon.RenderTransform>
                            </ic:FluentIcon>
                        </Border>
                        <!-- "Failed" turns red; "Done" and the waiting states stay prose-coloured,
                             so the one word meaning something broke is the one that stands out. -->
                        <TextBlock Grid.Column="1"
                                   Text="{x:Bind Activity.CompletionLabel, Mode=OneWay}"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Foreground="{x:Bind Activity.Status, Mode=OneWay, Converter={StaticResource ToolStatusToBrush}, ConverterParameter=danger-only}" />
                    </Grid>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>

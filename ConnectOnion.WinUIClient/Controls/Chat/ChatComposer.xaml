<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ConnectOnion.WinUIClient.Controls.ChatComposer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:models="using:ConnectOnion.WinUIClient.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    SizeChanged="Composer_SizeChanged">

    <StackPanel x:Name="ComposerPanel"
                MaxWidth="{StaticResource ChatComposerWidth}"
                Margin="24,0,24,14"
                HorizontalAlignment="Center"
                Spacing="6"
                Width="{StaticResource ChatComposerWidth}">
        <ScrollViewer x:Name="AttachmentsScrollViewer"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled"
                      HorizontalAlignment="Center"
                      MaxWidth="{StaticResource ChatComposerWidth}"
                      Visibility="Collapsed">
            <ItemsControl x:Name="AttachmentsList" ItemsSource="{x:Bind PendingAttachments}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:PendingAttachment">
                        <Border Width="180"
                                Height="56"
                                CornerRadius="10"
                                Padding="8,6"
                                Background="{ThemeResource SurfaceElevatedBrush}"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource BorderDefaultBrush}">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid Width="36" Height="36" VerticalAlignment="Center">
                                    <Border CornerRadius="6"
                                            Background="{ThemeResource SurfaceSecondaryBrush}"
                                            Visibility="{x:Bind IsImage, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                                        <ic:FluentIcon Icon="DocumentText"
                                                       IconVariant="Regular"
                                                       IconSize="Size20"
                                                       Foreground="{ThemeResource TextSecondaryBrush}" />
                                    </Border>
                                    <Border CornerRadius="6"
                                            Visibility="{x:Bind IsImage, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                        <Image Source="{x:Bind LocalPath, Mode=OneWay, Converter={StaticResource PathToImage}}"
                                               Stretch="UniformToFill" />
                                    </Border>
                                    <ProgressRing Width="18" Height="18"
                                                  IsActive="{x:Bind IsBusy, Mode=OneWay}"
                                                  Visibility="{x:Bind IsBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                    <ic:FluentIcon Icon="ErrorCircle"
                                                   IconVariant="Filled"
                                                   IconSize="Size16"
                                                   Foreground="{ThemeResource DangerBrush}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Bottom"
                                                   Visibility="{x:Bind IsFailed, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                                   ToolTipService.ToolTip="{x:Bind Error, Mode=OneWay}" />
                                </Grid>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Text="{x:Bind FileName}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               MaxLines="1" />
                                    <TextBlock Text="{x:Bind SizeLabel}"
                                               FontSize="10"
                                               Foreground="{ThemeResource TextSecondaryBrush}"
                                               Visibility="{x:Bind IsFailed, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                                    <TextBlock Text="{x:Bind Error, Mode=OneWay}"
                                               FontSize="10"
                                               Foreground="{ThemeResource DangerBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               MaxLines="1"
                                               Visibility="{x:Bind IsFailed, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>

                                <Button x:Uid="ComposerRemoveAttachment" Grid.Column="2"
                                        Width="22"
                                        Height="22"
                                        Padding="0"
                                        MinWidth="0"
                                        MinHeight="0"
                                        CornerRadius="11"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        VerticalAlignment="Top"
                                        Tag="{x:Bind}"
                                        Click="RemoveAttachment_Click"
                                        ToolTipService.ToolTip="Remove">
                                    <ic:FluentIcon Icon="Dismiss"
                                                   IconVariant="Regular"
                                                   IconSize="Size12"
                                                   Foreground="{ThemeResource TextSecondaryBrush}" />
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- The agent's own best skills, phrased as offers. Shown instead of the generic starters
             below whenever there are any, because "Publish a post to your feed" tells a user what
             this agent is for and "What can you do?" tells them nothing. -->
        <ItemsControl x:Name="SkillSuggestionList"
                      Visibility="Collapsed"
                      HorizontalAlignment="Center">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="8" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Content="{Binding}"
                            Tag="{Binding}"
                            Padding="14,6"
                            CornerRadius="16"
                            Background="{ThemeResource SurfaceElevatedBrush}"
                            BorderBrush="{ThemeResource BorderDefaultBrush}"
                            BorderThickness="1"
                            Click="Suggestion_Click" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Generic fallback for an agent that declares no usable skills. Kept as literal buttons
             rather than folded into the list above because each carries an x:Uid, and a templated
             item cannot. -->
        <StackPanel x:Name="SuggestionPanel"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Spacing="8">
            <Button x:Uid="ComposerSuggestionCapabilities" Content="What can you do?"
                    Tag="What can you do?"
                    Padding="14,6"
                    CornerRadius="16"
                    Background="{ThemeResource SurfaceElevatedBrush}"
                    BorderBrush="{ThemeResource BorderDefaultBrush}"
                    BorderThickness="1"
                    Click="Suggestion_Click" />
            <Button x:Uid="ComposerSuggestionSystem" Content="Show system info"
                    Tag="Show system info"
                    Padding="14,6"
                    CornerRadius="16"
                    Background="{ThemeResource SurfaceElevatedBrush}"
                    BorderBrush="{ThemeResource BorderDefaultBrush}"
                    BorderThickness="1"
                    Click="Suggestion_Click" />
            <Button x:Uid="ComposerSuggestionFiles" Content="List files"
                    Tag="List files in current directory"
                    Padding="14,6"
                    CornerRadius="16"
                    Background="{ThemeResource SurfaceElevatedBrush}"
                    BorderBrush="{ThemeResource BorderDefaultBrush}"
                    BorderThickness="1"
                    Click="Suggestion_Click" />
        </StackPanel>

        <!-- Slash-command palette: the agent's own skills, filtered as the user types after "/".
             Sits directly above the input because it completes what is being typed there, and it
             is the reason /info's `skills` are fetched at all — until now nothing consumed them.

             Classic {Binding}, not {x:Bind}: SkillInfo is a positional record, so its properties
             have `init` accessors, and those break the generated XamlTypeInfo metadata with a
             CS9035 (see the WinUI gotchas in CLAUDE.md). -->
        <Border x:Name="SkillPalette"
                Visibility="Collapsed"
                CornerRadius="12"
                Background="{ThemeResource SurfaceElevatedBrush}"
                BorderBrush="{ThemeResource BorderDefaultBrush}"
                BorderThickness="1">
            <StackPanel>
                <ListView x:Name="SkillList"
                          MaxHeight="240"
                          SelectionMode="Single"
                          IsItemClickEnabled="True"
                          ItemClick="SkillList_ItemClick"
                          Padding="4"
                          AutomationProperties.Name="Agent skills">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="Padding" Value="10,6" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <!-- Named explicitly: without it the item's automation name falls back
                                 to the data object's ToString(), and SkillInfo is a record — a
                                 screen reader would read out "SkillInfo { Name = post,
                                 Description = ... }" for every row. -->
                            <Grid ColumnSpacing="10"
                                  AutomationProperties.Name="{Binding Name}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontSize="13"
                                           FontWeight="SemiBold"
                                           FontFamily="{StaticResource JetBrainsMonoFontFamily}"
                                           VerticalAlignment="Center"><Run Text="/" /><Run Text="{Binding Name}" /></TextBlock>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Description}"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <!-- The keys are stated because none of them are discoverable: the palette steals
                     Enter and Tab while it is open, and a user who cannot see that has no way to
                     know why Enter stopped sending. -->
                <Border BorderBrush="{ThemeResource BorderSubtleBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="14,5">
                            <TextBlock x:Uid="ComposerCommandNavigation" Text="↑↓ navigate · Tab or Enter to complete · Esc to dismiss"
                               FontSize="11"
                               Foreground="{ThemeResource TextTertiaryBrush}" />
                </Border>
            </StackPanel>
        </Border>

        <!-- AllowDrop lives on this Border rather than on InputBox or the outer panel:
             the drag events are routed, so every child (input box, buttons) bubbles up
             to one handler, and the drop region visually matches the rounded surface
             the DropOverlay paints over. -->
        <Border x:Name="ComposerSurface"
                CornerRadius="12"
                Background="{ThemeResource ComposerBackgroundBrush}"
                BorderBrush="{ThemeResource ComposerBorderBrush}"
                BorderThickness="1"
                AllowDrop="True"
                DragEnter="Composer_DragEnter"
                DragOver="Composer_DragOver"
                DragLeave="Composer_DragLeave"
                Drop="Composer_Drop">
            <Grid MinHeight="76" Padding="12,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Top, against the app-wide implicit style's centring (ControlStyles.xaml):
                     that centring is for single-line fields, and this one wraps and grows, so
                     its text has to start at the top and run down. -->
                <TextBox x:Name="InputBox"
                         VerticalContentAlignment="Top"
                         AutomationProperties.AutomationId="MessageInput"
                         Grid.Row="0"
                         MinHeight="32"
                         MaxHeight="144"
                         Padding="0,3,0,3"
                         x:Uid="ComposerInput"
                         PlaceholderText="{x:Bind PlaceholderText, Mode=OneWay}"
                         PlaceholderForeground="{ThemeResource ComposerPlaceholderBrush}"
                         Foreground="{ThemeResource ComposerTextBrush}"
                         FontSize="15"
                         FontWeight="Normal"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                         BorderThickness="0"
                         Background="Transparent"
                         VerticalAlignment="Stretch"
                         TextChanged="InputBox_TextChanged"
                         GotFocus="InputBox_GotFocus"
                         PreviewKeyDown="InputBox_PreviewKeyDown">
                    <TextBox.Resources>
                        <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                        <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                        <!-- Keep the input transparent across every visual state so the outer
                             composer Border's color shows through unchanged — WinUI's TextBox
                             otherwise paints its own PointerOver/Focused background over the
                             transparent default, making the field flash a different shade on
                             hover and while typing. -->
                        <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent" />
                    </TextBox.Resources>
                </TextBox>

                <Grid Grid.Row="1"
                      Margin="0,4,0,0"
                      ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button x:Uid="ComposerAddAttachment" x:Name="AddAttachmentButton"
                            AutomationProperties.Name="Add attachment"
                            Grid.Column="0"
                            Width="34"
                            Height="34"
                            Padding="0"
                            CornerRadius="17"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="AddAttachment_Click"
                            ToolTipService.ToolTip="Add attachment">
                        <ic:FluentIcon Icon="Add"
                                       IconVariant="Regular"
                                       IconSize="Size20"
                                       Foreground="{ThemeResource TextPrimaryBrush}" />
                    </Button>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="6"
                                Margin="4,0,0,0"
                                VerticalAlignment="Center"
                                Visibility="{x:Bind ShowConnectionStatus, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <Ellipse Width="7"
                                 Height="7"
                                 VerticalAlignment="Center"
                                 Fill="{x:Bind ConnectionPhase, Mode=OneWay, Converter={StaticResource ConnectionPhaseToBrush}}" />
                        <TextBlock Text="{x:Bind ConnectionStatusText, Mode=OneWay}"
                                   AutomationProperties.AutomationId="ConnectionStatus"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Foreground="{x:Bind ConnectionPhase, Mode=OneWay, Converter={StaticResource ConnectionPhaseToBrush}}" />

                        <!-- The turn's running spend, beside the connection state rather than in
                             its own row: both answer "what is happening right now", and a second
                             row would push the input down every time a turn starts. Tertiary and
                             unpunctuated by a separator when absent — it collapses entirely for an
                             agent that reports no usage. -->
                        <TextBlock Text="{x:Bind UsageText, Mode=OneWay}"
                                   AutomationProperties.AutomationId="LiveUsage"
                                   FontSize="12"
                                   Margin="4,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextTertiaryBrush}"
                                   Visibility="{x:Bind HasUsageText, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <!-- Approval mode. Stays enabled mid-turn: the host applies a mode_change at
                         the agent's next iteration boundary, so switching to Safe while it works
                         is a real (if not instant) way to get approval prompts back. -->
                    <DropDownButton x:Name="ModeButton"
                                     AutomationProperties.AutomationId="ApprovalModeButton"
                                    Grid.Column="2"
                                    Height="34"
                                    Padding="9,0"
                                    CornerRadius="17"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ic:FluentIcon x:Name="ModeIcon"
                                            Icon="ShieldTask"
                                            IconVariant="Regular"
                                            IconSize="Size16"
                                            Foreground="{ThemeResource TextSecondaryBrush}" />
                            <TextBlock x:Name="ModeLabel"
                                       x:Uid="ComposerSafeMode" Text="Safe"
                                        FontSize="12"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextSecondaryBrush}" />
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <MenuFlyout Placement="Top">
                                <RadioMenuFlyoutItem x:Name="ModeSafeItem"
                                                     x:Uid="ComposerSafeModeDescription" Text="Safe — approve dangerous tools"
                                                     GroupName="ComposerApprovalMode"
                                                     Tag="safe"
                                                     Click="Mode_Click" />
                                <RadioMenuFlyoutItem x:Name="ModeAcceptEditsItem"
                                                     x:Uid="ComposerAcceptEditsDescription" Text="Accept edits — file writes run unprompted"
                                                     GroupName="ComposerApprovalMode"
                                                     Tag="accept_edits"
                                                     Click="Mode_Click" />
                                <RadioMenuFlyoutItem x:Name="ModePlanItem"
                                                     x:Uid="ComposerPlanDescription" Text="Plan — research first, then review a plan"
                                                     GroupName="ComposerApprovalMode"
                                                     Tag="plan"
                                                     Click="Mode_Click" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>

                    <Grid x:Name="RecordingWaveformHost"
                          Grid.Column="1"
                          Height="34"
                          MinWidth="120"
                          Visibility="Collapsed">
                        <Border Background="{ThemeResource SurfaceElevatedBrush}"
                                CornerRadius="4" />
                        <!-- A plain XAML Canvas is intentional. CanvasAnimatedControl creates a
                             swap chain and native render threads even before recording starts. -->
                        <Canvas x:Name="WaveformCanvas"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Background="{ThemeResource SurfaceElevatedBrush}"
                                SizeChanged="WaveformCanvas_SizeChanged">
                            <Line x:Name="WaveformBaseline"
                                  Stroke="{ThemeResource BorderStrongBrush}"
                                  StrokeThickness="1"
                                  StrokeDashArray="2,2" />
                        </Canvas>
                        <ProgressRing x:Name="BufferSpinner"
                                      Width="18"
                                      Height="18"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      IsActive="False"
                                      Visibility="Collapsed"
                                      Foreground="{ThemeResource ComposerMutedControlBrush}" />
                        <TextBlock x:Name="WaveformTimerText"
                                   Text="0:00"
                                   FontSize="11"
                                   Foreground="{ThemeResource TextTertiaryBrush}"
                                   VerticalAlignment="Bottom"
                                   HorizontalAlignment="Right"
                                   Margin="0,0,8,3" />
                    </Grid>

                    <Button x:Uid="ComposerVoiceInput" x:Name="SpeechButton"
                            AutomationProperties.Name="Voice input"
                            Grid.Column="3"
                            Width="34"
                            Height="34"
                            Padding="0"
                            CornerRadius="17"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Click="Speech_Click"
                            ToolTipService.ToolTip="Voice input">
                        <Grid Width="20" Height="20">
                            <ic:FluentIcon x:Name="SpeechIcon"
                                           Icon="Mic"
                                           IconVariant="Regular"
                                           IconSize="Size20"
                                           Foreground="{ThemeResource ComposerMutedControlBrush}" />
                            <ProgressRing x:Name="SpeechRing"
                                          Width="18"
                                          Height="18"
                                          IsActive="False"
                                          Visibility="Collapsed" />
                        </Grid>
                    </Button>

                    <Button x:Uid="ComposerStopVoiceInput" x:Name="StopSpeechButton"
                            AutomationProperties.AutomationId="StopVoiceInputButton"
                            AutomationProperties.Name="Stop voice input"
                            Grid.Column="3"
                            Width="34"
                            Height="34"
                            Padding="0"
                            CornerRadius="17"
                            Background="{ThemeResource ComposerStopButtonBackgroundBrush}"
                            BorderThickness="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Click="StopSpeech_Click"
                            Visibility="Collapsed"
                            ToolTipService.ToolTip="Stop voice input">
                        <Rectangle Width="9"
                                   Height="9"
                                   RadiusX="1"
                                   RadiusY="1"
                                   Fill="{ThemeResource ComposerStopButtonForegroundBrush}" />
                    </Button>

                    <Button x:Uid="ComposerSendMessage" x:Name="SendButton"
                            AutomationProperties.AutomationId="SendMessageButton"
                            AutomationProperties.Name="Send message"
                            Grid.Column="4"
                            Width="36"
                            Height="36"
                            Padding="0"
                            CornerRadius="18"
                            BorderThickness="0"
                            Background="{ThemeResource ComposerPrimaryButtonBackgroundBrush}"
                            IsEnabled="False"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Click="Send_Click"
                            ToolTipService.ToolTip="Send message">
                        <Grid Width="20" Height="20">
                            <ic:FluentIcon x:Name="SendIcon"
                                           Icon="ArrowUp"
                                           IconVariant="Regular"
                                           IconSize="Size20"
                                           Foreground="{ThemeResource ComposerPrimaryButtonForegroundBrush}" />
                        </Grid>
                    </Button>

                    <!-- Takes the send button's place for the whole turn. The ring around the
                         square is the busy indicator the send button used to show inline: a turn
                         in flight is exactly when stopping is possible, so the same slot can carry
                         both without either being hidden behind a mode switch. -->
                    <Button x:Name="StopButton"
                            AutomationProperties.AutomationId="StopResponseButton"
                            AutomationProperties.Name="Stop response"
                            Grid.Column="4"
                            Width="36"
                            Height="36"
                            Padding="0"
                            CornerRadius="18"
                            BorderThickness="0"
                            Background="{ThemeResource ComposerPrimaryButtonBackgroundBrush}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Visibility="Collapsed"
                            Click="Stop_Click">
                        <Rectangle x:Name="StopGlyph"
                                   Width="9"
                                   Height="9"
                                   RadiusX="1"
                                   RadiusY="1"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Fill="{ThemeResource ComposerPrimaryButtonForegroundBrush}" />
                    </Button>
                </Grid>

                <!-- Drop affordance. Negative margin cancels the parent Grid's Padding so it
                     covers the whole rounded surface. IsHitTestVisible=False keeps it out of
                     the drag hit-test, which would otherwise make DragLeave fire the moment
                     the overlay appears under the pointer. -->
                <Grid x:Name="DropOverlay"
                      Grid.Row="0"
                      Grid.RowSpan="2"
                      Margin="-12,-8,-12,-8"
                      IsHitTestVisible="False"
                      Visibility="Collapsed">
                    <Border CornerRadius="12"
                            Background="{ThemeResource ComposerBackgroundBrush}"
                            Opacity="0.92" />
                    <Rectangle Margin="2"
                               RadiusX="10"
                               RadiusY="10"
                               Fill="Transparent"
                               Stroke="{ThemeResource BrandPrimaryBrush}"
                               StrokeThickness="2"
                               StrokeDashArray="4,3"
                               StrokeDashCap="Round" />
                    <StackPanel Orientation="Horizontal"
                                Spacing="10"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <ic:FluentIcon Icon="ArrowDown"
                                       IconVariant="Regular"
                                       IconSize="Size20"
                                       Foreground="{ThemeResource BrandPrimaryBrush}"
                                       VerticalAlignment="Center" />
                        <TextBlock x:Uid="ComposerDropHint" Text="Drop files to attach"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource BrandPrimaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>

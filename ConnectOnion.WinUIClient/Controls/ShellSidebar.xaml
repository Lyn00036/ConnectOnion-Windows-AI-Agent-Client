<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ConnectOnion.WinUIClient.Controls.ShellSidebar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ConnectOnion.WinUIClient.Controls"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ShellSidebarBrush}"
          Padding="14,18,10,16"
          RowSpacing="10">
        <Grid.Resources>
            <Style x:Key="ShellNavButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="Padding" Value="8,6" />
            </Style>

            <Style x:Key="ShellIconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Width" Value="26" />
                <Setter Property="Height" Value="26" />
                <Setter Property="Padding" Value="0" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Button Grid.Row="0"
                Style="{StaticResource ShellNavButtonStyle}"
                Click="ChatHome_Click">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0"
                            Spacing="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Image Width="32" Height="32" Source="/Assets/icon.png" />
                    <StackPanel Orientation="Horizontal"
                                Spacing="3"
                                HorizontalAlignment="Center"
                                ToolTipService.ToolTip="Online agents">
                        <Ellipse Width="5"
                                 Height="5"
                                 Fill="{ThemeResource StatusSuccessTextBrush}"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="{Binding OnlineAgentCountText}"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource ShellMutedTextBrush}"
                                   TextAlignment="Center" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Text="ConnectOnion"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="2"
                           Text="desktop"
                           FontSize="10"
                           Foreground="{ThemeResource ShellMutedTextBrush}"
                           VerticalAlignment="Center" />
            </Grid>
        </Button>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="4">
                <Button Style="{StaticResource ShellNavButtonStyle}"
                        Click="TogglePinned_Click"
                        ToolTipService.ToolTip="Expand or collapse pinned chats">
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ic:FluentIcon Grid.Column="0"
                                       Icon="ChevronDown"
                                       IconVariant="Regular"
                                       IconSize="Size16"
                                       Foreground="{ThemeResource ShellMutedTextBrush}"
                                       RenderTransformOrigin="0.5,0.5">
                            <ic:FluentIcon.RenderTransform>
                                <RotateTransform Angle="{Binding PinnedChevronAngle}" />
                            </ic:FluentIcon.RenderTransform>
                        </ic:FluentIcon>
                        <TextBlock Grid.Column="1"
                                   Text="Pinned Chats"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource ShellMutedTextBrush}"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Button>

                <ItemsRepeater ItemsSource="{Binding PinnedSessions}"
                               Visibility="{Binding IsPinnedExpanded, Converter={StaticResource BoolToVis}}">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2,0,0"
                                  PointerEntered="SessionRow_PointerEntered"
                                  PointerExited="SessionRow_PointerExited"
                                  GotFocus="SessionRow_GotFocus"
                                  LostFocus="SessionRow_LostFocus">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.ColumnSpan="2"
                                        CornerRadius="8"
                                        Background="{ThemeResource AccentFillColorSecondaryBrush}"
                                        Opacity="0.16"
                                        Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}" />
                                <Border Grid.ColumnSpan="2"
                                        Width="3"
                                        Height="22"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        CornerRadius="2"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}" />
                                <Button Grid.Column="0"
                                        Style="{StaticResource ShellNavButtonStyle}"
                                        Click="Session_Click"
                                        Tag="{Binding Id}"
                                        ToolTipService.ToolTip="{Binding Title}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <ic:FluentIcon Icon="Chat"
                                                       IconVariant="Regular"
                                                       IconSize="Size16"
                                                       Foreground="{ThemeResource ShellMutedTextBrush}" />
                                        <StackPanel MinWidth="0">
                                            <TextBlock Text="{Binding Title}"
                                                       TextTrimming="CharacterEllipsis"
                                                       FontSize="13" />
                                            <TextBlock Text="{Binding AgentName}"
                                                       TextTrimming="CharacterEllipsis"
                                                       FontSize="10"
                                                       Foreground="{ThemeResource ShellMutedTextBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1"
                                        Margin="2,0,0,0"
                                        Style="{StaticResource ShellIconButtonStyle}"
                                        Click="TogglePinSession_Click"
                                        Tag="{Binding Id}"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding AreActionsVisible, Converter={StaticResource BoolToVis}}"
                                        AutomationProperties.Name="{Binding PinToolTip}"
                                        ToolTipService.ToolTip="{Binding PinToolTip}">
                                    <ic:FluentIcon Icon="Pin" IconVariant="Regular" IconSize="Size16" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <TextBlock Text="Agents"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource ShellMutedTextBrush}"
                           Margin="8,0,0,4" />
                <ItemsRepeater ItemsSource="{Binding ShellAgents}">
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,2">
                            <Border CornerRadius="8"
                                    Background="{ThemeResource ShellRowBrush}"
                                    PointerEntered="AgentRow_PointerEntered"
                                    PointerExited="AgentRow_PointerExited"
                                    GotFocus="AgentRow_GotFocus"
                                    LostFocus="AgentRow_LostFocus">
                                <Grid MinHeight="44" Padding="1.5,0" ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.ColumnSpan="4"
                                            CornerRadius="7"
                                            Background="{ThemeResource AccentFillColorSecondaryBrush}"
                                            Opacity="0.18"
                                            Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}" />
                                    <Border Grid.ColumnSpan="4"
                                            Width="3"
                                            Height="24"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            CornerRadius="2"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}" />
                                    <Button Grid.Column="0"
                                            Style="{StaticResource ShellIconButtonStyle}"
                                            Click="ToggleAgent_Click"
                                            Tag="{Binding Id}"
                                            AutomationProperties.Name="Expand or collapse chats"
                                            ToolTipService.ToolTip="Expand or collapse chats">
                                        <ic:FluentIcon Icon="ChevronDown"
                                                       IconVariant="Regular"
                                                       IconSize="Size16"
                                                       Foreground="{ThemeResource ShellMutedTextBrush}"
                                                       RenderTransformOrigin="0.5,0.5">
                                            <ic:FluentIcon.RenderTransform>
                                                <RotateTransform Angle="{Binding ChevronAngle}" />
                                            </ic:FluentIcon.RenderTransform>
                                        </ic:FluentIcon>
                                    </Button>
                                    <Border Grid.Column="1"
                                            Width="26"
                                            Height="26"
                                            VerticalAlignment="Center"
                                            CornerRadius="6"
                                            Background="{ThemeResource TextFillColorPrimaryBrush}">
                                        <TextBlock Text="{Binding Initial}"
                                                   Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <Button Grid.Column="2"
                                            Style="{StaticResource ShellNavButtonStyle}"
                                            Click="Agent_Click"
                                            Tag="{Binding Id}"
                                            Padding="0"
                                            MinHeight="0"
                                            ToolTipService.ToolTip="{Binding Name}">
                                        <Grid ColumnSpacing="7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Name}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                            <Grid Grid.Column="1"
                                                  Width="10"
                                                  Height="10"
                                                  VerticalAlignment="Center"
                                                  ToolTipService.ToolTip="{Binding PresenceLabel}">
                                                <Ellipse Fill="{ThemeResource StatusSuccessTextBrush}"
                                                         Visibility="{Binding IsOnline, Converter={StaticResource BoolToVis}}" />
                                                <Ellipse Stroke="{ThemeResource ShellMutedTextBrush}"
                                                         StrokeThickness="1.5"
                                                         Visibility="{Binding IsOfflineIconVisible, Converter={StaticResource BoolToVis}}" />
                                            </Grid>
                                        </Grid>
                                    </Button>
                                    <StackPanel Grid.Column="3"
                                                Orientation="Horizontal"
                                                Spacing="2"
                                                Width="54"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="2"
                                                    HorizontalAlignment="Right"
                                                    Visibility="{Binding AreActionsVisible, Converter={StaticResource BoolToVis}}">
                                            <Button Style="{StaticResource ShellIconButtonStyle}"
                                                    Click="AddChat_Click"
                                                    Tag="{Binding Id}"
                                                    AutomationProperties.Name="New chat"
                                                    ToolTipService.ToolTip="New chat">
                                                <ic:FluentIcon Icon="Add" IconVariant="Regular" IconSize="Size16" Foreground="{ThemeResource ShellMutedTextBrush}" />
                                            </Button>
                                            <Button Style="{StaticResource ShellIconButtonStyle}"
                                                    Click="DeleteAgent_Click"
                                                    Tag="{Binding Id}"
                                                    AutomationProperties.Name="Delete agent"
                                                    ToolTipService.ToolTip="Delete agent">
                                                <ic:FluentIcon Icon="Delete" IconVariant="Regular" IconSize="Size16" Foreground="{ThemeResource ShellMutedTextBrush}" />
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <ItemsRepeater ItemsSource="{Binding Sessions}"
                                           Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="34,2,0,0"
                                              PointerEntered="SessionRow_PointerEntered"
                                              PointerExited="SessionRow_PointerExited"
                                              GotFocus="SessionRow_GotFocus"
                                              LostFocus="SessionRow_LostFocus">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.ColumnSpan="2"
                                                    CornerRadius="8"
                                                    Background="{ThemeResource AccentFillColorSecondaryBrush}"
                                                    Opacity="0.16"
                                                    Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}" />
                                            <Border Grid.ColumnSpan="2"
                                                    Width="3"
                                                    Height="22"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    CornerRadius="2"
                                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                    Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}" />
                                            <Button Grid.Column="0"
                                                    Style="{StaticResource ShellNavButtonStyle}"
                                                    Click="Session_Click"
                                                    Tag="{Binding Id}">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <ic:FluentIcon Icon="Chat"
                                                                   IconVariant="Regular"
                                                                   IconSize="Size16"
                                                                   Foreground="{ThemeResource ShellMutedTextBrush}" />
                                                    <TextBlock Text="{Binding Title}"
                                                               TextTrimming="CharacterEllipsis"
                                                               FontSize="13" />
                                                </StackPanel>
                                            </Button>
                                            <Button Grid.Column="1"
                                                    Margin="2,0,0,0"
                                                    Style="{StaticResource ShellIconButtonStyle}"
                                                    Click="TogglePinSession_Click"
                                                    Tag="{Binding Id}"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding AreActionsVisible, Converter={StaticResource BoolToVis}}"
                                                    AutomationProperties.Name="{Binding PinToolTip}"
                                                    ToolTipService.ToolTip="{Binding PinToolTip}">
                                                <ic:FluentIcon Icon="Pin" IconVariant="Regular" IconSize="Size16" Foreground="{ThemeResource ShellMutedTextBrush}" />
                                            </Button>
                                            <Button Grid.Column="1"
                                                    Margin="30,0,0,0"
                                                    Style="{StaticResource ShellIconButtonStyle}"
                                                    Click="DeleteSession_Click"
                                                    Tag="{Binding Id}"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding AreActionsVisible, Converter={StaticResource BoolToVis}}"
                                                    AutomationProperties.Name="Delete chat"
                                                    ToolTipService.ToolTip="Delete chat">
                                                <ic:FluentIcon Icon="Delete" IconVariant="Regular" IconSize="Size16" Foreground="{ThemeResource ShellMutedTextBrush}" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Spacing="6">
            <local:AddAgentForm x:Name="AddAgentPanel"
                                Visibility="Collapsed"
                                CloseRequested="AddAgentForm_CloseRequested"
                                AgentAdded="AddAgentForm_AgentAdded" />

            <Button Style="{StaticResource ShellNavButtonStyle}" Click="AddAgent_Click">
                <StackPanel Orientation="Horizontal" Spacing="9">
                    <ic:FluentIcon Icon="Add" IconVariant="Regular" IconSize="Size20" />
                    <TextBlock Text="Add Agent" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource ShellNavButtonStyle}" Click="Settings_Click">
                <StackPanel Orientation="Horizontal" Spacing="9">
                    <ic:FluentIcon Icon="Settings" IconVariant="Regular" IconSize="Size20" />
                    <TextBlock Text="Settings" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>

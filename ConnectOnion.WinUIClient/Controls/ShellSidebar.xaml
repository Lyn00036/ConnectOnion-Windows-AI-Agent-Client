<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ConnectOnion.WinUIClient.Controls.ShellSidebar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ConnectOnion.WinUIClient.Controls"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource SidebarBackgroundBrush}"
          Padding="14,18,10,16"
          RowSpacing="10">
        <Grid.Resources>
            <Style x:Key="ShellNavButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="Padding" Value="8,6" />
            </Style>

            <Style x:Key="ShellIconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Width" Value="26" />
                <Setter Property="Height" Value="26" />
                <Setter Property="Padding" Value="0" />
            </Style>

        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Button Grid.Row="0"
                Style="{StaticResource ShellNavButtonStyle}"
                Click="ChatHome_Click">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0"
                            Spacing="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Image Width="32" Height="32" Source="/Assets/icon.png" />
                    <StackPanel Orientation="Horizontal"
                                Spacing="3"
                                HorizontalAlignment="Center"
                                ToolTipService.ToolTip="Online agents">
                        <Ellipse Width="5"
                                 Height="5"
                                 Fill="{ThemeResource SuccessBrush}"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="{Binding OnlineAgentCountText}"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextSecondaryBrush}"
                                   TextAlignment="Center" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Text="ConnectOnion"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="2"
                           Text="desktop"
                           FontSize="10"
                           Foreground="{ThemeResource TextSecondaryBrush}"
                           VerticalAlignment="Center" />
            </Grid>
        </Button>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="4">
                <Button Style="{StaticResource ShellNavButtonStyle}"
                        Click="TogglePinned_Click"
                        ToolTipService.ToolTip="Expand or collapse pinned chats">
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ic:FluentIcon Grid.Column="0"
                                       Icon="ChevronDown"
                                       IconVariant="Regular"
                                       IconSize="Size16"
                                       Foreground="{ThemeResource TextSecondaryBrush}"
                                       RenderTransformOrigin="0.5,0.5">
                            <ic:FluentIcon.RenderTransform>
                                <RotateTransform Angle="{Binding PinnedChevronAngle}" />
                            </ic:FluentIcon.RenderTransform>
                        </ic:FluentIcon>
                        <TextBlock Grid.Column="1"
                                   Text="Pinned Chats"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Button>

                <ItemsRepeater ItemsSource="{Binding PinnedSessions}"
                               Visibility="{Binding IsPinnedExpanded, Converter={StaticResource BoolToVis}}">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2,0,0"
                                  PointerEntered="Row_PointerEntered"
                                  PointerExited="Row_PointerExited"
                                  GotFocus="Row_GotFocus"
                                  LostFocus="Row_LostFocus">
                                <!--
                                    Shadows the theme's Button chrome resource keys so the
                                    name button and the Pin icon button in this row don't
                                    each paint their own separate PointerOver/Pressed
                                    background — only the unified RowStateToBackground
                                    Border below does. Must be declared inline per
                                    DataTemplate (not a shared StaticResource): WinUI
                                    requires a Resources dictionary to be uniquely owned
                                    per element, and ItemsRepeater re-instantiates this
                                    template once per row.
                                -->
                                <Grid.Resources>
                                    <ResourceDictionary>
                                        <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
                                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
                                        <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                                        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                                    </ResourceDictionary>
                                </Grid.Resources>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.ColumnSpan="2"
                                        CornerRadius="8"
                                        Background="{Binding IsSelected, Converter={StaticResource RowStateToBackground}}"
                                        Visibility="{Binding ShowRowBackground, Converter={StaticResource BoolToVis}}" />
                                <Border Grid.ColumnSpan="2"
                                        Width="3"
                                        Height="22"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        CornerRadius="2"
                                        Background="{ThemeResource SidebarSelectedAccentBrush}"
                                        Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}" />
                                <Button Grid.Column="0"
                                        Style="{StaticResource ShellNavButtonStyle}"
                                        Click="Session_Click"
                                        Tag="{Binding Id}"
                                        ToolTipService.ToolTip="{Binding Title}">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ic:FluentIcon Grid.Column="0"
                                                       Icon="Chat"
                                                       IconVariant="Regular"
                                                       IconSize="Size16"
                                                       VerticalAlignment="Center"
                                                       Foreground="{ThemeResource TextSecondaryBrush}" />
                                        <StackPanel Grid.Column="1" MinWidth="0">
                                            <TextBlock Text="{Binding Title}"
                                                       TextTrimming="CharacterEllipsis"
                                                       FontSize="13" />
                                            <TextBlock Text="{Binding AgentName}"
                                                       TextTrimming="CharacterEllipsis"
                                                       FontSize="10"
                                                       Foreground="{ThemeResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <Button Grid.Column="1"
                                        Margin="2,0,0,0"
                                        Style="{StaticResource ShellIconButtonStyle}"
                                        Click="TogglePinSession_Click"
                                        Tag="{Binding Id}"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding AreActionsVisible, Converter={StaticResource BoolToVis}}"
                                        AutomationProperties.Name="{Binding PinToolTip}"
                                        ToolTipService.ToolTip="{Binding PinToolTip}">
                                    <ic:FluentIcon Icon="Pin" IconVariant="Regular" IconSize="Size12" Foreground="{ThemeResource SidebarSelectedAccentBrush}" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <TextBlock Text="Agents"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextSecondaryBrush}"
                           Margin="8,0,0,4" />
                <ItemsRepeater ItemsSource="{Binding ShellAgents}">
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,2">
                            <Border CornerRadius="8"
                                    Background="{ThemeResource SurfaceSecondaryBrush}"
                                    PointerEntered="Row_PointerEntered"
                                    PointerExited="Row_PointerExited"
                                    GotFocus="Row_GotFocus"
                                    LostFocus="Row_LostFocus">
                                <Border.Resources>
                                    <ResourceDictionary>
                                        <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
                                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
                                        <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                                        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                                    </ResourceDictionary>
                                </Border.Resources>
                                <Grid MinHeight="44" Padding="1.5,0" ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.ColumnSpan="4"
                                            CornerRadius="7"
                                            Background="{Binding IsSelected, Converter={StaticResource RowStateToBackground}}"
                                            Visibility="{Binding ShowRowBackground, Converter={StaticResource BoolToVis}}" />
                                    <Border Grid.ColumnSpan="4"
                                            Width="3"
                                            Height="24"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            CornerRadius="2"
                                            Background="{ThemeResource SidebarSelectedAccentBrush}"
                                            Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}" />
                                    <Button Grid.Column="0"
                                            Style="{StaticResource ShellIconButtonStyle}"
                                            Click="ToggleAgent_Click"
                                            Tag="{Binding Id}"
                                            AutomationProperties.Name="Expand or collapse chats"
                                            ToolTipService.ToolTip="Expand or collapse chats">
                                        <ic:FluentIcon Icon="ChevronDown"
                                                       IconVariant="Regular"
                                                       IconSize="Size16"
                                                       Foreground="{ThemeResource TextSecondaryBrush}"
                                                       RenderTransformOrigin="0.5,0.5">
                                            <ic:FluentIcon.RenderTransform>
                                                <RotateTransform Angle="{Binding ChevronAngle}" />
                                            </ic:FluentIcon.RenderTransform>
                                        </ic:FluentIcon>
                                    </Button>
                                    <local:AgentAvatar Grid.Column="1"
                                                       Size="26"
                                                       CornerRadius="6"
                                                       FontSize="11"
                                                       VerticalAlignment="Center"
                                                       Initial="{Binding Initial}" />
                                    <Button Grid.Column="2"
                                            Style="{StaticResource ShellNavButtonStyle}"
                                            Click="Agent_Click"
                                            Tag="{Binding Id}"
                                            Padding="0"
                                            MinHeight="0"
                                            ToolTipService.ToolTip="{Binding Name}">
                                        <!-- Name column is * (not Auto) so it only ever claims the space
                                             left over after the Auto-width presence dot, shrinking via
                                             TextTrimming instead of overflowing past the row and pushing/
                                             hiding the dot when the name is longer than the row is wide. -->
                                        <Grid ColumnSpacing="7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Name}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                            <Grid Grid.Column="1"
                                                  Width="10"
                                                  Height="10"
                                                  VerticalAlignment="Center"
                                                  ToolTipService.ToolTip="{Binding PresenceLabel}">
                                                <!-- Breathing effect for the online status dot: slow opacity
                                                     fade, forever, started from code-behind on Loaded (see
                                                     OnlinePresenceDot_Loaded) — WinUI's FrameworkElement.Triggers/
                                                     EventTrigger doesn't support a RoutedEvent attribute the way
                                                     WPF's does, so a XAML-only trigger isn't an option here. -->
                                                <Ellipse Fill="{ThemeResource SuccessBrush}"
                                                         Visibility="{Binding IsOnline, Converter={StaticResource BoolToVis}}"
                                                         Loaded="OnlinePresenceDot_Loaded" />
                                                <Ellipse Stroke="{ThemeResource TextSecondaryBrush}"
                                                         StrokeThickness="1.5"
                                                         Visibility="{Binding IsOfflineIconVisible, Converter={StaticResource BoolToVis}}" />
                                            </Grid>
                                        </Grid>
                                    </Button>
                                    <StackPanel Grid.Column="3"
                                                Orientation="Horizontal"
                                                Spacing="2"
                                                Width="54"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="2"
                                                    HorizontalAlignment="Right"
                                                    Visibility="{Binding AreActionsVisible, Converter={StaticResource BoolToVis}}">
                                            <Button Style="{StaticResource ShellIconButtonStyle}"
                                                    Click="AddChat_Click"
                                                    Tag="{Binding Id}"
                                                    AutomationProperties.Name="New chat"
                                                    ToolTipService.ToolTip="New chat">
                                                <ic:FluentIcon Icon="Add" IconVariant="Regular" IconSize="Size12" RenderTransformOrigin="0.5,0.5" Foreground="{ThemeResource TextSecondaryBrush}">
                                                    <ic:FluentIcon.RenderTransform>
                                                        <ScaleTransform ScaleX="0.83" ScaleY="0.83" />
                                                    </ic:FluentIcon.RenderTransform>
                                                </ic:FluentIcon>
                                            </Button>
                                            <Button Style="{StaticResource ShellIconButtonStyle}"
                                                    Click="DeleteAgent_Click"
                                                    Tag="{Binding Id}"
                                                    AutomationProperties.Name="Delete agent"
                                                    ToolTipService.ToolTip="Delete agent">
                                                <ic:FluentIcon Icon="Dismiss" IconVariant="Regular" IconSize="Size12" RenderTransformOrigin="0.5,0.5" Foreground="{ThemeResource TextSecondaryBrush}">
                                                    <ic:FluentIcon.RenderTransform>
                                                        <ScaleTransform ScaleX="0.83" ScaleY="0.83" />
                                                    </ic:FluentIcon.RenderTransform>
                                                </ic:FluentIcon>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <ItemsRepeater ItemsSource="{Binding Sessions}"
                                           Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="34,2,0,0"
                                              PointerEntered="Row_PointerEntered"
                                              PointerExited="Row_PointerExited"
                                              GotFocus="Row_GotFocus"
                                              LostFocus="Row_LostFocus">
                                            <Grid.Resources>
                                                <ResourceDictionary>
                                                    <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                                                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
                                                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
                                                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                                                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                                                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                                                </ResourceDictionary>
                                            </Grid.Resources>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.ColumnSpan="2"
                                                    CornerRadius="8"
                                                    Background="{Binding IsSelected, Converter={StaticResource RowStateToBackground}}"
                                                    Visibility="{Binding ShowRowBackground, Converter={StaticResource BoolToVis}}" />
                                            <Border Grid.ColumnSpan="2"
                                                    Width="3"
                                                    Height="22"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    CornerRadius="2"
                                                    Background="{ThemeResource SidebarSelectedAccentBrush}"
                                                    Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}" />
                                            <Button Grid.Column="0"
                                                    Style="{StaticResource ShellNavButtonStyle}"
                                                    Click="Session_Click"
                                                    Tag="{Binding Id}"
                                                    ToolTipService.ToolTip="{Binding Title}">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <ic:FluentIcon Grid.Column="0"
                                                                   Icon="Chat"
                                                                   IconVariant="Regular"
                                                                   IconSize="Size16"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{ThemeResource TextSecondaryBrush}" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Title}"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"
                                                               FontSize="13" />
                                                </Grid>
                                            </Button>
                                            <Button Grid.Column="1"
                                                    Margin="2,0,0,0"
                                                    Style="{StaticResource ShellIconButtonStyle}"
                                                    Click="TogglePinSession_Click"
                                                    Tag="{Binding Id}"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding AreActionsVisible, Converter={StaticResource BoolToVis}}"
                                                    AutomationProperties.Name="{Binding PinToolTip}"
                                                    ToolTipService.ToolTip="{Binding PinToolTip}">
                                                <ic:FluentIcon Icon="Pin" IconVariant="Regular" IconSize="Size12" RenderTransformOrigin="0.5,0.5" Foreground="{ThemeResource TextSecondaryBrush}">
                                                    <ic:FluentIcon.RenderTransform>
                                                        <ScaleTransform ScaleX="0.83" ScaleY="0.83" />
                                                    </ic:FluentIcon.RenderTransform>
                                                </ic:FluentIcon>
                                            </Button>
                                            <Button Grid.Column="1"
                                                    Margin="30,0,0,0"
                                                    Style="{StaticResource ShellIconButtonStyle}"
                                                    Click="DeleteSession_Click"
                                                    Tag="{Binding Id}"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding AreActionsVisible, Converter={StaticResource BoolToVis}}"
                                                    AutomationProperties.Name="Delete chat"
                                                    ToolTipService.ToolTip="Delete chat">
                                                <ic:FluentIcon Icon="Dismiss" IconVariant="Regular" IconSize="Size12" RenderTransformOrigin="0.5,0.5" Foreground="{ThemeResource TextSecondaryBrush}">
                                                    <ic:FluentIcon.RenderTransform>
                                                        <ScaleTransform ScaleX="0.83" ScaleY="0.83" />
                                                    </ic:FluentIcon.RenderTransform>
                                                </ic:FluentIcon>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Spacing="6">
            <local:AddAgentForm x:Name="AddAgentPanel"
                                Visibility="Collapsed"
                                AgentAdded="AddAgentForm_AgentAdded" />

            <!-- IconText paints its icon and label from its own Foreground, so each site must
                 supply one (see IconText.xaml) — without it these two read as washed-out in both
                 themes. TextPrimary keeps them legible on the sidebar background either way. -->
            <Button Style="{StaticResource ShellNavButtonStyle}" Click="AddAgent_Click">
                <local:IconText Glyph="Add" IconSize="Size20" Spacing="9" Text="Add Agent"
                                Foreground="{ThemeResource TextPrimaryBrush}" />
            </Button>
            <Button Style="{StaticResource ShellNavButtonStyle}"
                    Click="Settings_Click"
                    AutomationProperties.Name="Open settings">
                <local:IconText Glyph="Settings" IconSize="Size20" Spacing="9" Text="Settings"
                                Foreground="{ThemeResource TextPrimaryBrush}" />
            </Button>
        </StackPanel>
    </Grid>
</UserControl>

<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ConnectOnion.WinUIClient.Controls.ShellSidebar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ShellSidebarBrush}"
          Padding="14,18,10,16"
          RowSpacing="10">
        <Grid.Resources>
            <Style x:Key="ShellNavButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="Padding" Value="8,6" />
            </Style>

            <Style x:Key="ShellIconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Width" Value="26" />
                <Setter Property="Height" Value="26" />
                <Setter Property="Padding" Value="0" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Button Grid.Row="0"
                Style="{StaticResource ShellNavButtonStyle}"
                Click="ChatHome_Click">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Width="32" Height="32" Source="/Assets/icon.png" />
                <TextBlock Grid.Column="1"
                           Text="ConnectOnion"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="2"
                           Text="desktop"
                           FontSize="10"
                           Foreground="{ThemeResource ShellMutedTextBrush}"
                           VerticalAlignment="Center" />
            </Grid>
        </Button>

        <Button Grid.Row="1"
                Style="{StaticResource ShellNavButtonStyle}"
                Click="Chat_Click"
                ToolTipService.ToolTip="Open chat">
            <StackPanel Orientation="Horizontal" Spacing="9">
                <FontIcon Glyph="&#xE8BD;" FontSize="16" />
                <TextBlock Text="Chat" />
            </StackPanel>
        </Button>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsRepeater ItemsSource="{Binding ShellAgents}">
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,2">
                            <Border CornerRadius="8"
                                    Background="{ThemeResource ShellRowBrush}"
                                    PointerEntered="AgentRow_PointerEntered"
                                    PointerExited="AgentRow_PointerExited"
                                    GotFocus="AgentRow_GotFocus"
                                    LostFocus="AgentRow_LostFocus">
                                <Grid MinHeight="44" Padding="6,0" ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            Style="{StaticResource ShellIconButtonStyle}"
                                            Click="ToggleAgent_Click"
                                            Tag="{Binding Id}"
                                            AutomationProperties.Name="Expand or collapse chats"
                                            ToolTipService.ToolTip="Expand or collapse chats">
                                        <FontIcon Glyph="&#xE70D;"
                                                  FontSize="11"
                                                  Foreground="{ThemeResource ShellMutedTextBrush}"
                                                  RenderTransformOrigin="0.5,0.5">
                                            <FontIcon.RenderTransform>
                                                <RotateTransform Angle="{Binding ChevronAngle}" />
                                            </FontIcon.RenderTransform>
                                        </FontIcon>
                                    </Button>
                                    <Border Grid.Column="1"
                                            Width="26"
                                            Height="26"
                                            VerticalAlignment="Center"
                                            CornerRadius="6"
                                            Background="{ThemeResource TextFillColorPrimaryBrush}">
                                        <TextBlock Text="{Binding Initial}"
                                                   Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <Button Grid.Column="2"
                                            Style="{StaticResource ShellNavButtonStyle}"
                                            Click="Agent_Click"
                                            Tag="{Binding Id}"
                                            Padding="0"
                                            MinHeight="0">
                                        <TextBlock Text="{Binding Name}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                    </Button>
                                    <StackPanel Grid.Column="3"
                                                Orientation="Horizontal"
                                                Spacing="2"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SessionCount}"
                                                   FontSize="10"
                                                   Foreground="{ThemeResource ShellMutedTextBrush}"
                                                   VerticalAlignment="Center" />
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="2"
                                                    Visibility="{Binding AreActionsVisible, Converter={StaticResource BoolToVis}}">
                                            <Button Style="{StaticResource ShellIconButtonStyle}"
                                                    Click="AddChat_Click"
                                                    Tag="{Binding Id}"
                                                    AutomationProperties.Name="New chat"
                                                    ToolTipService.ToolTip="New chat">
                                                <FontIcon Glyph="&#xE710;" FontSize="13" Foreground="{ThemeResource ShellMutedTextBrush}" />
                                            </Button>
                                            <Button Style="{StaticResource ShellIconButtonStyle}"
                                                    Click="EditAgent_Click"
                                                    Tag="{Binding Id}"
                                                    AutomationProperties.Name="Edit agent"
                                                    ToolTipService.ToolTip="Edit agent">
                                                <FontIcon Glyph="&#xE70F;" FontSize="13" Foreground="{ThemeResource ShellMutedTextBrush}" />
                                            </Button>
                                            <Button Style="{StaticResource ShellIconButtonStyle}"
                                                    Click="DeleteAgent_Click"
                                                    Tag="{Binding Id}"
                                                    AutomationProperties.Name="Delete agent"
                                                    ToolTipService.ToolTip="Delete agent">
                                                <FontIcon Glyph="&#xE711;" FontSize="13" Foreground="{ThemeResource ShellMutedTextBrush}" />
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <ItemsRepeater ItemsSource="{Binding Sessions}"
                                           Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="34,2,0,0"
                                              PointerEntered="SessionRow_PointerEntered"
                                              PointerExited="SessionRow_PointerExited"
                                              GotFocus="SessionRow_GotFocus"
                                              LostFocus="SessionRow_LostFocus">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0"
                                                    Style="{StaticResource ShellNavButtonStyle}"
                                                    Click="Session_Click"
                                                    Tag="{Binding Id}">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE8BD;"
                                                              FontSize="14"
                                                              Foreground="{ThemeResource ShellMutedTextBrush}" />
                                                    <TextBlock Text="{Binding Title}"
                                                               TextTrimming="CharacterEllipsis"
                                                               FontSize="13" />
                                                </StackPanel>
                                            </Button>
                                            <Button Grid.Column="1"
                                                    Margin="2,0,0,0"
                                                    Style="{StaticResource ShellIconButtonStyle}"
                                                    Click="DeleteSession_Click"
                                                    Tag="{Binding Id}"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding AreActionsVisible, Converter={StaticResource BoolToVis}}"
                                                    AutomationProperties.Name="Delete chat"
                                                    ToolTipService.ToolTip="Delete chat">
                                                <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="{ThemeResource ShellMutedTextBrush}" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Spacing="6">
            <Border x:Name="AddAgentPanel"
                    Padding="12"
                    CornerRadius="14"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Visibility="Collapsed">
                <StackPanel Spacing="8">
                    <Grid>
                        <TextBlock Text="Add agent"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <Button Style="{StaticResource ShellIconButtonStyle}"
                                HorizontalAlignment="Right"
                                Click="CloseAddAgentPanel_Click"
                                ToolTipService.ToolTip="Close add agent form">
                            <FontIcon Glyph="&#xE711;"
                                      FontSize="12"
                                      Foreground="{ThemeResource ShellMutedTextBrush}" />
                        </Button>
                    </Grid>

                    <TextBox x:Name="AddAgentAddressBox"
                             PlaceholderText="0x address (optional)"
                             TextChanged="AddAgentField_TextChanged"
                             MinHeight="38" />
                    <TextBox x:Name="AddAgentDirectUrlBox"
                             PlaceholderText="Optional direct URL"
                             TextChanged="AddAgentField_TextChanged"
                             MinHeight="38" />

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                x:Name="AddAgentTestButton"
                                Content="Test connection"
                                Click="TestAddAgentConnection_Click"
                                HorizontalAlignment="Stretch" />
                        <Button Grid.Column="1"
                                x:Name="AddAgentSubmitButton"
                                Content="Add Agent"
                                Style="{StaticResource AccentButtonStyle}"
                                IsEnabled="False"
                                Click="SubmitAddAgent_Click" />
                        <ProgressRing Grid.Column="2"
                                      x:Name="AddAgentTestRing"
                                      Width="18"
                                      Height="18"
                                      IsActive="False"
                                      VerticalAlignment="Center"
                                      Visibility="Collapsed" />
                    </Grid>

                    <TextBlock x:Name="AddAgentStatusText"
                               FontSize="11"
                               Foreground="{ThemeResource ShellMutedTextBrush}"
                               TextWrapping="WrapWholeWords"
                               Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <Button Style="{StaticResource ShellNavButtonStyle}" Click="AddAgent_Click">
                <StackPanel Orientation="Horizontal" Spacing="9">
                    <FontIcon Glyph="&#xE710;" FontSize="16" />
                    <TextBlock Text="Add Agent" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource ShellNavButtonStyle}" Click="Settings_Click">
                <StackPanel Orientation="Horizontal" Spacing="9">
                    <FontIcon Glyph="&#xE713;" FontSize="16" />
                    <TextBlock Text="Settings" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>

<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ConnectOnion.WinUIClient.Controls.ToolActivityView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:ConnectOnion.WinUIClient.Models">
    <Grid MaxWidth="760"
          Visibility="{x:Bind Activity.IsVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}">
        <Grid.ChildrenTransitions>
            <TransitionCollection><EntranceThemeTransition /></TransitionCollection>
        </Grid.ChildrenTransitions>
        <Border Background="{ThemeResource SurfaceSecondaryBrush}"
                BorderBrush="{ThemeResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10,8">
            <StackPanel Spacing="6">
                <Button Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Click="Header_Click"
                        AutomationProperties.Name="{x:Bind Activity.AccessibilityName, Mode=OneWay}">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Activity.StatusGlyph, Mode=OneWay}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{x:Bind Activity.Status, Mode=OneWay, Converter={StaticResource ToolStatusToBrush}}"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{x:Bind Activity.Summary, Mode=OneWay}"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                        <Grid Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="&#xE70D;"
                                       FontFamily="Segoe Fluent Icons"
                                       FontSize="10"
                                       Foreground="{ThemeResource TextTertiaryBrush}"
                                       Visibility="{x:Bind Activity.IsExpanded, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="&#xE76C;"
                                       FontFamily="Segoe Fluent Icons"
                                       FontSize="10"
                                       Foreground="{ThemeResource TextTertiaryBrush}"
                                       Visibility="{x:Bind Activity.IsExpanded, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                        </Grid>
                    </Grid>
                </Button>

                <Grid Visibility="{x:Bind Activity.IsTimelineVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <Border Width="2"
                            CornerRadius="1"
                            Background="{ThemeResource BorderSubtleBrush}"
                            HorizontalAlignment="Left"
                            Margin="7,5,0,7" />
                    <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{x:Bind Activity.Steps, Mode=OneWay}" Margin="0,0,0,2">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:ToolStepViewModel">
                                    <StackPanel Margin="0,2" Spacing="2">
                                        <Button Padding="4,3" Background="Transparent" BorderThickness="0"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                Click="Step_Click" Tag="{x:Bind}"
                                                AutomationProperties.Name="{x:Bind AccessibilityName, Mode=OneWay}">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind StatusGlyph, Mode=OneWay}" Width="14" TextAlignment="Center"
                                                           Foreground="{x:Bind Status, Mode=OneWay, Converter={StaticResource ToolStatusToBrush}}" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind DisplayName, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="2" Text="{x:Bind TimelineText, Mode=OneWay}" FontSize="11"
                                                           Foreground="{ThemeResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"
                                                           Visibility="{x:Bind HasTimelineText, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Grid.Column="3" Text="{x:Bind DurationLabel, Mode=OneWay}" FontSize="10"
                                                           Foreground="{ThemeResource TextTertiaryBrush}" />
                                                <Grid Grid.Column="4" VerticalAlignment="Center">
                                                    <TextBlock Text="&#xE70D;"
                                                               FontFamily="Segoe Fluent Icons"
                                                               FontSize="9"
                                                               Foreground="{ThemeResource TextTertiaryBrush}"
                                                               Visibility="{x:Bind IsExpanded, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                                    <TextBlock Text="&#xE76C;"
                                                               FontFamily="Segoe Fluent Icons"
                                                               FontSize="9"
                                                               Foreground="{ThemeResource TextTertiaryBrush}"
                                                               Visibility="{x:Bind IsExpanded, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                                                </Grid>
                                            </Grid>
                                        </Button>
                                        <StackPanel Margin="24,0,0,5" Spacing="4"
                                                    Visibility="{x:Bind IsExpanded, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{x:Bind Error, Mode=OneWay}" FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{ThemeResource DangerBrush}"
                                                       Visibility="{x:Bind HasError, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Text="{x:Bind Result, Mode=OneWay}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                                       Visibility="{x:Bind ShowResult, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ConnectOnion.WinUIClient.Controls.ToolActivityView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:models="using:ConnectOnion.WinUIClient.Models">

    <UserControl.Resources>
        <!-- Hover feedback comes through foreground color and icon visibility
             (handled in code-behind), never background painting. -->
    </UserControl.Resources>

    <Grid MaxWidth="{StaticResource ChatColumnWidth}"
          HorizontalAlignment="Stretch"
          Visibility="{x:Bind Activity.IsVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}">
        <Grid.ChildrenTransitions>
            <TransitionCollection>
                <EntranceThemeTransition />
            </TransitionCollection>
        </Grid.ChildrenTransitions>

        <StackPanel Spacing="5">
            <!-- Header row -->
            <Button MinHeight="30"
                    Padding="0,4"
                    Background="Transparent"
                    BorderThickness="0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Style="{StaticResource TransparentButtonStyle}"
                    Click="Header_Click"
                    PointerEntered="Header_PointerEntered"
                    PointerExited="Header_PointerExited"
                    AutomationProperties.Name="{x:Bind Activity.AccessibilityName, Mode=OneWay}">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="HeaderTitle"
                               Text="Tool activity"
                               FontSize="14"
                               Foreground="{ThemeResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{x:Bind Activity.Summary, Mode=OneWay}"
                               FontSize="11"
                               Foreground="{ThemeResource TextTertiaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="HeaderDuration"
                               Grid.Column="2"
                               Text="{x:Bind Activity.DurationLabel, Mode=OneWay}"
                               Margin="8,0,0,0"
                               FontSize="11"
                               Foreground="{ThemeResource TextTertiaryBrush}"
                               VerticalAlignment="Center" />
                    <Grid x:Name="HeaderChevron"
                          Grid.Column="3"
                          Width="20"
                          Height="20"
                          Margin="4,0,0,0"
                          VerticalAlignment="Center"
                          Opacity="0">
                        <ic:FluentIcon Icon="ChevronUp"
                                       IconVariant="Regular"
                                       IconSize="Size12"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextTertiaryBrush}"
                                       Visibility="{x:Bind Activity.IsExpanded, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                        <ic:FluentIcon Icon="ChevronDown"
                                       IconVariant="Regular"
                                       IconSize="Size12"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextTertiaryBrush}"
                                       Visibility="{x:Bind Activity.IsExpanded, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                    </Grid>
                </Grid>
            </Button>

            <!-- Timeline panel -->
            <Grid Margin="9,0,0,0"
                  Visibility="{x:Bind Activity.IsTimelineVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <Border Width="1"
                        Background="{ThemeResource BorderDefaultBrush}"
                        HorizontalAlignment="Left"
                        Margin="10,10,0,12" />

                <StackPanel>
                    <ItemsControl ItemsSource="{x:Bind Activity.Steps, Mode=OneWay}"
                                  Margin="0,2,4,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:ToolStepViewModel">
                            <Grid x:Name="StepItemRoot"
                                  Margin="0,2,0,10"
                                  ColumnSpacing="10"
                                  PointerEntered="StepItem_PointerEntered"
                                  PointerExited="StepItem_PointerExited">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="21" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Width="21"
                                        Height="21"
                                        CornerRadius="10.5"
                                        Background="{ThemeResource ChatBackgroundBrush}"
                                        VerticalAlignment="Top">
                                    <TextBlock Text="{x:Bind StatusGlyph, Mode=OneWay}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               TextAlignment="Center"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{x:Bind Status, Mode=OneWay, Converter={StaticResource ToolStatusToBrush}}" />
                                </Border>

                                <StackPanel Grid.Column="1"
                                            Spacing="5">
                                    <!-- Step header -->
                                    <Button MinHeight="0"
                                            Padding="0,1,0,3"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            CornerRadius="4"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            Style="{StaticResource TransparentButtonStyle}"
                                            Click="Step_Click"
                                            Tag="{x:Bind}"
                                            AutomationProperties.Name="{x:Bind AccessibilityName, Mode=OneWay}">
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Spacing="2">
                                                <TextBlock x:Name="StepNameText"
                                                           Text="{x:Bind DisplayName, Mode=OneWay}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{ThemeResource TextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind TimelineText, Mode=OneWay}"
                                                           FontSize="12"
                                                           Foreground="{ThemeResource TextSecondaryBrush}"
                                                           TextWrapping="WrapWholeWords"
                                                           MaxLines="2"
                                                           Visibility="{x:Bind HasTimelineText, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="1"
                                                       Text="{x:Bind DurationLabel, Mode=OneWay}"
                                                       FontSize="11"
                                                       Foreground="{ThemeResource TextTertiaryBrush}"
                                                       VerticalAlignment="Top"
                                                       Margin="12,2,0,0" />

                                            <Grid x:Name="StepChevron"
                                                  Grid.Column="2"
                                                  Width="20"
                                                  Height="20"
                                                  Margin="4,1,0,0"
                                                  VerticalAlignment="Top"
                                                  Opacity="0">
                                                <ic:FluentIcon Icon="ChevronUp"
                                                               IconVariant="Regular"
                                                               IconSize="Size12"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Foreground="{ThemeResource TextTertiaryBrush}"
                                                               Visibility="{x:Bind IsExpanded, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                                <ic:FluentIcon Icon="ChevronDown"
                                                               IconVariant="Regular"
                                                               IconSize="Size12"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Foreground="{ThemeResource TextTertiaryBrush}"
                                                               Visibility="{x:Bind IsExpanded, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                                            </Grid>
                                        </Grid>
                                    </Button>

                                    <!-- Per-step expanded content -->
                                    <ScrollViewer MaxHeight="330"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  Visibility="{x:Bind IsExpanded, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                        <StackPanel Spacing="7">
                                            <Border Background="{ThemeResource SurfaceSecondaryBrush}"
                                                    CornerRadius="7"
                                                    Padding="10,8"
                                                    Visibility="{x:Bind HasArguments, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="Input"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{ThemeResource TextTertiaryBrush}" />
                                                    <TextBlock Text="{x:Bind Arguments, Mode=OneWay}"
                                                               FontFamily="Consolas"
                                                               FontSize="11"
                                                               Foreground="{ThemeResource TextSecondaryBrush}"
                                                               TextWrapping="Wrap"
                                                               IsTextSelectionEnabled="True" />
                                                </StackPanel>
                                            </Border>

                                            <Border Background="{ThemeResource SurfaceElevatedBrush}"
                                                    BorderBrush="{ThemeResource BorderDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="10,8"
                                                    Visibility="{x:Bind ShowResult, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                                <StackPanel Spacing="5">
                                                    <TextBlock Text="Result"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{ThemeResource TextTertiaryBrush}" />
                                                    <TextBlock Text="{x:Bind Result, Mode=OneWay}"
                                                               FontFamily="Consolas"
                                                               FontSize="11"
                                                               Foreground="{ThemeResource TextPrimaryBrush}"
                                                               TextWrapping="Wrap"
                                                               IsTextSelectionEnabled="True" />
                                                </StackPanel>
                                            </Border>

                                            <Border Background="{ThemeResource SurfaceElevatedBrush}"
                                                    BorderBrush="{ThemeResource DangerBrush}"
                                                    BorderThickness="2,0,0,0"
                                                    CornerRadius="4"
                                                    Padding="10,7"
                                                    Visibility="{x:Bind HasError, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="Error"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{ThemeResource DangerBrush}" />
                                                    <TextBlock Text="{x:Bind Error, Mode=OneWay}"
                                                               FontFamily="Consolas"
                                                               FontSize="11"
                                                               Foreground="{ThemeResource TextPrimaryBrush}"
                                                               TextWrapping="Wrap"
                                                               IsTextSelectionEnabled="True" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Completion marker -->
                    <Grid ColumnSpacing="10" Margin="0,0,4,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="21" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="21"
                                Height="21"
                                CornerRadius="10.5"
                                Background="{ThemeResource ChatBackgroundBrush}">
                            <TextBlock Text="{x:Bind Activity.StatusGlyph, Mode=OneWay}"
                                       FontSize="13"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{x:Bind Activity.Status, Mode=OneWay, Converter={StaticResource ToolStatusToBrush}}" />
                        </Border>
                        <TextBlock Grid.Column="1"
                                   Text="{x:Bind Activity.CompletionLabel, Mode=OneWay}"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextSecondaryBrush}" />
                    </Grid>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>

<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ConnectOnion.WinUIClient.Controls.UsageSettingsContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ConnectOnion.WinUIClient.ViewModels"
    MinWidth="0" HorizontalAlignment="Stretch">

    <StackPanel MinWidth="0" HorizontalAlignment="Stretch" Spacing="16">
        <TextBlock Text="Token usage recorded on this device, grouped by model. Usage is kept even after you delete a conversation — the tokens were still spent — and never leaves your machine."
                   TextWrapping="Wrap" Foreground="{ThemeResource TextSecondaryBrush}" />

        <!-- Time window -->
        <StackPanel Orientation="Horizontal" Spacing="8">
            <RadioButton x:Name="TodayRange" GroupName="UsageRange" Content="Today"
                         Click="Range_Click" Tag="Today" />
            <RadioButton x:Name="Week" GroupName="UsageRange" Content="Last 7 days" IsChecked="True"
                         Click="Range_Click" Tag="Last7Days" />
            <RadioButton x:Name="Month" GroupName="UsageRange" Content="Last 30 days"
                         Click="Range_Click" Tag="Last30Days" />
            <RadioButton x:Name="AllTime" GroupName="UsageRange" Content="All time"
                         Click="Range_Click" Tag="AllTime" />
        </StackPanel>

        <ProgressRing IsActive="{x:Bind Vm.IsLoading, Mode=OneWay}"
                      Visibility="{x:Bind Vm.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                      HorizontalAlignment="Center" Margin="0,18" />

        <!-- Totals for the window -->
        <Border Style="{StaticResource SettingsSectionStyle}" HorizontalAlignment="Stretch"
                Visibility="{x:Bind Vm.ShowContent, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{x:Bind Vm.TotalTokensText, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="Total tokens" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextSecondaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{x:Bind Vm.TotalInputTokensText, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="Input" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextSecondaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="2">
                    <TextBlock Text="{x:Bind Vm.TotalOutputTokensText, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="Output" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextSecondaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="3" Spacing="2">
                    <TextBlock Text="{x:Bind Vm.TotalCallsText, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="LLM calls" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Per-model breakdown -->
        <Border Style="{StaticResource SettingsSectionStyle}" HorizontalAlignment="Stretch"
                Visibility="{x:Bind Vm.ShowContent, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <StackPanel Spacing="14">
                <TextBlock Text="By model" Style="{StaticResource BodyStrongTextBlockStyle}" />

                <ItemsControl ItemsSource="{x:Bind Vm.Rows, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:UsageRowViewModel">
                            <StackPanel Spacing="5" Margin="0,0,0,14"
                                        AutomationProperties.Name="{x:Bind AccessibilityName}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Model}" FontFamily="Consolas" FontSize="13"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind TotalTokensText}"
                                               FontWeight="SemiBold" VerticalAlignment="Center" />
                                </Grid>

                                <!-- Share bar, relative to the biggest model in this window. A
                                     ProgressBar rather than a hand-sized Border: it already stretches
                                     to its container, so the bar stays correct when the settings
                                     modal is resized, with no width converter to maintain. -->
                                <ProgressBar Value="{x:Bind SharePercent}" Maximum="100"
                                             Height="6" HorizontalAlignment="Stretch"
                                             Foreground="{ThemeResource BrandPrimaryBrush}"
                                             AutomationProperties.AccessibilityView="Raw" />

                                <StackPanel Orientation="Horizontal" Spacing="14">
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextSecondaryBrush}">
                                        <Run Text="{x:Bind CallsText}" /><Run Text=" calls" />
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextSecondaryBrush}">
                                        <Run Text="{x:Bind InputTokensText}" /><Run Text=" in" />
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextSecondaryBrush}">
                                        <Run Text="{x:Bind OutputTokensText}" /><Run Text=" out" />
                                    </TextBlock>
                                    <TextBlock Text="{x:Bind CacheText}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextTertiaryBrush}"
                                               Visibility="{x:Bind HasCacheHits, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Empty state -->
        <StackPanel Spacing="6" Margin="0,36" HorizontalAlignment="Center"
                    Visibility="{x:Bind Vm.ShowEmptyState, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="No usage recorded yet" HorizontalAlignment="Center"
                       Style="{StaticResource BodyStrongTextBlockStyle}" />
            <TextBlock Text="Token usage appears here after an agent replies."
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextSecondaryBrush}" />
        </StackPanel>

        <!-- Footer: provenance + the one and only path that deletes usage -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{x:Bind Vm.FirstRecordedText, Mode=OneWay}"
                       VerticalAlignment="Center" TextWrapping="Wrap"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextTertiaryBrush}"
                       Visibility="{x:Bind Vm.HasFirstRecorded, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
            <Button x:Name="ClearButton" Grid.Column="1" Content="Clear usage history"
                    Click="Clear_Click"
                    AutomationProperties.Name="Clear all recorded token usage"
                    Visibility="{x:Bind Vm.ShowContent, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
        </Grid>
    </StackPanel>
</UserControl>

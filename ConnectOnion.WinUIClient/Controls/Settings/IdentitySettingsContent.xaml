<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ConnectOnion.WinUIClient.Controls.IdentitySettingsContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ic="using:FluentIcons.WinUI"
    MinWidth="0" HorizontalAlignment="Stretch">
    <StackPanel MinWidth="0" HorizontalAlignment="Stretch" Spacing="16">
        <TextBlock Text="This desktop client uses an Ed25519 identity to sign ConnectOnion messages. Agents recognize you by the address below."
                   TextWrapping="Wrap" Foreground="{ThemeResource TextSecondaryBrush}" />
        <Border Style="{StaticResource SettingsSectionStyle}" HorizontalAlignment="Stretch">
            <StackPanel Spacing="18">
                <Grid MinWidth="0" ColumnSpacing="14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" MinWidth="0" Spacing="4">
                        <TextBlock Text="Address" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="AddressText" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontFamily="{StaticResource JetBrainsMonoFontFamily}" />
                    </StackPanel>
                    <Button Grid.Column="1" Tag="address" Padding="10,6" VerticalAlignment="Center"
                            Click="Copy_Click" AutomationProperties.Name="Copy identity address" ToolTipService.ToolTip="Copy address">
                        <ic:FluentIcon Icon="Copy" IconVariant="Regular" IconSize="Size16" />
                    </Button>
                </Grid>
                <Grid MinWidth="0" ColumnSpacing="14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" MinWidth="0" Spacing="4">
                        <TextBlock Text="Public key" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="PublicKeyText" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontFamily="{StaticResource JetBrainsMonoFontFamily}" />
                    </StackPanel>
                    <Button Grid.Column="1" Tag="publicKey" Padding="10,6" VerticalAlignment="Center"
                            Click="Copy_Click" AutomationProperties.Name="Copy public key" ToolTipService.ToolTip="Copy public key">
                        <ic:FluentIcon Icon="Copy" IconVariant="Regular" IconSize="Size16" />
                    </Button>
                </Grid>
                <StackPanel Spacing="4">
                    <TextBlock Text="Storage" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Name="StorageText" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                               FontFamily="{StaticResource JetBrainsMonoFontFamily}" Foreground="{ThemeResource TextSecondaryBrush}" />
                </StackPanel>
                <TextBlock Text="Your private identity is encrypted on this device with your Windows account, which is what keeps the database safe — and also why a copy of it cannot be opened anywhere else. Use the backup below to move this identity to another machine."
                           TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextSecondaryBrush}" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource SettingsSectionStyle}" HorizontalAlignment="Stretch">
            <StackPanel Spacing="12">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="3">
                        <TextBlock Text="OpenOnion account" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="Signed in with this device identity. The API key remains in memory only."
                                   TextWrapping="Wrap"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextSecondaryBrush}" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="Refresh"
                            VerticalAlignment="Center"
                            Click="RefreshAccount_Click"
                            AutomationProperties.Name="Refresh OpenOnion balance" />
                </Grid>

                <ProgressRing x:Name="AccountProgress"
                              Width="18"
                              Height="18"
                              HorizontalAlignment="Left"
                              IsActive="False"
                              Visibility="Collapsed"
                              AutomationProperties.Name="Loading OpenOnion account" />
                <InfoBar x:Name="AccountErrorBar"
                         Severity="Warning"
                         Title="Account unavailable"
                         IsOpen="False"
                         IsClosable="False" />

                <StackPanel x:Name="AccountSummaryPanel" Spacing="12" Visibility="Collapsed">
                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Balance" Style="{StaticResource CaptionTextBlockStyle}" />
                            <TextBlock x:Name="BalanceText" FontSize="20" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="Purchased" Style="{StaticResource CaptionTextBlockStyle}" />
                            <TextBlock x:Name="PurchasedText" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="2">
                            <TextBlock Text="Spent" Style="{StaticResource CaptionTextBlockStyle}" />
                            <TextBlock x:Name="SpentText" />
                        </StackPanel>
                    </Grid>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel MinWidth="0" Spacing="3">
                            <TextBlock Text="API key" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Name="ApiKeyText"
                                       TextTrimming="CharacterEllipsis"
                                       IsTextSelectionEnabled="True"
                                       FontFamily="{StaticResource JetBrainsMonoFontFamily}"
                                       AutomationProperties.Name="Masked OpenOnion API key" />
                        </StackPanel>
                        <Button x:Name="RevealApiKeyButton"
                                Grid.Column="1"
                                Content="Reveal"
                                Click="RevealApiKey_Click"
                                AutomationProperties.Name="Reveal OpenOnion API key" />
                        <Button Grid.Column="2"
                                Tag="apiKey"
                                Content="Copy"
                                Click="Copy_Click"
                                AutomationProperties.Name="Copy OpenOnion API key" />
                    </Grid>

                    <Button Content="Top up balance"
                            HorizontalAlignment="Left"
                            Click="TopUp_Click"
                            AutomationProperties.Name="Open the OpenOnion purchase page" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource SettingsSectionStyle}" HorizontalAlignment="Stretch">
            <StackPanel Spacing="12">
                <TextBlock Text="Backup and recovery" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock x:Name="BackupDescriptionText" TextWrapping="Wrap" MinWidth="0"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextSecondaryBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button x:Name="ShowBackupButton" Click="ShowBackup_Click"
                            AutomationProperties.AutomationId="ShowIdentityBackupButton"
                            AutomationProperties.Name="Show recovery phrase">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ic:FluentIcon Icon="Key" IconVariant="Regular" IconSize="Size16" />
                            <TextBlock x:Name="ShowBackupButtonText" Text="Show recovery phrase" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="RestoreButton" Click="Restore_Click"
                            AutomationProperties.AutomationId="RestoreIdentityButton"
                            AutomationProperties.Name="Restore an identity from a recovery phrase">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ic:FluentIcon Icon="ArrowClockwise" IconVariant="Regular" IconSize="Size16" />
                            <TextBlock Text="Restore..." />
                        </StackPanel>
                    </Button>
                    <Button x:Name="GenerateIdentityButton"
                            Click="GenerateIdentity_Click"
                            Foreground="{ThemeResource DangerBrush}"
                            AutomationProperties.AutomationId="GenerateIdentityButton"
                            AutomationProperties.Name="Generate a new ConnectOnion identity">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ic:FluentIcon Icon="ArrowSync" IconVariant="Regular" IconSize="Size16" />
                            <TextBlock Text="Generate new..." />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <InfoBar x:Name="IdentityActionErrorBar"
                         Severity="Error"
                         Title="Identity unchanged"
                         IsOpen="False"
                         IsClosable="True" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>

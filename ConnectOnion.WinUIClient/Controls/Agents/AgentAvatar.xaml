<?xml version="1.0" encoding="utf-8"?>

<UserControl
    x:Class="ConnectOnion.WinUIClient.Controls.AgentAvatar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="{x:Bind Size, Mode=OneWay}"
    Height="{x:Bind Size, Mode=OneWay}"
    IsTabStop="False"
    UseLayoutRounding="True"
    mc:Ignorable="d">

    <!--
        AvatarBorder defines the avatar shape, fallback background,
        border and clipping area.

        When ImagePath resolves to a valid app-managed image,
        CustomAvatarImage is shown.

        If ImagePath is empty, invalid, missing or fails to load,
        InitialText and the deterministic palette remain visible.
    -->
    <Border
        x:Name="AvatarBorder"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        Background="{ThemeResource AvatarBackgroundBrush}"
        BorderBrush="{ThemeResource AvatarBorderBrush}"
        BorderThickness="1"
        CornerRadius="{x:Bind CornerRadius, Mode=OneWay}">

        <Grid
            x:Name="AvatarContentRoot"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">

            <VisualStateManager.VisualStateGroups>

                <!--
                    Determines whether the control displays the fallback
                    initial or the custom Agent image.

                    These names must match AgentAvatar.xaml.cs:
                    - FallbackInitial
                    - CustomImage
                -->
                <VisualStateGroup x:Name="ContentStates">

                    <VisualState x:Name="FallbackInitial">
                        <VisualState.Setters>

                            <Setter
                                Target="InitialText.Visibility"
                                Value="Visible" />

                            <Setter
                                Target="CustomAvatarImage.Visibility"
                                Value="Collapsed" />

                        </VisualState.Setters>
                    </VisualState>

                    <VisualState x:Name="CustomImage">
                        <VisualState.Setters>

                            <Setter
                                Target="InitialText.Visibility"
                                Value="Collapsed" />

                            <Setter
                                Target="CustomAvatarImage.Visibility"
                                Value="Visible" />

                        </VisualState.Setters>
                    </VisualState>

                </VisualStateGroup>

                <!--
                    Identity colours are deliberately separate from the
                    Online, Warning and Error semantic colours.

                    These state names must match PaletteStateNames in
                    AgentAvatar.xaml.cs.
                -->
                <VisualStateGroup x:Name="PaletteStates">

                    <VisualState x:Name="Neutral">
                        <VisualState.Setters>

                            <Setter
                                Target="AvatarBorder.Background"
                                Value="{ThemeResource AvatarBackgroundBrush}" />

                            <Setter
                                Target="AvatarBorder.BorderBrush"
                                Value="{ThemeResource AvatarBorderBrush}" />

                            <Setter
                                Target="InitialText.Foreground"
                                Value="{ThemeResource AvatarForegroundBrush}" />

                        </VisualState.Setters>
                    </VisualState>

                    <VisualState x:Name="Blue">
                        <VisualState.Setters>

                            <Setter
                                Target="AvatarBorder.Background"
                                Value="{ThemeResource AvatarPaletteBlueBackgroundBrush}" />

                            <Setter
                                Target="AvatarBorder.BorderBrush"
                                Value="{ThemeResource AvatarPaletteBlueForegroundBrush}" />

                            <Setter
                                Target="InitialText.Foreground"
                                Value="{ThemeResource AvatarPaletteBlueForegroundBrush}" />

                        </VisualState.Setters>
                    </VisualState>

                    <VisualState x:Name="Violet">
                        <VisualState.Setters>

                            <Setter
                                Target="AvatarBorder.Background"
                                Value="{ThemeResource AvatarPaletteVioletBackgroundBrush}" />

                            <Setter
                                Target="AvatarBorder.BorderBrush"
                                Value="{ThemeResource AvatarPaletteVioletForegroundBrush}" />

                            <Setter
                                Target="InitialText.Foreground"
                                Value="{ThemeResource AvatarPaletteVioletForegroundBrush}" />

                        </VisualState.Setters>
                    </VisualState>

                    <VisualState x:Name="Teal">
                        <VisualState.Setters>

                            <Setter
                                Target="AvatarBorder.Background"
                                Value="{ThemeResource AvatarPaletteTealBackgroundBrush}" />

                            <Setter
                                Target="AvatarBorder.BorderBrush"
                                Value="{ThemeResource AvatarPaletteTealForegroundBrush}" />

                            <Setter
                                Target="InitialText.Foreground"
                                Value="{ThemeResource AvatarPaletteTealForegroundBrush}" />

                        </VisualState.Setters>
                    </VisualState>

                    <VisualState x:Name="Coral">
                        <VisualState.Setters>

                            <Setter
                                Target="AvatarBorder.Background"
                                Value="{ThemeResource AvatarPaletteCoralBackgroundBrush}" />

                            <Setter
                                Target="AvatarBorder.BorderBrush"
                                Value="{ThemeResource AvatarPaletteCoralForegroundBrush}" />

                            <Setter
                                Target="InitialText.Foreground"
                                Value="{ThemeResource AvatarPaletteCoralForegroundBrush}" />

                        </VisualState.Setters>
                    </VisualState>

                    <VisualState x:Name="Indigo">
                        <VisualState.Setters>

                            <Setter
                                Target="AvatarBorder.Background"
                                Value="{ThemeResource AvatarPaletteIndigoBackgroundBrush}" />

                            <Setter
                                Target="AvatarBorder.BorderBrush"
                                Value="{ThemeResource AvatarPaletteIndigoForegroundBrush}" />

                            <Setter
                                Target="InitialText.Foreground"
                                Value="{ThemeResource AvatarPaletteIndigoForegroundBrush}" />

                        </VisualState.Setters>
                    </VisualState>

                    <VisualState x:Name="Cyan">
                        <VisualState.Setters>

                            <Setter
                                Target="AvatarBorder.Background"
                                Value="{ThemeResource AvatarPaletteCyanBackgroundBrush}" />

                            <Setter
                                Target="AvatarBorder.BorderBrush"
                                Value="{ThemeResource AvatarPaletteCyanForegroundBrush}" />

                            <Setter
                                Target="InitialText.Foreground"
                                Value="{ThemeResource AvatarPaletteCyanForegroundBrush}" />

                        </VisualState.Setters>
                    </VisualState>

                    <VisualState x:Name="Emerald">
                        <VisualState.Setters>

                            <Setter
                                Target="AvatarBorder.Background"
                                Value="{ThemeResource AvatarPaletteEmeraldBackgroundBrush}" />

                            <Setter
                                Target="AvatarBorder.BorderBrush"
                                Value="{ThemeResource AvatarPaletteEmeraldForegroundBrush}" />

                            <Setter
                                Target="InitialText.Foreground"
                                Value="{ThemeResource AvatarPaletteEmeraldForegroundBrush}" />

                        </VisualState.Setters>
                    </VisualState>

                    <VisualState x:Name="Amber">
                        <VisualState.Setters>

                            <Setter
                                Target="AvatarBorder.Background"
                                Value="{ThemeResource AvatarPaletteAmberBackgroundBrush}" />

                            <Setter
                                Target="AvatarBorder.BorderBrush"
                                Value="{ThemeResource AvatarPaletteAmberForegroundBrush}" />

                            <Setter
                                Target="InitialText.Foreground"
                                Value="{ThemeResource AvatarPaletteAmberForegroundBrush}" />

                        </VisualState.Setters>
                    </VisualState>

                    <VisualState x:Name="Rose">
                        <VisualState.Setters>

                            <Setter
                                Target="AvatarBorder.Background"
                                Value="{ThemeResource AvatarPaletteRoseBackgroundBrush}" />

                            <Setter
                                Target="AvatarBorder.BorderBrush"
                                Value="{ThemeResource AvatarPaletteRoseForegroundBrush}" />

                            <Setter
                                Target="InitialText.Foreground"
                                Value="{ThemeResource AvatarPaletteRoseForegroundBrush}" />

                        </VisualState.Setters>
                    </VisualState>

                    <VisualState x:Name="Plum">
                        <VisualState.Setters>

                            <Setter
                                Target="AvatarBorder.Background"
                                Value="{ThemeResource AvatarPalettePlumBackgroundBrush}" />

                            <Setter
                                Target="AvatarBorder.BorderBrush"
                                Value="{ThemeResource AvatarPalettePlumForegroundBrush}" />

                            <Setter
                                Target="InitialText.Foreground"
                                Value="{ThemeResource AvatarPalettePlumForegroundBrush}" />

                        </VisualState.Setters>
                    </VisualState>

                    <VisualState x:Name="Slate">
                        <VisualState.Setters>

                            <Setter
                                Target="AvatarBorder.Background"
                                Value="{ThemeResource AvatarPaletteSlateBackgroundBrush}" />

                            <Setter
                                Target="AvatarBorder.BorderBrush"
                                Value="{ThemeResource AvatarPaletteSlateForegroundBrush}" />

                            <Setter
                                Target="InitialText.Foreground"
                                Value="{ThemeResource AvatarPaletteSlateForegroundBrush}" />

                        </VisualState.Setters>
                    </VisualState>

                    <VisualState x:Name="Olive">
                        <VisualState.Setters>

                            <Setter
                                Target="AvatarBorder.Background"
                                Value="{ThemeResource AvatarPaletteOliveBackgroundBrush}" />

                            <Setter
                                Target="AvatarBorder.BorderBrush"
                                Value="{ThemeResource AvatarPaletteOliveForegroundBrush}" />

                            <Setter
                                Target="InitialText.Foreground"
                                Value="{ThemeResource AvatarPaletteOliveForegroundBrush}" />

                        </VisualState.Setters>
                    </VisualState>

                </VisualStateGroup>

            </VisualStateManager.VisualStateGroups>

            <!--
                Fallback Agent initial.

                This remains the default visible element until the code-behind
                has successfully loaded and decoded a custom image.
            -->
            <TextBlock
                x:Name="InitialText"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="{x:Bind FontSize, Mode=OneWay}"
                FontWeight="SemiBold"
                Foreground="{ThemeResource AvatarForegroundBrush}"
                IsHitTestVisible="False"
                MaxLines="1"
                Text="{x:Bind Initial, Mode=OneWay}"
                TextAlignment="Center"
                TextTrimming="CharacterEllipsis"
                Visibility="Visible" />

            <!--
                Custom Agent image.

                Source is assigned by AgentAvatar.xaml.cs after ImagePath has
                been resolved and validated.

                AgentIconService normally produces a square 256 × 256 PNG.
                UniformToFill also protects the layout if a stored file is
                manually replaced with a non-square image.
            -->
            <Image
                x:Name="CustomAvatarImage"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                AutomationProperties.AccessibilityView="Raw"
                ImageFailed="CustomImage_ImageFailed"
                IsHitTestVisible="False"
                Stretch="UniformToFill"
                Visibility="Collapsed" />

        </Grid>
    </Border>
</UserControl>
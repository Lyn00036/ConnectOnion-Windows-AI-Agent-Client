<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ConnectOnion.WinUIClient.Controls.AgentAvatar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Brand-colored square with the agent's initial. Size/CornerRadius/FontSize
         are set per-site; the brushes, centering and bold weight are shared. -->
    <Border Width="{x:Bind Size, Mode=OneWay}"
            Height="{x:Bind Size, Mode=OneWay}"
            CornerRadius="{x:Bind CornerRadius, Mode=OneWay}"
            Background="{ThemeResource BrandPrimaryBrush}">
        <TextBlock Text="{x:Bind Initial, Mode=OneWay}"
                   Foreground="{ThemeResource TextOnBrandBrush}"
                   FontSize="{x:Bind FontSize, Mode=OneWay}"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
    </Border>
</UserControl>

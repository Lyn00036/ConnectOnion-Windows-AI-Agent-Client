<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ConnectOnion.WinUIClient.Controls.ChatComposer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    SizeChanged="Composer_SizeChanged">

    <StackPanel x:Name="ComposerPanel"
                MaxWidth="880"
                Margin="24,0,24,24"
                HorizontalAlignment="Center"
                Spacing="10"
                Width="880">
        <StackPanel x:Name="SuggestionPanel"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Spacing="8">
            <Button Content="What can you do?"
                    Tag="What can you do?"
                    Padding="14,6"
                    CornerRadius="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Click="Suggestion_Click" />
            <Button Content="Show system info"
                    Tag="Show system info"
                    Padding="14,6"
                    CornerRadius="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Click="Suggestion_Click" />
            <Button Content="List files"
                    Tag="List files in current directory"
                    Padding="14,6"
                    CornerRadius="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Click="Suggestion_Click" />
        </StackPanel>

        <Border CornerRadius="24"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
            <Grid MinHeight="112" Padding="14,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBox x:Name="InputBox"
                         Grid.Row="0"
                         MinHeight="48"
                         MaxHeight="160"
                         Padding="4,7,4,8"
                         PlaceholderText="Message this agent..."
                         PlaceholderForeground="{ThemeResource TextFillColorTertiaryBrush}"
                         Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                         FontSize="16"
                         FontWeight="SemiBold"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         BorderThickness="0"
                         Background="Transparent"
                         VerticalAlignment="Stretch"
                         TextChanged="InputBox_TextChanged"
                         PreviewKeyDown="InputBox_PreviewKeyDown">
                    <TextBox.Resources>
                        <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                        <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                    </TextBox.Resources>
                </TextBox>

                <Grid Grid.Row="1"
                      Margin="0,6,0,0"
                      ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Width="36"
                            Height="36"
                            Padding="0"
                            CornerRadius="18"
                            Background="Transparent"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            ToolTipService.ToolTip="Add attachment">
                        <ic:FluentIcon Icon="Add"
                                       IconVariant="Regular"
                                       IconSize="Size20"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Button>

                    <Button x:Name="SendButton"
                            Grid.Column="2"
                            Width="36"
                            Height="36"
                            Padding="0"
                            CornerRadius="18"
                            BorderThickness="0"
                            IsEnabled="False"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Click="Send_Click"
                            ToolTipService.ToolTip="Send message">
                        <Grid Width="20" Height="20">
                            <ic:FluentIcon x:Name="SendIcon"
                                           Icon="ArrowUp"
                                           IconVariant="Regular"
                                           IconSize="Size20" />
                            <ProgressRing x:Name="BusyRing"
                                          Width="18"
                                          Height="18"
                                          IsActive="False"
                                          Visibility="Collapsed" />
                        </Grid>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>

<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ConnectOnion.WinUIClient.Controls.ChatComposer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:models="using:ConnectOnion.WinUIClient.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    SizeChanged="Composer_SizeChanged">

    <StackPanel x:Name="ComposerPanel"
                MaxWidth="880"
                Margin="24,0,24,24"
                HorizontalAlignment="Center"
                Spacing="10"
                Width="880">
        <ScrollViewer x:Name="AttachmentsScrollViewer"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled"
                      HorizontalAlignment="Center"
                      MaxWidth="880"
                      Visibility="Collapsed">
            <ItemsControl x:Name="AttachmentsList" ItemsSource="{x:Bind PendingAttachments}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:PendingAttachment">
                        <Border Width="180"
                                Height="56"
                                CornerRadius="10"
                                Padding="8,6"
                                Background="{ThemeResource SurfaceElevatedBrush}"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource BorderDefaultBrush}">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid Width="36" Height="36" VerticalAlignment="Center">
                                    <Border CornerRadius="6"
                                            Background="{ThemeResource SurfaceSecondaryBrush}"
                                            Visibility="{x:Bind IsImage, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                                        <ic:FluentIcon Icon="DocumentText"
                                                       IconVariant="Regular"
                                                       IconSize="Size20"
                                                       Foreground="{ThemeResource TextSecondaryBrush}" />
                                    </Border>
                                    <Border CornerRadius="6"
                                            Visibility="{x:Bind IsImage, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                        <Image Source="{x:Bind LocalPath, Mode=OneWay, Converter={StaticResource PathToImage}}"
                                               Stretch="UniformToFill" />
                                    </Border>
                                    <ProgressRing Width="18" Height="18"
                                                  IsActive="{x:Bind IsBusy, Mode=OneWay}"
                                                  Visibility="{x:Bind IsBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                    <ic:FluentIcon Icon="ErrorCircle"
                                                   IconVariant="Filled"
                                                   IconSize="Size16"
                                                   Foreground="{ThemeResource DangerBrush}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Bottom"
                                                   Visibility="{x:Bind IsFailed, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                                   ToolTipService.ToolTip="{x:Bind Error, Mode=OneWay}" />
                                </Grid>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Text="{x:Bind FileName}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               MaxLines="1" />
                                    <TextBlock Text="{x:Bind SizeLabel}"
                                               FontSize="10"
                                               Foreground="{ThemeResource TextSecondaryBrush}"
                                               Visibility="{x:Bind IsFailed, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                                    <TextBlock Text="{x:Bind Error, Mode=OneWay}"
                                               FontSize="10"
                                               Foreground="{ThemeResource DangerBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               MaxLines="1"
                                               Visibility="{x:Bind IsFailed, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>

                                <Button Grid.Column="2"
                                        Width="22"
                                        Height="22"
                                        Padding="0"
                                        MinWidth="0"
                                        MinHeight="0"
                                        CornerRadius="11"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        VerticalAlignment="Top"
                                        Tag="{x:Bind}"
                                        Click="RemoveAttachment_Click"
                                        ToolTipService.ToolTip="Remove">
                                    <ic:FluentIcon Icon="Dismiss"
                                                   IconVariant="Regular"
                                                   IconSize="Size12"
                                                   Foreground="{ThemeResource TextSecondaryBrush}" />
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel x:Name="SuggestionPanel"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Spacing="8">
            <Button Content="What can you do?"
                    Tag="What can you do?"
                    Padding="14,6"
                    CornerRadius="16"
                    Background="{ThemeResource SurfaceElevatedBrush}"
                    BorderBrush="{ThemeResource BorderDefaultBrush}"
                    BorderThickness="1"
                    Click="Suggestion_Click" />
            <Button Content="Show system info"
                    Tag="Show system info"
                    Padding="14,6"
                    CornerRadius="16"
                    Background="{ThemeResource SurfaceElevatedBrush}"
                    BorderBrush="{ThemeResource BorderDefaultBrush}"
                    BorderThickness="1"
                    Click="Suggestion_Click" />
            <Button Content="List files"
                    Tag="List files in current directory"
                    Padding="14,6"
                    CornerRadius="16"
                    Background="{ThemeResource SurfaceElevatedBrush}"
                    BorderBrush="{ThemeResource BorderDefaultBrush}"
                    BorderThickness="1"
                    Click="Suggestion_Click" />
        </StackPanel>

        <!-- AllowDrop lives on this Border rather than on InputBox or the outer panel:
             the drag events are routed, so every child (input box, buttons) bubbles up
             to one handler, and the drop region visually matches the rounded surface
             the DropOverlay paints over. -->
        <Border x:Name="ComposerSurface"
                CornerRadius="24"
                Background="{ThemeResource ComposerBackgroundBrush}"
                BorderBrush="{ThemeResource ComposerBorderBrush}"
                BorderThickness="1"
                AllowDrop="True"
                DragEnter="Composer_DragEnter"
                DragOver="Composer_DragOver"
                DragLeave="Composer_DragLeave"
                Drop="Composer_Drop">
            <Grid MinHeight="112" Padding="14,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBox x:Name="InputBox"
                         AutomationProperties.AutomationId="MessageInput"
                         Grid.Row="0"
                         MinHeight="48"
                         MaxHeight="160"
                         Padding="4,7,4,8"
                         PlaceholderText="Do anything"
                         PlaceholderForeground="{ThemeResource ComposerPlaceholderBrush}"
                         Foreground="{ThemeResource ComposerTextBrush}"
                         FontSize="16"
                         FontWeight="SemiBold"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                         BorderThickness="0"
                         Background="Transparent"
                         VerticalAlignment="Stretch"
                         TextChanged="InputBox_TextChanged"
                         PreviewKeyDown="InputBox_PreviewKeyDown">
                    <TextBox.Resources>
                        <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                        <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                        <!-- Keep the input transparent across every visual state so the outer
                             composer Border's color shows through unchanged — WinUI's TextBox
                             otherwise paints its own PointerOver/Focused background over the
                             transparent default, making the field flash a different shade on
                             hover and while typing. -->
                        <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent" />
                    </TextBox.Resources>
                </TextBox>

                <Grid Grid.Row="1"
                      Margin="0,6,0,0"
                      ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="AddAttachmentButton"
                            Grid.Column="0"
                            Width="36"
                            Height="36"
                            Padding="0"
                            CornerRadius="18"
                            Background="Transparent"
                            BorderBrush="{ThemeResource ComposerControlBorderBrush}"
                            BorderThickness="1"
                            Click="AddAttachment_Click"
                            ToolTipService.ToolTip="Add attachment">
                        <ic:FluentIcon Icon="Add"
                                       IconVariant="Regular"
                                       IconSize="Size20"
                                       Foreground="{ThemeResource ComposerMutedControlBrush}" />
                    </Button>

                    <Grid x:Name="RecordingWaveformHost"
                          Grid.Column="1"
                          Height="36"
                          MinWidth="120"
                          Visibility="Collapsed">
                        <Border Background="{ThemeResource SurfaceElevatedBrush}"
                                CornerRadius="4" />
                        <canvas:CanvasAnimatedControl x:Name="WaveformCanvas"
                                                      HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Stretch"
                                                      ClearColor="Transparent" />
                        <ProgressRing x:Name="BufferSpinner"
                                      Width="18"
                                      Height="18"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      IsActive="False"
                                      Visibility="Collapsed"
                                      Foreground="{ThemeResource ComposerMutedControlBrush}" />
                        <TextBlock x:Name="WaveformTimerText"
                                   Text="0:00"
                                   FontSize="11"
                                   Foreground="{ThemeResource TextTertiaryBrush}"
                                   VerticalAlignment="Bottom"
                                   HorizontalAlignment="Right"
                                   Margin="0,0,8,3" />
                    </Grid>

                    <Button x:Name="SpeechButton"
                            Grid.Column="3"
                            Width="36"
                            Height="36"
                            Padding="0"
                            CornerRadius="18"
                            Background="Transparent"
                            BorderBrush="{ThemeResource ComposerControlBorderBrush}"
                            BorderThickness="1"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Click="Speech_Click"
                            ToolTipService.ToolTip="Voice input">
                        <Grid Width="20" Height="20">
                            <ic:FluentIcon x:Name="SpeechIcon"
                                           Icon="Mic"
                                           IconVariant="Regular"
                                           IconSize="Size20"
                                           Foreground="{ThemeResource ComposerMutedControlBrush}" />
                            <ProgressRing x:Name="SpeechRing"
                                          Width="18"
                                          Height="18"
                                          IsActive="False"
                                          Visibility="Collapsed" />
                        </Grid>
                    </Button>

                    <Button x:Name="StopSpeechButton"
                            AutomationProperties.AutomationId="StopResponseButton"
                            Grid.Column="3"
                            Width="36"
                            Height="36"
                            Padding="0"
                            CornerRadius="18"
                            Background="{ThemeResource ComposerStopButtonBackgroundBrush}"
                            BorderThickness="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Click="StopSpeech_Click"
                            Visibility="Collapsed"
                            ToolTipService.ToolTip="Stop voice input">
                        <Rectangle Width="9"
                                   Height="9"
                                   RadiusX="1"
                                   RadiusY="1"
                                   Fill="{ThemeResource ComposerStopButtonForegroundBrush}" />
                    </Button>

                    <Button x:Name="SendButton"
                            AutomationProperties.AutomationId="SendMessageButton"
                            Grid.Column="4"
                            Width="36"
                            Height="36"
                            Padding="0"
                            CornerRadius="18"
                            BorderThickness="0"
                            Background="{ThemeResource ComposerPrimaryButtonBackgroundBrush}"
                            IsEnabled="False"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Click="Send_Click"
                            ToolTipService.ToolTip="Send message">
                        <Grid Width="20" Height="20">
                            <ic:FluentIcon x:Name="SendIcon"
                                           Icon="ArrowUp"
                                           IconVariant="Regular"
                                           IconSize="Size20"
                                           Foreground="{ThemeResource ComposerPrimaryButtonForegroundBrush}" />
                            <ProgressRing x:Name="BusyRing"
                                          Width="18"
                                          Height="18"
                                          IsActive="False"
                                          Visibility="Collapsed" />
                        </Grid>
                    </Button>
                </Grid>

                <!-- Drop affordance. Negative margin cancels the parent Grid's Padding so it
                     covers the whole rounded surface. IsHitTestVisible=False keeps it out of
                     the drag hit-test, which would otherwise make DragLeave fire the moment
                     the overlay appears under the pointer. -->
                <Grid x:Name="DropOverlay"
                      Grid.Row="0"
                      Grid.RowSpan="2"
                      Margin="-14,-12,-14,-12"
                      IsHitTestVisible="False"
                      Visibility="Collapsed">
                    <Border CornerRadius="24"
                            Background="{ThemeResource ComposerBackgroundBrush}"
                            Opacity="0.92" />
                    <Rectangle Margin="2"
                               RadiusX="22"
                               RadiusY="22"
                               Fill="Transparent"
                               Stroke="{ThemeResource BrandPrimaryBrush}"
                               StrokeThickness="2"
                               StrokeDashArray="4,3"
                               StrokeDashCap="Round" />
                    <StackPanel Orientation="Horizontal"
                                Spacing="10"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <ic:FluentIcon Icon="ArrowDown"
                                       IconVariant="Regular"
                                       IconSize="Size20"
                                       Foreground="{ThemeResource BrandPrimaryBrush}"
                                       VerticalAlignment="Center" />
                        <TextBlock Text="Drop files to attach"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource BrandPrimaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
